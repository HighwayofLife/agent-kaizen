#!/usr/bin/env python3
"""Configure scheduled agent-kaizen work.

Commands:
  config show [--for DIR]           show effective scheduled settings and reports path
  config set [--for DIR] KEY=VALUE  merge global or project scheduled settings
                                    (--for DIR scheduledAutonomy=auto|propose also adds or removes
                                    DIR in the global autoProjects list, which project auto needs)
  audit                            run the global token audit
  review [--dry-run]                audit and review every due project
  housekeep [--dry-run]             delete expired generated audit files

Global settings live in <Claude config dir>/agent-kaizen.json; project settings
live in docs/kaizen/config.json. Interactive autonomy settings are left unchanged.
"""
import argparse
import contextlib
import fnmatch
from datetime import datetime, timedelta, timezone
import hashlib
import json
import math
import os
from pathlib import Path
import re
import runpy
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import uuid

try:
    import fcntl
except ImportError:  # no file locking on this platform
    fcntl = None


# --- paths helper ---
def claude_home():
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude").expanduser()


def claude_json():
    root = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(root).expanduser() / ".claude.json" if root else Path.home() / ".claude.json"


def codex_home():
    return Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").expanduser()
# --- end paths helper ---


def valid_retention_overrides(value):
    return isinstance(value, dict) and all(
        isinstance(name, str) and isinstance(limits, dict) and all(
            key in ("days", "hours", "maxMB") and type(limit) is int and limit >= 1
            for key, limit in limits.items())
        for name, limits in value.items())


def valid_relative_paths(value):
    """Check relative path syntax only; do not resolve filesystem paths."""
    return isinstance(value, list) and all(
        isinstance(path, str) and bool(path) and not path.startswith("/")
        and not re.match(r"^[A-Za-z]:", path) and "\\" not in path and "\0" not in path
        and all(part not in ("", ".", "..") for part in path.split("/"))
        for path in value)


def valid_project_commands(value):
    def valid_command(name, command):
        if name == "outcomeLog":
            return (isinstance(command, str) and bool(command) and not command.startswith("/")
                    and ".." not in command)
        return (name in ("shadowStatus", "slowTests", "speedReport")
                and isinstance(command, list) and bool(command)
                and all(isinstance(arg, str) for arg in command))

    return all(isinstance(path, str) and (path.startswith("/") or path.startswith("~/"))
               and isinstance(commands, dict)
               and all(valid_command(name, command) for name, command in commands.items())
               for path, commands in value.items())


def valid_notes_ledger(value):
    if not isinstance(value, dict):
        return False
    if not value:
        return True
    if not isinstance(value.get("csv"), str) or not value["csv"]:
        return False
    try:
        return all((key in ("csv", "timeline") and isinstance(item, str) and bool(item)
                    and Path(item).expanduser().is_absolute())
                   or (key == "measureAfterDays" and type(item) is int and item >= 1)
                   for key, item in value.items())
    except (ValueError, RuntimeError):
        return False


def valid_auto_projects(value):
    """Absolute project directories (after `~` expansion); a project file cannot opt itself in."""
    try:
        return all("\0" not in item and Path(item).expanduser().is_absolute() for item in value)
    except (ValueError, RuntimeError):
        return False


SCHEMA = {
    "enabled": {"kind": "bool", "default": True, "global_only": True},
    "schedule": {"kind": "enum", "default": "active", "choices": ("active", "always", "off")},
    "scheduledAutonomy": {"kind": "enum", "default": "propose", "choices": ("propose", "auto")},
    "autoProjects": {"kind": "strings", "default": [], "global_only": True,
                     "check": valid_auto_projects},
    "retention": {"kind": "enum", "default": "auto", "choices": ("auto", "off"), "global_only": True},
    "retentionOverrides": {"kind": "object", "default": {}, "global_only": True,
                           "check": valid_retention_overrides},
    "projectCommands": {"kind": "object", "default": {}, "global_only": True,
                        "check": valid_project_commands},
    "notesLedger": {"kind": "object", "default": {}, "global_only": True,
                    "check": valid_notes_ledger},
    "calibrationLadder": {"kind": "strings", "default": ["haiku", "sonnet medium", "sonnet high", "opus high"],
                          "global_only": True, "check": lambda value: all(len(item.split()) in (1, 2) for item in value)},
    "rulesLintFiles": {"kind": "strings", "default": [], "global_only": True},
    "localScripts": {"kind": "strings", "default": [], "global_only": True,
                     "check": lambda value: all("/" not in item for item in value)},
}
DEFAULTS = {name: spec["default"] for name, spec in SCHEMA.items()}
CHOICES = {name: spec["choices"] for name, spec in SCHEMA.items() if spec["kind"] == "enum"}
HERE = Path(__file__).resolve().parent
# Keep in sync with the independently pinned permission tests. Search with Grep:
# rg can execute preprocessors, and git can execute repository-configured helpers.
READ_ONLY_BASH = []
REVIEW_AVAILABLE = "Read,Grep,Glob,Bash"
REVIEW_TOOLS = ",".join(["Read", "Grep", "Glob", *READ_ONLY_BASH])
AUTO_AVAILABLE = "Read,Grep,Glob,Edit,Write,Bash"
GIT_DENY = ["Edit(**/.git/**)", "Write(**/.git/**)"]
# Load beside the resolved script, for linked and copied installations alike.
CREDENTIALS = runpy.run_path(str(HERE / "kaizen_credentials.py"))
CREDENTIAL_PATHS = CREDENTIALS["CREDENTIAL_PATHS"]
HARD_STOP_DENY = ",".join(f"Bash({command}:*)" for command in (
    "git push", "git commit", "git reset", "git clean", "gh", "rm", "rmdir", "mv", "curl", "wget",
    "launchctl", "crontab", "brew", "npm", "pip", "pip3", "sudo", "env", "printenv", "chmod",
    "cp", "touch", "mkdir", "sed", "dd", "install", "ln", "truncate", "perl", "python3 -c", "python",
    "grep", "egrep", "fgrep", "rg", "find", "cat", "strings", "xxd", "od", "base64"))


def audits_dir():
    return claude_home() / "audits"


def global_config_path():
    return claude_home() / "agent-kaizen.json"


def project_config_path(project_dir):
    return Path(project_dir) / "docs/kaizen/config.json"


def load_config(path, strict=False):
    """Read a config object; strict reads reject errors other than a missing file."""
    path = Path(path)
    try:
        cfg = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except (ValueError, UnicodeError) as error:
        if strict:
            raise ValueError(f"config: {path}: invalid JSON; scheduled review blocked") from error
        print(f"config: {path}: invalid JSON, using {{}}", file=sys.stderr)
        return {}
    except OSError as error:
        if strict:
            raise ValueError(f"config: {path}: {error}; scheduled review blocked") from error
        print(f"config: {path}: {error.strerror or error}, using {{}}", file=sys.stderr)
        return {}
    if not isinstance(cfg, dict):
        if strict:
            raise ValueError(f"config: {path}: expected a JSON object; scheduled review blocked")
        print(f"config: {path}: expected a JSON object, using {{}}", file=sys.stderr)
        return {}
    return cfg


def valid_value(name, value):
    spec = SCHEMA[name]
    kind = spec["kind"]
    if kind == "bool":
        return isinstance(value, bool)
    if kind == "enum":
        return isinstance(value, str) and value in spec["choices"]
    if kind == "int":
        return type(value) is int and value >= spec["minimum"]
    if kind == "object":
        return isinstance(value, dict) and spec["check"](value)
    if kind == "paths":
        return valid_relative_paths(value)
    if kind == "strings":
        return (isinstance(value, list) and all(isinstance(item, str) and bool(item.strip()) for item in value)
                and ("check" not in spec or spec["check"](value)))
    return False


def same_directory(path, other):
    try:
        return Path(path).expanduser().resolve() == Path(other).expanduser().resolve()
    except (OSError, RuntimeError, ValueError):
        return False


def auto_not_opted_in(project_dir, auto_projects):
    """Explain why a project file's `auto` is ignored, or return None when the project opted in."""
    if any(same_directory(project_dir, listed) for listed in auto_projects):
        return None
    directory = Path(project_dir).resolve()
    command = shlex.join(["python3", str(HERE / "kaizen-scheduled"), "config", "set", "--for",
                          str(directory), "scheduledAutonomy=auto"])
    return (f"scheduledAutonomy=auto in the project file is ignored: {directory} is not in autoProjects "
            f"(global); using the global or default value. To opt in, run: {command}")


def effective(project_dir=None):
    """Resolve scheduled settings with their project, global or default source."""
    global_path = global_config_path()
    layers = [("global", global_path, load_config(global_path))]
    if project_dir is not None:
        path = project_config_path(project_dir)
        layers.append(("project", path, load_config(path)))
    result = {name: {"value": value, "source": "default"} for name, value in DEFAULTS.items()}
    for source, path, cfg in layers:
        for name in DEFAULTS:
            if name not in cfg:
                continue
            if SCHEMA[name].get("global_only", False) and source == "project":
                print(f"config: {path}: {name} is global-only, ignored", file=sys.stderr)
                continue
            value = cfg[name]
            if not valid_value(name, value):
                shown = value if isinstance(value, str) else json.dumps(value)
                shown = shown.replace("\n", "\\n").replace("\r", "\\r")
                fallback = result[name]["value"]
                if not isinstance(fallback, str):
                    fallback = json.dumps(fallback)
                print(f"config: {path}: {name}={shown} invalid, using {fallback}", file=sys.stderr)
                continue
            if name == "scheduledAutonomy" and source == "project" and value == "auto":
                note = auto_not_opted_in(project_dir, result["autoProjects"]["value"])
                if note:
                    print(f"config: {path}: {note}", file=sys.stderr)
                    result["scheduledAutonomy"] = dict(result["scheduledAutonomy"], note=note)
                    continue
            result[name] = {"value": value, "source": source}
    if result["enabled"]["value"] is False:
        result["schedule"] = {"value": "off", "source": "global"}
    return result


def key(path):
    resolved = Path(path).resolve()
    slug = re.sub(r"[^a-zA-Z0-9]+", "-", resolved.name).strip("-")[:40] or "root"
    return slug + "-" + hashlib.sha256(str(resolved).encode()).hexdigest()[:12]


# --json output must stay parseable, so main() sends log lines to stderr then.
LOG_TO_STDERR = False


def log(message):
    print(f"{datetime.now(timezone.utc).isoformat()} {message}", file=sys.stderr if LOG_TO_STDERR else sys.stdout)


# Wall-clock limits. Every helper step gets STEP_TIMEOUT; the model run gets KAIZEN_REVIEW_TIMEOUT.
STEP_TIMEOUT = 600
REVIEW_TIMEOUT = 3600
LOCK_WAIT = 1800
LOG_LIMIT = 1 << 20


def env_seconds(name, default):
    """A non-negative number of seconds from the environment; anything else is the default."""
    try:
        value = float(os.environ[name])
    except (KeyError, ValueError):
        return default
    return value if math.isfinite(value) and value >= 0 else default


def review_timeout():
    """Seconds allowed for one model run; None means no limit (KAIZEN_REVIEW_TIMEOUT=0)."""
    return env_seconds("KAIZEN_REVIEW_TIMEOUT", REVIEW_TIMEOUT) or None


def failure_text(error):
    if isinstance(error, subprocess.TimeoutExpired):
        return f"timed out after {error.timeout:g} s"
    return str(error)


@contextlib.contextmanager
def run_lock(audits):
    """Hold <audits>/.lock for a whole run; yield False if another run keeps it past KAIZEN_LOCK_WAIT."""
    if fcntl is None:
        yield True
        return
    audits.mkdir(parents=True, exist_ok=True)
    path = audits / ".lock"
    wait = env_seconds("KAIZEN_LOCK_WAIT", LOCK_WAIT)
    deadline = time.monotonic() + wait
    announced = False
    with path.open("a") as handle:
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except (BlockingIOError, PermissionError):
                if wait > 0 and not announced:
                    announced = True
                    print(f"waiting up to {wait:g} s for the run lock {path}", file=sys.stderr)
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    log(f"another run holds the lock {path}; this run was skipped")
                    yield False
                    return
                time.sleep(min(1, remaining))
        yield True


class Terminated(BaseException):
    """A SIGTERM or SIGHUP; unwinds through the finally blocks that roll back and verify the ledger."""

    def __init__(self, number):
        super().__init__(number)
        self.number = number
        self.name = signal.Signals(number).name


# fired: first signal seen; raised: Terminated already thrown; deferred: depth of protected() sections.
SIGNALS = {"fired": None, "raised": False, "deferred": 0}


def _on_signal(number, frame):
    if SIGNALS["fired"] is None:
        SIGNALS["fired"] = number
    if SIGNALS["raised"] or SIGNALS["deferred"]:
        return  # one exception only; cleanup keeps running
    SIGNALS["raised"] = True
    raise Terminated(number)


@contextlib.contextmanager
def terminating_on_signals():
    """Turn SIGTERM and SIGHUP into Terminated. The child process is killed as the exception unwinds
    through subprocess.run."""
    SIGNALS.update(fired=None, raised=False, deferred=0)
    previous = {}
    for name in ("SIGTERM", "SIGHUP"):
        number = getattr(signal, name, None)
        try:
            if number is not None and signal.getsignal(number) != signal.SIG_IGN:  # nohup stays honoured
                previous[number] = signal.signal(number, _on_signal)
        except ValueError:  # not the main thread
            break
    try:
        yield
    finally:
        for number, handler in previous.items():
            signal.signal(number, handler)


@contextlib.contextmanager
def protected():
    """Hold back a signal until cleanup is done, then raise it."""
    SIGNALS["deferred"] += 1
    try:
        yield
    finally:
        SIGNALS["deferred"] -= 1
        # Also when the body raised: the held signal wins over the body's error.
        if SIGNALS["fired"] is not None and not SIGNALS["raised"] and not SIGNALS["deferred"]:
            SIGNALS["raised"] = True
            raise Terminated(SIGNALS["fired"])


def rotate_log(audits):
    """Keep run.log under 1 MB. The scheduler redirects with `>>`, so copy then truncate in place:
    a renamed file would keep receiving this run's own output."""
    path = audits / "run.log"
    copied = None
    try:
        if path.is_symlink() or not path.is_file() or path.stat().st_size <= LOG_LIMIT:
            return
        with path.open("rb") as source, tempfile.NamedTemporaryFile(
                dir=audits, prefix=".run.log.", delete=False) as copy:
            copied = Path(copy.name)
            shutil.copyfileobj(source, copy)
        os.chmod(copied, stat.S_IMODE(path.stat().st_mode))
        os.replace(copied, audits / "run.log.1")
        os.truncate(path, 0)
        log("run.log: rotated to run.log.1")
    except OSError as error:
        log(f"run.log: cannot rotate ({error})")
    finally:
        if copied is not None:
            copied.unlink(missing_ok=True)


# Bound each JSONL line read; a huge first line is not a session header.
LINE_LIMIT = 1 << 20


def first_cwd(path, max_lines=50):
    """Read the first top-level cwd from a bounded Claude transcript prefix."""
    try:
        with Path(path).open(encoding="utf-8") as stream:
            for _ in range(max_lines):
                line = stream.readline(LINE_LIMIT)
                if not line:
                    break
                if '"cwd"' not in line:
                    continue
                try:
                    row = json.loads(line)
                except (ValueError, RecursionError):
                    continue
                if isinstance(row, dict) and isinstance(row.get("cwd"), str) and row["cwd"]:
                    return row["cwd"]
    except (OSError, UnicodeError):
        pass
    return None


class Project:
    def __init__(self, canonical, paths, folder=None):
        self.canonical = Path(canonical).resolve()
        self.paths = sorted({self.canonical, *(Path(path).resolve() for path in paths)})
        self.key = key(self.canonical)
        self.folder = Path(folder) if folder is not None else audits_dir() / "projects" / self.key


def _git(directory, *arguments):
    try:
        result = subprocess.run(["git", "-C", str(directory), *arguments],
                                capture_output=True, text=True, timeout=STEP_TIMEOUT)
    except (OSError, UnicodeError, subprocess.TimeoutExpired):
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def discover(claude_root, codex_root, index, project_dirs=None):
    """Find enrolled projects and group paths sharing a git common directory."""
    candidates = set()
    if project_dirs is not None:
        candidates.update(project_dirs)
    else:
        candidates.update(index)
        for folder in Path(claude_root).glob("*"):
            try:
                newest = sorted(((path.stat().st_mtime, path) for path in folder.glob("*.jsonl")
                                 if path.is_file()), reverse=True)[:5]
            except OSError:
                continue
            for _, path in newest:
                cwd = first_cwd(path)
                if cwd:
                    candidates.add(cwd)
        cutoff = time.time() - 30 * 24 * 60 * 60
        for path in Path(codex_root).glob("*/*/*/*.jsonl"):
            try:
                if path.stat().st_mtime < cutoff:
                    continue
                with path.open(encoding="utf-8") as stream:
                    row = json.loads(stream.readline(LINE_LIMIT))
                payload = row.get("payload") if isinstance(row, dict) else None
                cwd = payload.get("cwd") if isinstance(payload, dict) else None
                if isinstance(cwd, str) and cwd:
                    candidates.add(cwd)
            except (OSError, ValueError, UnicodeError, RecursionError):
                continue

    enrolled, not_enrolled = set(), set()
    for candidate in candidates:
        try:
            directory = Path(candidate).resolve()
        except (OSError, RuntimeError):
            continue
        if not directory.is_dir():
            continue
        ancestors = [directory] if project_dirs is not None else [directory, *directory.parents]
        project = next((path for path in ancestors if (path / "docs/kaizen").is_dir()), None)
        if project is None:
            not_enrolled.add(str(directory))
        else:
            enrolled.add(project)

    groups = {}
    for directory in sorted(enrolled):
        # Relative to `directory`; --path-format=absolute is not in git < 2.31 (it is echoed back).
        common = _git(directory, "rev-parse", "--git-common-dir")
        common = (directory / common).resolve() if common else None
        groups.setdefault(("git", common) if common else ("directory", directory), []).append(directory)

    projects = []
    for (kind, common), directories in groups.items():
        paths = set(directories)
        listed = []
        worktrees = _git(directories[0], "worktree", "list", "--porcelain")
        for line in (worktrees or "").splitlines():
            if line.startswith("worktree "):
                path = Path(line[len("worktree "):]).resolve()
                if path.is_dir():
                    listed.append(path)
                    paths.add(path)
        root = (common.parent if kind == "git" and common.name == ".git"
                else listed[0] if kind == "git" and listed else None)
        if root is None:
            projects.append(Project(directories[0], paths))
        elif (root / "docs/kaizen").is_dir():
            # The repository root is itself enrolled: it is the project, with every worktree.
            projects.append(Project(root, paths))
        else:
            # Enrolled subdirectories of a larger repository: one project per subdirectory,
            # grouped with the same subdirectory of the other worktrees.
            prefixes = {}
            for directory in directories:
                prefix = _git(directory, "rev-parse", "--show-prefix")
                prefixes.setdefault(prefix.rstrip("/") if prefix is not None else None, []).append(directory)
            for prefix, members in prefixes.items():
                if prefix is None:
                    projects.extend(Project(member, {member}) for member in members)
                    continue
                same = {path / prefix for path in listed if (path / prefix).is_dir()}
                main = listed[0] / prefix if listed else None
                canonical = main if main in same and (main / "docs/kaizen").is_dir() else sorted(members)[0]
                projects.append(Project(canonical, {*members, *same}))
    return sorted(projects, key=lambda project: project.canonical), sorted(not_enrolled)


def read_index(audits):
    path = Path(audits) / "projects/index.json"
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
        if (isinstance(document, dict) and type(document.get("v")) is int and document["v"] == 1
                and isinstance(document.get("projects"), dict)
                and all(isinstance(path, str) and isinstance(value, str)
                        for path, value in document["projects"].items())):
            return document["projects"]
    except FileNotFoundError:
        return {}
    except (OSError, ValueError, UnicodeError):
        pass
    log(f"index: {path}: invalid or unreadable, using {{}}")
    return {}


def _index_document(index, projects):
    merged = dict(index)
    for project in projects:
        merged.update((str(path), project.key) for path in project.paths)
    return {"v": 1, "projects": merged}


def write_index(audits, projects):
    document = _index_document(read_index(audits), projects)
    path = Path(audits) / "projects/index.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent,
                                         prefix=path.name + ".", delete=False) as stream:
            temporary = Path(stream.name)
            stream.write(json.dumps(document, sort_keys=True) + "\n")
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def parse_time(text):
    """Parse an ISO timestamp with an offset, returning UTC or None."""
    if not isinstance(text, str):
        return None
    try:
        value = datetime.fromisoformat(text.replace("Z", "+00:00"))
        return value.astimezone(timezone.utc) if value.tzinfo is not None else None
    except (ValueError, OverflowError):
        return None


def read_state(project):
    path = project.folder / "state.json"
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(state, dict):
            return state
    except FileNotFoundError:
        return {}
    except (OSError, ValueError, UnicodeError):
        pass
    log(f"state: {path}: invalid or unreadable, using {{}}")
    return {}


def write_state(project, state):
    """Atomically save state, including review ids before starting Claude."""
    path = project.folder / "state.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent,
                                         prefix=path.name + ".", delete=False) as stream:
            temporary = Path(stream.name)
            stream.write(json.dumps(state, indent=2) + "\n")
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def _session_cwd(path, cache, codex=False):
    if not codex and path.parent.name == "subagents":
        parent = path.parent.parent.parent / (path.parent.parent.name + ".jsonl")
        if parent.is_file():
            path = parent
    key = ("codex" if codex else "claude", path)
    if key not in cache:
        cwd = None
        if codex:
            try:
                with path.open(encoding="utf-8") as stream:
                    row = json.loads(stream.readline(LINE_LIMIT))
                payload = row.get("payload") if isinstance(row, dict) else None
                value = payload.get("cwd") if isinstance(payload, dict) else None
                if isinstance(value, str) and value:
                    cwd = value
            except (OSError, ValueError, UnicodeError, RecursionError):
                pass
        else:
            cwd = first_cwd(path)
        cache[key] = cwd
    return cache[key]


def file_belongs(path, folder_name, target_paths, cache=None, codex=False):
    """Match a session's cwd (or Claude's no-cwd folder fallback)."""
    cache = {} if cache is None else cache
    cwd = _session_cwd(Path(path), cache, codex)
    if cwd is None:
        return not codex and any(folder_name == re.sub(r"[^a-zA-Z0-9]", "-", str(target))
                                 for target in target_paths)
    key = ("realpath", cwd)
    if key not in cache:
        try:
            cache[key] = os.path.realpath(cwd)
        except (OSError, ValueError):  # e.g. an embedded NUL in a malformed row
            cache[key] = cwd
    return any(candidate == str(target) or candidate.startswith(str(target).rstrip(os.sep) + os.sep)
               for target in target_paths for candidate in (cwd, cache[key]))


def owner_of(path, folder_name, projects, cache=None, codex=False):
    """Return the project with the longest matching enrolled path."""
    cache = {} if cache is None else cache
    owner, longest = None, -1
    for project in projects:
        for target in project.paths:
            if len(str(target)) > longest and file_belongs(path, folder_name, [target], cache, codex):
                owner, longest = project, len(str(target))
    return owner


def _cutoff(state, now):
    return parse_time(state.get("reviewed_at")) or now - timedelta(days=7)


def gate(project, projects, cfg, state, now, claude_root, codex_root, cache=None):
    """Decide whether a project is due without writes or review subprocesses."""
    if cfg["enabled"]["value"] is False:
        return False, "skipped: disabled"
    schedule = cfg["schedule"]
    if schedule["value"] == "off":
        return False, f"skipped: schedule off ({schedule['source']})"
    if schedule["value"] == "always":
        return True, "due: schedule always"
    cutoff = _cutoff(state, now)
    cache = {} if cache is None else cache
    ignored = state.get("ignore_sessions", [])
    ignored = {value for value in ignored if isinstance(value, str)} if isinstance(ignored, list) else set()
    for root, patterns, codex in ((Path(claude_root), ("*/*.jsonl", "*/*/subagents/*.jsonl"), False),
                                  (Path(codex_root), ("*/*/*/*.jsonl",), True)):
        for pattern in patterns:
            for path in root.glob(pattern):
                subagent = not codex and path.parent.name == "subagents"
                session = path.parent.parent.name if subagent else path.stem
                if not codex and session in ignored:
                    continue
                try:
                    info = path.stat()
                    if not stat.S_ISREG(info.st_mode) or info.st_mtime <= cutoff.timestamp():
                        continue
                except OSError:
                    continue
                folder = path.parent.parent.parent.name if subagent else path.parent.name
                if owner_of(path, folder, projects, cache, codex) is project:
                    kind = "codex session" if codex else "claude transcript"
                    return True, f"due: activity ({kind})"
    if _git(project.canonical, "log", "-1", "--branches",
            # --since is inclusive and reviewed_at has whole seconds: skip the review's own second.
            f"--since=@{int(cutoff.timestamp()) + 1}", "--format=%H"):
        return True, "due: activity (git commit)"
    return False, f"skipped: no activity since {cutoff.date().isoformat()}"


def review_gate(project, projects, cfg, state, now, cache, options, project_dirs):
    if (getattr(options, "force", False) and project_dirs
            and cfg["enabled"]["value"] and cfg["schedule"]["value"] != "off"):
        return True, "due: forced"
    return gate(project, projects, cfg, state, now, claude_home() / "projects",
                codex_home() / "sessions", cache)


def cycle_mode(cfg, options):
    return ("auto" if not getattr(options, "propose_only", False)
            and cfg["scheduledAutonomy"]["value"] == "auto" else "propose-only")


def review_dry_run(audits, project_dirs=None, now=None, options=None, json_output=False):
    if not json_output and effective()["enabled"]["value"] is False:
        log("skipped: disabled")
        return
    options = options if options is not None else command_options(argparse.Namespace(dry_run=True))
    now = now if now is not None else datetime.now(timezone.utc)
    cache = {}
    index = read_index(audits)
    projects, not_enrolled = discover(claude_home() / "projects", codex_home() / "sessions",
                                    index, project_dirs)
    if json_output:
        rows = []
        for project in projects:
            setting = effective(project.canonical)["scheduledAutonomy"]
            row = dict(path=str(project.canonical), scheduledAutonomy=setting["value"],
                       source=setting["source"])
            if "note" in setting:
                row["note"] = setting["note"]
            rows.append(row)
        print(json.dumps(rows))
        return
    for project in projects:
        project.folder = Path(audits) / "projects" / project.key
        print(f"project: {project.canonical}")
        print(f"  key: {project.key}")
        print("  paths: " + ", ".join(map(str, project.paths)))
        settings = []
        cfg = effective(project.canonical)
        for name, setting in cfg.items():
            value = setting["value"]
            if isinstance(value, bool):
                value = json.dumps(value)
            settings.append(f"{name}={value} ({setting['source']})")
        print("  config: " + "; ".join(settings))
        if "note" in cfg["scheduledAutonomy"]:
            print("  note: " + cfg["scheduledAutonomy"]["note"])
        state = read_state(project)
        due, reason = review_gate(project, projects, cfg, state, now, cache, options, project_dirs)
        print("  gate: " + (f"due ({reason.removeprefix('due: ')})" if due else reason))
        print(f"  reviewed_at: {state.get('reviewed_at') or 'never'}")
        print("  cutoff: " + _cutoff(state, now).strftime("%Y-%m-%dT%H:%M:%SZ"))
        if due:
            # The report name is generated by the audit, which dry-run cannot execute.
            report = "<report path from audit stdout>"
            mode = cycle_mode(cfg, options)
            print("audit command: " + shlex.join(audit_command(options, project.folder, project)))
            try:
                print("review command: " + shlex.join(review_command(
                    options, mode, report, str(uuid.uuid4()), project.canonical)))
            except ValueError as error:
                print(f"review command: not built ({error})")
    for path in not_enrolled:
        print(f"not enrolled: {path} (no docs/kaizen/ in it or any parent)")
    if not projects:
        print("no projects found; enrol a project with /agent-kaizen:start or pass --project-dir")
    print("index.json (not written, dry run): " + json.dumps(_index_document(index, projects), sort_keys=True))


def now(override=None):
    return override if override is not None else datetime.now(timezone.utc)


def timestamp(value):
    # Keep subsecond exit precision: truncation can make pre-review activity look new.
    return value.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")


def sibling(override, *names):
    if override is not None:
        return Path(override).expanduser().resolve()
    for name in names:
        path = HERE / name
        if path.is_file():
            return path
    raise FileNotFoundError(f"{names[-1]} not found; pass --{names[-1].removesuffix('.json')}")


def command_options(args):
    """Resolve installed/repository siblings and command defaults without subprocesses."""
    python = getattr(args, "python", None) or sys.executable
    python = str(Path(shutil.which(python) or python).expanduser().absolute())
    claude = getattr(args, "claude", None) or shutil.which("claude")
    if (claude is None and not getattr(args, "dry_run", False)
            and getattr(args, "command", "review") == "review"):
        raise FileNotFoundError("claude not found; pass --claude or put it on PATH")
    if claude and os.sep in claude:
        claude = str(Path(claude).expanduser().absolute())
    token_audit = sibling(getattr(args, "token_audit", None), "kaizen-token-audit", "token-audit")
    if not token_audit.is_file():
        raise FileNotFoundError("token-audit not found; pass --token-audit")
    return argparse.Namespace(
        python=python, claude=claude or "claude", token_audit=token_audit,
        pricing=sibling(getattr(args, "pricing", None), "kaizen-pricing.json", "pricing.json"),
        model=getattr(args, "model", None) or os.environ.get("KAIZEN_REVIEW_MODEL") or "sonnet",
        max_turns=getattr(args, "max_turns", None) or os.environ.get("KAIZEN_REVIEW_MAX_TURNS") or "40",
        propose_only=getattr(args, "propose_only", False), force=getattr(args, "force", False))


def audit_command(options, out, project=None):
    command = [options.python, str(options.token_audit)]
    if project is not None:
        for path in sorted(project.paths):
            command.extend(["--cwd", str(path)])
        command.extend(["--days", "7"])
    extracts = out.parent.parent / "extracts" if project is not None else out / "extracts"
    return command + ["--out", str(out), "--pricing", str(options.pricing),
                      "--extract-out", str(extracts)]


class UnsupportedPath(ValueError):
    """A path holds characters that permission rules cannot express."""


def deny_path(path, resolve=True):
    path = Path(path).expanduser()
    path = (path.resolve() if resolve else path).as_posix()
    # Rule syntax gives these characters meaning; fail closed rather than build a wrong rule.
    bad = sorted(set(path) & set(",()*?[]\\"))
    if bad:
        raise UnsupportedPath(f"cannot build deny rules: path contains {''.join(bad)!r}: {path}; "
                              "permission rules cannot express these characters, so this project "
                              "cannot be reviewed until the path is renamed or moved")
    return "//" + path.lstrip("/")


def allow_path(path):
    """Check a path embedded in a Bash allow rule; commas also split --allowedTools."""
    path = str(path)
    bad = sorted({char for char in path if char in ",()*?[]\\\"'`$;&|<>" or char.isspace()})
    if bad:
        raise UnsupportedPath(f"cannot build allow rules: path contains {''.join(bad)!r}: {path}; "
                              "permission rules cannot express these characters, so auto mode "
                              "cannot run until the path is renamed or moved")
    return path


def config_home_deny(project_dir=None):
    """Protect config state; Claude Code separately protects instruction paths."""
    rules = []
    # Agent definitions (tool and permission frontmatter) and Codex's AGENTS.md steer later sessions.
    for home, extra in ((claude_home(), ("agents/**",)), (codex_home(), ("AGENTS.md",))):
        for root in dict.fromkeys(deny_path(home, resolve=value) for value in (False, True)):
            for pattern in ("settings*.json", "hooks/**", "plugins/**", "skills/**", "commands/**",
                            "bin/**", "**/*.json", "**/*.toml", "**/*.sh", "**/*.py", "**/*.js",
                            ".credentials*", "auth.json", "**/.git/**", *extra):
                rules.extend(f"{tool}({root}/{pattern})" for tool in ("Edit", "Write"))
    for path in dict.fromkeys(deny_path(claude_json(), resolve=value) for value in (False, True)):
        rules.extend(f"{tool}({path})" for tool in ("Edit", "Write"))
    if project_dir is not None:
        for root in dict.fromkeys(deny_path(project_dir, resolve=value) for value in (False, True)):
            # Files that run, or widen permissions, in the next interactive session or CI run.
            for pattern in (".claude/settings*.json", ".claude/hooks/**", ".claude/agents/**",
                            ".claude/commands/**", ".claude/skills/**", ".mcp.json",
                            ".github/workflows/**", ".husky/**"):
                rules.extend(f"{tool}({root}/{pattern})" for tool in ("Edit", "Write"))
    return rules


def credential_deny(project_dir=None):
    paths = dict.fromkeys(deny_path(base, resolve=False) + suffix
                          for base, suffix in CREDENTIALS["credential_paths"](project_dir))
    return [f"{tool}({path})" for path in paths for tool in ("Read", "Edit", "Write")]


def auto_edit_allow(project_dir=None):
    roots = (Path(project_dir) if project_dir is not None else Path.cwd(), claude_home(), codex_home())
    paths = dict.fromkeys(deny_path(root, resolve=value) for root in roots for value in (False, True))
    return [f"{tool}({path}/**)" for path in paths for tool in ("Edit", "Write")]


def ledger_paths():
    # notes-ledger reads the raw global value too: never use effective()'s fallback here.
    ledger = load_config(global_config_path(), strict=True).get("notesLedger", {})
    if not valid_value("notesLedger", ledger):
        raise ValueError("notesLedger is invalid: require csv and optional timeline paths "
                         "absolute after expanduser, and only supported keys")
    return {name: Path(ledger[name]).expanduser() for name in ("csv", "timeline") if ledger.get(name)}


def ledger_deny():
    paths = dict.fromkeys(deny_path(path, resolve=resolve)
            for path in ledger_paths().values()
            for resolve in (False, True))
    return [f"{tool}({path})" for path in paths for tool in ("Edit", "Write")]


def backup_root():
    # The same rule as scripts/kaizen-backup.
    return Path(os.environ.get("KAIZEN_BACKUP_DIR") or claude_home() / "kaizen-backups").expanduser()


def backup_deny():
    paths = dict.fromkeys(deny_path(backup_root(), resolve=resolve) for resolve in (False, True))
    return [f"{tool}({path}/**)" for path in paths for tool in ("Read", "Edit", "Write")]


class LedgerConfigError(ValueError):
    """The configured ledger cannot be read at the start: a config problem, not a violation."""


class LedgerGuard:
    """Snapshot configured ledgers before Claude; verify before accepting its output."""

    def __init__(self, folder):
        self.folder = folder
        self.entries = []

    def snapshot(self):
        try:
            paths = ledger_paths()
        except ValueError as error:
            raise LedgerConfigError(str(error)) from error
        for kind, path in paths.items():
            try:
                if path.is_symlink() or not path.is_file():
                    raise ValueError("ledger must be a regular file, not a symlink")
                data = path.read_bytes()
                snapshot = self.folder / kind
                snapshot.write_bytes(data)
                self.entries.append({"kind": kind, "path": path, "resolved": path.resolve(), "snapshot": snapshot,
                                     "data": data, "size": len(data), "sha256": hashlib.sha256(data).hexdigest(),
                                     "mode": stat.S_IMODE(path.stat().st_mode)})
            except (OSError, ValueError) as error:
                raise LedgerConfigError(f"{path}: cannot snapshot ledger ({error})") from error
        (self.folder / "manifest.json").write_text(json.dumps([
            {key: str(value) if isinstance(value, Path) else value
             for key, value in entry.items() if key != "data"} for entry in self.entries], indent=2) + "\n")

    @contextlib.contextmanager
    def locked(self):
        """The lock notes-ledger takes (<csv>.lock), so a concurrent `notes-ledger set` finishes first.
        A lock path that is not a plain file we can open (a symlink, a FIFO) raises OSError."""
        entry = next((item for item in self.entries if item["kind"] == "csv"), None)
        descriptor = None
        if fcntl is not None and entry is not None:
            # Never create the lock file through a replaced parent directory.
            if entry["path"].parent.resolve() == entry["resolved"].parent:
                lock = str(entry["path"]) + ".lock"
                flags = (os.O_WRONLY | os.O_CREAT | os.O_APPEND
                         | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
                try:
                    descriptor = os.open(lock, flags, 0o666)
                    if not stat.S_ISREG(os.fstat(descriptor).st_mode):
                        raise OSError(f"{lock} is not a regular file")
                except OSError as error:
                    if descriptor is not None:
                        os.close(descriptor)
                    raise OSError(f"cannot lock the ledger: {error}") from error
        if descriptor is None:
            yield
            return
        try:
            deadline = time.monotonic() + 60
            while True:
                try:
                    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except (BlockingIOError, PermissionError):
                    if time.monotonic() > deadline:
                        raise OSError("timed out waiting for the ledger lock") from None
                    time.sleep(0.1)
            yield
        finally:
            os.close(descriptor)

    def verify(self):
        with self.locked():
            return self._verify()

    def save_rejected(self, entry):
        """Keep the bytes the guard is about to overwrite; return a message naming them."""
        path = entry["path"]
        try:
            if (path.parent.resolve() != entry["resolved"].parent or path.is_symlink()
                    or not path.is_file()):
                return ""
            saved = self.folder / (entry["kind"] + ".rejected")
            saved.write_bytes(path.read_bytes())
            return f"; rejected content saved to {saved}"
        except OSError as error:
            return f"; rejected content not saved ({error})"

    def _verify(self):
        problems = []
        for entry in self.entries:
            path = entry["path"]
            old = entry["data"]
            try:
                if path.resolve() != entry["resolved"]:
                    raise ValueError("ledger resolved path changed (parent symlink replacement)")
                if path.is_symlink() or not path.is_file():
                    raise ValueError("ledger is missing or is not a regular file (symlinks are forbidden)")
                new = path.read_bytes()
                if entry["kind"] == "timeline":
                    lines = iter(new.splitlines(keepends=True))
                    valid = all(any(line.rstrip(b"\r\n") == candidate.rstrip(b"\r\n") for candidate in lines)
                                for line in old.splitlines(keepends=True))
                else:
                    valid = hashlib.sha256(new[:entry["size"]]).hexdigest() == entry["sha256"]
                    if len(new) > entry["size"]:
                        valid = valid and (not old or old.endswith(b"\n")) and new.endswith(b"\n")
                if not valid:
                    raise ValueError("ledger history changed or growth is not whole lines")
            except (OSError, ValueError) as error:
                message = f"{path}: {error}" + self.save_rejected(entry)
                temporary = None
                try:
                    if path.parent.resolve() != entry["resolved"].parent:
                        raise OSError("ledger parent changed; refusing to restore through it")
                    with tempfile.NamedTemporaryFile(dir=path.parent, prefix=".kaizen-restore-",
                                                     delete=False) as output:
                        temporary = Path(output.name)
                        output.write(old)
                        os.fchmod(output.fileno(), entry["mode"])
                    os.replace(temporary, path)
                    message += "; restored snapshot"
                except OSError as restore_error:
                    message += f"; restore failed ({restore_error}); snapshot: {entry['snapshot']}"
                finally:
                    if temporary is not None:
                        temporary.unlink(missing_ok=True)
                problems.append(message)
        return problems


def review_command(options, mode, report, session_id, project_dir=None):
    auto = mode == "auto"
    ledger = HERE / "notes-ledger"
    allowed = REVIEW_TOOLS
    if auto:
        ledger_rules = ledger_deny()  # Validate before granting notes-ledger add.
        allowed_tools = ["Read", "Grep", "Glob",
                         *auto_edit_allow(project_dir), *READ_ONLY_BASH]
        # File-writing Bash tools bypass Edit/Write denies; grant only the scoped helpers.
        backup = HERE / "kaizen-backup"
        if backup.is_file() or ledger.is_file():
            python = allow_path(options.python)
        if backup.is_file():
            allow_path(backup)
            for subcommand in ("begin", "finish", "list"):
                allowed_tools.extend(f"Bash({prefix}{backup} {subcommand}:*)"
                                     for prefix in ("", "python3 ", python + " "))
        if ledger.is_file():
            allow_path(ledger)
            allowed_tools.extend([f"Bash(python3 {ledger} add:*)",
                                  f"Bash({python} {ledger} add:*)"])
        allowed = ",".join(allowed_tools)
    command = [options.claude, "-p", f"/agent-kaizen:cycle {mode} {report} notes-ledger-path={ledger}",
               "--session-id", session_id, "--model", options.model, "--max-turns", str(options.max_turns),
               "--tools", AUTO_AVAILABLE if auto else REVIEW_AVAILABLE, "--strict-mcp-config"]
    for path in (claude_home(), codex_home()):
        if path.is_dir():
            command.extend(["--add-dir", str(path.resolve())])
    command.extend(["--allowedTools", allowed])
    denied = [*credential_deny(project_dir), HARD_STOP_DENY]
    if auto:
        denied.extend([*GIT_DENY, *config_home_deny(project_dir), *ledger_rules])
    denied.extend(backup_deny())
    command.extend(["--disallowedTools", ",".join(denied)])
    return command + ["--permission-mode", "default" if auto else "dontAsk"]


# Patterns are relative to audits; each wildcard matches one path component.
RETENTION_KINDS = {
    "extracts": {"patterns": ("extracts/*.extract.json", "projects/*/*.extract.json",
                              "projects/*/host-probe-*.json", "projects/*/friction-inputs-*.json"),
                 "days": 30, "maxMB": 200},
    "markers": {"patterns": ("projects/*/cycle-*.failed.md", "*.noticed-*",
                             "projects/*/*.noticed-*"), "days": 30},
    "reports": {"families": {
        "token-audit": ("token-audit-*.md", "projects/*/token-audit-*.md"),
        "checks": ("checks-*.md",),
        "project-report": ("projects/*/project-report-*.md",),
        "cycle": ("projects/*/cycle-*.md",)}, "days": 365},
    # Per-run ledger snapshots kept after a violation; temp files of a run that was killed.
    "ledger-runs": {"patterns": ("projects/*/.ledger-*/*",), "days": 7},
    "temp": {"patterns": ("projects/*/cycle-*.md.*",), "days": 1},
}


def retention_matches(root, pattern):
    """Expand a pattern without traversing symlink directories."""
    folders = [root]
    parts = pattern.split("/")
    for index, part in enumerate(parts):
        matches = []
        for folder in folders:
            try:
                if not stat.S_ISDIR(os.lstat(folder).st_mode):
                    continue
                with os.scandir(folder) as entries:
                    matches.extend(Path(entry.path) for entry in entries
                                   if fnmatch.fnmatchcase(entry.name, part)
                                   and (index == len(parts) - 1
                                        or entry.is_dir(follow_symlinks=False)))
            except FileNotFoundError:
                continue
            except OSError as error:
                log(f"housekeep: cannot scan {folder}: {error}")
                continue
        folders = matches
    return folders


def retention_stat(root, path):
    """Only regular files inside the real audits root are eligible."""
    try:
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode):
            return None
        if not os.path.realpath(path).startswith(os.path.realpath(root).rstrip(os.sep) + os.sep):
            return None
        parent = path.parent
        while parent != root:
            if not stat.S_ISDIR(os.lstat(parent).st_mode):
                return None
            parent = parent.parent
        return info
    except OSError:
        return None


def housekeep(audits, cfg, dry_run=False, now=None):
    """Plan retention in kind order, then apply the same plan used by dry-run."""
    if cfg.get("retention", {}).get("value", "auto") == "off":
        return []
    audits = Path(audits).absolute()
    current = datetime.now(timezone.utc) if now is None else now
    current = current.timestamp() if isinstance(current, datetime) else current
    overrides = cfg.get("retentionOverrides", {}).get("value", {})

    def warn(reason):
        print(f"housekeep: retentionOverrides: {reason}, ignored", file=sys.stderr)

    valid = {}
    if not isinstance(overrides, dict):
        warn("expected an object")
        overrides = {}
    for kind, limits in overrides.items():
        if kind not in RETENTION_KINDS:
            warn(f"unknown kind {kind}")
            continue
        if not isinstance(limits, dict):
            warn(f"{kind}: expected an object")
            continue
        valid[kind] = {}
        for field, value in limits.items():
            if field not in ("days", "hours", "maxMB"):
                warn(f"{kind}: unknown field {field}")
            elif type(value) is not int or value < 1:
                warn(f"{kind}.{field}: expected an integer >= 1")
            else:
                valid[kind][field] = value
    plan = []
    planned = set()
    identities = {}

    def add(path, info, kind, reason):
        if path not in planned:
            planned.add(path)
            identities[path] = (info.st_ino, info.st_dev, info.st_mtime_ns)
            plan.append({"path": path.relative_to(audits).as_posix(), "kind": kind,
                         "size": info.st_size, "reason": reason})

    for kind, spec in RETENTION_KINDS.items():
        limits = valid.get(kind, {})
        window = (limits["hours"] * 3600 if "hours" in limits
                  else limits.get("days", spec["days"]) * 86400)
        cap = limits.get("maxMB", spec.get("maxMB"))
        files, protected = {}, set()
        families = spec.get("families", {"": spec.get("patterns", ())})
        for family, patterns in families.items():
            groups = {}
            for pattern in patterns:
                for path in retention_matches(audits, pattern):
                    if family == "cycle" and path.name.endswith(".failed.md"):
                        continue
                    info = retention_stat(audits, path)
                    if info is not None:
                        files[path] = info
                        groups.setdefault(path.parent, {})[path] = info
            if kind == "reports":
                for group in groups.values():
                    protected.update(sorted(group, key=lambda p: (group[p].st_mtime, p.name),
                                            reverse=True)[:5])
        for path in sorted(files, key=lambda p: (files[p].st_mtime, p.as_posix())):
            info = files[path]
            if path not in protected and current - info.st_mtime > window:
                add(path, info, kind, "age")
                if kind == "reports":
                    marker = path.with_suffix(".reviewed")
                    marker_info = retention_stat(audits, marker)
                    if marker_info is not None:
                        add(marker, marker_info, kind, "report")
        remaining = [p for p in files if p not in planned]
        total = sum(files[p].st_size for p in remaining)
        if cap is not None:
            for path in sorted(remaining, key=lambda p: (files[p].st_mtime, p.as_posix())):
                if total <= cap * 1024 * 1024:
                    break
                if path not in protected:
                    add(path, files[path], kind, "cap")
                    total -= files[path].st_size
    touched = set()
    completed = []
    for entry in plan:
        path = audits / entry["path"]
        if not dry_run:
            try:
                info = retention_stat(audits, path)
                if info is None or (info.st_ino, info.st_dev, info.st_mtime_ns) != identities[path]:
                    log(f"housekeep: skipped {entry['path']}: file changed or missing")
                    continue
                path.unlink()
            except OSError as error:
                log(f"housekeep: skipped {entry['path']}: {error}")
                continue
            touched.add(path.parent)
        completed.append(entry)
        action = "would delete" if dry_run else "deleted"
        log(f"housekeep: {action} {entry['path']} kind={entry['kind']} "
            f"size={entry['size']} reason={entry['reason']}")
    for folder in sorted(touched):
        if (folder == audits / "extracts" or folder.parent == audits / "projects"
                or (folder.name.startswith(".ledger-") and folder.parent.parent == audits / "projects")):
            try:
                if stat.S_ISDIR(os.lstat(folder).st_mode):
                    os.rmdir(folder)
            except OSError:
                pass
    return completed


def scheduled_housekeep(audits):
    try:
        housekeep(audits, effective())
    except Exception as error:
        log(f"housekeep: failed ({error})")


def run_audit(audits, options):
    stopped = False
    try:
        return _run_audit(audits, options)
    except Terminated:
        stopped = True
        raise
    finally:
        if not stopped:
            scheduled_housekeep(audits)


def run_review(audits, project_dirs, options, clock):
    safety = {"ledger_violation": False, "stopped": False}
    try:
        result = _run_review(audits, project_dirs, options, clock, safety)
        return result
    except Terminated:
        safety["stopped"] = True  # a stopped run does no housekeeping
        raise
    finally:
        # Reporting can raise after a violation; still stop all later steps.
        if not (safety["ledger_violation"] or safety["stopped"]):
            scheduled_housekeep(audits)


def run_step(name, options, arguments, success=(0,)):
    """Return bounded step output, or None when the optional sibling is absent."""
    try:
        script = sibling(None, name)
    except FileNotFoundError:
        return None
    try:
        result = subprocess.run([options.python, str(script), *map(str, arguments)],
                                capture_output=True, text=True, timeout=STEP_TIMEOUT)
        if result.returncode in success:
            return "\n".join(result.stdout.strip().splitlines()[:30])
        reason = f"exit {result.returncode}"
        detail = (result.stderr or result.stdout).strip().splitlines()
        if detail:
            reason += ": " + detail[0]
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        reason = failure_text(error)
    log(f"step {name}: failed ({reason})")
    return "unavailable: " + reason


def step_stamp():
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def run_drift(options):
    try:
        sibling(None, "kaizen-link")
    except FileNotFoundError:
        return None
    root = os.environ.get("CLAUDE_PLUGIN_ROOT")
    if not root:
        try:
            # Keep the invocation directory: HERE follows symlinks into the source checkout.
            record = Path(__file__).absolute().parent / ".kaizen-plugin-root"
            root = record.read_text(encoding="utf-8").strip()
        except FileNotFoundError:
            root = None
        except (OSError, UnicodeError) as error:
            reason = f"cannot read installed plugin root: {error}"
            log(f"step kaizen-link: failed ({reason})")
            return "unavailable: " + reason
    if not root:
        reason = "plugin root unknown; set CLAUDE_PLUGIN_ROOT or re-run install-schedule --apply"
        log(f"step kaizen-link: failed ({reason})")
        return "unavailable: " + reason
    return run_step("kaizen-link", options,
                    ["--check", "--plugin-root", str(Path(root).expanduser())], (0, 1))


def run_checks(audits, options, projects=None):
    if os.environ.get("KAIZEN_SKIP_CHECKS") == "1":
        return
    try:
        if projects is None:
            projects, _ = discover(claude_home() / "projects", codex_home() / "sessions", read_index(audits))
        repo_args = [arg for project in projects for arg in ("--repo", str(project.canonical))]
        project_args = [arg for project in projects for arg in ("--project", str(project.canonical))]
        sections = []
        drift = run_drift(options)
        if drift is not None:
            sections.append(f"## Drift\n\n{drift}")
        for title, name, arguments, success in (
                ("Stale rules", "rules-lint", repo_args, (0, 1)),
                ("Notes ledger: measurements due", "notes-ledger", ["due", *project_args], (0,))):
            output = run_step(name, options, arguments, success)
            if output is not None:
                sections.append(f"## {title}\n\n{output}")
        if sections:
            audits.mkdir(parents=True, exist_ok=True)
            (audits / f"checks-{step_stamp()}.md").write_text(
                "\n\n".join(sections) + "\n", encoding="utf-8")
    except (OSError, ValueError) as error:
        log(f"step checks: failed ({error})")


def run_project_report(audits, project_dir, project_key, options):
    if os.environ.get("KAIZEN_SKIP_CHECKS") == "1" or not (HERE / "kaizen-project-report").is_file():
        return
    try:
        folder = audits / "projects" / project_key
        folder.mkdir(parents=True, exist_ok=True)
        run_step("kaizen-project-report", options,
                 ["--project", project_dir, "--out", folder / f"project-report-{step_stamp()}.md"])
    except (OSError, ValueError) as error:
        log(f"step kaizen-project-report: failed ({error})")


def audit_steps(audits, options):
    if os.environ.get("KAIZEN_SKIP_CHECKS") == "1":
        return
    try:
        projects, _ = discover(claude_home() / "projects", codex_home() / "sessions", read_index(audits))
        write_index(audits, projects)
        run_checks(audits, options, projects)
        for project in projects:
            run_project_report(audits, project.canonical, project.key, options)
    except (OSError, ValueError) as error:
        log(f"step projects: failed ({error})")


def run_usage_db(options):
    """Keep per-call usage history; never changes the audit result."""
    try:
        script = sibling(None, "usage-db")
    except FileNotFoundError:
        return
    lines = []
    try:
        result = subprocess.run([options.python, str(script), "ingest", "--quiet"],
                                capture_output=True, text=True, timeout=STEP_TIMEOUT)
        lines = result.stderr.strip().splitlines()
        if not result.returncode:
            for line in lines[:10]:
                log(f"step usage-db: {line}")
            return
        reason = f"exit {result.returncode}"
        if lines:
            reason += ": " + lines.pop(0)
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        reason = failure_text(error)
    log(f"step usage-db: failed ({reason})")
    for line in lines[:9]:
        log(f"step usage-db: {line}")


def _run_audit(audits, options):
    code = _run_token_audit(audits, options)
    run_usage_db(options)
    return code


def _run_token_audit(audits, options):
    audits.mkdir(parents=True, exist_ok=True)
    audit_steps(audits, options)
    try:
        with (audits / "run.log").open("a", encoding="utf-8") as errors:
            result = subprocess.run(audit_command(options, audits), stdout=subprocess.PIPE,
                                    stderr=errors, text=True, timeout=STEP_TIMEOUT)
        if not result.returncode:
            report = report_path(result.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        log(f"audit: failed ({failure_text(error)})")
        return 1
    if result.returncode:
        log(f"audit: failed (exit {result.returncode})")
    else:
        log(f"audit: ok {report}")
    return result.returncode


def report_path(stdout):
    lines = stdout.splitlines()
    if not lines or not lines[0].strip():
        raise ValueError("token-audit did not print a report path")
    return Path(lines[0].strip()).expanduser().resolve()


def backup_directories(root):
    """Record directory names and identities outside model-controlled manifests."""
    paths, inodes = set(), set()
    for path in root.iterdir():
        info = path.lstat()
        if stat.S_ISDIR(info.st_mode):
            paths.add(path.resolve())
            inodes.add((info.st_dev, info.st_ino))
    return paths, inodes


def rollback_auto_changes(options, run_id, session_id, started, root, before):
    """Undo only this cycle's unfinished or failed changes, newest first."""
    pending, messages, problems = [], [], []
    for manifest in root.glob("*/manifest.json"):
        try:
            if manifest.is_symlink() or manifest.parent.is_symlink():
                continue
            info = manifest.parent.stat()
            if manifest.parent.resolve() in before[0] or (info.st_dev, info.st_ino) in before[1]:
                continue
            data = json.loads(manifest.read_text(encoding="utf-8"))
            created = parse_time(data.get("created_at"))
            if (data.get("run_id") != run_id and data.get("session_id") != session_id
                    or created is None or created <= started or data.get("reverted")):
                continue
            if not data.get("finished") or data.get("verification") == "failed":
                pending.append((created, manifest.parent))
        except (OSError, ValueError, AttributeError) as error:
            problems.append(f"rollback failed: {manifest.parent}: {error}")
    for _, change in sorted(pending, reverse=True):
        try:
            result = subprocess.run([options.python, str(HERE / "kaizen-backup"), "undo", str(change), "--force"],
                                    capture_output=True, text=True, timeout=STEP_TIMEOUT,
                                    env=dict(os.environ, KAIZEN_BACKUP_DIR=str(root)))
            if result.returncode:
                detail = (result.stderr or result.stdout).strip()
                raise ValueError(f"exit {result.returncode}: {detail}")
            messages.append(f"rolled-back: {change}")
        except (OSError, ValueError, subprocess.TimeoutExpired) as error:
            problems.append(f"rollback failed: {change}: {failure_text(error)}")
    return messages, problems


def _run_review(audits, project_dirs, options, clock, safety):
    """Review projects serially; failed/killed runs leave reviewed_at unchanged.

    Their Codex sessions and git commits still count as activity at the next gate;
    the project stays due because its review time did not move.
    """
    load_config(global_config_path(), strict=True)
    projects, _ = discover(claude_home() / "projects", codex_home() / "sessions",
                           read_index(audits), project_dirs)
    write_index(audits, projects)
    run_checks(audits, options, projects)
    rollback_failed = config_failed = False
    cache = {}
    for project in sorted(projects, key=lambda project: project.canonical):
        project.folder = audits / "projects" / project.key
        cfg, state = effective(project.canonical), read_state(project)
        due, reason = review_gate(project, projects, cfg, state, clock(), cache, options, project_dirs)
        if not due:
            log(f"{project.canonical}: {reason}")
            continue
        audit_error = None
        try:
            project.folder.mkdir(parents=True, exist_ok=True)
            with (audits / "run.log").open("a", encoding="utf-8") as errors:
                result = subprocess.run(audit_command(options, project.folder, project),
                                        stdout=subprocess.PIPE, stderr=errors, text=True,
                                        timeout=STEP_TIMEOUT)
            if result.returncode:
                audit_error = f"audit failed (exit {result.returncode})"
            else:
                report = report_path(result.stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired) as error:
            audit_error = f"failed ({failure_text(error)})"
        if audit_error is not None:
            state.update(status="audit-failed", last_error=audit_error, last_error_at=timestamp(clock()))
            state.pop("ledger_errors", None)
            write_state(project, state)
            log(f"{project.canonical}: {audit_error}")
            continue
        run_project_report(audits, project.canonical, project.key, options)
        mode = cycle_mode(cfg, options)
        session_id = str(uuid.uuid4())
        ignored = state.get("ignore_sessions", [])
        ignored = [value for value in ignored if isinstance(value, str)] if isinstance(ignored, list) else []
        state["ignore_sessions"] = (ignored + [session_id])[-20:]
        write_state(project, state)
        started = clock()
        base = "cycle-" + started.astimezone().strftime("%Y-%m-%d")
        proposal = project.folder / (base + ".md")
        number = 2
        while proposal.exists():  # never replace a proposal the owner may not have read
            proposal = project.folder / f"{base}-{number}.md"
            number += 1
        failed = proposal.with_suffix(".failed.md")
        temporary = None
        succeeded = False
        ledger_problems = []
        path_error = config_error = timed_out = terminated = None
        rollbacks, rollback_problems = [], []
        guard = None
        try:
            run_id = started.astimezone().strftime("%Y%m%d-%H%M%S") + "-" + session_id
            root = backup_root().resolve()
            env = dict(os.environ, KAIZEN_RUN_ID=run_id, KAIZEN_SESSION_ID=session_id,
                       KAIZEN_BACKUP_DIR=str(root))
            if mode == "auto":
                root.mkdir(parents=True, exist_ok=True)
                before = backup_directories(root)
            with (audits / "run.log").open("a", encoding="utf-8") as errors, tempfile.NamedTemporaryFile(
                    mode="w", encoding="utf-8", dir=project.folder,
                    prefix=proposal.name + ".", delete=False) as output:
                temporary = Path(output.name)
                # mkdtemp creates a private (0700) state directory for this run.
                try:
                    guard = LedgerGuard(Path(tempfile.mkdtemp(dir=project.folder, prefix=".ledger-")))
                    guard.snapshot()
                except LedgerConfigError as error:
                    config_error = (f"{error}; fix notesLedger in the global config "
                                    "or create the file")
                    shutil.rmtree(guard.folder, ignore_errors=True)
                except Exception as error:
                    ledger_problems.append(str(error))
                if not ledger_problems and config_error is None:
                    limit = review_timeout()
                    try:
                        result = subprocess.run(review_command(options, mode, report, session_id, project.canonical),
                                                cwd=project.canonical, env=env, stdout=output, stderr=errors,
                                                timeout=limit)
                    except subprocess.TimeoutExpired:
                        timed_out = limit
                    finally:
                        with protected():  # a signal now waits until rollback and the ledger check are done
                            if mode == "auto":
                                try:
                                    rollbacks, rollback_problems = rollback_auto_changes(
                                        options, run_id, session_id, started, root, before)
                                except Exception as error:
                                    rollback_problems.append(f"rollback failed: {error}")
                            try:
                                ledger_problems.extend(guard.verify())
                                if not ledger_problems:
                                    shutil.rmtree(guard.folder)
                            except Exception as error:
                                paths = ", ".join(str(entry["path"]) for entry in guard.entries)
                                ledger_problems.append(f"{paths}: ledger guard failed ({error}); snapshots: {guard.folder}")
                            for message in [*rollbacks, *rollback_problems]:
                                output.write("\n" + message + "\n")
            if ledger_problems:
                outcome = "ledger-violation: " + "; ".join(ledger_problems)
            elif config_error:
                outcome = "ledger-config-error: " + config_error
            elif rollback_problems:
                outcome = "; ".join(rollback_problems)
            elif rollbacks:
                outcome = "rolled-back"
            elif timed_out:
                outcome = f"failed (timed out after {timed_out:g} s)"
            elif result.returncode == 0:
                os.replace(temporary, proposal)
                succeeded = True
                outcome = f"reviewed ({mode})"
            else:
                outcome = f"failed (exit {result.returncode})"
        except Terminated as error:
            terminated = error
            outcome = f"failed (terminated by {error.name})"
        except UnsupportedPath as error:
            path_error = str(error)
            outcome = "unsupported-path: " + path_error
        except (OSError, ValueError) as error:
            outcome = f"failed ({error})"
        rollback_failed = rollback_failed or bool(rollback_problems)
        if rollbacks and not rollback_problems:
            outcome = "rolled-back"
        if config_error and not ledger_problems:
            config_failed = True
            outcome = "ledger-config-error: " + config_error
            if temporary is not None:
                with temporary.open("a", encoding="utf-8") as output:
                    output.write("\n" + outcome + "\n")
        if ledger_problems:
            safety["ledger_violation"] = True
            outcome = "ledger-violation: " + "; ".join(ledger_problems)
            if temporary is not None:
                with temporary.open("a", encoding="utf-8") as output:
                    output.write("\n" + outcome + "\n")
        exited = clock()
        if succeeded:
            state.pop("ledger_errors", None)
            state.pop("last_error", None)
            state.update(reviewed_at=timestamp(exited), status="ok", report=str(report), proposal=str(proposal))
        else:
            state.update(status="ledger-violation" if ledger_problems else
                         "ledger-config-error" if config_error else
                         "unsupported-path" if path_error else
                         "failed" if rollback_problems else
                         "rolled-back" if rollbacks else
                         "timed-out" if timed_out else "failed",
                         last_error_at=timestamp(exited))
            detail = (path_error or config_error
                      or (f"timed out after {timed_out:g} s" if timed_out else None)
                      or (f"terminated by {terminated.name}" if terminated else None))
            if detail:
                state["last_error"] = detail
            else:
                state.pop("last_error", None)
            if ledger_problems:
                state["ledger_errors"] = ledger_problems
            else:
                state.pop("ledger_errors", None)
            if temporary is not None:
                try:
                    os.replace(temporary, failed)
                    outcome += f"; output: {failed}"
                except (OSError, ValueError) as error:
                    outcome += f"; output: {temporary} (could not save as {failed}: {error})"
        write_state(project, state)
        log(f"{project.canonical}: {outcome}")
        if terminated is not None:
            raise terminated
        if ledger_problems:
            return 1
    return 1 if rollback_failed or config_failed else 0


def write_config(path, updates):
    """Merge an object and atomically replace it without discarding other keys."""
    path = Path(path)
    if path.is_symlink():
        # Replace the real file so a symlinked config (dotfiles, stow) stays a symlink.
        path = Path(os.path.realpath(path))
    try:
        cfg = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        cfg = {}
    except (OSError, ValueError, UnicodeError):
        cfg = None
    if not isinstance(cfg, dict):
        print(f"config: {path} is not valid JSON; fix or remove it", file=sys.stderr)
        raise SystemExit(2)
    cfg.update(updates)
    if path.resolve() == global_config_path().resolve():
        path.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent,
                                         prefix=path.name + ".", delete=False) as stream:
            temporary = Path(stream.name)
            stream.write(json.dumps(cfg, indent=2) + "\n")
        # The temp file is 0600; keep the target's mode (project configs are shared files).
        if path.exists():
            mode = stat.S_IMODE(path.stat().st_mode)
        else:
            mask = os.umask(0)
            os.umask(mask)
            mode = 0o666 & ~mask
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def canonical_project(directory):
    """Return the enrolled project a real run would use for this directory or one above it."""
    directory = Path(directory).resolve()
    for candidate in (directory, *directory.parents):
        if (candidate / "docs/kaizen").is_dir():
            projects, _ = discover(claude_home() / "projects", codex_home() / "sessions", {}, [candidate])
            if projects:
                return projects[0].canonical
            break
    return directory


def update_auto_projects(project, enable):
    """Add or remove a project's canonical path in the global autoProjects list."""
    raw = load_config(global_config_path(), strict=True).get("autoProjects", [])
    if not valid_value("autoProjects", raw):
        raise ValueError("autoProjects in the global config is invalid; fix it first")
    listed = any(same_directory(item, project) for item in raw)
    if enable and not listed:
        write_config(global_config_path(), {"autoProjects": [*raw, str(project)]})
    elif listed and not enable:
        write_config(global_config_path(), {"autoProjects": [
            item for item in raw if not same_directory(item, project)]})


def show_config(project_dir=None):
    if project_dir is not None:
        project_dir = canonical_project(project_dir)
    result = effective(project_dir)
    result["reports"] = (str(audits_dir() / "projects" / key(project_dir)) + "/"
                         if project_dir is not None else None)
    print(json.dumps(result, indent=2))


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    config = commands.add_parser("config", help="show or set scheduled settings")
    actions = config.add_subparsers(dest="action", required=True)
    for action in ("show", "set"):
        subparser = actions.add_parser(action, help=action + " scheduled settings")
        subparser.add_argument("--for", dest="project_dir", type=Path, help="project directory")
        if action == "set":
            subparser.add_argument("assignments", metavar="KEY=VALUE", nargs="+")
    cleanup = commands.add_parser("housekeep", help="delete expired generated audit files")
    cleanup.add_argument("--dry-run", action="store_true", help="preview deletions")
    cleanup.add_argument("--audits", type=Path, help="override the audits folder")
    audit = commands.add_parser("audit", help="run the global token audit")
    review = commands.add_parser("review", help="audit and review due projects")
    review.add_argument("--json", action="store_true", help="with --dry-run, list project autonomy and sources as JSON")
    review.add_argument("--dry-run", action="store_true", help="preview without tokens or writes")
    review.add_argument("--propose-only", action="store_true", help="force the restricted propose-only cycle mode")
    review.add_argument("--force", action="store_true", help="skip the activity gate for selected --project-dir projects")
    review.add_argument("--project-dir", type=Path, action="append", help="use only these project directories")
    review.add_argument("--now", help="review time in ISO format with UTC offset")
    for scheduled in (audit, review):
        scheduled.add_argument("--audits", type=Path, help="override the audits folder")
        scheduled.add_argument("--python", help="Python interpreter (default: current interpreter)")
        scheduled.add_argument("--token-audit", type=Path, help="override the token-audit script")
        scheduled.add_argument("--pricing", type=Path, help="override the pricing file")
    review.add_argument("--claude", help="Claude executable (default: claude on PATH)")
    review.add_argument("--model", default=os.environ.get("KAIZEN_REVIEW_MODEL") or "sonnet")
    review.add_argument("--max-turns", type=int, default=os.environ.get("KAIZEN_REVIEW_MAX_TURNS") or "40")
    args = parser.parse_args(argv)
    if args.command == "review" and args.json and not args.dry_run:
        parser.error("--json requires --dry-run")
    global LOG_TO_STDERR
    LOG_TO_STDERR = getattr(args, "json", False)
    if args.command == "housekeep":
        audits = (args.audits if args.audits is not None else audits_dir()).expanduser().resolve()
        if args.dry_run or not audits.is_dir():
            housekeep(audits, effective(), args.dry_run)
            return 0
        with run_lock(audits) as held:
            if held:
                housekeep(audits, effective())
        return 0
    if args.command in ("audit", "review"):
        if args.command == "review":
            try:
                load_config(global_config_path(), strict=True)
            except ValueError as error:
                print(f"kaizen-scheduled: {error}", file=sys.stderr)
                return 2
        if not getattr(args, "json", False) and effective()["enabled"]["value"] is False:
            log("skipped: disabled")
            return 0
        fixed = None
        if args.command == "review":
            fixed = parse_time(args.now) if args.now is not None else None
            if args.now is not None and fixed is None:
                parser.error("--now must be an ISO timestamp with UTC offset")
            if args.max_turns < 1:
                parser.error("--max-turns must be positive")
        try:
            options = command_options(args)
            audits = (args.audits if args.audits is not None else audits_dir()).expanduser().resolve()
            if args.command == "review" and args.dry_run:
                review_dry_run(audits, args.project_dir, now(fixed), options, args.json)
                return 0
            with terminating_on_signals(), run_lock(audits) as held:
                if not held:
                    return 0
                rotate_log(audits)
                if args.command == "audit":
                    return run_audit(audits, options)
                return run_review(audits, args.project_dir, options, lambda: now(fixed))
        except Terminated as error:
            return 128 + error.number
        except (OSError, ValueError) as error:
            print(f"kaizen-scheduled: {error}", file=sys.stderr)
            return 2
    if args.action == "set":
        updates = {}
        for assignment in args.assignments:
            name, separator, value = assignment.partition("=")
            if not separator or name not in DEFAULTS:
                parser.error(f"unknown setting or invalid assignment: {assignment}")
            spec = SCHEMA[name]
            if spec.get("global_only", False) and args.project_dir is not None:
                parser.error(f"{name} is global-only")
            kind = spec["kind"]
            if kind == "bool":
                if value not in ("true", "false"):
                    parser.error(f"invalid value for {name}: {value}; use true or false")
                value = value == "true"
            elif kind in ("int", "object", "paths", "strings"):
                try:
                    value = int(value) if kind == "int" else json.loads(value)
                except ValueError:
                    parser.error(f"invalid value for {name}: {value}")
            if not valid_value(name, value):
                parser.error(f"invalid value for {name}: {value}")
            updates[name] = value
        path = global_config_path()
        note = None
        if args.project_dir is not None:
            # Runs use the canonical project, not the directory named here: a monorepo root, a main
            # worktree, or a nested project. Opt-in and the config file must be that project's.
            canonical = canonical_project(args.project_dir)
            path = project_config_path(canonical)
            if not path.parent.is_dir():
                parser.error(f"{args.project_dir} must contain docs/kaizen/")
            if canonical != Path(args.project_dir).expanduser().resolve():
                if updates.get("scheduledAutonomy") == "auto":
                    print(f"kaizen-scheduled: {args.project_dir} is not the project runs use ({canonical}); "
                          f"to opt that project in run: kaizen-scheduled config set --for "
                          f"{shlex.quote(str(canonical))} scheduledAutonomy=auto", file=sys.stderr)
                    return 2
                note = f"kaizen-scheduled: {args.project_dir} is not the project runs use; wrote to {path}"
            if "scheduledAutonomy" in updates:
                # Project auto only takes effect for projects listed in the global autoProjects.
                try:
                    update_auto_projects(canonical, updates["scheduledAutonomy"] == "auto")
                except ValueError as error:
                    print(f"kaizen-scheduled: {error}", file=sys.stderr)
                    return 2
        write_config(path, updates)
        if note:
            print(note, file=sys.stderr)
    show_config(args.project_dir)
    return 0


if __name__ == "__main__":
    sys.exit(main())
