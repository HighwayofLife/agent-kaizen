try:
    import fcntl
except ImportError:  # no file locking on this platform
    fcntl = None


# --- paths helper ---
def claude_home():
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude").expanduser()


def claude_json():
    root = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(root).expanduser() / ".claude.json" if root else Path.home() / ".claude.json"


def codex_home():
    return Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").expanduser()
# --- end paths helper ---


def valid_retention_overrides(value):
    return isinstance(value, dict) and all(
        isinstance(name, str) and isinstance(limits, dict) and all(
            key in ("days", "hours", "maxMB") and type(limit) is int and limit >= 1
            for key, limit in limits.items())
        for name, limits in value.items())


def valid_relative_paths(value):
    """Check relative path syntax only; do not resolve filesystem paths."""
    return isinstance(value, list) and all(
        isinstance(path, str) and bool(path) and not path.startswith("/")
        and not re.match(r"^[A-Za-z]:", path) and "\\" not in path and "\0" not in path
        and all(part not in ("", ".", "..") for part in path.split("/"))
        for path in value)


def valid_project_commands(value):
    def valid_command(name, command):
        if name == "outcomeLog":
            return (isinstance(command, str) and bool(command) and not command.startswith("/")
                    and ".." not in command)
        return (name in ("shadowStatus", "slowTests", "speedReport")
                and isinstance(command, list) and bool(command)
                and all(isinstance(arg, str) for arg in command))

    return all(isinstance(path, str) and (path.startswith("/") or path.startswith("~/"))
               and isinstance(commands, dict)
               and all(valid_command(name, command) for name, command in commands.items())
               for path, commands in value.items())


def valid_notes_ledger(value):
    if not isinstance(value, dict):
        return False
    if not value:
        return True
    if not isinstance(value.get("csv"), str) or not value["csv"]:
        return False
    try:
        return all((key in ("csv", "timeline") and isinstance(item, str) and bool(item)
                    and Path(item).expanduser().is_absolute())
                   or (key == "measureAfterDays" and type(item) is int and item >= 1)
                   for key, item in value.items())
    except (ValueError, RuntimeError):
        return False


def valid_auto_projects(value):
    """Absolute project directories (after `~` expansion); a project file cannot opt itself in."""
    try:
        return all("\0" not in item and Path(item).expanduser().is_absolute() for item in value)
    except (ValueError, RuntimeError):
        return False


SCHEMA = {
    "enabled": {"kind": "bool", "default": True, "global_only": True},
    "autoAudit": {"kind": "bool", "default": True, "global_only": True},
    "pendingDays": {"kind": "int", "default": 10, "minimum": 1},
    "schedule": {"kind": "enum", "default": "active", "choices": ("active", "always", "off")},
    "scheduledAutonomy": {"kind": "enum", "default": "propose", "choices": ("propose", "auto")},
    "maxChangesPerRun": {"kind": "int", "default": 3, "minimum": 0},
    "autoProjects": {"kind": "strings", "default": [], "global_only": True,
                     "check": valid_auto_projects},
    "retention": {"kind": "enum", "default": "auto", "choices": ("auto", "off"), "global_only": True},
    "retentionOverrides": {"kind": "object", "default": {}, "global_only": True,
                           "check": valid_retention_overrides},
    "friction": {"kind": "enum", "default": "on", "choices": ("on", "off")},
    "frictionSlowCallSeconds": {"kind": "int", "default": 120, "minimum": 10},
    "frictionHeavySeconds": {"kind": "int", "default": 60, "minimum": 5},
    "frictionOutputDirs": {"kind": "paths", "default": [], "project_only": True},
    "frictionSampler": {"kind": "enum", "default": "on", "choices": ("on", "off"), "global_only": True},
    "hostActions": {"kind": "enum", "default": "apply", "choices": ("apply", "suggest", "off")},
    "projectCommands": {"kind": "object", "default": {}, "global_only": True,
                        "check": valid_project_commands},
    "notesLedger": {"kind": "object", "default": {}, "global_only": True,
                    "check": valid_notes_ledger},
    "calibrationLadder": {"kind": "strings", "default": ["haiku", "sonnet medium", "sonnet high", "opus high"],
                          "global_only": True, "check": lambda value: all(len(item.split()) in (1, 2) for item in value)},
    "rulesLintFiles": {"kind": "strings", "default": [], "global_only": True},
    "localScripts": {"kind": "strings", "default": [], "global_only": True,
                     "check": lambda value: all("/" not in item for item in value)},
}
DEFAULTS = {name: spec["default"] for name, spec in SCHEMA.items()}
CHOICES = {name: spec["choices"] for name, spec in SCHEMA.items() if spec["kind"] == "enum"}
HERE = Path(__file__).resolve().parent
# Keep in sync with the independently pinned permission tests. Search with Grep:
# rg can execute preprocessors, and git can execute repository-configured helpers.
READ_ONLY_BASH = []
REVIEW_AVAILABLE = "Read,Grep,Glob,Bash"
REVIEW_TOOLS = ",".join(["Read", "Grep", "Glob", *READ_ONLY_BASH])
AUTO_AVAILABLE = "Read,Grep,Glob,Edit,Write,Bash"
GIT_DENY = ["Edit(**/.git/**)", "Write(**/.git/**)"]
# Load beside the resolved script, for linked and copied installations alike.
CREDENTIALS = runpy.run_path(str(HERE / "kaizen_credentials.py"))
CREDENTIAL_PATHS = CREDENTIALS["CREDENTIAL_PATHS"]
HARD_STOP_DENY = ",".join(f"Bash({command}:*)" for command in (
    "git push", "git commit", "git reset", "git clean", "gh", "rm", "rmdir", "mv", "curl", "wget",
    "launchctl", "crontab", "brew", "npm", "pip", "pip3", "sudo", "env", "printenv", "chmod",
    "cp", "touch", "mkdir", "sed", "dd", "install", "ln", "truncate", "perl", "python3 -c", "python",
    "grep", "egrep", "fgrep", "rg", "find", "cat", "strings", "xxd", "od", "base64"))


def audits_dir():
    return claude_home() / "audits"


def global_config_path():
    return claude_home() / "agent-kaizen.json"


def project_config_path(project_dir):
    return Path(project_dir) / "docs/kaizen/config.json"


def load_config(path, strict=False):
    """Read a config object; strict reads reject errors other than a missing file."""
    path = Path(path)
    try:
        cfg = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except (ValueError, UnicodeError) as error:
        if strict:
            raise ValueError(f"config: {path}: invalid JSON; scheduled review blocked") from error
        print(f"config: {path}: invalid JSON, using {{}}", file=sys.stderr)
        return {}
    except OSError as error:
        if strict:
            raise ValueError(f"config: {path}: {error}; scheduled review blocked") from error
        print(f"config: {path}: {error.strerror or error}, using {{}}", file=sys.stderr)
        return {}
    if not isinstance(cfg, dict):
        if strict:
            raise ValueError(f"config: {path}: expected a JSON object; scheduled review blocked")
        print(f"config: {path}: expected a JSON object, using {{}}", file=sys.stderr)
        return {}
    return cfg


def valid_value(name, value):
    spec = SCHEMA[name]
    kind = spec["kind"]
    if kind == "bool":
        return isinstance(value, bool)
    if kind == "enum":
        return isinstance(value, str) and value in spec["choices"]
    if kind == "int":
        return type(value) is int and value >= spec["minimum"]
    if kind == "object":
        return isinstance(value, dict) and spec["check"](value)
    if kind == "paths":
        return valid_relative_paths(value)
    if kind == "strings":
        return (isinstance(value, list) and all(isinstance(item, str) and bool(item.strip()) for item in value)
                and ("check" not in spec or spec["check"](value)))
    return False


def same_directory(path, other):
    try:
        return Path(path).expanduser().resolve() == Path(other).expanduser().resolve()
    except (OSError, RuntimeError, ValueError):
        return False


def auto_not_opted_in(project_dir, auto_projects):
    """Explain why a project file's `auto` is ignored, or return None when the project opted in."""
    if any(same_directory(project_dir, listed) for listed in auto_projects):
        return None
    directory = Path(project_dir).resolve()
    command = shlex.join(["python3", str(HERE / "kaizen-scheduled"), "config", "set", "--for",
                          str(directory), "scheduledAutonomy=auto"])
    return (f"scheduledAutonomy=auto in the project file is ignored: {directory} is not in autoProjects "
            f"(global); using the global or default value. To opt in, run: {command}")


def effective(project_dir=None):
    """Resolve scheduled settings with their project, global or default source."""
    global_path = global_config_path()
    layers = [("global", global_path, load_config(global_path))]
    if project_dir is not None:
        path = project_config_path(project_dir)
        layers.append(("project", path, load_config(path)))
    result = {name: {"value": value, "source": "default"} for name, value in DEFAULTS.items()}
    for source, path, cfg in layers:
        for name in DEFAULTS:
            if name not in cfg:
                continue
            if SCHEMA[name].get("global_only", False) and source == "project":
                print(f"config: {path}: {name} is global-only, ignored", file=sys.stderr)
                continue
            if SCHEMA[name].get("project_only", False) and source == "global":
                print(f"config: {path}: {name} is project-only, ignored", file=sys.stderr)
                continue
            value = cfg[name]
            if not valid_value(name, value):
                shown = value if isinstance(value, str) else json.dumps(value)
                shown = shown.replace("\n", "\\n").replace("\r", "\\r")
                fallback = result[name]["value"]
                if not isinstance(fallback, str):
                    fallback = json.dumps(fallback)
                print(f"config: {path}: {name}={shown} invalid, using {fallback}", file=sys.stderr)
                continue
            if name == "scheduledAutonomy" and source == "project" and value == "auto":
                note = auto_not_opted_in(project_dir, result["autoProjects"]["value"])
                if note:
                    print(f"config: {path}: {note}", file=sys.stderr)
                    result["scheduledAutonomy"] = dict(result["scheduledAutonomy"], note=note)
                    continue
            result[name] = {"value": value, "source": source}
    if result["enabled"]["value"] is False:
        result["schedule"] = {"value": "off", "source": "global"}
    return result


def freeze_mutation_config(project, backup):
    """Read the controlling config independently of report rendering."""
    def reject_constant(_value):
        raise ValueError("non-JSON constant in mutation config")

    project = Path(project)
    if canonical_path(project) != project or enrolled_project(project) != project:
        raise ValueError("mutation config scope is not the enrolled project")
    layers, stamps = [], [backup["directory_identity"](project)]
    for path in (global_config_path(), project_config_path(project)):
        if path.resolve() != path:
            raise ValueError("mutation config path is not canonical")
        try:
            _, raw, stamp = backup["checked_bytes"](path, LINE_LIMIT)
            info = path.lstat()
            if (canonical_path(path) != path or info.st_nlink != 1 or info.st_uid not in (0, os.getuid())
                    or info.st_mode & 0o022 or backup["file_version"](info) != stamp):
                raise ValueError("mutation config source is not trusted")
            config = json.loads(raw.decode("utf-8"), object_pairs_hook=backup["unique_fields"],
                                parse_constant=reject_constant)
            stamp = (tuple(backup["directory_identity"](parent) for parent in path.parents), stamp)
        except FileNotFoundError:
            # A ledger append can change this directory's timestamps.
            parent = next(parent for parent in path.parents if parent.exists())
            stamp, raw, config = ("absent", backup["directory_identity"](parent)), None, {}
        if not isinstance(config, dict):
            raise ValueError("expected a mutation config object")
        for name in config.keys() & SCHEMA.keys():
            if not valid_value(name, config[name]) or SCHEMA[name].get("global_only" if layers else "project_only"):
                raise ValueError("invalid controlling mutation config")
        layers.append(config)
        stamps.append((path, stamp, hashlib.sha256(raw).hexdigest() if raw is not None else None))
    global_cfg, project_cfg = layers
    if (not global_cfg.get("enabled", True)
            or project_cfg.get("schedule", global_cfg.get("schedule")) == "off"):
        return 0, tuple(stamps)
    opted_in = [Path(path).expanduser().resolve(strict=False) for path in global_cfg.get("autoProjects", [])]
    if (len(set(opted_in)) != len(opted_in)
            or project_cfg.get("scheduledAutonomy", global_cfg.get("scheduledAutonomy")) != "auto"
            or project_cfg.get("scheduledAutonomy") == "auto" and project not in opted_in):
        raise ValueError("mutation config does not authorize this auto review")
    limit = project_cfg.get("maxChangesPerRun", global_cfg.get("maxChangesPerRun", DEFAULTS["maxChangesPerRun"]))
    return limit, tuple(stamps)


def key(path, *, resolved=False):
    path = Path(path) if resolved else Path(path).resolve()
    slug = re.sub(r"[^a-zA-Z0-9]+", "-", path.name).strip("-")[:40] or "root"
    return slug + "-" + hashlib.sha256(str(path).encode("utf-8", "surrogateescape")).hexdigest()[:12]


# --json output must stay parseable, so main() sends log lines to stderr then.
LOG_TO_STDERR = False


def log(message):
    print(f"{datetime.now(timezone.utc).isoformat()} {message}", file=sys.stderr if LOG_TO_STDERR else sys.stdout)


# Wall-clock limits. Every helper step gets STEP_TIMEOUT; the model run gets KAIZEN_REVIEW_TIMEOUT.
STEP_TIMEOUT = 600
AUTO_AUDIT_TIMEOUT = STEP_TIMEOUT
AUTO_AUDIT_STATE = "auto-audit-state.json"
EXTRACT_WRITE_FAILED = 4  # token-audit wrote a usable report
REVIEW_TIMEOUT = 3600
LOCK_WAIT = 1800
LOG_LIMIT = 1 << 20


def env_seconds(name, default):
    """A non-negative number of seconds from the environment; anything else is the default."""
    try:
        value = float(os.environ[name])
    except (KeyError, ValueError):
        return default
    return value if math.isfinite(value) and value >= 0 else default


def review_timeout():
    """Seconds allowed for one model run; None means no limit (KAIZEN_REVIEW_TIMEOUT=0)."""
    return env_seconds("KAIZEN_REVIEW_TIMEOUT", REVIEW_TIMEOUT) or None


def failure_text(error):
    if isinstance(error, subprocess.TimeoutExpired):
        return f"timed out after {error.timeout:g} s"
    return str(error)


@contextlib.contextmanager
def run_lock(audits, watchdog=False, wait=None):
    """Hold <audits>/.lock for a whole run, waiting up to KAIZEN_LOCK_WAIT by default."""
    if fcntl is None:
        yield True
        return
    audits.mkdir(parents=True, exist_ok=True)
    path = audits / ".lock"
    if wait is None:
        wait = env_seconds("KAIZEN_LOCK_WAIT", LOCK_WAIT)
    deadline = time.monotonic() + wait
    announced = False
    with path.open("a") as handle:
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except (BlockingIOError, PermissionError):
                if wait > 0 and not announced:
                    announced = True
                    print(f"waiting up to {wait:g} s for the run lock {path}", file=sys.stderr)
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    log(f"another run holds the lock {path}; this run was skipped")
                    yield False
                    return
                time.sleep(min(1, remaining))
        if watchdog:
            SIGNALS["lease"] = handle.fileno()
        try:
            yield True
        finally:
            if watchdog:
                SIGNALS["lease"] = None


class Terminated(BaseException):
    """A handled signal; unwinds through rollback and ledger verification."""

    def __init__(self, number):
        super().__init__(number)
        self.number = number
        self.name = signal.Signals(number).name


# fired: first signal seen; raised: Terminated already thrown; deferred: depth of protected() sections;
# child: the model run's process, killed by the handler while cleanup is deferred; stoppable: set by run_group.
SIGNALS = {"fired": None, "raised": False, "deferred": 0, "child": None, "stoppable": False}


def _on_signal(number, frame):
    if SIGNALS["fired"] is None:
        SIGNALS["fired"] = number
    child = SIGNALS["child"]
    if child is not None:
        child.kill()
    if SIGNALS["raised"] or SIGNALS["deferred"]:
        return  # One exception only; cleanup keeps running.
    SIGNALS["raised"] = True
    raise Terminated(number)


class GroupPopen(subprocess.Popen):
    """A child in its own session; kill() takes down its whole process group, so a step's helpers
    do not outlive a timeout or a signal. Used only through run_group (subprocess.run calls kill())."""

    def __init__(self, *args, terminate_grace=False, **kwargs):
        kwargs.setdefault("start_new_session", True)
        self.grouped = kwargs["start_new_session"]
        self.terminate_grace = terminate_grace
        self.group_killed = False
        if SIGNALS.get("watchdog") is not None:
            reader, lease = SIGNALS["watchdog"]
            args = ([sys.executable, "-I", "-c", WATCHDOG, str(reader), str(lease), *args[0]], *args[1:])
        # Defer handled signals until the child is registered. Popen's caller has not
        # installed its context manager yet, so construction must do its own cleanup.
        fired_before = SIGNALS["fired"]
        with protected():
            super().__init__(*args, **kwargs)
            if SIGNALS["stoppable"]:
                SIGNALS["child"] = self
            if (SIGNALS["fired"] is not None and not SIGNALS["raised"]
                    and (SIGNALS["stoppable"] or fired_before is None)):
                self.kill()
                self.wait()

    def kill(self):
        if self.grouped:
            if self.group_killed:
                return  # KILL was already delivered; never target a dying/reused group twice
            try:
                if self.terminate_grace and self.poll() is None:
                    os.killpg(self.pid, signal.SIGTERM)
                    time.sleep(0.15)  # Let Git release a prepared ref lock.
                os.killpg(self.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            self.group_killed = True
        else:
            super().kill()


# Only the runner owns the pipe's write end. The watcher retains the protected
# run lock until KILL is delivered, so recovery cannot race an orphaned writer.
WATCHDOG = r'''
import os, signal, sys, time
reader, lease = int(sys.argv[1]), int(sys.argv[2])
if os.fork() == 0:
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    for descriptor in range(max(reader, lease) + 1):
        if descriptor not in (reader, lease):
            try:
                os.close(descriptor)
            except OSError:
                pass
    os.closerange(max(reader, lease) + 1, 1048576)
    while os.read(reader, 1):
        pass
    os.killpg(os.getpgrp(), signal.SIGTERM)
    time.sleep(0.15)
    os.killpg(os.getpgrp(), signal.SIGKILL)
os.close(reader)
if lease >= 0:
    os.close(lease)
os.execvpe(sys.argv[3], sys.argv[3:], os.environ)
'''


def run_group(command, stoppable=False, **kwargs):
    """subprocess.run in a new session whose whole group is killed on timeout or error. With
    stoppable or a worker deadline, track the group for signal cleanup and hard kills."""
    original = subprocess.Popen
    stoppable = stoppable or SIGNALS.get("deadline", False)
    reader = writer = None
    try:
        if stoppable:
            reader, writer = os.pipe()  # non-inheritable; only reader is passed
            lease = SIGNALS.get("lease")
            kwargs["pass_fds"] = (*kwargs.get("pass_fds", ()), reader,
                                  *((lease,) if lease is not None else ()))
            SIGNALS["watchdog"] = (reader, lease if lease is not None else -1)
        subprocess.Popen = GroupPopen
        SIGNALS["stoppable"] = stoppable
        return subprocess.run(command, **kwargs)
    finally:
        subprocess.Popen = original
        child = SIGNALS["child"]
        try:
            if child is not None:
                child.kill()  # stop helpers before rollback, even after a successful exit
        finally:
            SIGNALS.update(child=None, stoppable=False, watchdog=None)
            for descriptor in (reader, writer):
                if descriptor is not None:
                    os.close(descriptor)


@contextlib.contextmanager
def terminating_on_signals(timeout=None):
    """Unwind on SIGTERM, SIGHUP, SIGINT or the optional whole-run deadline."""
    SIGNALS.update(fired=None, raised=False, deferred=0, child=None, stoppable=False)
    previous = {}
    names = ("SIGTERM", "SIGHUP", "SIGINT")
    if timeout is not None:
        names += ("SIGALRM",)
    for name in names:
        number = getattr(signal, name, None)
        try:
            if number is not None and (name == "SIGALRM" or signal.getsignal(number) != signal.SIG_IGN):
                previous[number] = signal.signal(number, _on_signal)
        except ValueError:  # not the main thread
            break
    try:
        if timeout is not None:
            SIGNALS["deadline"] = True
            signal.setitimer(signal.ITIMER_REAL, timeout)
        yield
    finally:
        if timeout is not None:
            signal.setitimer(signal.ITIMER_REAL, 0)
            SIGNALS.pop("deadline", None)
        for number, handler in previous.items():
            signal.signal(number, handler)


@contextlib.contextmanager
def protected():
    """Hold back a signal until cleanup is done, then raise it."""
    SIGNALS["deferred"] += 1
    try:
        yield
    finally:
        SIGNALS["deferred"] -= 1
        # Also when the body raised: the held signal wins over the body's error.
        if SIGNALS["fired"] is not None and not SIGNALS["raised"] and not SIGNALS["deferred"]:
            SIGNALS["raised"] = True
            raise Terminated(SIGNALS["fired"])


def rotate_log(audits):
    """Keep run.log under 1 MB. The scheduler redirects with `>>`, so copy then truncate in place:
    a renamed file would keep receiving this run's own output."""
    path = audits / "run.log"
    copied = None
    try:
        if path.is_symlink() or not path.is_file() or path.stat().st_size <= LOG_LIMIT:
            return
        with path.open("rb") as source, tempfile.NamedTemporaryFile(
                dir=audits, prefix=".run.log.", delete=False) as copy:
            copied = Path(copy.name)
            shutil.copyfileobj(source, copy)
        os.chmod(copied, stat.S_IMODE(path.stat().st_mode))
        os.replace(copied, audits / "run.log.1")
        os.truncate(path, 0)
        log("run.log: rotated to run.log.1")
    except OSError as error:
        log(f"run.log: cannot rotate ({error})")
    finally:
        if copied is not None:
            copied.unlink(missing_ok=True)


# Bound each JSONL line read; a huge first line is not a session header.
LINE_LIMIT = 1 << 20


def first_cwd(path, max_lines=50):
    """Read the first top-level cwd from a bounded Claude transcript prefix."""
    try:
        with Path(path).open(encoding="utf-8") as stream:
            for _ in range(max_lines):
                line = stream.readline(LINE_LIMIT)
                if not line:
                    break
                if '"cwd"' not in line:
                    continue
                try:
                    row = json.loads(line)
                except (ValueError, RecursionError):
                    continue
                if isinstance(row, dict) and isinstance(row.get("cwd"), str) and row["cwd"]:
                    return row["cwd"]
    except (OSError, UnicodeError):
        pass
    return None


class Project:
    def __init__(self, canonical, paths, folder=None, unknown=False, anchors=None):
        self.canonical = Path(canonical).resolve()
        self.paths = sorted({self.canonical, *(Path(path).resolve() for path in paths)})
        # Paths whose relative layout maps onto `canonical` (one per worktree): selectors are relative to them.
        self.anchors = sorted({self.canonical, *(Path(path).resolve() for path in
                                                  (paths if anchors is None else anchors))})
        self.key = key(self.canonical)
        self.folder = Path(folder) if folder is not None else audits_dir() / "projects" / self.key
        # A Git probe failed, so the grouping may differ from a later run: no stable action scope.
        self.unknown = unknown


# Repository-locating variables would make the CLI and scheduled runs discover different scopes.
GIT_LOCATION_ENV = ("GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY",
                    "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_NAMESPACE", "GIT_PREFIX",
                    "GIT_CEILING_DIRECTORIES", "GIT_DISCOVERY_ACROSS_FILESYSTEM")


def _git(directory, *arguments, trusted_path=False):
    if trusted_path:
        environment = dict(PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin")
    else:
        environment = {name: value for name, value in os.environ.items()
                       if name not in GIT_LOCATION_ENV and not name.startswith(("GIT_TRACE", "GIT_CONFIG"))}
    environment.update(LC_ALL="C", GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL=os.devnull,
                       GIT_TERMINAL_PROMPT="0", GIT_OPTIONAL_LOCKS="0", GIT_NO_LAZY_FETCH="1",
                       GIT_ALLOW_PROTOCOL="")
    arguments = tuple(arg for target in ("normal", "perf", "event")
                      for arg in ("-c", f"trace2.{target}Target=")) + arguments
    try:
        result = run_group(["git", "-C", str(directory), *arguments], capture_output=True,
                           env=environment, timeout=STEP_TIMEOUT)
    except (OSError, UnicodeError, subprocess.TimeoutExpired):
        return None
    if result.returncode == 0:
        output = result.stdout.decode("utf-8", "surrogateescape")
        return output.removesuffix("\n")


def canonical_path(path):
    path = Path(path).resolve(strict=True)
    if sys.platform != "darwin":
        return path
    # realpath preserves the caller's spelling on case-insensitive macOS volumes.
    parent = Path(path.anchor)
    for name in path.parts[1:]:
        names = os.listdir(parent)
        if name not in names:
            folded = unicodedata.normalize("NFD", name).casefold()
            info = (parent / name).lstat()
            matches = [entry for entry in names if unicodedata.normalize("NFD", entry).casefold() == folded
                       and os.path.samestat((parent / entry).lstat(), info)]
            if len(matches) != 1:
                raise ValueError("cannot determine canonical path spelling")
            name = matches[0]
        parent /= name
    return parent


def enrolled_project(directory):
    return next((path for path in (directory, *directory.parents) if (path / "docs/kaizen").is_dir()), None)


def git_common_dir(directory):
    # Relative to `directory`; git < 2.31 echoes back --path-format=absolute.
    common = _git(directory, "rev-parse", "--git-common-dir")
    return ((directory / common).resolve() if common and not any(c in str(directory) + common for c in "\r\n")
            else None)


def checkout_root(directory):
    return next((path for path in (directory, *directory.parents)
                 if os.path.lexists(path / ".git")), None)


def worktree_paths(directory):
    """Return (existing canonical worktrees, complete), or None when Git cannot list them."""
    output = _git(directory, "worktree", "list", "--porcelain", "-z")
    exact = output is not None
    if not exact:  # git < 2.36 has no -z; a path with a newline cannot be parsed there.
        output = _git(directory, "worktree", "list", "--porcelain")
        if output is None:
            return None
    if not output:
        return [], False
    listed, complete = [], exact
    common = git_common_dir(directory)
    primary = None
    if common is not None and common.name != ".git":
        worktree = _git(common, "config", "--local", "--path", "--get", "core.worktree")
        if worktree and not any(c in worktree for c in "\r\n"):
            primary = common / worktree
    for field in output.split("\0" if exact else "\n"):
        if not field.startswith("worktree "):
            continue
        try:
            name = field[len("worktree "):]
            if any(c in name for c in "\r\n"):
                raise ValueError("invalid worktree path")
            path = canonical_path(name)
            if path == common and primary is not None:
                path = canonical_path(primary)
            dotgit = path / ".git"
            if not path.is_dir() or not dotgit.exists():
                raise ValueError("worktree registration is missing")
            gitdir = _git(path, "rev-parse", "--absolute-git-dir")
            if not gitdir or any(c in gitdir for c in "\r\n") or git_common_dir(path) != common:
                raise ValueError("worktree gitdir is unavailable")
            gitdir = canonical_path(gitdir)
            if dotgit.is_dir():
                if canonical_path(dotgit) != gitdir:
                    raise ValueError("worktree gitdir mismatch")
            elif gitdir == common:
                # A submodule keeps its primary Git directory in the superproject.
                if primary is None or canonical_path(primary) != path:
                    raise ValueError("primary worktree registration mismatch")
            elif (common is None or gitdir.parent != common / "worktrees"
                  or canonical_path(gitdir / os.fsdecode((gitdir / "gitdir").read_bytes()).removesuffix("\n")) != dotgit):
                raise ValueError("worktree registration mismatch")
        except (OSError, RuntimeError, ValueError):
            complete = False
            continue
        listed.append(path)
    return listed, complete and bool(listed)


def discover(claude_root, codex_root, index, project_dirs=None):
    """Find enrolled projects and group paths sharing a git common directory."""
    candidates = set()
    if project_dirs is not None:
        candidates.update(project_dirs)
    else:
        candidates.update(index)
        for folder in Path(claude_root).glob("*"):
            try:
                newest = sorted(((path.stat().st_mtime, path) for path in folder.glob("*.jsonl")
                                 if path.is_file()), reverse=True)[:5]
            except OSError:
                continue
            for _, path in newest:
                cwd = first_cwd(path)
                if cwd:
                    candidates.add(cwd)
        cutoff = time.time() - 30 * 24 * 60 * 60
        for path in Path(codex_root).glob("*/*/*/*.jsonl"):
            try:
                if path.stat().st_mtime < cutoff:
                    continue
                with path.open(encoding="utf-8") as stream:
                    row = json.loads(stream.readline(LINE_LIMIT))
                payload = row.get("payload") if isinstance(row, dict) else None
                cwd = payload.get("cwd") if isinstance(payload, dict) else None
                if isinstance(cwd, str) and cwd:
                    candidates.add(cwd)
            except (OSError, ValueError, UnicodeError, RecursionError):
                continue

    enrolled, not_enrolled = set(), set()
    for candidate in candidates:
        try:
            directory = canonical_path(candidate)
        except (OSError, RuntimeError, ValueError):
            continue
        if not directory.is_dir():
            continue
        project = enrolled_project(directory)
        if project_dirs is not None and project != directory:
            project = None
        if project is None:
            not_enrolled.add(str(directory))
        else:
            enrolled.add(project)

    groups, unknown = {}, set()
    for directory in sorted(enrolled):
        common = git_common_dir(directory)
        if common is None and checkout_root(directory) is not None:
            unknown.add(directory)  # Never treat a checkout whose probe failed as standalone.
        groups.setdefault(("git", common) if common else ("directory", directory), []).append(directory)

    found = {}

    def add(canonical, paths, uncertain, anchors=None):
        # Case-varied prefixes in other worktrees can resolve to one canonical scope.
        merged, was_uncertain, mapped = found.get(canonical, (set(), False, set()))
        found[canonical] = (merged | set(paths), was_uncertain or uncertain,
                            mapped | set(paths if anchors is None else anchors))

    for (kind, common), directories in groups.items():
        if kind == "directory":
            add(directories[0], directories, directories[0] in unknown)
            continue
        worktrees = worktree_paths(directories[0])
        listed, complete = worktrees if worktrees is not None else ([], False)
        # A copied .git file can point at another worktree's registered admin dir.
        # Its own checkout root must be among the validated registrations.
        if listed:
            valid_directories = []
            for directory in directories:
                if checkout_root(directory) not in listed:
                    add(directory, {directory}, True)
                else:
                    valid_directories.append(directory)
            directories = valid_directories
            if not directories:
                continue
        paths = set(directories) | set(listed)
        root = common.parent if common.name == ".git" else listed[0] if listed else None
        try:
            root = canonical_path(root) if root is not None else None
        except (OSError, RuntimeError, ValueError):
            root = None
        if root is None:
            add(directories[0], paths, True)
            continue
        roots = {root, *listed}
        if (root / "docs/kaizen").is_dir():
            # The repository root is itself enrolled: it is the project, with every worktree and
            # every enrollment nested in any of them.
            add(root, paths, not complete, anchors=roots)
            continue
        # Enrolled subdirectories of a larger repository: one project per subdirectory,
        # grouped with the same subdirectory of the other worktrees.
        prefixes = {}
        for directory in directories:
            prefix = "" if directory in roots else _git(directory, "rev-parse", "--show-prefix")
            if prefix is not None and any(c in prefix for c in "\r\n"):
                prefix = None
            prefixes.setdefault(prefix.rstrip("/") if prefix is not None else None, []).append(directory)
        for prefix, members in prefixes.items():
            if prefix is None:
                for member in members:
                    add(member, {member}, True)
                continue
            peers, uncertain = {}, not complete
            enrolled_peers = set(members)
            for worktree in roots:
                peer = worktree / prefix
                try:
                    if not peer.is_dir() or peer.resolve() != peer:
                        continue
                    peer = canonical_path(peer)
                except (OSError, RuntimeError, ValueError):
                    uncertain = True
                    continue
                if peer not in enrolled_peers:
                    if checkout_root(peer) != worktree:
                        continue
                    peer_common = git_common_dir(peer)
                    if peer_common != common:
                        uncertain = uncertain or peer_common is None
                        continue
                    if (peer / "docs/kaizen").is_dir():
                        enrolled_peers.add(peer)
                peers[worktree] = peer
            main = peers.get(root)
            canonical = main if main in enrolled_peers else min(enrolled_peers)
            add(canonical, {*members, *peers.values()}, uncertain)
    projects = [Project(canonical, paths, unknown=uncertain, anchors=anchors)
                for canonical, (paths, uncertain, anchors) in found.items()]
    return sorted(projects, key=lambda project: project.canonical), sorted(not_enrolled)


def read_index(audits):
    path = Path(audits) / "projects/index.json"
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
        if (isinstance(document, dict) and type(document.get("v")) is int and document["v"] == 1
                and isinstance(document.get("projects"), dict)
                and all(isinstance(path, str) and isinstance(value, str)
                        for path, value in document["projects"].items())):
            return document["projects"]
    except FileNotFoundError:
        return {}
    except (OSError, ValueError, UnicodeError):
        pass
    log(f"index: {path}: invalid or unreadable, using {{}}")
    return {}


def _index_document(index, projects):
    merged = dict(index)
    for project in projects:
        merged.update((str(path), project.key) for path in project.paths)
    return {"v": 1, "projects": merged}


def write_index(audits, projects):
    document = _index_document(read_index(audits), projects)
    path = Path(audits) / "projects/index.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent,
                                         prefix=path.name + ".", delete=False) as stream:
            temporary = Path(stream.name)
            stream.write(json.dumps(document, sort_keys=True) + "\n")
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def parse_time(text):
    """Parse an ISO timestamp with an offset, returning UTC or None."""
    if not isinstance(text, str):
        return None
    try:
        value = datetime.fromisoformat(text.replace("Z", "+00:00"))
        return value.astimezone(timezone.utc) if value.tzinfo is not None else None
    except (ValueError, OverflowError):
        return None


def read_state(project):
    path = project.folder / "state.json"
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(state, dict):
            return state
    except FileNotFoundError:
        return {}
    except (OSError, ValueError, UnicodeError):
        pass
    log(f"state: {path}: invalid or unreadable, using {{}}")
    return {}


def write_state(project, state, *, durable=False):
    """Atomically save state, including review ids before starting Claude."""
    path = project.folder / "state.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    write_state_file(path, state, durable=durable)


def sync_directory(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def write_state_file(path, state, *, durable=False):
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent,
                                         prefix=path.name + ".", delete=False) as stream:
            temporary = Path(stream.name)
            stream.write(json.dumps(state, indent=2) + "\n")
            if durable:
                stream.flush()
                os.fsync(stream.fileno())
        os.replace(temporary, path)
        if durable:
            sync_directory(path.parent)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def _session_cwd(path, cache, codex=False):
    if not codex and path.parent.name == "subagents":
        parent = path.parent.parent.parent / (path.parent.parent.name + ".jsonl")
        if parent.is_file():
            path = parent
    key = ("codex" if codex else "claude", path)
    if key not in cache:
        cwd = None
        if codex:
            try:
                with path.open(encoding="utf-8") as stream:
                    row = json.loads(stream.readline(LINE_LIMIT))
                payload = row.get("payload") if isinstance(row, dict) else None
                value = payload.get("cwd") if isinstance(payload, dict) else None
                if isinstance(value, str) and value:
                    cwd = value
            except (OSError, ValueError, UnicodeError, RecursionError):
                pass
        else:
            cwd = first_cwd(path)
        cache[key] = cwd
    return cache[key]


def file_belongs(path, folder_name, target_paths, cache=None, codex=False):
    """Match a session's cwd (or Claude's no-cwd folder fallback)."""
    cache = {} if cache is None else cache
    cwd = _session_cwd(Path(path), cache, codex)
    if cwd is None:
        return not codex and any(folder_name == re.sub(r"[^a-zA-Z0-9]", "-", str(target))
                                 for target in target_paths)
    key = ("canonical", cwd)
    if key not in cache:
        try:
            # Match discovery's spelling, so a case alias of an enrolled path still counts.
            cache[key] = str(canonical_path(cwd))
        except (OSError, RuntimeError, ValueError):  # e.g. a deleted directory or an embedded NUL
            try:
                cache[key] = os.path.realpath(cwd)
            except (OSError, ValueError):
                cache[key] = cwd
    return any(candidate == str(target) or candidate.startswith(str(target).rstrip(os.sep) + os.sep)
               for target in target_paths for candidate in (cwd, cache[key]))


def owner_of(path, folder_name, projects, cache=None, codex=False):
    """Return the project with the longest matching enrolled path."""
    cache = {} if cache is None else cache
    owner, longest = None, -1
    for project in projects:
        for target in project.paths:
            if len(str(target)) > longest and file_belongs(path, folder_name, [target], cache, codex):
                owner, longest = project, len(str(target))
    return owner


def _cutoff(state, now):
    return parse_time(state.get("reviewed_at")) or now - timedelta(days=7)


def gate(project, projects, cfg, state, now, claude_root, codex_root, cache=None):
    """Decide whether a project is due without writes or review subprocesses."""
    if cfg["enabled"]["value"] is False:
        return False, "skipped: disabled"
    schedule = cfg["schedule"]
    if schedule["value"] == "off":
        return False, f"skipped: schedule off ({schedule['source']})"
    if schedule["value"] == "always":
        return True, "due: schedule always"
    cutoff = _cutoff(state, now)
    cache = {} if cache is None else cache
    ignored = state.get("ignore_sessions", [])
    ignored = {value for value in ignored if isinstance(value, str)} if isinstance(ignored, list) else set()
    for root, patterns, codex in ((Path(claude_root), ("*/*.jsonl", "*/*/subagents/*.jsonl"), False),
                                  (Path(codex_root), ("*/*/*/*.jsonl",), True)):
        for pattern in patterns:
            for path in root.glob(pattern):
                subagent = not codex and path.parent.name == "subagents"
                session = path.parent.parent.name if subagent else path.stem
                if not codex and session in ignored:
                    continue
                try:
                    info = path.stat()
                    if not stat.S_ISREG(info.st_mode) or info.st_mtime <= cutoff.timestamp():
                        continue
                except OSError:
                    continue
                folder = path.parent.parent.parent.name if subagent else path.parent.name
                if owner_of(path, folder, projects, cache, codex) is project:
                    kind = "codex session" if codex else "claude transcript"
                    return True, f"due: activity ({kind})"
    if _git(project.canonical, "log", "-1", "--branches",
            # --since is inclusive and reviewed_at has whole seconds: skip the review's own second.
            f"--since=@{int(cutoff.timestamp()) + 1}", "--format=%H"):
        return True, "due: activity (git commit)"
    return False, f"skipped: no activity since {cutoff.date().isoformat()}"


def review_gate(project, projects, cfg, state, now, cache, options, project_dirs):
    if (getattr(options, "force", False) and project_dirs
            and cfg["enabled"]["value"] and cfg["schedule"]["value"] != "off"):
        return True, "due: forced"
    return gate(project, projects, cfg, state, now, claude_home() / "projects",
                codex_home() / "sessions", cache)


def cycle_mode(cfg, options):
    return ("auto" if not getattr(options, "propose_only", False)
            and cfg["scheduledAutonomy"]["value"] == "auto" else "propose-only")


def review_dry_run(audits, project_dirs=None, now=None, options=None, json_output=False):
    if not json_output and effective()["enabled"]["value"] is False:
        log("skipped: disabled")
        return
    options = options if options is not None else command_options(argparse.Namespace(dry_run=True))
    now = now if now is not None else datetime.now(timezone.utc)
    cache = {}
    index = read_index(audits)
    projects, not_enrolled = discover(claude_home() / "projects", codex_home() / "sessions",
                                    index, project_dirs)
    if json_output:
        rows = []
        for project in projects:
            setting = effective(project.canonical)["scheduledAutonomy"]
            row = dict(path=str(project.canonical), scheduledAutonomy=setting["value"],
                       source=setting["source"])
            if "note" in setting:
                row["note"] = setting["note"]
            rows.append(row)
        print(json.dumps(rows))
        return
    for project in projects:
        project.folder = Path(audits) / "projects" / project.key
        print(f"project: {project.canonical}")
        print(f"  key: {project.key}")
        print("  paths: " + ", ".join(map(str, project.paths)))
        settings = []
        cfg = effective(project.canonical)
        for name, setting in cfg.items():
            value = setting["value"]
            if isinstance(value, bool):
                value = json.dumps(value)
            settings.append(f"{name}={value} ({setting['source']})")
        print("  config: " + "; ".join(settings))
        if "note" in cfg["scheduledAutonomy"]:
            print("  note: " + cfg["scheduledAutonomy"]["note"])
        state = read_state(project)
        due, reason = review_gate(project, projects, cfg, state, now, cache, options, project_dirs)
        print("  gate: " + (f"due ({reason.removeprefix('due: ')})" if due else reason))
        print(f"  reviewed_at: {state.get('reviewed_at') or 'never'}")
        print("  cutoff: " + _cutoff(state, now).strftime("%Y-%m-%dT%H:%M:%SZ"))
        if due:
            # The report name is generated by the audit, which dry-run cannot execute.
            report = "<report path from audit stdout>"
            mode = cycle_mode(cfg, options)
            print("audit command: " + shlex.join(audit_command(options, project.folder, project)))
            try:
                print("review command: " + shlex.join(review_command(
                    options, mode, report, str(uuid.uuid4()), project.canonical, audits)))
            except ValueError as error:
                print(f"review command: not built ({error})")
    for path in not_enrolled:
        print(f"not enrolled: {path} (no docs/kaizen/ in it or any parent)")
    if not projects:
        print("no projects found; enrol a project with /agent-kaizen:start or pass --project-dir")
    print("index.json (not written, dry run): " + json.dumps(_index_document(index, projects), sort_keys=True))


def now(override=None):
    return override if override is not None else datetime.now(timezone.utc)


def timestamp(value):
    # Keep subsecond exit precision: truncation can make pre-review activity look new.
    return value.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")


def sibling(override, *names):
    if override is not None:
        return Path(override).expanduser().resolve()
    for name in names:
        path = HERE / name
        if path.is_file():
            return path
    raise FileNotFoundError(f"{names[-1]} not found; pass --{names[-1].removesuffix('.json')}")


def broker_command(options, operation):
    """Resolve a fixed broker entry point from the runner installation."""
    names = {"host-fix": ("kaizen-host-fix", "host-fix"),
             "allow-rule": ("kaizen-allow-rule", "allow-rule"),
             "worktree-prune": ("kaizen-worktree-prune", "worktree-prune"),
             "local-commit": ("kaizen-backup",)}
    path = sibling(None, *names[operation])
    if path.resolve() != path:
        raise ValueError("broker helper must be installed beside the runner")
    return [options.python, str(path)]


def command_options(args):
    """Resolve installed/repository siblings and command defaults without subprocesses."""
    python = getattr(args, "python", None) or sys.executable
    python = str(Path(shutil.which(python) or python).expanduser().absolute())
    claude = getattr(args, "claude", None) or shutil.which("claude")
    if (claude is None and not getattr(args, "dry_run", False)
            and getattr(args, "command", "review") == "review"):
        raise FileNotFoundError("claude not found; pass --claude or put it on PATH")
    if claude and os.sep in claude:
        claude = str(Path(claude).expanduser().absolute())
    token_audit = sibling(getattr(args, "token_audit", None), "kaizen-token-audit", "token-audit")
    if not token_audit.is_file():
        raise FileNotFoundError("token-audit not found; pass --token-audit")
    return argparse.Namespace(
        python=python, claude=claude or "claude", token_audit=token_audit,
        audits_alias=getattr(args, "audits", None),
        pricing=sibling(getattr(args, "pricing", None), "kaizen-pricing.json", "pricing.json"),
        model=getattr(args, "model", None) or os.environ.get("KAIZEN_REVIEW_MODEL") or "sonnet",
        max_turns=getattr(args, "max_turns", None) or os.environ.get("KAIZEN_REVIEW_MAX_TURNS") or "40",
        propose_only=getattr(args, "propose_only", False), force=getattr(args, "force", False))


def audit_command(options, out, project=None):
    cfg = effective(project.canonical if project is not None else None)
    command = [options.python, str(options.token_audit)]
    if project is not None:
        for path in sorted(project.paths):
            command.extend(["--cwd", str(path)])
        command.extend(["--days", "6"])
    extracts = out.parent.parent / "extracts" if project is not None else out / "extracts"
    command += ["--out", str(out), "--pricing", str(options.pricing),
                "--extract-out", str(extracts)]
    for name, flag, default in (("frictionSlowCallSeconds", "--friction-slow-seconds", 120),
                                ("frictionHeavySeconds", "--friction-heavy-seconds", 60)):
        if cfg[name]["value"] != default:
            command.extend([flag, str(cfg[name]["value"])])
    if cfg["friction"]["value"] == "off":
        command.append("--no-friction")
    return command


class UnsupportedPath(ValueError):
    """A path holds characters that permission rules cannot express."""


def deny_path(path, resolve=True):
    path = Path(path).expanduser()
    path = (path.resolve() if resolve else path).as_posix()
    # Rule syntax gives these characters meaning; fail closed rather than build a wrong rule.
    bad = sorted(set(path) & set(",()*?[]\\"))
    if bad:
        raise UnsupportedPath(f"cannot build deny rules: path contains {''.join(bad)!r}: {path}; "
                              "permission rules cannot express these characters, so this project "
                              "cannot be reviewed until the path is renamed or moved")
    return "//" + path.lstrip("/")


def allow_path(path):
    """Check a path embedded in a Bash allow rule; commas also split --allowedTools."""
    path = str(path)
    bad = sorted({char for char in path if char in ",()*?[]\\\"'`$;&|<>" or char.isspace()})
    if bad:
        raise UnsupportedPath(f"cannot build allow rules: path contains {''.join(bad)!r}: {path}; "
                              "permission rules cannot express these characters, so auto mode "
                              "cannot run until the path is renamed or moved")
    return path


def config_home_deny(project_dir=None):
    """Protect config state; Claude Code separately protects instruction paths."""
    rules = []
    # Agent definitions (tool and permission frontmatter) and Codex's AGENTS.md steer later sessions.
    for home, extra in ((claude_home(), ("agents/**",)), (codex_home(), ("AGENTS.md",))):
        for root in dict.fromkeys(deny_path(home, resolve=value) for value in (False, True)):
            for pattern in ("settings*.json", "hooks/**", "plugins/**", "skills/**", "commands/**",
                            "bin/**", "**/*.json", "**/*.toml", "**/*.sh", "**/*.py", "**/*.js",
                            ".credentials*", "auth.json", "**/.git/**", *extra):
                rules.extend(f"{tool}({root}/{pattern})" for tool in ("Edit", "Write"))
    for path in dict.fromkeys(deny_path(claude_json(), resolve=value) for value in (False, True)):
        rules.extend(f"{tool}({path})" for tool in ("Edit", "Write"))
    if project_dir is not None:
        for root in dict.fromkeys(deny_path(project_dir, resolve=value) for value in (False, True)):
            # Files that run, or widen permissions, in the next interactive session or CI run.
            for pattern in (".claude/settings*.json", ".claude/hooks/**", ".claude/agents/**",
                            ".claude/commands/**", ".claude/skills/**", ".mcp.json",
                            ".github/workflows/**", ".husky/**"):
                rules.extend(f"{tool}({root}/{pattern})" for tool in ("Edit", "Write"))
    return rules


def credential_deny(project_dir=None):
    paths = dict.fromkeys(deny_path(base, resolve=False) + suffix
                          for base, suffix in CREDENTIALS["credential_paths"](project_dir))
    return [f"{tool}({path})" for path in paths for tool in ("Read", "Edit", "Write")]


def auto_edit_allow(project_dir=None):
    roots = (Path(project_dir) if project_dir is not None else Path.cwd(), claude_home(), codex_home())
    paths = dict.fromkeys(deny_path(root, resolve=value) for root in roots for value in (False, True))
    return [f"{tool}({path}/**)" for path in paths for tool in ("Edit", "Write")]


def auto_read_allow(project_dir=None, audits=None):
    """Read, and through it Grep and Glob, only under the roots a run needs."""
    roots = (Path(project_dir) if project_dir is not None else Path.cwd(), claude_home(), codex_home(),
             HERE.parent, audits_dir(), audits if audits is not None else audits_dir())
    paths = dict.fromkeys(deny_path(root, resolve=value) for root in roots for value in (False, True))
    return [f"Read({path}/**)" for path in paths]


def ledger_paths():
    # notes-ledger reads the raw global value too: never use effective()'s fallback here.
    ledger = load_config(global_config_path(), strict=True).get("notesLedger", {})
    if not valid_value("notesLedger", ledger):
        raise ValueError("notesLedger is invalid: require csv and optional timeline paths "
                         "absolute after expanduser, and only supported keys")
    return {name: Path(ledger[name]).expanduser() for name in ("csv", "timeline") if ledger.get(name)}


def ledger_deny():
    paths = dict.fromkeys(deny_path(path, resolve=resolve)
            for path in ledger_paths().values()
            for resolve in (False, True))
    return [f"{tool}({path})" for path in paths for tool in ("Edit", "Write")]


def backup_root():
    # The same rule as scripts/kaizen-backup.
    return Path(os.environ.get("KAIZEN_BACKUP_DIR") or claude_home() / "kaizen-backups").expanduser()


def deny_roots(*paths):
    return tuple(dict.fromkeys(deny_path(path, resolve=resolve) for path in paths for resolve in (False, True)))


def action_store_deny(root):
    return [f"{tool}({root}/{name})" for name in ("host-actions.json", "host-actions.json.*")
            for tool in ("Read", "Edit", "Write")]


def audit_state_deny(root):
    return [f"{tool}({root}/projects/*/state.json)" for tool in ("Edit", "Write")]


def backup_deny():
    paths = dict.fromkeys(deny_path(backup_root(), resolve=resolve) for resolve in (False, True))
    return ([f"{tool}({path}/**)" for path in paths for tool in ("Read", "Edit", "Write")]
            + [rule for root in deny_roots(audits_dir()) for rule in action_store_deny(root)])


class LedgerConfigError(ValueError):
    """The configured ledger cannot be read at the start: a config problem, not a violation."""


class LedgerGuard:
    """Snapshot configured ledgers before Claude; verify before accepting its output."""

    def __init__(self, folder):
        self.folder = folder
        self.entries = []

    def snapshot(self):
        try:
            paths = ledger_paths()
        except ValueError as error:
            raise LedgerConfigError(str(error)) from error
        for kind, path in paths.items():
            try:
                if path.is_symlink() or not path.is_file():
                    raise ValueError("ledger must be a regular file, not a symlink")
                data = path.read_bytes()
                snapshot = self.folder / kind
                snapshot.write_bytes(data)
                self.entries.append({"kind": kind, "path": path, "resolved": path.resolve(), "snapshot": snapshot,
                                     "data": data, "size": len(data), "sha256": hashlib.sha256(data).hexdigest(),
                                     "mode": stat.S_IMODE(path.stat().st_mode)})
            except (OSError, ValueError) as error:
                raise LedgerConfigError(f"{path}: cannot snapshot ledger ({error})") from error
        (self.folder / "manifest.json").write_text(json.dumps([
            {key: str(value) if isinstance(value, Path) else value
             for key, value in entry.items() if key != "data"} for entry in self.entries], indent=2) + "\n")

    @contextlib.contextmanager
    def locked(self):
        """The lock notes-ledger takes (<csv>.lock), so a concurrent `notes-ledger set` finishes first.
        A lock path that is not a plain file we can open (a symlink, a FIFO) raises OSError."""
        entry = next((item for item in self.entries if item["kind"] == "csv"), None)
        descriptor = None
        if fcntl is not None and entry is not None:
            # Never create the lock file through a replaced parent directory.
            if entry["path"].parent.resolve() == entry["resolved"].parent:
                lock = str(entry["path"]) + ".lock"
                flags = (os.O_WRONLY | os.O_CREAT | os.O_APPEND
                         | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
                try:
                    descriptor = os.open(lock, flags, 0o666)
                    if not stat.S_ISREG(os.fstat(descriptor).st_mode):
                        raise OSError(f"{lock} is not a regular file")
                except OSError as error:
                    if descriptor is not None:
                        os.close(descriptor)
                    raise OSError(f"cannot lock the ledger: {error}") from error
        if descriptor is None:
            yield
            return
        try:
            deadline = time.monotonic() + 60
            while True:
                try:
                    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except (BlockingIOError, PermissionError):
                    if time.monotonic() > deadline:
                        raise OSError("timed out waiting for the ledger lock") from None
                    time.sleep(0.1)
            yield
        finally:
            os.close(descriptor)

    def verify(self):
        with self.locked():
            return self._verify()

    def save_rejected(self, entry):
        """Keep the bytes the guard is about to overwrite; return a message naming them."""
        path = entry["path"]
        try:
            if (path.parent.resolve() != entry["resolved"].parent or path.is_symlink()
                    or not path.is_file()):
                return ""
            saved = self.folder / (entry["kind"] + ".rejected")
            saved.write_bytes(path.read_bytes())
            return f"; rejected content saved to {saved}"
        except OSError as error:
            return f"; rejected content not saved ({error})"

    def _verify(self):
        problems = []
        for entry in self.entries:
            path = entry["path"]
            old = entry["data"]
            try:
                if path.resolve() != entry["resolved"]:
                    raise ValueError("ledger resolved path changed (parent symlink replacement)")
                if path.is_symlink() or not path.is_file():
                    raise ValueError("ledger is missing or is not a regular file (symlinks are forbidden)")
                new = path.read_bytes()
                if entry["kind"] == "timeline":
                    lines = iter(new.splitlines(keepends=True))
                    valid = all(any(line.rstrip(b"\r\n") == candidate.rstrip(b"\r\n") for candidate in lines)
                                for line in old.splitlines(keepends=True))
                else:
                    valid = hashlib.sha256(new[:entry["size"]]).hexdigest() == entry["sha256"]
                    if len(new) > entry["size"]:
                        valid = valid and (not old or old.endswith(b"\n")) and new.endswith(b"\n")
                if not valid:
                    raise ValueError("ledger history changed or growth is not whole lines")
            except (OSError, ValueError) as error:
                message = f"{path}: {error}" + self.save_rejected(entry)
                temporary = None
                try:
                    if path.parent.resolve() != entry["resolved"].parent:
                        raise OSError("ledger parent changed; refusing to restore through it")
                    with tempfile.NamedTemporaryFile(dir=path.parent, prefix=".kaizen-restore-",
                                                     delete=False) as output:
                        temporary = Path(output.name)
                        output.write(old)
                        os.fchmod(output.fileno(), entry["mode"])
                    os.replace(temporary, path)
                    message += "; restored snapshot"
                except OSError as restore_error:
                    message += f"; restore failed ({restore_error}); snapshot: {entry['snapshot']}"
                finally:
                    if temporary is not None:
                        temporary.unlink(missing_ok=True)
                problems.append(message)
        return problems


def review_command(options, mode, report, session_id, project_dir=None, audits=None, inputs=None):
    auto = mode == "auto"
    ledger = HERE / "notes-ledger"
    allowed = REVIEW_TOOLS
    if auto:
        ledger_rules = ledger_deny()  # Validate before granting notes-ledger add.
        allowed_tools = [*auto_read_allow(project_dir, audits),
                         *auto_edit_allow(project_dir), *READ_ONLY_BASH]
        # File-writing Bash tools bypass Edit/Write denies; grant only the scoped helpers.
        backup = HERE / "kaizen-backup"
        if backup.is_file() or ledger.is_file():
            python = allow_path(options.python)
        if backup.is_file():
            allow_path(backup)
            for subcommand in ("begin", "finish", "list"):
                allowed_tools.extend(f"Bash({prefix}{backup} {subcommand}:*)"
                                     for prefix in ("", "python3 ", python + " "))
        if ledger.is_file():
            allow_path(ledger)
            allowed_tools.extend([f"Bash(python3 {ledger} add:*)",
                                  f"Bash({python} {ledger} add:*)"])
        allowed = ",".join(allowed_tools)
    prompt = f"/agent-kaizen:cycle {mode} {report} notes-ledger-path={ledger}"
    if inputs is not None:
        prompt += " friction-inputs=" + json.dumps(str(inputs), ensure_ascii=True)
    command = [options.claude, "-p", prompt,
               "--session-id", session_id, "--model", options.model, "--max-turns", str(options.max_turns),
               "--tools", AUTO_AVAILABLE if auto else REVIEW_AVAILABLE, "--strict-mcp-config"]
    for path in (claude_home(), codex_home()):
        if path.is_dir():
            command.extend(["--add-dir", str(path.resolve())])
    command.extend(["--allowedTools", allowed])
    denied = [*credential_deny(project_dir), HARD_STOP_DENY]
    if auto:
        denied.extend([*GIT_DENY, *config_home_deny(project_dir), *ledger_rules])
    denied.extend(backup_deny())
    # Keep the standard deny list and attach external protections as additional
    # values of the same CLI option. In-checkout protections stay with its rules.
    project_roots = deny_roots(project_dir if project_dir is not None else Path.cwd())
    external_denies = []

    def add_denies(root, rules):
        in_checkout = any(root == project or root.startswith(project + "/") for project in project_roots)
        (denied if in_checkout else external_denies).extend(rules)

    if auto:
        installed = deny_path(HERE)
        add_denies(installed, [f"{tool}({installed}/**)" for tool in ("Edit", "Write")])
    default_audits = deny_roots(audits_dir())
    overrides = (Path(path).expanduser().absolute()
                 for path in (audits, getattr(options, "audits_alias", None)) if path is not None)
    for root in dict.fromkeys((*default_audits, *deny_roots(*overrides))):
        rules = audit_state_deny(root)
        if root not in default_audits:
            rules.extend(action_store_deny(root))
        add_denies(root, rules)
    command.extend(["--disallowedTools", ",".join(denied), *external_denies])
    return command + ["--permission-mode", "default" if auto else "dontAsk"]


# Patterns are relative to audits; each wildcard matches one path component.
RETENTION_KINDS = {
    "samples": {"patterns": ("samples/*.tsv",), "days": 14, "maxMB": 50},
    "extracts": {"patterns": ("extracts/*.extract.json", "projects/*/*.extract.json",
                              "projects/*/host-probe-*.json", "projects/*/friction-inputs-*.json"),
                 "days": 30, "maxMB": 200},
    "markers": {"patterns": ("projects/*/cycle-*.failed.md", "*.noticed-*",
                             "projects/*/*.noticed-*"), "days": 30},
    "reports": {"families": {
        "token-audit": ("token-audit-*.md", "projects/*/token-audit-*.md"),
        "checks": ("checks-*.md",),
        "project-report": ("projects/*/project-report-*.md",),
        "cycle": ("projects/*/cycle-*.md",)}, "days": 365},
    # Per-run ledger snapshots kept after a violation; temp files of a run that was killed.
    "ledger-runs": {"patterns": ("projects/*/.ledger-*/*",), "days": 7},
    "temp": {"patterns": ("projects/*/cycle-*.md.*",), "days": 1},
}


def retention_matches(root, pattern):
    """Expand a pattern without traversing symlink directories."""
    folders = [root]
    parts = pattern.split("/")
    for index, part in enumerate(parts):
        matches = []
        for folder in folders:
            try:
                if not stat.S_ISDIR(os.lstat(folder).st_mode):
                    continue
                with os.scandir(folder) as entries:
                    matches.extend(Path(entry.path) for entry in entries
                                   if fnmatch.fnmatchcase(entry.name, part)
                                   and (index == len(parts) - 1
                                        or entry.is_dir(follow_symlinks=False)))
            except FileNotFoundError:
                continue
            except OSError as error:
                log(f"housekeep: cannot scan {folder}: {error}")
                continue
        folders = matches
    return folders


def retention_stat(root, path):
    """Only regular files inside the real audits root are eligible."""
    try:
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode):
            return None
        if not os.path.realpath(path).startswith(os.path.realpath(root).rstrip(os.sep) + os.sep):
            return None
        parent = path.parent
        while parent != root:
            if not stat.S_ISDIR(os.lstat(parent).st_mode):
                return None
            parent = parent.parent
        return info
    except OSError:
        return None


def delete_sample(audits, path, identity, current):
    """Coordinate with sampler writers and recheck both pinned file identities."""
    if fcntl is None or path.name >= datetime.fromtimestamp(current, timezone.utc).strftime("%Y-%m-%d.tsv"):
        raise OSError("sample day is protected")
    flags = os.O_RDWR | getattr(os, "O_NOFOLLOW", 0) | os.O_NONBLOCK
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0))
    try:
        lock = os.open(".lock", flags | os.O_CREAT, 0o600, dir_fd=directory)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fd = os.open(path.name, flags, dir_fd=directory)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                info = os.fstat(fd)
                named = os.stat(path.name, dir_fd=directory, follow_symlinks=False)
                lock_info = os.fstat(lock)
                named_lock = os.stat(".lock", dir_fd=directory, follow_symlinks=False)
                if (not stat.S_ISREG(lock_info.st_mode) or not os.path.samestat(lock_info, named_lock)
                        or not os.path.samestat(info, named)
                        or (info.st_ino, info.st_dev, info.st_mtime_ns) != identity
                        or retention_stat(audits, path) is None):
                    raise OSError("sample changed")
                os.unlink(path.name, dir_fd=directory)
            finally:
                os.close(fd)
        finally:
            os.close(lock)
    finally:
        os.close(directory)


def housekeep(audits, cfg, dry_run=False, now=None):
    """Plan retention in kind order, then apply the same plan used by dry-run."""
    if cfg.get("retention", {}).get("value", "auto") == "off":
        return []
    audits = Path(audits).absolute()
    current = datetime.now(timezone.utc) if now is None else now
    current = current.timestamp() if isinstance(current, datetime) else current
    overrides = cfg.get("retentionOverrides", {}).get("value", {})

    def warn(reason):
        print(f"housekeep: retentionOverrides: {reason}, ignored", file=sys.stderr)

    valid = {}
    if not isinstance(overrides, dict):
        warn("expected an object")
        overrides = {}
    for kind, limits in overrides.items():
        if kind not in RETENTION_KINDS:
            warn(f"unknown kind {kind}")
            continue
        if not isinstance(limits, dict):
            warn(f"{kind}: expected an object")
            continue
        valid[kind] = {}
        for field, value in limits.items():
            if field not in ("days", "hours", "maxMB"):
                warn(f"{kind}: unknown field {field}")
            elif type(value) is not int or value < 1:
                warn(f"{kind}.{field}: expected an integer >= 1")
            else:
                valid[kind][field] = value
    plan = []
    planned = set()
    identities = {}
    # Recovery must retain its authenticated baseline even on propose-only
    # retries or a separately invoked housekeep. Unreadable state pins all
    # ledger snapshots because its individual paths cannot be recovered safely.
    pinned_snapshots = set()
    pin_all_snapshots = False
    try:
        for marker in recovery_markers(backup_root().resolve()):
            try:
                data = read_recovery_json(marker)
                for entry in data["ledger"]:
                    pinned_snapshots.add(Path(entry["snapshot"]).absolute())
            except (OSError, ValueError, KeyError, TypeError):
                pin_all_snapshots = True
    except OSError:
        pin_all_snapshots = True

    def add(path, info, kind, reason):
        if path not in planned:
            planned.add(path)
            identities[path] = (info.st_ino, info.st_dev, info.st_mtime_ns)
            plan.append({"path": path.relative_to(audits).as_posix(), "kind": kind,
                         "size": info.st_size, "reason": reason})

    for kind, spec in RETENTION_KINDS.items():
        limits = valid.get(kind, {})
        window = (limits["hours"] * 3600 if "hours" in limits
                  else limits.get("days", spec["days"]) * 86400)
        cap = limits.get("maxMB", spec.get("maxMB"))
        files, protected = {}, set()
        families = spec.get("families", {"": spec.get("patterns", ())})
        for family, patterns in families.items():
            groups = {}
            for pattern in patterns:
                for path in retention_matches(audits, pattern):
                    if kind == "ledger-runs" and (pin_all_snapshots or path in pinned_snapshots):
                        continue
                    if family == "cycle" and path.name.endswith(".failed.md"):
                        continue
                    if kind == "samples":
                        try:
                            day = datetime.strptime(path.name, "%Y-%m-%d.tsv").replace(tzinfo=timezone.utc)
                        except ValueError:
                            continue
                        if day.strftime("%Y-%m-%d.tsv") != path.name:
                            continue
                        if day.date() >= datetime.fromtimestamp(current, timezone.utc).date():
                            protected.add(path)
                    info = retention_stat(audits, path)
                    if info is not None:
                        files[path] = info
                        groups.setdefault(path.parent, {})[path] = info
            if kind == "reports":
                for group in groups.values():
                    protected.update(sorted(group, key=lambda p: (group[p].st_mtime, p.name),
                                            reverse=True)[:5])
        for path in sorted(files, key=lambda p: (files[p].st_mtime, p.as_posix())):
            info = files[path]
            age_origin = (datetime.strptime(path.name, "%Y-%m-%d.tsv")
                          .replace(tzinfo=timezone.utc).timestamp() + 86400
                          if kind == "samples" else info.st_mtime)
            if path not in protected and (current - age_origin >= window if kind == "samples"
                                          else current - age_origin > window):
                add(path, info, kind, "age")
                if kind == "reports":
                    marker = path.with_suffix(".reviewed")
                    marker_info = retention_stat(audits, marker)
                    if marker_info is not None:
                        add(marker, marker_info, kind, "report")
        remaining = [p for p in files if p not in planned]
        total = sum(files[p].st_size for p in remaining)
        if cap is not None:
            for path in sorted(remaining, key=lambda p: (files[p].st_mtime, p.as_posix())):
                if total <= cap * 1024 * 1024:
                    break
                if path not in protected:
                    add(path, files[path], kind, "cap")
                    total -= files[path].st_size
    touched = set()
    completed = []
    for entry in plan:
        path = audits / entry["path"]
        if not dry_run:
            try:
                info = retention_stat(audits, path)
                if info is None or (info.st_ino, info.st_dev, info.st_mtime_ns) != identities[path]:
                    log(f"housekeep: skipped {entry['path']}: file changed or missing")
                    continue
                if entry["kind"] == "samples":
                    delete_sample(audits, path, identities[path], current)
                else:
                    path.unlink()
            except OSError as error:
                log(f"housekeep: skipped {entry['path']}: {error}")
                continue
            touched.add(path.parent)
        completed.append(entry)
        action = "would delete" if dry_run else "deleted"
        log(f"housekeep: {action} {entry['path']} kind={entry['kind']} "
            f"size={entry['size']} reason={entry['reason']}")
    for folder in sorted(touched):
        if (folder == audits / "extracts" or folder.parent == audits / "projects"
                or (folder.name.startswith(".ledger-") and folder.parent.parent == audits / "projects")):
            try:
                if stat.S_ISDIR(os.lstat(folder).st_mode):
                    os.rmdir(folder)
            except OSError:
                pass
    return completed


def scheduled_housekeep(audits):
    try:
        housekeep(audits, effective())
    except Exception as error:
        log(f"housekeep: failed ({error})")


def run_audit(audits, options):
    stopped = False
    try:
        return _run_audit(audits, options)
    except Terminated:
        stopped = True
        raise
    finally:
        if not stopped:
            scheduled_housekeep(audits)


def run_auto_audit(args):
    with terminating_on_signals(timeout=AUTO_AUDIT_TIMEOUT):
        cfg = effective()
        if fcntl is None or not (cfg["enabled"]["value"] and cfg["autoAudit"]["value"]):
            return
        audits = audits_dir().resolve()
        with run_lock(audits, watchdog=True, wait=0) as held:
            if not held:
                return
            state = load_config(audits / AUTO_AUDIT_STATE)
            last = parse_time(state.get("last_audit_ok"))
            current = now()
            if last is not None and timedelta(0) <= current - last <= timedelta(days=3):
                return
            options = command_options(args)
            rotate_log(audits)
            with (audits / "run.log").open("a", encoding="utf-8", buffering=1) as stream:
                with contextlib.redirect_stdout(stream), contextlib.redirect_stderr(stream):
                    try:
                        run_audit(audits, options)
                    except Terminated as error:
                        log(f"auto-audit: stopped by {error.name}; will retry next session")
                        raise


def run_review(audits, project_dirs, options, clock):
    safety = {"ledger_violation": False, "stopped": False}
    try:
        # Shared across audit overrides, and inherited by the model watchdog. It
        # remains locked after a hard kill until all orphaned writers are stopped.
        lock = (contextlib.nullcontext(True) if same_directory(audits, backup_root())
                else run_lock(backup_root().resolve(), watchdog=True))
        with lock as held:
            if not held:
                return 0
            result = _run_review(audits, project_dirs, options, clock, safety)
        return result
    except Terminated:
        safety["stopped"] = True  # a stopped run does no housekeeping
        raise
    finally:
        # Reporting can raise after a violation; still stop all later steps.
        if not (safety["ledger_violation"] or safety["stopped"]):
            scheduled_housekeep(audits)


def run_step(name, options, arguments, success=(0,)):
    """Return bounded step output, or None when the optional sibling is absent."""
    try:
        script = sibling(None, "kaizen-host-probe", name) if name == "host-probe" else sibling(None, name)
    except FileNotFoundError:
        return None
    try:
        result = run_group([options.python, str(script), *map(str, arguments)],
                                capture_output=True, text=True, timeout=STEP_TIMEOUT)
        if result.returncode in success:
            lines = result.stdout.strip().splitlines()
            if len(lines) > 30:
                # Keep the final summary when a helper lists many entries.
                lines = lines[:28] + ["... (truncated)", lines[-1]]
            return "\n".join(lines)
        reason = f"exit {result.returncode}"
        detail = (result.stderr or result.stdout).strip().splitlines()
        if detail:
            reason += ": " + detail[0]
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        reason = failure_text(error)
    log(f"step {name}: failed ({reason})")
    return "unavailable: " + reason


def step_stamp():
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def run_drift(options):
    try:
        sibling(None, "kaizen-link")
    except FileNotFoundError:
        return None
    root = os.environ.get("CLAUDE_PLUGIN_ROOT")
    if not root:
        try:
            # Keep the invocation directory: HERE follows symlinks into the source checkout.
            record = Path(__file__).absolute().parent / ".kaizen-plugin-root"
            root = record.read_text(encoding="utf-8").strip()
        except FileNotFoundError:
            root = None
        except (OSError, UnicodeError) as error:
            reason = f"cannot read installed plugin root: {error}"
            log(f"step kaizen-link: failed ({reason})")
            return "unavailable: " + reason
    if not root:
        reason = "plugin root unknown; set CLAUDE_PLUGIN_ROOT or re-run install-schedule --apply"
        log(f"step kaizen-link: failed ({reason})")
        return "unavailable: " + reason
    return run_step("kaizen-link", options,
                    ["--check", "--plugin-root", str(Path(root).expanduser())], (0, 1))


def run_checks(audits, options, projects=None):
    if os.environ.get("KAIZEN_SKIP_CHECKS") == "1":
        return
    try:
        if projects is None:
            projects, _ = discover(claude_home() / "projects", codex_home() / "sessions", read_index(audits))
        repo_args = [arg for project in projects for arg in ("--repo", str(project.canonical))]
        project_args = [arg for project in projects for arg in ("--project", str(project.canonical))]
        sections = []
        drift = run_drift(options)
        if drift is not None:
            sections.append(f"## Drift\n\n{drift}")
        for title, name, arguments, success in (
                ("Stale rules", "rules-lint", repo_args, (0, 1)),
                ("Notes ledger: measurements due", "notes-ledger", ["due", *project_args], (0,))):
            output = run_step(name, options, arguments, success)
            if output is not None:
                sections.append(f"## {title}\n\n{output}")
        for project in projects:
            output = run_step("experiment-check", options, ["--project", str(project.canonical),
                              "--checks", "--state-file", str(project.folder / "checks.json")], (0, 1))
            if output is not None and not output.startswith("experiment-check: 0 finding"):
                sections.append(f"## Experiments: {project.canonical}\n\n{output}")
        if sections:
            audits.mkdir(parents=True, exist_ok=True)
            (audits / f"checks-{step_stamp()}.md").write_text(
                "\n\n".join(sections) + "\n", encoding="utf-8")
    except (OSError, ValueError) as error:
        log(f"step checks: failed ({error})")


def run_project_report(audits, project_dir, project_key, options):
    if os.environ.get("KAIZEN_SKIP_CHECKS") == "1" or not (HERE / "kaizen-project-report").is_file():
        return
    try:
        folder = audits / "projects" / project_key
        folder.mkdir(parents=True, exist_ok=True)
        run_step("kaizen-project-report", options,
                 ["--project", project_dir, "--out", folder / f"project-report-{step_stamp()}.md"])
    except (OSError, ValueError) as error:
        log(f"step kaizen-project-report: failed ({error})")


def audit_steps(audits, options):
    if os.environ.get("KAIZEN_SKIP_CHECKS") == "1":
        return
    try:
        projects, _ = discover(claude_home() / "projects", codex_home() / "sessions", read_index(audits))
        write_index(audits, projects)
        run_checks(audits, options, projects)
        for project in projects:
            run_project_report(audits, project.canonical, project.key, options)
    except (OSError, ValueError) as error:
        log(f"step projects: failed ({error})")


def run_usage_db(options):
    """Keep per-call usage history; never changes the audit result."""
    try:
        script = sibling(None, "usage-db")
    except FileNotFoundError:
        return
    lines = []
    try:
        result = run_group([options.python, str(script), "ingest", "--quiet"],
                                capture_output=True, text=True, timeout=STEP_TIMEOUT)
        lines = result.stderr.strip().splitlines()
        if not result.returncode:
            for line in lines[:10]:
                log(f"step usage-db: {line}")
            return
        reason = f"exit {result.returncode}"
        if lines:
            reason += ": " + lines.pop(0)
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        reason = failure_text(error)
    log(f"step usage-db: failed ({reason})")
    for line in lines[:9]:
        log(f"step usage-db: {line}")


def _run_audit(audits, options):
    code, report = _run_token_audit(audits, options)
    run_usage_db(options)
    # Only the unscoped audit reaches this path. Its callers hold the run lock.
    try:
        if fcntl is not None and code == 0 and report.is_file():
            write_state_file(audits / AUTO_AUDIT_STATE, {"last_audit_ok": timestamp(now())})
    except OSError as error:
        log(f"audit state: failed ({error})")
    return code


def _run_token_audit(audits, options):
    audits.mkdir(parents=True, exist_ok=True)
    audit_steps(audits, options)
    try:
        with (audits / "run.log").open("a", encoding="utf-8") as errors:
            result = run_group(audit_command(options, audits), stdout=subprocess.PIPE,
                                    stderr=errors, text=True, timeout=STEP_TIMEOUT)
        if result.returncode in (0, EXTRACT_WRITE_FAILED):
            report = report_path(result.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        log(f"audit: failed ({failure_text(error)})")
        return 1, None
    if result.returncode == EXTRACT_WRITE_FAILED:
        log(f"audit: extract not written; using {report} (details in run.log)")
        return 0, report
    if result.returncode:
        log(f"audit: failed (exit {result.returncode})")
        return result.returncode, None
    log(f"audit: ok {report}")
    return 0, report


def report_path(stdout):
    lines = stdout.splitlines()
    if not lines or not lines[0].strip():
        raise ValueError("token-audit did not print a report path")
    return Path(lines[0].strip()).expanduser().resolve()


def backup_directories(root):
    """Record directory names and identities outside model-controlled manifests."""
    paths, inodes = set(), set()
    for path in root.iterdir():
        info = path.lstat()
        if stat.S_ISDIR(info.st_mode):
            paths.add(path.resolve())
            inodes.add((info.st_dev, info.st_ino))
    return paths, inodes


def rollback_auto_changes(options, run_id, session_id, started, root, before, recovery=False):
    """Undo only this cycle's unfinished or failed changes, newest first."""
    pending, messages, problems = [], [], []
    for manifest in root.glob("*/manifest.json"):
        try:
            if manifest.is_symlink() or manifest.parent.is_symlink():
                continue
            info = manifest.parent.stat()
            if manifest.parent.resolve() in before[0] or (info.st_dev, info.st_ino) in before[1]:
                continue
            data = json.loads(manifest.read_text(encoding="utf-8"))
            created = parse_time(data.get("created_at"))
            if (data.get("run_id") != run_id and data.get("session_id") != session_id
                    or created is None or created <= started or data.get("reverted")):
                continue
            if recovery and (data.get("run_id") != run_id or data.get("session_id") != session_id):
                continue
            if not data.get("finished") or data.get("verification") == "failed":
                if recovery and not data.get("finished"):
                    # begin has no after hash. We cannot distinguish an abandoned
                    # edit from a later legitimate edit; never overwrite either.
                    raise ValueError("CONFLICT: unfinished change has no verified after hash")
                pending.append((created, manifest.parent))
        except (OSError, ValueError, AttributeError) as error:
            problems.append(f"rollback failed: {manifest.parent}: {error}")
    for _, change in sorted(pending, reverse=True):
        try:
            result = run_group([options.python, str(HERE / "kaizen-backup"), "undo", str(change),
                                *([] if recovery else ["--force"])],
                                    capture_output=True, text=True, timeout=STEP_TIMEOUT,
                                    env=dict(os.environ, KAIZEN_BACKUP_DIR=str(root)))
            if result.returncode:
                detail = (result.stderr or result.stdout).strip()
                raise ValueError(f"exit {result.returncode}: {detail}")
            messages.append(f"rolled-back: {change}")
        except (OSError, ValueError, subprocess.TimeoutExpired) as error:
            problems.append(f"rollback failed: {change}: {failure_text(error)}")
    return messages, problems


ACTIVE_RUN = ".active-run.json"
EPOCH = datetime(1970, 1, 1, tzinfo=timezone.utc)


def write_active_run(audits, run_id, session_id, mode, guard):
    """Create runner-owned state exclusively in the backup tree, which tools deny.
    Never replace an unresolved marker, even during a subsequent propose-only run.
    """
    root = backup_root().resolve()
    root.mkdir(parents=True, exist_ok=True)
    path = root / ACTIVE_RUN
    payload = {"run_id": run_id, "session_id": session_id, "mode": mode,
               "ledger": [{key: str(value) if isinstance(value, Path) else value
                           for key, value in entry.items() if key != "data"}
                          for entry in guard.entries]}
    while True:
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            break
        except FileExistsError:
            # No -NN- component: kaizen-backup's <run>-NN-<skill> names
            # cannot occupy this namespace, regardless of either argument.
            path = root / (".active-run." + uuid.uuid4().hex + ".json")
    with os.fdopen(descriptor, "w", encoding="utf-8") as output:
        os.fchmod(output.fileno(), 0o600)
        json.dump(payload, output)
        output.flush()
        os.fsync(output.fileno())
    return path


def read_recovery_json(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(descriptor, "r", encoding="utf-8") as source:
        info = os.fstat(source.fileno())
        if not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600:
            raise ValueError("marker must be a regular file with mode 0600")
        return json.load(source)


def recovery_ledger(data, root):
    """Authenticate every snapshot before verifying or restoring any ledger."""
    entries = data["ledger"]
    if not isinstance(entries, list):
        raise ValueError("missing authenticated ledger metadata")
    guard = LedgerGuard(None)
    for item in entries:
        entry = dict(item)
        if entry["kind"] not in ("csv", "timeline"):
            raise ValueError("invalid ledger kind")
        for name in ("path", "resolved", "snapshot"):
            entry[name] = Path(entry[name])
            if not entry[name].is_absolute():
                raise ValueError("ledger paths must be absolute")
        descriptor = os.open(entry["snapshot"], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(descriptor, "rb") as source:
            info = os.fstat(source.fileno())
            if not stat.S_ISREG(info.st_mode):
                raise ValueError("snapshot is not a regular file")
            if type(entry["size"]) is not int or entry["size"] < 0 or info.st_size != entry["size"]:
                raise ValueError("snapshot hash mismatch")
            old = source.read(entry["size"] + 1)
        if len(old) != entry["size"] or hashlib.sha256(old).hexdigest() != entry["sha256"]:
            raise ValueError("snapshot hash mismatch")
        entry["data"] = old
        guard.entries.append(entry)
    # Rejected bytes must not be written through a model-controlled snapshot folder.
    guard.folder = Path(tempfile.mkdtemp(dir=root, prefix=".ledger-recovery-"))
    for entry in guard.entries:
        entry["snapshot"] = guard.folder / entry["kind"]
        entry["snapshot"].write_bytes(entry["data"])
    return guard


def recovery_markers(root):
    for path in sorted(root.glob(".active-run*.json")):
        # Include first-round UUID names for upgrades, but never directories,
        # symlinks or other objects that a backup helper could create.
        if (path.name == ACTIVE_RUN
                or re.fullmatch(r"\.active-run\.[0-9a-f]{32}\.json", path.name)
                or re.fullmatch(r"\.active-run-[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}\.json", path.name)):
            if stat.S_ISREG(path.lstat().st_mode):
                yield path


def removal_command(path):
    # lstat avoids recursing through a symlink to a directory.
    recursive = stat.S_ISDIR(path.lstat().st_mode)
    return shlex.join(["rm", *(["-r"] if recursive else []), "--", str(path)])


def unresolved_recovery(path, run_id, problems, options, root, data=None):
    """Print complete owner actions, including a way out of untrusted state."""
    command = None
    if data is not None:
        for manifest in sorted(root.glob("*/manifest.json"), reverse=True):
            if manifest.is_symlink() or manifest.parent.is_symlink():
                continue
            try:
                change = json.loads(manifest.read_text(encoding="utf-8"))
                if (change.get("run_id") == data["run_id"]
                        and change.get("session_id") == data["session_id"]
                        and not change.get("reverted")):
                    assignments = []
                    home = claude_home().resolve()
                    if home != (Path.home() / ".claude").resolve():
                        assignments.append("CLAUDE_CONFIG_DIR=" + shlex.quote(str(home)))
                    if root != home / "kaizen-backups":
                        assignments.append("KAIZEN_BACKUP_DIR=" + shlex.quote(str(root)))
                    command = " ".join([*assignments, shlex.join([
                        options.python, str(HERE / "kaizen-backup"), "undo", str(manifest.parent)])])
                    break
            except (OSError, ValueError, AttributeError):
                continue
    action = f"; recovery command: {command}" if command else ""
    return (f"interrupted run {run_id}: " + "; ".join(problems) + action
            + "; resolve changes and ledger by hand if needed, then discard recovery record: "
            + removal_command(path))


def recover_interrupted_run(audits, options):
    """With both locks held, retry every unresolved runner-owned record.
    Audit-local legacy state cannot authorize rollback or ledger restoration.
    """
    root = backup_root().resolve()
    statuses = []
    legacy = audits / ACTIVE_RUN
    if legacy.parent.resolve() != root and (legacy.exists() or legacy.is_symlink()):
        statuses.append(unresolved_recovery(legacy, "unknown",
                        [f"ledger-unverified: untrusted legacy marker {legacy}"], options, root))
    for path in recovery_markers(root):
        run_id = "unknown"
        try:
            data = read_recovery_json(path)
            run_id, session_id = data["run_id"], data["session_id"]
            if not (isinstance(run_id, str) and run_id and isinstance(session_id, str) and session_id):
                raise ValueError("bad ids")
            if data.get("mode") not in ("auto", "propose-only"):
                raise ValueError("bad mode")
        except (OSError, ValueError, KeyError, TypeError, UnicodeError) as error:
            statuses.append(unresolved_recovery(path, run_id,
                            [f"ledger-unverified: unreadable marker ({error})"], options, root))
            continue
        problems = []
        if data.get("mode") == "auto":
            try:
                messages, problems = rollback_auto_changes(options, run_id, session_id, EPOCH, root,
                                                           (set(), set()), recovery=True)
            except Exception as error:
                messages, problems = [], [f"rollback failed: {error}"]
            for message in messages:
                log(f"interrupted run {run_id}: {message}")
        guard = None
        violations = []
        try:
            guard = recovery_ledger(data, root)
            violations = guard.verify()
            if violations:
                log(f"interrupted run {run_id}: ledger-violation: " + "; ".join(violations))
                # A successful restoration is verified again before dropping state.
                if any("; restore failed (" in item for item in violations) or guard.verify():
                    problems.append("ledger-unverified: ledger restoration remains unresolved")
                else:
                    statuses.append(f"interrupted run {run_id}: ledger-violation: restored authenticated snapshot")
        except Exception as error:
            problems.append(f"ledger-unverified: {error}")
        finally:
            if guard is not None and guard.folder is not None and not violations:
                shutil.rmtree(guard.folder, ignore_errors=True)
        if problems:
            statuses.append(unresolved_recovery(path, run_id, problems, options, root, data))
        else:
            path.unlink()
    return "; ".join(statuses) or None


def scheduled_authority(audits, project, options, command, root):
    """Accept only the pinned grants and a private namespace outside the checkout."""
    if (audits != audits_dir().resolve() or backup_root().absolute() != root
            or root.is_relative_to(project) or project.is_relative_to(root)):
        raise ValueError("broker state is outside the protected scope")
    deny_values = command[command.index("--disallowedTools") + 1:command.index("--permission-mode")]
    denied = set(",".join(deny_values).split(","))
    allowed = command[command.index("--allowedTools") + 1].split(",")
    pinned_denies = backup_deny() + [rule for path in deny_roots(audits_dir()) for rule in audit_state_deny(path)]
    if not set(pinned_denies) <= denied:
        raise ValueError("broker state lacks the pinned denies")
    backup_script, notes_script = HERE / "kaizen-backup", HERE / "notes-ledger"
    if any(path.resolve(strict=True) != path for path in (backup_script, notes_script)):
        raise ValueError("broker requires fixed backup and notes helpers")
    bash = {f"Bash({prefix}{backup_script} {operation}:*)" for operation in ("begin", "finish", "list")
            for prefix in ("", "python3 ", options.python + " ")}
    bash.update(f"Bash({python} {notes_script} add:*)" for python in ("python3", options.python))
    if set(rule for rule in allowed if rule.startswith("Bash")) != bash:
        raise ValueError("broker cannot trust the effective Bash grants")
    executables = (Path(options.python).resolve(), Path(command[0]).resolve())
    for path in (HERE, *executables, Path(options.python), Path(command[0]).absolute()):
        if path.is_relative_to(project) or any(
                path.is_relative_to(home) and not any(path.is_relative_to(home / name)
                                                     for name in ("bin", "plugins"))
                for home in (claude_home().resolve(), codex_home().resolve())):
            raise ValueError("broker code is in a model-writable location")
    for path in ledger_paths().values():
        for target in (path.resolve(), path.with_name(path.name + ".lock").resolve()):
            if (target.is_relative_to(root) or target.is_relative_to(HERE) or target in executables
                    or target.parent == audits and target.name.startswith("host-actions.json")):
                raise ValueError("notes ledger overlaps the broker state")
    backup = review_helper("kaizen-backup")
    cfg = effective(project)
    if (not cfg["enabled"]["value"] or cycle_mode(cfg, options) != "auto"
            or cfg["schedule"]["value"] == "off" or cfg["friction"]["value"] == "off"
            or cfg["hostActions"]["value"] != "apply"):
        raise ValueError("broker policy does not authorize scheduled actions")
    return backup, freeze_mutation_config(project, backup)


def scheduled_budget(audits, project, options, command, root, prepared, started, run_id, session_id, before):
    if not Path(command[0]).is_absolute():
        return None
    try:
        backup, config = scheduled_authority(audits, project, options, command, root)
        broker = review_helper("kaizen_friction_apply.py")
        if broker["scheduled_marker_refusal"]():
            return None
        version = run_group([command[0], "--version"], cwd="/", timeout=STEP_TIMEOUT,
                            capture_output=True, text=True, stdin=subprocess.DEVNULL)
        version = re.fullmatch(r"([0-9]+\.[0-9]+\.[0-9]+) \(Claude Code\)\s*", version.stdout) if not version.returncode else None
        if not version or version[1] not in broker["VERIFIED_STREAM_VERSIONS"]:
            return None
        scope = dict(run_id=run_id, session_id=session_id, started=started, before=before,
                     root_identity=backup["backup_root_identity"](root))
        notes = HERE / "notes-ledger"
        baseline = backup["capture_git_baseline"](project)
        if baseline is None:
            return None
        proof = dict(backup=backup, root=root, scope=scope, project=project, baseline=baseline,
                     ledger_before=broker["snapshot_ledger"](backup, project), config_before=config,
                     backup_script=HERE / "kaizen-backup", notes_script=notes, python=options.python,
                     notes_add=runpy.run_path(str(notes))["add"],
                     notes_before=broker["snapshot_notes"](backup, ledger_paths()))
        targets = {}
        for ident, candidate in prepared["allowed"].items():
            if candidate["catalog_id"] == "linux-localsearch" and "apply" in candidate["intents"]:
                path = Path(candidate["selector_key"])
                provenance = candidate["provenance"]
                if any(finding["subject"] == str(path) for finding in
                       (provenance if isinstance(provenance, list) else [provenance])):
                    info = path.lstat()
                    if stat.S_ISDIR(info.st_mode) and canonical_path(path) == path:
                        targets[ident] = [info.st_dev, info.st_ino]
        commit_id = None
        if config[0]:
            host = review_helper("kaizen_friction_actions.py")
            store = host["HostActions"](audits, root, action_project, key)
            commit_id = store.action_id(project, broker["LOCAL_COMMIT"], run_id, allowed=(run_id,))
        return broker, version[1], proof, targets, commit_id
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError):
        return None


def scheduled_action_refusal(catalog_id):
    if catalog_id not in ("linux-localsearch", "local-commit"):
        return "operation is proposal-only"
    runtime = review_helper("kaizen_friction_apply.py")
    return runtime["scheduled_marker_refusal"]()


def commit_generation(generation, run_id):
    return f"scheduled-local:{generation}:{run_id}"


def recover_scheduled_suggestions(store, host, project, *, proposal_only=False):
    """Close legacy proposal-only receipts that have no native broker record."""
    if store.friction.resolve().is_relative_to(project):
        raise ValueError("broker state must be outside the project")
    with host["_directory"](store.friction, private=True) as state, host["_locked"](state, "prepare"), \
            host["_directory"](store.path.parent) as directory, host["_locked"](directory, store.path.name):
        if store._scope(project) != project:
            raise ValueError("host-action scope changed; try again")
        rows, _, receipts = store._load(directory)
        generations = receipts.get(str(project), {})
        pending = host["_pending"](generations)
        suggestions = {}
        for ident in sorted(pending):
            if ident not in rows:
                continue
            # Scheduled reservations take both locks before creating a record.
            try:
                os.stat("broker-" + ident + ".json", dir_fd=state, follow_symlinks=False)
            except FileNotFoundError:
                catalog = rows[ident]["catalog_id"]
                reason = ("recovery is proposal-only" if proposal_only else
                          "commit was never reserved" if catalog == "local-commit" else
                          scheduled_action_refusal(catalog))
                if reason:
                    suggestions[ident] = reason
        if suggestions:
            for imported in generations.values():
                for ident in suggestions.keys() & imported.keys():
                    if imported[ident] == "pending":
                        imported[ident] = "terminal"
            store._save(directory, rows, receipts)
            for ident, reason in suggestions.items():
                log(f"friction: broker action {ident} resolved as a suggestion ({reason})")
        return bool(pending - suggestions.keys())


def run_scheduled_broker(audits, project, options, *, receipt=None, attempt=None):
    """Reconcile older reservations before allowing any new fixed operation."""
    root = backup_root().resolve()
    host = review_helper("kaizen_friction_actions.py")
    store = host["HostActions"](audits, root, action_project, key)
    project_path = project.canonical
    if attempt is None and not recover_scheduled_suggestions(store, host, project_path):
        return
    command = review_command(options, "auto", "", "", project_path, audits)
    backup, config = None, None

    def authorize():
        nonlocal backup, config
        if config is None:
            backup, config = scheduled_authority(audits, project_path, options, command, root)

    if attempt is not None:
        authorize()
    broker_path = HERE / "kaizen_friction_apply.py"
    runtime = review_helper("kaizen_friction_apply.py")
    broker = runtime["BrokerLedger"]
    local_commit = runtime["LOCAL_COMMIT"]
    helper_env = dict(HOME=str(canonical_path(Path.home())), CLAUDE_CONFIG_DIR=str(canonical_path(claude_home())),
                      KAIZEN_BACKUP_DIR=str(root), PATH="/usr/bin:/bin")
    slots = 0

    def invoke(phase, ident, target, bound):
        nonlocal slots
        if phase == "apply":
            if not slots or config != freeze_mutation_config(project_path, backup):
                raise ValueError("broker policy or budget changed before the effect")
            # The broker has persisted the reservation by this point.
            slots -= 1
        arguments = (["--target", target, "--identity", *map(str, bound)] if phase == "verify"
                     else ["--lease-fd", str(ledger.lease)])
        result = run_group([str(Path(options.python).resolve()), "-I", str(broker_path), phase,
                            str(project_path), ident, *arguments], cwd="/", env=helper_env,
                           timeout=30, stoppable=True, stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, pass_fds=(ledger.lease,))
        if result.returncode:
            raise ValueError("native marker transaction is unavailable or ambiguous")
        return result.stdout.strip()

    def commit_helper(folder, operation, payload):
        python, helper = broker_command(options, local_commit)
        return run_group([str(Path(python).resolve()), "-I", helper, "commit", operation, str(folder)],
                         input=payload, cwd="/", env=dict(helper_env, KAIZEN_BROKER_LEASE_FD=str(ledger.lease)),
                         timeout=30, stoppable=True, terminate_grace=True,
                         capture_output=True, text=True, pass_fds=(ledger.lease,))

    def finish_commit(record):
        result = commit_helper(record["tool_record"], "--scheduled-recovery-stdin",
                               json.dumps([record["id"], record["request"], str(project_path)]))
        if result.returncode:
            raise ValueError("native commit transaction is unavailable or ambiguous")
        return ledger.finish_commit(record, result.stdout.strip())

    with broker.locked(host, store, project_path) as ledger, host["_locked"](ledger.state, "prepare"), \
            host["_directory"](store.path.parent) as directory, host["_locked"](directory, store.path.name):
        rows, _, receipts = store._load(directory)
        generations = receipts.get(str(project_path), {})
        pending = sorted(host["_pending"](generations))
        generation = "scheduled:" + receipt["generation"] if receipt else None
        current = generations.get(generation, {})
        commit = None
        if attempt is not None:
            slots, run_id, targets, frozen_config, commit = attempt
            state = json.loads(host["_read"](ledger.state, "prepare-" + project.key + ".json", 1 << 20))
            if (state["project"] != str(project_path) or state["generation"] != int(receipt["generation"])
                    or generation not in generations or config != frozen_config):
                raise ValueError("scheduled authority changed after import")

        def terminal(ident, *, applied=True):
            for imported in generations.values():
                if imported.get(ident) == "pending":
                    imported[ident] = "terminal"
            if applied:
                rows[ident].update(status="done", done_by="verify", updated_at=now().isoformat())
            store._save(directory, rows, receipts)

        unresolved = set()
        action_errors = (OSError, RuntimeError, ValueError, KeyError, TypeError, subprocess.SubprocessError)
        for ident in pending:
            if commit and ident == commit[0]:
                continue
            phase, reason = None, None
            try:
                catalog = rows[ident]["catalog_id"]
                record = ledger.load(ident)
                if record is None:
                    reason = "commit was never reserved" if catalog == local_commit else scheduled_action_refusal(catalog)
                elif record["phase"] == "cancelled":
                    reason = record["reason"]
                elif record["phase"] == "reverted":
                    authorize()
                    phase = ledger.reconcile(ident)
                elif catalog == local_commit and record["operation"] == local_commit and record.get("reservation"):
                    bound = commit_generation(record["generation"], record["reservation"])
                    if rows[ident]["selector_key"] != record["reservation"] or generations.get(bound, {}).get(ident) != "pending":
                        raise ValueError("commit receipt does not match its reservation")
                    phase = finish_commit(record)
                elif record.get("reservation"):
                    authorize()
                    if ledger.cancel_unstarted_marker(record):
                        reason = record["reason"]
                    else:
                        phase = ledger.scheduled_marker(ident, rows[ident]["selector_key"], record["target_identity"], invoke)
            except action_errors:
                unresolved.add(ident)
                log(f"friction: broker action {ident} remains pending")
                continue
            if reason:
                terminal(ident, applied=False)
                log(f"friction: broker action {ident} resolved as a suggestion ({reason})")
            elif phase:
                terminal(ident, applied=phase == "recorded")
        if attempt is not None and not any(rows.get(ident, {}).get("catalog_id") == local_commit for ident in unresolved):
            if slots and commit:
                ident, folder, handoff = commit
                try:
                    bound = commit_generation(receipt["generation"], run_id)
                    if (generations.get(bound) != {ident: "pending"} or rows[ident]["catalog_id"] != local_commit
                            or rows[ident]["selector_key"] != run_id or unresolved):
                        raise ValueError("scheduled commit authority changed")
                    payload = json.dumps(handoff, sort_keys=True)
                    digest = hashlib.sha256(payload.encode("ascii")).hexdigest()
                    record = ledger.reserve_commit(ident, folder, digest,
                                                   (run_id, receipt["generation"], receipt["scope"]["cwd"],
                                                    runtime["policy_digest"](config)))
                except action_errors:
                    terminal(ident, applied=False)
                    log("friction: local commit resolved as a suggestion")
                else:
                    slots -= 1
                    if scheduled_action_refusal(local_commit) or config != freeze_mutation_config(project_path, backup):
                        ledger.cancel_reservation(record, "scheduled commit policy changed")
                        terminal(ident, applied=False)
                    else:
                        commit_helper(folder, "--scheduled-baseline-stdin", json.dumps(dict(handoff, action_id=ident)))
                        terminal(ident, applied=finish_commit(record) == "recorded")
            for ident in pending:
                if not slots or current.get(ident) != "pending" or ident not in targets or ident in unresolved:
                    continue
                try:
                    candidate = receipt["allowed"][ident]
                    if any(rows[ident][key] != candidate[key] for key in ("catalog_id", "selector_key")):
                        raise ValueError("scheduled action changed after import")
                    phase = ledger.scheduled_marker(ident, candidate["selector_key"], targets[ident], invoke,
                                                    attempt=(run_id, receipt["generation"], receipt["scope"]["cwd"],
                                                             runtime["policy_digest"](config)))
                except action_errors:
                    log(f"friction: broker action {ident} remains pending")
                    continue
                if phase:
                    terminal(ident, applied=phase == "recorded")


def _run_review(audits, project_dirs, options, clock, safety):
    """Review projects serially; failed/killed runs leave reviewed_at unchanged.

    Their Codex sessions and git commits still count as activity at the next gate;
    the project stays due because its review time did not move.
    """
    load_config(global_config_path(), strict=True)
    projects, _ = discover(claude_home() / "projects", codex_home() / "sessions",
                           read_index(audits), project_dirs)
    write_index(audits, projects)
    run_checks(audits, options, projects)
    rollback_failed = config_failed = recovery_failed = False
    try:
        degraded = recover_interrupted_run(audits, options)
    except (OSError, RuntimeError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        degraded = f"interrupted-run recovery failed ({failure_text(error)})"
    if degraded:
        log(f"recovery: {degraded}; every project runs as propose-only this cycle")
    cache = {}
    for project in sorted(projects, key=lambda project: project.canonical):
        project.folder = audits / "projects" / project.key
        cfg, state = effective(project.canonical), read_state(project)
        project_recovery_failed = False
        try:
            recovered = recover_scheduled_publication(audits, project, options=options, degraded=bool(degraded),
                                                      review_state=state)
        except (OSError, RuntimeError, ValueError, KeyError, TypeError) as error:
            log(f"friction: publication recovery failed ({failure_text(error)}); continuing ordinary review")
            recovered = None
            project_recovery_failed = recovery_failed = True
        if recovered:
            log(f"{project.canonical}: recovered published review")
            continue
        due, reason = review_gate(project, projects, cfg, state, clock(), cache, options, project_dirs)
        if not due:
            log(f"{project.canonical}: {reason}")
            continue
        audit_error = None
        try:
            project.folder.mkdir(parents=True, exist_ok=True)
            with (audits / "run.log").open("a", encoding="utf-8") as errors:
                result = run_group(audit_command(options, project.folder, project),
                                        stdout=subprocess.PIPE, stderr=errors, text=True,
                                        timeout=STEP_TIMEOUT)
            if result.returncode not in (0, EXTRACT_WRITE_FAILED):
                audit_error = f"audit failed (exit {result.returncode})"
            else:
                report = report_path(result.stdout)
                if result.returncode == EXTRACT_WRITE_FAILED:
                    log(f"{project.canonical}: audit extract not written; using {report} (details in run.log)")
        except (OSError, ValueError, subprocess.TimeoutExpired) as error:
            audit_error = f"failed ({failure_text(error)})"
        if audit_error is not None:
            state.update(status="audit-failed", last_error=audit_error, last_error_at=timestamp(clock()))
            state.pop("ledger_errors", None)
            write_state(project, state)
            log(f"{project.canonical}: {audit_error}")
            continue
        run_project_report(audits, project.canonical, project.key, options)
        mode = "propose-only" if degraded or project_recovery_failed else cycle_mode(cfg, options)
        started = clock()
        prepared = None
        try:
            if (recovered is not None and cfg["enabled"]["value"] and cfg["friction"]["value"] != "off"
                    and cfg["hostActions"]["value"] != "off"):
                probe = run_step("host-probe", options, ["--project", project.canonical, "--out", project.folder])
                if probe is None or probe.startswith("unavailable:"):
                    raise ValueError("host probe refresh failed")
            if recovered is not None and result.returncode != EXTRACT_WRITE_FAILED:
                prepared = friction_prepare(audits, project, report, options, cfg, mode, now, retain=True)
            if prepared is not None and (not isinstance(prepared, tuple) or len(prepared) != 2
                                         or not isinstance(prepared[0], Path) or not isinstance(prepared[1], dict)):
                raise ValueError("invalid preparation result")
            if prepared and mode == "auto":
                review_helper("kaizen_friction_apply.py")
        except (OSError, RuntimeError, ValueError, RecursionError, KeyError, TypeError, AttributeError) as error:
            prepared = None
            log(f"friction: preparation unavailable ({failure_text(error)}); continuing review")
        session_id = str(uuid.uuid4())
        ignored = state.get("ignore_sessions", [])
        ignored = [value for value in ignored if isinstance(value, str)] if isinstance(ignored, list) else []
        state["ignore_sessions"] = (ignored + [session_id])[-20:]
        write_state(project, state)
        base = "cycle-" + started.astimezone().strftime("%Y-%m-%d")
        proposal = project.folder / (base + ".md")
        number = 2
        while proposal.exists():  # never replace a proposal the owner may not have read
            proposal = project.folder / f"{base}-{number}.md"
            number += 1
        failed = proposal.with_suffix(".failed.md")
        output = temporary = publication_time = None
        succeeded = imported = publication_saved = False
        ledger_problems = []
        path_error = config_error = timed_out = terminated = None
        rollbacks, rollback_problems = [], []
        guard = None
        active_marker = None
        observation = calls = rendered = None
        try:
            run_id = started.astimezone().strftime("%Y%m%d-%H%M%S") + "-" + session_id
            root = backup_root().resolve()
            env = dict(os.environ, KAIZEN_RUN_ID=run_id, KAIZEN_SESSION_ID=session_id,
                       KAIZEN_BACKUP_DIR=str(root))
            if mode == "auto":
                root.mkdir(parents=True, exist_ok=True)
                before = backup_directories(root)
            with (audits / "run.log").open("a", encoding="utf-8") as errors:
                output = tempfile.NamedTemporaryFile(mode="w+", encoding="utf-8", dir=project.folder,
                                                     prefix=proposal.name + ".", delete=False)
                temporary = Path(output.name)
                # mkdtemp creates a private (0700) state directory for this run.
                try:
                    guard = LedgerGuard(Path(tempfile.mkdtemp(dir=project.folder, prefix=".ledger-")))
                    guard.snapshot()
                except LedgerConfigError as error:
                    config_error = (f"{error}; fix notesLedger in the global config "
                                    "or create the file")
                    shutil.rmtree(guard.folder, ignore_errors=True)
                except Exception as error:
                    ledger_problems.append(str(error))
                if not ledger_problems and config_error is None:
                    limit = review_timeout()
                    active_marker = write_active_run(audits, run_id, session_id, mode, guard)
                    with protected():  # from here a signal waits for rollback and the ledger check
                        try:
                            command = review_command(options, mode, report, session_id, project.canonical, audits,
                                                     prepared[0] if prepared else None)
                            launch = dict(stoppable=True, cwd=project.canonical, env=env, stderr=errors, timeout=limit)
                            if mode == "auto" and prepared:
                                observation = scheduled_budget(audits, project.canonical, options, command, root,
                                                               prepared[1], started, run_id, session_id, before)
                            if observation is None:
                                result = run_group(command, stdout=output, **launch)
                            else:
                                broker, version, proof, _, commit_id = observation
                                if commit_id:
                                    command[2] += (f"\nIf this review made a verified backed-up file change, you may "
                                                   f"request a local commit with action ID {commit_id} and intent "
                                                   "apply in the kaizen-host-actions comment. Use only that ID.")
                                result, rendered, calls = broker["observe_review"](
                                    run_group, command, version, backup=proof["backup"], scope=proof["scope"],
                                    project=project.canonical, **launch)
                                output.write(rendered)
                        except subprocess.TimeoutExpired:
                            timed_out = limit
                        finally:
                            if mode == "auto":
                                try:
                                    rollbacks, rollback_problems = rollback_auto_changes(
                                        options, run_id, session_id, started, root, before)
                                except Exception as error:
                                    rollback_problems.append(f"rollback failed: {error}")
                            ledger_resolved = False
                            try:
                                ledger_problems.extend(guard.verify())
                                if not ledger_problems:
                                    ledger_resolved = True
                                elif not any("; restore failed (" in item for item in ledger_problems):
                                    recheck = guard.verify()
                                    ledger_problems.extend(recheck)
                                    ledger_resolved = not recheck
                            except Exception as error:
                                paths = ", ".join(str(entry["path"]) for entry in guard.entries)
                                ledger_problems.append(f"{paths}: ledger guard failed ({error}); snapshots: {guard.folder}")
                            if not rollback_problems and ledger_resolved:
                                # The marker is the commit point. A kill before
                                # unlink retries verification; a kill afterwards
                                # leaves only disposable, already-verified files.
                                active_marker.unlink(missing_ok=True)
                                if not ledger_problems:
                                    shutil.rmtree(guard.folder)
                            else:
                                problems = [*rollback_problems]
                                if not ledger_resolved:
                                    problems.append("ledger-unverified: ledger restoration remains unresolved")
                                degraded = unresolved_recovery(active_marker, run_id, problems, options, root,
                                                              {"run_id": run_id, "session_id": session_id})
                                log(f"recovery: {degraded}; every project runs as propose-only this cycle")
                            for message in [*rollbacks, *rollback_problems]:
                                output.write("\n" + message + "\n")
            if ledger_problems:
                outcome = "ledger-violation: " + "; ".join(ledger_problems)
            elif config_error:
                outcome = "ledger-config-error: " + config_error
            elif rollback_problems:
                outcome = "; ".join(rollback_problems)
            elif rollbacks:
                outcome = "rolled-back"
            elif timed_out:
                outcome = f"failed (timed out after {timed_out:g} s)"
            elif result.returncode == 0:
                terminal = False
                attempt = None
                if prepared:
                    try:
                        commit_id = commit = None
                        if observation is not None:
                            broker, _, proof, targets, commit_id = observation
                            with guard.locked():
                                config = freeze_mutation_config(project.canonical, proof["backup"])
                                slots, attestation, verified = broker["prove_budget"](calls, **proof, config_after=config)
                            if slots is None:
                                raise ValueError("scheduled mutation budget is unknown")
                            commit = broker["commit_tuple"](proof, attestation, verified)
                        terminal, requested = reconcile_scheduled(
                            audits, project, output, prepared[1], acknowledge=False, rendered=rendered,
                            commit_id=commit_id, commit_run=run_id if commit_id and commit and slots else None,
                            authorize=lambda: scheduled_authority(audits, project.canonical, options, command, root))
                        if observation is not None and slots:
                            local = (commit_id, *commit) if requested and commit else None
                            if local or targets:
                                attempt = (slots, run_id, targets, config, local)
                        imported = True
                    except (OSError, RuntimeError, ValueError, RecursionError, KeyError, TypeError, AttributeError):
                        log("friction: review output could not be reconciled")
                if imported and (terminal or attempt is not None):
                    output.flush()
                    os.fsync(output.fileno())
                    publication_time = timestamp(clock())
                    recover_scheduled_publication(audits, project, prepared[1], proposal, output,
                                                  reviewed_at=publication_time)
                if not os.path.samestat(temporary.lstat(), os.fstat(output.fileno())):
                    raise ValueError("review output path was replaced")
                os.replace(temporary, proposal)
                if imported and (terminal or attempt is not None):
                    sync_directory(proposal.parent)
                if imported and attempt is not None and not terminal:
                    try:
                        run_scheduled_broker(audits, project, options, receipt=prepared[1], attempt=attempt)
                    except (OSError, RuntimeError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
                        log("friction: broker work remains pending")
                if imported and (terminal or attempt is not None):
                    try:
                        publication_saved = bool(recover_scheduled_publication(
                            audits, project, degraded=bool(degraded), review_state=state))
                    except (OSError, RuntimeError, ValueError, KeyError, TypeError) as error:
                        project_recovery_failed = recovery_failed = True
                        log(f"friction: publication recovery failed ({failure_text(error)})")
                succeeded = True
                outcome = f"reviewed ({mode})"
            else:
                outcome = f"failed (exit {result.returncode})"
        except Terminated as error:
            terminated = error
            outcome = f"failed (terminated by {error.name})"
        except UnsupportedPath as error:
            path_error = str(error)
            outcome = "unsupported-path: " + path_error
        except (OSError, ValueError) as error:
            outcome = f"failed ({error})"
        finally:
            if ledger_problems:
                safety["ledger_violation"] = True
            if output is not None:
                with output:
                    if config_error and not ledger_problems:
                        output.write("\nledger-config-error: " + config_error + "\n")
                    if ledger_problems:
                        output.write("\nledger-violation: " + "; ".join(ledger_problems) + "\n")
        rollback_failed = rollback_failed or bool(rollback_problems)
        if rollbacks and not rollback_problems:
            outcome = "rolled-back"
        if config_error and not ledger_problems:
            config_failed = True
            outcome = "ledger-config-error: " + config_error
        if ledger_problems:
            outcome = "ledger-violation: " + "; ".join(ledger_problems)
        exited = clock()
        if succeeded:
            state.pop("ledger_errors", None)
            state.pop("last_error", None)
            state.update(status="ok", report=str(report), proposal=str(proposal))
            if (not project_recovery_failed or cfg["friction"]["value"] == "off") and (not prepared or imported):
                state["reviewed_at"] = publication_time or timestamp(exited)
        else:
            state.update(status="ledger-violation" if ledger_problems else
                         "ledger-config-error" if config_error else
                         "unsupported-path" if path_error else
                         "failed" if rollback_problems else
                         "rolled-back" if rollbacks else
                         "timed-out" if timed_out else "failed",
                         last_error_at=timestamp(exited))
            detail = (path_error or config_error
                      or (f"timed out after {timed_out:g} s" if timed_out else None)
                      or (f"terminated by {terminated.name}" if terminated else None))
            if detail:
                state["last_error"] = detail
            else:
                state.pop("last_error", None)
            if ledger_problems:
                state["ledger_errors"] = ledger_problems
            else:
                state.pop("ledger_errors", None)
            if temporary is not None:
                try:
                    os.replace(temporary, failed)
                    outcome += f"; output: {failed}"
                except (OSError, ValueError) as error:
                    outcome += f"; output: {temporary} (could not save as {failed}: {error})"
        if not publication_saved:
            write_state(project, state)
        log(f"{project.canonical}: {outcome}")
        if terminated is not None:
            raise terminated
        if ledger_problems:
            return 1
    return 1 if rollback_failed or config_failed or recovery_failed else 0


def write_config(path, updates):
    """Merge an object and atomically replace it without discarding other keys."""
    path = Path(path)
    if path.is_symlink():
        # Replace the real file so a symlinked config (dotfiles, stow) stays a symlink.
        path = Path(os.path.realpath(path))
    try:
        cfg = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        cfg = {}
    except (OSError, ValueError, UnicodeError):
        cfg = None
    if not isinstance(cfg, dict):
        print(f"config: {path} is not valid JSON; fix or remove it", file=sys.stderr)
        raise SystemExit(2)
    cfg.update(updates)
    if path.resolve() == global_config_path().resolve():
        path.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent,
                                         prefix=path.name + ".", delete=False) as stream:
            temporary = Path(stream.name)
            stream.write(json.dumps(cfg, indent=2) + "\n")
        # The temp file is 0600; keep the target's mode (project configs are shared files).
        if path.exists():
            mode = stat.S_IMODE(path.stat().st_mode)
        else:
            mask = os.umask(0)
            os.umask(mask)
            mode = 0o666 & ~mask
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def canonical_project(directory):
    """Return the enrolled project a real run would use for this directory or one above it."""
    directory = Path(directory).resolve()
    for candidate in (directory, *directory.parents):
        if (candidate / "docs/kaizen").is_dir():
            projects, _ = discover(claude_home() / "projects", codex_home() / "sessions", {}, [candidate])
            if projects:
                return projects[0].canonical
            break
    return directory


@contextlib.contextmanager
def config_lock(path):
    """Serialize read-modify-write of a config file with flock on <name>.lock beside the file (beside the link when the file is a symlink)."""
    if fcntl is None:
        yield
        return
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(str(path) + ".lock", "a") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def update_auto_projects(project, enable):
    """Add or remove a project's canonical path in the global autoProjects list."""
    with config_lock(global_config_path()):
        raw = load_config(global_config_path(), strict=True).get("autoProjects", [])
        if not valid_value("autoProjects", raw):
            raise ValueError("autoProjects in the global config is invalid; fix it first")
        listed = any(same_directory(item, project) for item in raw)
        if enable and not listed:
            write_config(global_config_path(), {"autoProjects": [*raw, str(project)]})
        elif listed and not enable:
            write_config(global_config_path(), {"autoProjects": [
                item for item in raw if not same_directory(item, project)]})


def show_config(project_dir=None):
    if project_dir is not None:
        project_dir = canonical_project(project_dir)
    result = effective(project_dir)
    result["reports"] = (str(audits_dir() / "projects" / key(project_dir)) + "/"
                         if project_dir is not None else None)
    if project_dir is not None:
        result["localAudits"] = str(project_dir / "docs/kaizen")
    print(json.dumps(result, indent=2))


def action_project(directory, *, selector=None, allow_missing=False):
    directory = canonical_path(Path(directory).expanduser())
    if not directory.is_dir():
        raise ValueError("expected a project directory")
    if any(c in str(directory) for c in "\r\n"):
        raise ValueError("project scope is unknown")
    member = enrolled_project(directory)
    if member is None:
        raise ValueError("host actions require an enrolled project")
    (project,), _ = discover(None, None, {}, [member])
    if project.unknown:
        raise ValueError("project scope is unknown because a Git probe failed; try again")
    if selector is None:
        return project.canonical

    target = canonical_path(member / selector)
    if any(c in str(target) for c in "\r\n"):
        raise ValueError("action target scope is unknown")

    def check_owner(path, *, required=True):
        owner = enrolled_project(path if path.is_dir() else path.parent)
        if owner is None and required:
            raise ValueError("action target scope is unknown")
        if owner is not None and owner != project.canonical:
            (scope,), _ = discover(None, None, {}, [owner])
            if scope.unknown or scope.canonical != project.canonical:
                raise ValueError("action target is outside the canonical project")

    # The innermost worktree anchor holding the target, so a worktree nested in another maps correctly.
    anchor = max((path for path in project.anchors if path == target or path in target.parents),
                 key=lambda path: len(path.parts), default=None)
    if anchor is None:
        raise ValueError("action target is outside the enrolled project")
    check_owner(target, required=False)
    target = project.canonical / target.relative_to(anchor)
    try:
        target = canonical_path(target)
    except FileNotFoundError:
        if not allow_missing:
            raise
        target = target.resolve()
    if target != project.canonical and project.canonical not in target.parents:
        raise ValueError("action target scope is unknown")
    check_owner(target)
    return project.canonical, target


def actions_command(args):
    if args.action == "import":
        return friction_reconcile_command(args)
    try:
        host = runpy.run_path(str(HERE / "kaizen_friction_actions.py"))
        audits, backups = audits_dir(), backup_root()
        if args.action == "undo":
            if "KAIZEN_RUN_ID" in os.environ or "KAIZEN_SESSION_ID" in os.environ:
                raise ValueError("broker undo requires an interactive invocation")
            home, config, backups = map(canonical_path, (Path.home(), claude_home(), backups))
            if not all(path.is_dir() for path in (home, config, backups)):
                raise ValueError("broker undo requires valid state directories")
            audits = config / "audits"
            helper_env = dict(os.environ, HOME=str(home), CLAUDE_CONFIG_DIR=str(config), KAIZEN_BACKUP_DIR=str(backups))
        store = host["HostActions"](audits, backups, action_project, key)
        project = args.project_dir
        if args.action == "undo":
            requested = canonical_path(project.expanduser())
            member = enrolled_project(requested)
            if (member is None or checkout_root(requested) != checkout_root(member)
                    or git_common_dir(requested) != git_common_dir(member)):
                raise ValueError("undo requires a directory in the enrolled checkout")
            project = action_project(requested)
            broker = runpy.run_path(str(HERE / "kaizen_friction_apply.py"))["BrokerLedger"]

            def inverse(operation, record):
                python, helper = broker_command(argparse.Namespace(python=sys.executable), operation)
                if operation != "allow-rule":
                    path = Path(record)
                    record = str(canonical_path(path.parent) / path.name)
                operands = (["--scheduled-action", args.id, record] if operation == "local-commit"
                            else [record, "--project", str(project)])
                result = run_group([python, "-I", helper, "undo", *operands], stoppable=True,
                                   cwd="/", env=helper_env, timeout=30, stdin=subprocess.DEVNULL,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if result.returncode:
                    raise ValueError("the fixed undo helper could not verify reversal")

            with terminating_on_signals(), broker.locked(host, store, project) as ledger:
                SIGNALS["lease"] = ledger.lease
                try:
                    ledger.undo(args.id, inverse)
                finally:
                    SIGNALS.pop("lease", None)
            print("Broker action reverted.")
        elif args.action == "verify":
            for ident, result in store.verify(project).items():
                print(f"{ident} {result}")
        elif args.action != "list":
            store.mark(project, args.id, args.action)
        elif args.json:
            print(json.dumps(store.scoped(project), indent=2))
        else:
            for row in store.scoped(project):
                print(f"{row['id']} {row['status']} {json.dumps(row['subject'])}")
        return 0
    except Terminated as error:
        return 128 + error.number
    except (OSError, RuntimeError, subprocess.SubprocessError):
        print("actions: project or private host-action files are unavailable", file=sys.stderr)
    except ValueError as error:
        print(f"actions: {error}", file=sys.stderr)
    return 2


@lru_cache(maxsize=None)
def review_helper(name):
    """Keep the runner's Python helpers loaded across the unattended review."""
    return runpy.run_path(str(HERE / name))


def friction_prepare(audits, project, report, options, cfg, mode, clock, *, interactive=False, retain=False):
    """Prepare bounded local evidence without a review or acknowledgement."""
    module = review_helper("kaizen_friction_prepare.py")
    helpers = {"host": review_helper("kaizen_friction_actions.py")} if module.get("RUNNER_API") == 2 else {}
    return module["prepare"](Path(audits), backup_root(), project, report, cfg, mode,
                             clock(), action_project, key, interactive=interactive, retain=retain, **helpers)


@contextlib.contextmanager
def review_output(output):
    if isinstance(output, Path):
        descriptor = os.open(output, os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(descriptor, "r+", encoding="utf-8") as stream:
            info = os.fstat(descriptor)
            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
                raise ValueError("expected a regular review output file")
            yield stream
    else:
        yield output


def reconcile_scheduled(audits, project, output, receipt, *, acknowledge=True, rendered=None, authorize=None,
                        commit_id=None, commit_run=None):
    """Import one validated action line, then acknowledge only terminal requests."""
    if isinstance(output, Path):
        with review_output(output) as stream:
            return reconcile_scheduled(audits, project, stream, receipt, acknowledge=acknowledge, rendered=rendered,
                                       authorize=authorize, commit_id=commit_id, commit_run=commit_run)
    module = review_helper("kaizen_friction_prepare.py")
    host = review_helper("kaizen_friction_actions.py")
    output.flush()
    output.seek(0)
    limit = 1024 * 1024
    if os.fstat(output.fileno()).st_size > limit:
        raise ValueError("review output too large")
    text = output.read(limit + 1) if rendered is None else rendered
    if len(text.encode("utf-8")) > limit:
        raise ValueError("review output too large")
    lines = text.splitlines(keepends=True)
    matches = [line for line in lines if line.startswith(host["BLOCK_PREFIX"])]
    if len(matches) != 1 or text.count(host["BLOCK_PREFIX"]) != 1:
        raise ValueError("expected one action comment")
    block = matches[0].rstrip("\r\n")
    requests = host["_requests"](block)
    commit_intent = requests.pop(commit_id, None)
    downgraded = commit_intent is not None
    for ident, intent in requests.items():
        if intent != "apply":
            continue
        candidate = receipt["allowed"].get(ident, {})
        if intent not in candidate.get("intents", ()):
            raise ValueError("unavailable host-action ID or intent for this project")
        if scheduled_action_refusal(candidate["catalog_id"]):
            requests[ident] = "suggest"
            downgraded = True
    if authorize is not None and "apply" in requests.values():
        authorize()
    if downgraded:
        block = host["BLOCK_PREFIX"] + json.dumps(
            dict(v=1, actions=[dict(id=ident, intent=intent) for ident, intent in requests.items()])) + " -->"
    store = host["HostActions"](audits, backup_root(), action_project, key)
    helpers = {"host": host} if module.get("RUNNER_API") == 2 else {}
    imported = module["import_scheduled"](audits, backup_root(), project, receipt,
                                          effective(project.canonical), now(), action_project, key, block, **helpers)
    reserved = commit_run is not None and commit_intent == "apply"
    if reserved:
        # The public catalogue import has already revalidated the preparation.
        # Persist the private intent before publishing or reserving any effect.
        with host["_directory"](store.friction, private=True) as state, host["_locked"](state, "prepare"), \
                host["_directory"](store.path.parent) as directory, host["_locked"](directory, store.path.name):
            current = json.loads(host["_read"](state, "prepare-" + project.key + ".json", 1 << 20))
            rows, secret, receipts = store._load(directory)
            generations = receipts[str(project.canonical)]
            bound = commit_generation(receipt["generation"], commit_run)
            identity = (str(project.canonical), "local-commit", commit_run)
            if (current["project"] != identity[0] or current["generation"] != int(receipt["generation"])
                    or generations.get("scheduled:" + receipt["generation"]) != imported or commit_id in rows
                    or bound in generations or host["_id"](secret or store._secret(), *identity) != commit_id):
                raise ValueError("local commit request does not match the current preparation")
            rows[commit_id] = store._new_row(identity, "Verified scheduled review backup", now().isoformat())
            generations[bound] = {commit_id: "pending"}
            store._save(directory, rows, receipts)
    output.seek(0)
    output.write("".join(line for line in lines if line != matches[0]))
    output.truncate()
    terminal = not reserved and all(value == "terminal" for value in imported.values())
    if terminal and acknowledge:
        module["acknowledge_scheduled"](store, project, receipt, **helpers)
    return terminal, reserved


def recover_scheduled_publication(audits, project, receipt=None, proposal=None, output=None, *,
                                  options=None, degraded=False, reviewed_at=None, review_state=None):
    """Recover broker work, then make the comparison and review cutoff durable."""
    try:
        module = review_helper("kaizen_friction_prepare.py")
    except FileNotFoundError:
        return False
    if "scheduled_publication" not in module:
        return False
    host = review_helper("kaizen_friction_actions.py")
    store = host["HostActions"](audits, backup_root(), action_project, key)
    name = "publication-" + project.key + ".json"
    limit = 1 << 20
    if receipt is not None:
        with review_output(output) as stream:
            stream.flush()
            stream.seek(0)
            raw = stream.buffer.read(limit + 1)
            if len(raw) > limit:
                raise ValueError("review output too large")
        marker = dict(v=1, audits=str(audits), reviewed_at=reviewed_at or timestamp(now()),
                      generation=receipt["generation"], proposal=proposal.name, sha256=hashlib.sha256(raw).hexdigest())
        with host["_directory"](store.friction, True, private=True) as directory:
            host["_replace"](directory, name, module["_encode"](marker))
        return False

    def ready():
        if not os.path.lexists(store.path):
            return True
        pending_before = any(row.get("pending") for row in store.scoped(project.canonical))
        try:
            if pending_before:
                if degraded:
                    recover_scheduled_suggestions(store, host, project.canonical, proposal_only=True)
                elif options is not None:
                    run_scheduled_broker(audits, project, options)
        except (OSError, RuntimeError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
            log("friction: broker recovery remains pending")
            return False
        return not (degraded and pending_before) and not any(
            row.get("pending") for row in store.scoped(project.canonical))

    broker_ready = not project.unknown and ready()
    with contextlib.ExitStack() as stack:
        try:
            directory = stack.enter_context(host["_directory"](store.friction, private=True))
            marker = module["_json"](host["_read"](directory, name, limit), host)
        except FileNotFoundError:
            return False
        generation, filename = marker.get("generation"), marker.get("proposal")
        if (not isinstance(generation, str) or not re.fullmatch(r"[0-9]{20}", generation)
                or not isinstance(filename, str) or not re.fullmatch(r"cycle-[0-9-]+\.md", filename)):
            raise ValueError("invalid publication marker")
        if marker.get("audits", str(audits)) != str(audits):
            return None  # Preserve the generation owned by another audit root.
        frozen = module["_json"](host["_read"](directory, "receipt-" + project.key + "-" + generation + ".json",
                                              limit), host)
        if (frozen.get("channel") != "scheduled" or frozen.get("project") != str(project.canonical)
                or frozen.get("generation") != generation
                or not hmac.compare_digest(frozen.get("signature", ""), module["_signature"](frozen, store._secret()))):
            raise ValueError("invalid publication receipt")
        if Path(frozen["identities"]["extract"]["path"]).parent.parent != audits:
            return None
        if project.unknown:
            raise ValueError("cannot recover publication with unknown project scope")
        if "reviewed_at" in marker:
            if not isinstance(marker["reviewed_at"], str):
                raise ValueError("invalid evidence time")
            cutoff = module["_stamp"](marker["reviewed_at"])
        else:
            cutoff = datetime.fromtimestamp(os.stat(name, dir_fd=directory, follow_symlinks=False).st_mtime, timezone.utc)
        if not broker_ready:
            return False
        published = project.folder / filename
        if not published.exists():
            os.unlink(name, dir_fd=directory)
            os.fsync(directory)
            return False
        if module.get("RUNNER_API") == 2:
            module["acknowledge_scheduled"](store, project, frozen, host, proposal=published, digest=marker.get("sha256"))
        else:
            # The legacy helper only acknowledges the current generation.
            state_raw = host["_read"](directory, "prepare-" + project.key + ".json", limit)
            state = module["_json"](state_raw, host)
            if (state.get("project") != str(project.canonical) or type(state.get("generation")) is not int
                    or state["generation"] <= int(generation)):
                _, identity = module["_read"](published, host)
                if identity["sha256"] != marker.get("sha256"):
                    warnings.warn("published review changed before acknowledgement; preserving the edited report")
                module["acknowledge_scheduled"](store, project, frozen)

        # The in-flight review may have started with a model-writable audit root.
        state = read_state(project) if review_state is None else review_state.copy()
        previous = parse_time(state.get("reviewed_at"))
        if previous is None or previous <= cutoff:
            for field in ("ledger_errors", "last_error", "last_error_at"):
                state.pop(field, None)
            state.update(reviewed_at=timestamp(cutoff), status="ok",
                         report=frozen["identities"]["report"]["path"], proposal=str(published))
        write_state(project, state, durable=True)
        os.unlink(name, dir_fd=directory)
        os.fsync(directory)
        return published

def friction_reconcile_command(args):
    try:
        canonical = action_project(args.project_dir)
        (project,), _ = discover(None, None, {}, [canonical])
        module = runpy.run_path(str(HERE / "kaizen_friction_prepare.py"))
        module["reconcile"](audits_dir(), backup_root(), project, args.inputs,
                            effective(project.canonical), now(), action_project, key,
                            actions=getattr(args, "file", None))
        return 0
    except (OSError, RuntimeError, ValueError, RecursionError, KeyError, TypeError, AttributeError):
        print("friction: reconciliation refused; preparation or successful import is unavailable or changed",
              file=sys.stderr)
        return 2


def friction_prepare_command(args):
    if args.action == "acknowledge":
        return friction_reconcile_command(args)
    scope_error = ()
    try:
        canonical = action_project(args.project_dir)
        (project,), _ = discover(None, None, {}, [canonical])
        cfg = effective(project.canonical)
        scope_error = review_helper("kaizen_friction_prepare.py").get("IncompleteAuditScope", ())
        path = friction_prepare(audits_dir(), project, args.report, None, cfg,
                                "propose-only", now, interactive=True)
        if path is not None:
            print(path)
        return 0
    except scope_error as error:
        print(f"friction: preparation refused. {error}", file=sys.stderr)
        return 2
    except (OSError, RuntimeError, ValueError, RecursionError, KeyError, TypeError, AttributeError):
        print("friction: preparation refused; local evidence or private state is invalid or unavailable",
              file=sys.stderr)
        return 2


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    friction = commands.add_parser("friction", help="prepare scoped friction evidence")
    friction_commands = friction.add_subparsers(dest="action", required=True)
    prepare = friction_commands.add_parser("prepare", help="prepare bounded friction inputs")
    prepare.add_argument("--for", dest="project_dir", type=Path, required=True)
    prepare.add_argument("--report", type=Path, help="use this scoped token-audit report")
    acknowledge = friction_commands.add_parser("acknowledge", help="acknowledge successfully imported interactive inputs")
    acknowledge.add_argument("inputs", type=Path)
    acknowledge.add_argument("--for", dest="project_dir", type=Path, required=True)
    config = commands.add_parser("config", help="show or set scheduled settings")
    actions = config.add_subparsers(dest="action", required=True)
    for action in ("show", "set"):
        subparser = actions.add_parser(action, help=action + " scheduled settings")
        subparser.add_argument("--for", dest="project_dir", type=Path, help="project directory")
        if action == "set":
            subparser.add_argument("assignments", metavar="KEY=VALUE", nargs="+")
    checks = commands.add_parser("checks", help="locate or record completed checks")
    check_actions = checks.add_subparsers(dest="action", required=True)
    for action in ("path", "record"):
        subparser = check_actions.add_parser(action, help=action + " check state")
        subparser.add_argument("--for", dest="project_dir", type=Path, required=True)
        if action == "record":
            subparser.add_argument("name", choices=("models", "roster", "whats-new"))
            # Local date, matching experiment-check and the dates people write in the ledger.
            subparser.add_argument("--date", default=datetime.now().date().isoformat())
    host = commands.add_parser("actions", help="track machine-local host actions")
    host_commands = host.add_subparsers(dest="action", required=True)
    importer = host_commands.add_parser("import", help="import bounded interactive suggestions")
    importer.add_argument("file", type=Path)
    importer.add_argument("--for", dest="project_dir", type=Path, required=True)
    importer.add_argument("--inputs", type=Path, required=True)
    for action in ("list", "done", "dismiss", "reopen", "verify", "undo"):
        subparser = host_commands.add_parser(action)
        subparser.add_argument("--for", dest="project_dir", type=Path, required=True)
        if action == "list":
            subparser.add_argument("--json", action="store_true")
        elif action != "verify":
            subparser.add_argument("id")
    cleanup = commands.add_parser("housekeep", help="delete expired generated audit files")
    cleanup.add_argument("--dry-run", action="store_true", help="preview deletions")
    cleanup.add_argument("--audits", type=Path, help="override the audits folder")
    audit = commands.add_parser("audit", help="run the global token audit")
    commands.add_parser("auto-audit", help="run the global token audit if due at session start")
    review = commands.add_parser("review", help="audit and review due projects")
    review.add_argument("--json", action="store_true", help="with --dry-run, list project autonomy and sources as JSON")
    review.add_argument("--dry-run", action="store_true", help="preview without tokens or writes")
    review.add_argument("--propose-only", action="store_true", help="force the restricted propose-only cycle mode")
    review.add_argument("--force", action="store_true", help="skip the activity gate for selected --project-dir projects")
    review.add_argument("--project-dir", type=Path, action="append", help="use only these project directories")
    review.add_argument("--now", help="review time in ISO format with UTC offset")
    for scheduled in (audit, review):
        scheduled.add_argument("--audits", type=Path, help="override the audits folder")
        scheduled.add_argument("--python", help="Python interpreter (default: current interpreter)")
        scheduled.add_argument("--token-audit", type=Path, help="override the token-audit script")
        scheduled.add_argument("--pricing", type=Path, help="override the pricing file")
    review.add_argument("--claude", help="Claude executable (default: claude on PATH)")
    review.add_argument("--model", default=os.environ.get("KAIZEN_REVIEW_MODEL") or "sonnet")
    review.add_argument("--max-turns", type=int, default=os.environ.get("KAIZEN_REVIEW_MAX_TURNS") or "40")
    args = parser.parse_args(argv)
    if args.command == "review" and args.json and not args.dry_run:
        parser.error("--json requires --dry-run")
    global LOG_TO_STDERR
    LOG_TO_STDERR = getattr(args, "json", False)
    if args.command == "friction":
        return friction_prepare_command(args)
    if args.command == "actions":
        return actions_command(args)
    if args.command == "auto-audit":
        try:
            run_auto_audit(args)
        except Terminated as error:
            return 128 + error.number
        except (OSError, ValueError) as error:
            print(f"kaizen-scheduled: {error}", file=sys.stderr)
            return 2
        return 0
    if args.command == "checks":
        project = canonical_project(args.project_dir)
        if not (project / "docs/kaizen").is_dir():
            parser.error(f"{args.project_dir} must contain docs/kaizen/")
        path = Project(project, []).folder / "checks.json"
        if args.action == "path":
            print(path)
            return 0
        try:
            if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", args.date):
                raise ValueError("expected YYYY-MM-DD")
            day = datetime.strptime(args.date, "%Y-%m-%d").date()
            if day > datetime.now().date():
                raise ValueError("date cannot be in the future")
            with config_lock(path):
                try:
                    raw = path.read_bytes()
                    state = json.loads(raw.decode("utf-8"))
                except FileNotFoundError:
                    raw, state = None, {}
                except (ValueError, UnicodeError) as error:
                    raise ValueError(f"{path} is invalid; fix or remove it") from error
                if not isinstance(state, dict):
                    raise ValueError(f"{path} is not an object; fix or remove it")
                if raw is not None:
                    shutil.copy2(path, str(path) + ".bak")
                write_config(path, {args.name: args.date})
        except (OSError, ValueError) as error:
            print(f"kaizen-scheduled: {error}", file=sys.stderr)
            return 2
        print(f"recorded {args.name} {args.date} in {path}")
        return 0
    if args.command == "housekeep":
        audits = (args.audits if args.audits is not None else audits_dir()).expanduser().resolve()
        if args.dry_run or not audits.is_dir():
            housekeep(audits, effective(), args.dry_run)
            return 0
        with run_lock(audits) as held:
            if held:
                housekeep(audits, effective())
        return 0
    if args.command in ("audit", "review"):
        if args.command == "review":
            try:
                load_config(global_config_path(), strict=True)
            except ValueError as error:
                print(f"kaizen-scheduled: {error}", file=sys.stderr)
                return 2
        if not getattr(args, "json", False) and effective()["enabled"]["value"] is False:
            log("skipped: disabled")
            return 0
        fixed = None
        if args.command == "review":
            fixed = parse_time(args.now) if args.now is not None else None
            if args.now is not None and fixed is None:
                parser.error("--now must be an ISO timestamp with UTC offset")
            if args.max_turns < 1:
                parser.error("--max-turns must be positive")
        try:
            options = command_options(args)
            audits = (args.audits if args.audits is not None else audits_dir()).expanduser().resolve()
            if args.command == "review" and args.dry_run:
                review_dry_run(audits, args.project_dir, now(fixed), options, args.json)
                return 0
            with terminating_on_signals(), run_lock(audits, watchdog=args.command == "review") as held:
                if not held:
                    return 0
                rotate_log(audits)
                if args.command == "audit":
                    return run_audit(audits, options)
                return run_review(audits, args.project_dir, options, lambda: now(fixed))
        except Terminated as error:
            return 128 + error.number
        except (OSError, ValueError) as error:
            print(f"kaizen-scheduled: {error}", file=sys.stderr)
            return 2
    if args.action == "set":
        updates = {}
        for assignment in args.assignments:
            name, separator, value = assignment.partition("=")
            if not separator or name not in DEFAULTS:
                parser.error(f"unknown setting or invalid assignment: {assignment}")
            spec = SCHEMA[name]
            if spec.get("global_only", False) and args.project_dir is not None:
                parser.error(f"{name} is global-only")
            if spec.get("project_only", False) and args.project_dir is None:
                parser.error(f"{name} is project-only")
            kind = spec["kind"]
            if kind == "bool":
                if value not in ("true", "false"):
                    parser.error(f"invalid value for {name}: {value}; use true or false")
                value = value == "true"
            elif kind in ("int", "object", "paths", "strings"):
                try:
                    value = int(value) if kind == "int" else json.loads(value)
                except ValueError:
                    parser.error(f"invalid value for {name}: {value}")
            if not valid_value(name, value):
                parser.error(f"invalid value for {name}: {value}")
            updates[name] = value
        path = global_config_path()
        note = None
        if args.project_dir is not None:
            # Runs use the canonical project, not the directory named here: a monorepo root, a main
            # worktree, or a nested project. Opt-in and the config file must be that project's.
            canonical = canonical_project(args.project_dir)
            path = project_config_path(canonical)
            if not path.parent.is_dir():
                parser.error(f"{args.project_dir} must contain docs/kaizen/")
            if canonical != Path(args.project_dir).expanduser().resolve():
                if updates.get("scheduledAutonomy") == "auto":
                    print(f"kaizen-scheduled: {args.project_dir} is not the project runs use ({canonical}); "
                          f"to opt that project in run: kaizen-scheduled config set --for "
                          f"{shlex.quote(str(canonical))} scheduledAutonomy=auto", file=sys.stderr)
                    return 2
                note = f"kaizen-scheduled: {args.project_dir} is not the project runs use; wrote to {path}"
            if "scheduledAutonomy" in updates:
                # Project auto only takes effect for projects listed in the global autoProjects.
                try:
                    update_auto_projects(canonical, updates["scheduledAutonomy"] == "auto")
                except ValueError as error:
                    print(f"kaizen-scheduled: {error}", file=sys.stderr)
                    return 2
        if args.project_dir is None:
            with config_lock(path):  # the global file is also edited by `config set --for`
                write_config(path, updates)
        else:
            write_config(path, updates)
        if note:
            print(note, file=sys.stderr)
    show_config(args.project_dir)
    return 0


if __name__ == "__main__":
    sys.exit(main())
