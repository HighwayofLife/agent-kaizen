#!/usr/bin/env python3
"""Collect bounded, read-only host facts in a private local report."""
import argparse
import csv
from datetime import datetime, timezone
import fnmatch
from functools import partial
import io
import json
import math
import os
import re
import runpy
from pathlib import Path
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import threading
import time
import uuid

try:
    import resource
except ImportError:
    resource = None

HERE = Path(__file__).resolve().parent
LIMIT = 1024 * 1024
STATUS_CONFIG = {
    'core.attributesfile', 'core.autocrlf', 'core.checkroundtripencoding', 'core.checkstat',
    'core.eol', 'core.excludesfile', 'core.filemode', 'core.ignorecase', 'core.precomposeunicode',
    'core.safecrlf',
    'core.sparsecheckout', 'core.sparsecheckoutcone', 'core.symlinks', 'core.trustctime',
    'extensions.objectformat', 'extensions.refstorage', 'index.sparse',
}
SIZE_PARENT_FDS = 24


def sibling(*names):
    for name in names:
        path = HERE / name
        if path.is_file():
            return path
    return HERE / names[-1]


def open_directory(path, create=False):
    """Walk from the filesystem root without following any path component."""
    path = Path(path).absolute()
    fd = os.open(path.anchor, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for component in path.parts[1:]:
            if create:
                try:
                    os.mkdir(component, 0o700, dir_fd=fd)
                except FileExistsError:
                    pass
            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = child
        return fd
    except BaseException:
        os.close(fd)
        raise


def index_stamp(path):
    try:
        info = path.stat()
    except FileNotFoundError:
        return None
    return info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns


class Probe:
    def __init__(self, project, platform, proc, catalog):
        self.project, self.platform, self.proc = project, platform, proc
        self.deadline = time.monotonic() + 30
        self.warnings = []
        self.catalog = {}
        try:
            with catalog.open('rb') as stream:
                data = json.loads(stream.read(LIMIT + 1))
            if (not isinstance(data, dict) or not isinstance(data.get('actions'), list)
                    or not isinstance(data.get('processes'), dict)
                    or not isinstance(data.get('cloud_sync_names'), list)):
                raise ValueError('invalid catalogue')
            self.catalog = data
        except (OSError, ValueError, UnicodeError):
            self.warn('catalogue')

    def warn(self, category):
        if category not in self.warnings:
            self.warnings.append(category)

    def remaining(self, check):
        left = self.deadline - time.monotonic()
        if left <= 0:
            self.warn('budget')
        return left

    def command(self, argv, *, index_records=False):
        left = self.remaining(argv[0])
        if left <= 0:
            return None
        try:
            process = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                       start_new_session=(os.name == 'posix'),
                                       env=dict({k: v for k, v in os.environ.items() if not k.startswith('GIT_')},
                                                GIT_OPTIONAL_LOCKS='0', GIT_CONFIG_NOSYSTEM='1',
                                                GIT_CONFIG_GLOBAL=os.devnull, GIT_TERMINAL_PROMPT='0',
                                                GIT_ALLOW_PROTOCOL='', GIT_NO_LAZY_FETCH='1'))
            buffers = [bytearray(), bytearray()]
            overflow = [False, False]

            def drain(stream, index):
                tail = b''
                with stream:
                    while True:
                        chunk = stream.read(65536)
                        if not chunk:
                            overflow[index] |= bool(tail)
                            break
                        if index_records and index == 0:
                            *rows, tail = (tail + chunk).split(b'\0')
                            if len(tail) > LIMIT:
                                overflow[index] = True
                                break
                            # Keep only gitlinks and index flags that can hide modifications.
                            chunk = b''.join(row + b'\0' for row in rows if
                                             row[:1].islower() or row[:2] == b'S ' or
                                             row[2:9] == b'160000 ')
                        room = max(0, LIMIT - len(buffers[index]))
                        buffers[index].extend(chunk[:room])
                        overflow[index] |= len(chunk) > room

            threads = [threading.Thread(target=drain, args=(stream, i), daemon=True)
                       for i, stream in enumerate((process.stdout, process.stderr))]
            for thread in threads:
                thread.start()
            timed_out = False
            try:
                process.wait(timeout=min(5, left))
            except subprocess.TimeoutExpired:
                timed_out = True
                self.warn('timeout')
            finally:
                if os.name == 'posix':
                    for sig in (signal.SIGTERM, signal.SIGKILL):
                        try:
                            os.killpg(process.pid, sig)
                        except ProcessLookupError:
                            pass
                        if sig == signal.SIGTERM:
                            for thread in threads:
                                thread.join(timeout=max(0, min(0.05, self.deadline - time.monotonic())))
                elif process.poll() is None:
                    process.kill()
                process.wait()
                for thread in threads:
                    thread.join(timeout=max(0, min(0.05, self.deadline - time.monotonic())))
            if timed_out:
                return None
            if any(overflow) or any(thread.is_alive() for thread in threads):
                self.warn('command_output')
                return None
            if process.returncode == 1 and 'merge-base' in argv:
                return '\0'
            if process.returncode == 1 and 'check-ignore' in argv:
                return ''
            if process.returncode:
                self.warn('command_failed')
                return None
            output = bytes(buffers[0])
            return os.fsdecode(output) if index_records else output.decode('utf-8', errors='replace')
        except OSError:
            self.warn('command_unavailable')
            return None

    def processes(self):
        self.busy_categories = set()
        output = self.command(['tasklist', '/fo', 'csv', '/nh'] if self.platform == 'windows'
                              else ['ps', '-A', '-o', 'pcpu=,comm='])
        if output is None:
            return None
        self.busy_names = set()
        if self.platform == 'windows':
            names = [row[0] for row in csv.reader(io.StringIO(output)) if row][:10000]
        else:
            rows = []
            for line in output.splitlines()[:10000]:
                try:
                    cpu, name = line.strip().split(None, 1)
                    cpu = float(cpu)
                    if math.isfinite(cpu) and cpu >= 0:
                        rows.append((cpu, os.path.basename(name).lower()))
                except ValueError:
                    continue
            names = [name for _, name in rows]
            self.busy_names = {name for cpu, name in sorted(rows, reverse=True)[:10] if cpu > 0}
        names = [os.path.basename(name.strip()).lower().removesuffix('.exe') for name in names]
        result = {}
        for category, spec in self.catalog.get('processes', {}).items():
            if not isinstance(spec, dict) or not isinstance(spec.get('names'), list):
                self.warn('catalogue')
                continue
            if self.platform not in spec.get('os', []) and 'any' not in spec.get('os', []):
                continue
            patterns = [p.lower() for p in spec['names'] if isinstance(p, str)]
            hits = sum(any(fnmatch.fnmatchcase(name, p) for p in patterns) for name in names)
            result[category] = {'count': hits, 'informational': bool(spec.get('informational'))}
            if any(fnmatch.fnmatchcase(name, p) for name in self.busy_names for p in patterns):
                self.busy_categories.add(category)
        return result

    def read_proc(self, relative):
        if self.remaining('proc') <= 0:
            return None
        try:
            with (self.proc / relative).open() as stream:
                value = int(stream.read(4096).strip())
            if value < 0:
                raise ValueError('negative')
            return value
        except (OSError, ValueError):
            self.warn('proc_unavailable')
            return None

    def git(self, root, *args):
        if args and args[0] == 'status':
            return self.status(Path(root), args)
        return self.command(['git', '-c', 'core.fsmonitor=false', '-C', str(root), *args])

    def status(self, root, args, config=None, *, with_index=False):
        # Give status a private Git directory with only allowlisted configuration.
        # Git must not read live config or recurse into a submodule's live config.
        if config is None:
            config = self.git(root, 'config', '--null', '--list')
        if config is None:
            return None
        options = {}
        for entry in config.split('\0'):
            key, separator, value = entry.partition('\n')
            key = key.lower()
            if re.fullmatch(r'filter\..+\.(clean|process|required)', key):
                # Raw contents cannot establish cleanliness when a filter is configured.
                self.warn('unsafe_git_filter')
                return None
            if key in STATUS_CONFIG:
                options[key] = value if separator else 'true'
        layout = self.git(root, 'rev-parse', '--absolute-git-dir', '--git-common-dir')
        if layout is None or len(layout.splitlines()) != 2:
            return None
        admin, common = (root / path for path in layout.splitlines())
        try:
            try:
                scratch = tempfile.TemporaryDirectory(prefix='kaizen-status-')
            except OSError:
                if with_index:
                    return self.read_only_status(root, admin, common, args, options)
                raise
            with scratch as temporary:
                shadow = Path(temporary)
                config_text = '[core]\nrepositoryFormatVersion = 1\nfsmonitor = false\n'
                for key, value in options.items():
                    section, name = key.split('.')
                    value = value.replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n')
                    config_text += f'[{section}]\n{name} = "{value}"\n'
                (shadow / 'config').write_text(config_text, encoding='utf-8')
                (shadow / 'HEAD').write_text(self.pointer(admin / 'HEAD') + '\n', encoding='utf-8')
                for source, names in ((admin, ('index',)), (common, (
                        'objects', 'refs', 'packed-refs', 'reftable', 'info'))):
                    for name in names:
                        (shadow / name).symlink_to(source / name)
                # Split-index and sparse-checkout metadata carry no executable config.
                for name in admin.glob('sharedindex.*'):
                    if self.remaining('status') <= 0:
                        return None
                    (shadow / name.name).symlink_to(name)
                if admin != common:
                    (shadow / 'info').unlink()
                    (shadow / 'info').mkdir()
                    for source, name in ((common, 'exclude'), (common, 'attributes'), (admin, 'sparse-checkout')):
                        (shadow / 'info' / name).symlink_to(source / 'info' / name)
                git = ['git', '-C', str(root), f'--git-dir={shadow}', f'--work-tree={root}']
                before = index_stamp(admin / 'index') if with_index else None
                status = self.command([*git, *args, '--ignore-submodules=dirty'])
                if status is None or not with_index:
                    return status
                # Check flags after status, and reject changes across both reads.
                index = self.command([*git, 'ls-files', '-v', '--stage', '-z'], index_records=True)
                if index_stamp(admin / 'index') != before:
                    self.warn('index_changed')
                    return None
                return (status, index) if index is not None else None
        except (OSError, ValueError):
            self.warn('command_unavailable')
            return None

    def read_only_status(self, root, admin, common, args, options):
        # Reuse the installed config-isolated Git directory when scratch creation
        # fails. Read untracked and ignored paths separately so Git still uses
        # the live repo's info/exclude without exposing its config to status.
        helper = runpy.run_path(str(HERE / 'kaizen_worktree_facts.py'))
        run = partial(helper['git'], shutil.which('git'), deadline=self.deadline)
        config = [(os.fsencode(key), os.fsencode(value)) for key, value in options.items()]
        before = index_stamp(admin / 'index')

        def tracked_status(isolated_git, checkout):
            return isolated_git(checkout, 'status', '--porcelain=v1', '-z', '--untracked-files=no')

        result = helper['readonly_status'](run, tracked_status, root, admin, common, config)
        if result is None or result[0]:
            self.warn('command_unavailable')
            return None
        others = ['ls-files', '--others', '--exclude-standard', '--directory', '-z']
        untracked = self.git(root, *others, '--no-empty-directory')
        ignored = self.git(root, *others, '--ignored') if '--ignored=matching' in args else ''
        index = self.command(['git', '-c', 'core.fsmonitor=false', '-C', str(root),
                              'ls-files', '-v', '--stage', '-z'], index_records=True)
        if index_stamp(admin / 'index') != before:
            self.warn('index_changed')
            return None
        if untracked is None or ignored is None or index is None:
            return None
        return bool(result[1] or untracked or ignored), index

    def clean(self, root, depth=0):
        config = self.git(root, 'config', '--null', '--list')
        modules = self.git(root, 'config', '--null', '--file', '.gitmodules', '--list') if (root / '.gitmodules').exists() else ''
        if config is None or modules is None:
            return None
        if any(re.fullmatch(r'(?:diff\.ignoresubmodules|submodule\..*\.ignore)\n'
                            r'(?:untracked|dirty|all)', entry, re.I)
               for entry in (config + modules).split('\0')):
            return None
        args = ('status', '--porcelain=v1', '-z', '--untracked-files=all')
        if not depth:
            args += ('--ignored=matching',)
        evidence = self.status(root, args, config, with_index=True)
        if evidence is None:
            return None
        status, index = evidence
        dirty = bool(status)
        for entry in filter(None, index.split('\0')):
            if entry[0].islower() or entry[0] == 'S':
                return None
            meta, _, relative = entry.partition('\t')
            if not meta.endswith(' 0'):
                continue
            child = root / relative
            try:
                if root not in child.parents or child.resolve() != child:
                    return None
            except (OSError, RuntimeError):
                return None
            if not os.path.lexists(child / '.git'):
                continue
            if depth >= 32 or self.git(child, 'rev-parse', '--show-toplevel') != str(child) + '\n':
                return None
            clean = self.clean(child, depth + 1)
            if clean is None:
                return None
            dirty |= not clean
        return not dirty

    def pointer(self, path):
        if self.remaining('pointer') <= 0:
            raise ValueError('budget')
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
        with os.fdopen(fd, 'rb') as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                raise ValueError('not a regular pointer')
            data = stream.read(4097)
        if len(data) > 4096 or self.remaining('pointer') <= 0:
            raise ValueError('invalid pointer')
        return data.decode('utf-8').strip()

    def worktrees(self):
        output = self.git(self.project, 'worktree', 'list', '--porcelain', '-z')
        if not output or not output.endswith('\0\0'):
            self.warn('worktrees_unavailable')
            return None
        blocks = output.split('\0\0')[:-1]
        if len(blocks) > 256:
            self.warn('worktrees_limit')
            return None
        common = self.git(self.project, 'rev-parse', '--git-common-dir')
        try:
            common_path = Path(common.strip())
            common_stat = (self.project / common_path).stat()
        except (AttributeError, OSError):
            self.warn('worktrees_unavailable')
            return None
        trees = []
        admin_ids = set()
        for index, block in enumerate(blocks):
            fields = {}
            for field in block.split('\0'):
                key, _, value = field.partition(' ')
                if key in fields or key not in ('worktree', 'HEAD', 'branch', 'bare', 'detached', 'locked', 'prunable'):
                    self.warn('worktrees_unavailable')
                    return None
                fields[key] = value
            if not fields.get('worktree') or 'bare' in fields:
                self.warn('worktrees_unavailable')
                return None
            path = Path(fields['worktree']).resolve()
            live_common = self.git(path, 'rev-parse', '--git-common-dir')
            top = self.git(path, 'rev-parse', '--show-toplevel')
            try:
                live_stat = (path / live_common.strip()).stat()
                valid = ((live_stat.st_dev, live_stat.st_ino) == (common_stat.st_dev, common_stat.st_ino)
                         and Path(top.strip()).resolve() == path)
                if index:
                    gitfile = self.pointer(path / '.git')
                    if not gitfile.startswith('gitdir: '):
                        raise ValueError('invalid gitfile')
                    admin = (path / gitfile[8:]).resolve()
                    worktrees_dir = (self.project / common_path / 'worktrees').resolve()
                    admin_stat = admin.stat()
                    admin_id = (admin_stat.st_dev, admin_stat.st_ino)
                    backlink = Path(self.pointer(admin / 'gitdir'))
                    if not backlink.is_absolute():
                        backlink = admin / backlink
                    checkout_stat = path.stat()
                    back_stat = backlink.parent.stat()
                    valid = (valid and admin.parent == worktrees_dir and admin_id not in admin_ids
                             and backlink.name == '.git'
                             and (checkout_stat.st_dev, checkout_stat.st_ino) == (back_stat.st_dev, back_stat.st_ino))
                    admin_ids.add(admin_id)
            except (AttributeError, OSError, ValueError, UnicodeError):
                valid = False
            if not valid:
                self.warn('worktrees_unavailable')
                return None
            trees.append({'path': str(path), 'is_main': index == 0,
                          'branch': fields.get('branch'), 'head': fields.get('HEAD'),
                          'locked': 'locked' in fields, 'clean': None, 'merged': None,
                          'last_commit_age_days': None})
        for tree in trees[1:]:
            root = tree['path']
            tree['clean'] = self.clean(Path(root))
            head, primary = tree['head'], trees[0]['head']
            if (head and primary and re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', head)
                    and re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', primary)):
                ancestor = self.git(self.project, 'merge-base', '--is-ancestor', head, primary)
                if ancestor is not None:
                    tree['merged'] = ancestor != '\0'
            stamp = self.git(root, 'log', '-1', '--format=%ct')
            if stamp is not None and stamp.strip().isdigit():
                tree['last_commit_age_days'] = max(0, int((time.time() - int(stamp.strip())) // 86400))
        return trees

    def size(self, path):
        total, count, queued = 0, 0, 0
        parents, held = [], {}
        fd = None
        parent_limit = SIZE_PARENT_FDS
        if resource is not None:
            soft, _ = resource.getrlimit(resource.RLIMIT_NOFILE)
            if soft != resource.RLIM_INFINITY:
                # Leave room for stdio, traversal, and the descriptor used by scandir.
                parent_limit = min(parent_limit, max(2, soft - 8))

        def parent_fd(level):
            if level in held:
                return held[level]
            # Restore evicted descriptors through the nearest retained ancestor.
            anchor = max(i for i in held if i < level)
            previous = held[anchor]
            try:
                for index in range(anchor + 1, level + 1):
                    if self.remaining('size') <= 0:
                        raise OSError('directory scan timed out')
                    name, expected, _ = parents[index]
                    child = os.open(name, flags, dir_fd=previous)
                    if index - 1 not in held:
                        os.close(previous)
                    previous = child
                    if not os.path.samestat(expected, os.fstat(child)):
                        raise OSError('directory moved')
                    if index == level or level - index < parent_limit - len(held):
                        held[index] = child
                return previous
            finally:
                if previous not in held.values():
                    os.close(previous)

        def close_parent(level):
            if level in held:
                os.close(held.pop(level))

        try:
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
            fd = open_directory(path)
            name = None
            while True:
                if self.remaining('size') <= 0:
                    return None
                entries = []
                with os.scandir(fd) as scan:
                    for entry in scan:
                        count += 1
                        if count > 20000 or self.remaining('size') <= 0:
                            self.warn('directory_limit')
                            return None
                        entries.append(entry)
                names = {entry.name for entry in entries}
                if '.git' in names or {'HEAD', 'objects', 'refs'} <= names:
                    return None
                children = []
                for entry in entries:
                    if self.remaining('size') <= 0:
                        return None
                    if entry.is_dir(follow_symlinks=False):
                        children.append(entry.name)
                    elif entry.is_file(follow_symlinks=False):
                        total += entry.stat(follow_symlinks=False).st_size
                if children:
                    child_name = children.pop()
                    if children or queued:
                        if len(held) >= parent_limit:
                            # Thin the checkpoints while keeping the root.
                            for level in sorted(held)[1::2]:
                                close_parent(level)
                        parents.append((name, os.fstat(fd), children))
                        held[len(parents) - 1] = fd
                        fd = None
                        fd = os.open(child_name, flags, dir_fd=held[len(parents) - 1])
                    else:
                        child = os.open(child_name, flags, dir_fd=fd)
                        os.close(fd)
                        fd = child
                    queued += len(children)
                    name = child_name
                    continue
                if not parents:
                    break

                while parents:
                    if self.remaining('size') <= 0:
                        return None
                    level = len(parents) - 1
                    parent_name, _, siblings = parents[-1]
                    parent = parent_fd(level)
                    live = os.stat(name, dir_fd=parent, follow_symlinks=False)
                    if not os.path.samestat(os.fstat(fd), live):
                        raise OSError('directory moved')
                    os.close(fd)
                    fd = None
                    if siblings:
                        name = siblings.pop()
                        queued -= 1
                        fd = os.open(name, flags, dir_fd=parent)
                        break
                    name = parent_name
                    parents.pop()
                    fd = held.pop(level)
                else:
                    break
        except (OSError, AttributeError, NotImplementedError):
            self.warn('directory_unavailable')
            return None
        finally:
            if fd is not None:
                os.close(fd)
            for parent in held.values():
                os.close(parent)
        return total

    def directories(self, trees):
        results = []
        patterns = self.catalog.get('cloud_sync_names', [])
        roots = [Path(t['path']) for t in trees]
        if any(root == Path(root.anchor) or root == Path.home().resolve()
               or any(fnmatch.fnmatchcase(root.name, p) for p in patterns if isinstance(p, str))
               for root in roots):
            self.warn('sensitive_scope')
            return None
        if self.project not in roots:
            self.warn('ambiguous_scope')
            return None
        for root in roots:
            configured = []
            try:
                if os.open in os.supports_dir_fd:
                    parent = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
                    try:
                        for component in ('docs', 'kaizen'):
                            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
                            os.close(parent)
                            parent = child
                        fd = os.open('config.json', os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
                    finally:
                        os.close(parent)
                else:
                    config_path = root
                    for component in ('docs', 'kaizen', 'config.json'):
                        config_path = config_path / component
                        if stat.S_ISLNK(config_path.lstat().st_mode):
                            raise ValueError('symlink in config path')
                    fd = os.open(config_path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
                with os.fdopen(fd, 'rb') as stream:
                    if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                        raise ValueError('not a regular file')
                    data = stream.read(LIMIT + 1)
                if len(data) > LIMIT or self.remaining('config') <= 0:
                    raise ValueError('config limit')
                config = json.loads(data)
                configured = config.get('frictionOutputDirs', [])
                if not isinstance(configured, list) or len(configured) > 256:
                    raise ValueError('invalid output directories')
                if any(not isinstance(entry, str) for entry in configured):
                    self.warn('output_config')
                configured = [entry for entry in configured if isinstance(entry, str)]
            except FileNotFoundError:
                pass
            except (OSError, ValueError, AttributeError):
                self.warn('output_config')
                configured = []
            ignored_dirs = self.git(root, 'ls-files', '--others', '--ignored', '--exclude-standard',
                                    '--directory', '-z')
            if ignored_dirs is None:
                return None
            names = self.catalog.get('output_dir_names', [])
            candidates = [(entry[:-1], 'name') for entry in ignored_dirs.split('\0')
                          if entry.endswith('/') and Path(entry[:-1]).name in names]
            candidates += [(entry, 'config') for entry in configured]
            if len(candidates) > 256:
                self.warn('directory_limit')
                return None
            for relative, match in sorted(candidates):
                if (not isinstance(relative, str) or not relative or relative.startswith('/')
                        or re.match(r'^[A-Za-z]:', relative) or '\\' in relative or '\0' in relative
                        or any(p.lower() in ('', '.', '..', 'secrets', 'credentials', 'private') or p.startswith('.') and p != '.gradle'
                               for p in relative.split('/'))):
                    self.warn('output_config')
                    continue
                path = root / relative
                if any((root.joinpath(*relative.split('/')[:i])).is_symlink()
                       for i in range(1, len(relative.split('/')) + 1)) or not path.is_dir():
                    continue
                if any(path == other or path in other.parents for other in roots):
                    continue
                ignored = self.git(root, 'check-ignore', '--', relative + '/')
                tracked = self.git(root, 'ls-files', '-z', '--', ':(literal)' + relative)
                if ignored is None or tracked is None:
                    self.warn('directory_unavailable')
                    return None
                if not ignored or tracked:
                    continue
                size = self.size(path)
                if size is None:
                    self.warn('directory_incomplete')
                    return None
                if not any(path == Path(d['path']) or path in Path(d['path']).parents
                           or Path(d['path']) in path.parents for d in results):
                    marker = path / '.nomedia'
                    results.append({'path': str(path), 'worktree': str(root), 'size_bytes': size,
                                    'match': match, 'excluded': {'nomedia': marker.is_file() and not marker.is_symlink(),
                                    'noindex_ancestor': any(p.name.endswith('.noindex') for p in (path, *path.parents))}})
        return sorted(results, key=lambda d: (-d['size_bytes'], d['path']))

    def run(self):
        facts = {'cpu_count': os.cpu_count(), 'load': None, 'free_disk_bytes': None,
                 'free_disk_pct': None, 'cloud_roots': [], 'processes': None,
                 'inotify_max_user_watches': None, 'tracked_files': None}
        try:
            load = os.getloadavg()
            if all(math.isfinite(v) and v >= 0 for v in load):
                facts['load'] = list(load)
        except (AttributeError, OSError):
            self.warn('load_unavailable')
        try:
            disk = shutil.disk_usage(self.project)
            facts['free_disk_bytes'] = disk.free
            facts['free_disk_pct'] = 100 * disk.free / disk.total if disk.total else None
        except OSError:
            self.warn('disk_unavailable')
        patterns = [p for p in self.catalog.get('cloud_sync_names', []) if isinstance(p, str)]
        facts['cloud_roots'] = sorted({part for part in self.project.parts
                                       if any(fnmatch.fnmatchcase(part, p) for p in patterns)})[:100]
        facts['processes'] = self.processes()
        if self.platform == 'linux':
            facts['inotify_max_user_watches'] = self.read_proc('sys/fs/inotify/max_user_watches')
            output = self.command(['git', '-c', 'core.fsmonitor=false', '-C', str(self.project), 'ls-files', '-z'])
            if output is not None:
                facts['tracked_files'] = min(500000, output.count('\0'))
        else:
            self.warn('inotify_unavailable')
        trees = self.worktrees()
        directories = self.directories(trees) if trees is not None else None
        linked = [tree for tree in trees if not tree['is_main']] if trees is not None else None
        facts['worktree_count'] = len(linked) if linked is not None else None
        facts['prunable_worktrees'] = (sum(t['clean'] is True and t['merged'] is True and not t['locked'] for t in linked)
                                      if linked is not None and all(t['clean'] is not None and t['merged'] is not None for t in linked) else None)
        facts['stale_worktrees'] = (sum(t['last_commit_age_days'] > 14 and not (t['clean'] is True and t['merged'] is True and not t['locked']) for t in linked)
                                   if linked is not None and all(t['last_commit_age_days'] is not None and t['clean'] is not None and t['merged'] is not None for t in linked) else None)
        facts['regenerable_bytes'] = sum(d['size_bytes'] for d in directories) if directories is not None else None
        findings = []

        def add(detector, action_id, subject, evidence):
            for action in self.catalog.get('actions', []):
                if (isinstance(action, dict) and action.get('id') == action_id
                        and not action.get('needs_research')
                        and isinstance(action.get('detect'), dict)
                        and action['detect'].get('finding') == detector):
                    findings.append({'id': detector, 'catalog_id': action_id,
                                     'subject': subject, 'evidence': evidence})
                    break

        free, pct = facts['free_disk_bytes'], facts['free_disk_pct']
        if free is not None and (free < 20 * 1024**3 or (pct is not None and pct < 10)):
            add('low-disk', 'low-disk', 'project-volume', {'free_disk_bytes': free})
        for name in facts['cloud_roots']:
            add('cloud-paths', 'cloud-sync-repo', name, {'matched': 1})
        sprawl = ((facts['worktree_count'] is not None and facts['worktree_count'] > 8)
                  or (facts['regenerable_bytes'] is not None and facts['regenerable_bytes'] > 10 * 1024**3))
        if sprawl:
            for key, action in (('prunable_worktrees', 'worktree-prune'), ('stale_worktrees', 'worktree-stale')):
                if facts[key]:
                    add('sprawl', action, str(self.project), {key: facts[key]})
            for action in self.catalog.get('actions', []):
                detect = action.get('detect', {}) if isinstance(action, dict) else {}
                if (not isinstance(detect, dict) or detect.get('finding') != 'indexed-output'
                        or action.get('needs_research') or self.platform not in action.get('os', [])):
                    continue
                active = any(category in self.busy_categories and (facts['processes'] or {}).get(category, {}).get('count', 0)
                             and not (facts['processes'] or {}).get(category, {}).get('informational')
                             for category in detect.get('categories', []))
                if active:
                    for directory in (directories or [])[:50]:
                        if action['id'] == 'linux-localsearch' and directory['excluded']['nomedia']:
                            continue
                        path = Path(directory['path'])
                        if action['id'] == 'spotlight-output':
                            root = Path(directory['worktree'])
                            ancestors = (path, *path.parents)
                            excluded = directory['excluded']['noindex_ancestor'] or any(
                                (p / '.metadata_never_index').is_file()
                                and not (p / '.metadata_never_index').is_symlink()
                                for p in ancestors if p == root or root in p.parents)
                            directory['excluded']['spotlight'] = excluded
                            if excluded:
                                continue
                            volume = path
                            while not os.path.ismount(volume):
                                volume = volume.parent
                            state = self.command(['mdutil', '-s', str(volume)])
                            if state is None or not re.search(r'(?im)^\s*Indexing enabled\.\s*$', state):
                                if state is None or not re.search(r'(?im)^\s*Indexing disabled\.\s*$', state):
                                    self.warn('spotlight_unknown')
                                continue
                        if action['id'] == 'timemachine-output':
                            output = self.command(['tmutil', 'isexcluded', str(path)])
                            excluded = None
                            if output is not None:
                                if re.match(r'^\[Excluded\](?:\s|$)', output):
                                    excluded = True
                                elif re.match(r'^\[Included\](?:\s|$)', output):
                                    excluded = False
                            directory['excluded']['timemachine'] = excluded
                            if excluded is not False:
                                if excluded is None:
                                    self.warn('timemachine_unknown')
                                continue
                        add('indexed-output', action['id'], directory['path'], {'size_bytes': directory['size_bytes']})
        watches, tracked = facts['inotify_max_user_watches'], facts['tracked_files']
        if watches is not None and tracked is not None and watches < 2 * tracked:
            add('inotify', 'inotify-limit', 'inotify', {'watches': watches, 'tracked_files': tracked})
        return {'v': 1, 'project': str(self.project), 'generated_at': datetime.now(timezone.utc).isoformat(),
                'facts': facts, 'findings': findings, 'regenerable_dirs': directories or [], 'worktrees': trees or [],
                'warnings': self.warnings}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--project', required=True, type=Path)
    parser.add_argument('--out', required=True, type=Path)
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args(argv)
    if not args.project.is_dir():
        parser.error('--project must be an existing directory')
    out = args.out.absolute()
    try:
        out_fd = open_directory(out, create=True)
        try:
            platform = {'darwin': 'macos', 'linux': 'linux', 'win32': 'windows'}.get(sys.platform, 'unknown')
            report = Probe(args.project.resolve(), platform, Path('/proc'),
                           sibling('kaizen-friction-catalog.json', 'friction-catalog.json')).run()
            payload = json.dumps(report, indent=2, allow_nan=False) + '\n'
            destination = out / ('host-probe-' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ-') + uuid.uuid4().hex + '.json')
            temporary = '.host-probe-' + uuid.uuid4().hex
            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         0o600, dir_fd=out_fd)
            try:
                with os.fdopen(fd, 'w', encoding='utf-8') as stream:
                    stream.write(payload)
                os.link(temporary, destination.name, src_dir_fd=out_fd, dst_dir_fd=out_fd)
            finally:
                os.unlink(temporary, dir_fd=out_fd)
            check_fd = open_directory(out)
            try:
                pinned, current = os.fstat(out_fd), os.fstat(check_fd)
                if (pinned.st_dev, pinned.st_ino) != (current.st_dev, current.st_ino):
                    raise ValueError('output directory moved')
            finally:
                os.close(check_fd)
        finally:
            os.close(out_fd)
        if args.json:
            public = json.loads(payload)
            public['project'] = '[project]'
            public['facts']['cloud_roots'] = ['[cloud root]' for _ in public['facts']['cloud_roots']]
            for tree in public['worktrees']:
                tree['path'] = '[project]' if tree['path'] == str(args.project.resolve()) else '[worktree]'
                if tree['branch'] is not None:
                    tree['branch'] = '[branch]'
                tree.pop('head', None)
            for directory in public['regenerable_dirs']:
                directory['path'] = '[output]'
                directory['worktree'] = '[worktree]'
            for finding in public['findings']:
                if finding['id'] == 'cloud-paths' or os.path.isabs(finding['subject']):
                    finding['subject'] = '[path]'
            print(json.dumps(public, indent=2, allow_nan=False))
        else:
            print(destination)
        return 0
    except (OSError, ValueError) as exc:
        print('host-probe: output failed: {}'.format(type(exc).__name__), file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
