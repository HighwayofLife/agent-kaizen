#!/usr/bin/env python3
"""Prepare an evidence-backed exact Claude project allow rule."""
import argparse
from contextlib import ExitStack, contextmanager
import ctypes
from datetime import datetime, timedelta, timezone
import errno
from functools import lru_cache, partial
import hashlib
import hmac
import json
import os
from pathlib import Path
import re
import runpy
import stat
import sys

LITERALS = ("ls", "ls -a", "ls -l")
TARGET = Path(".claude/settings.local.json")
MAX_AGE = timedelta(days=7)
EXTRACT_LIMIT = 8 * 1024 * 1024
UNSAFE_EXTRACTS = "unsafe audit extract storage (mode 0700 required)"
SETTINGS_LIMIT = 1024 * 1024
HERE = Path(__file__).resolve().parent
WRITES_ENABLED = False  # S2 requires live Claude matching and scheduled boundary proof.
PENDING = "settings writes are disabled pending live Claude proof"
RECORD = re.compile(r"(?:direct_|fa1_)[0-9a-f]{64}")
STATE = "allow-rules.json"
WITNESS = "allow-rules.started"
OWNER_ATTR = "user.kaizen.allow-rule"


class Refused(Exception):
    pass


class Parser(argparse.ArgumentParser):
    def error(self, message):
        self.exit(2, "kaizen-allow-rule: invalid arguments. Use --help.\n")


@lru_cache(maxsize=None)
def helper(*names):
    if not all((HERE / name).is_file() for name in names):
        raise Refused("required companion script is missing")
    return runpy.run_path(str(HERE / names[0]))


def unique_object(pairs):
    value = dict(pairs)
    if len(value) != len(pairs):
        raise Refused("duplicate JSON field")
    return value


def v1(value):
    return isinstance(value, dict) and type(value.get("v")) is int and value["v"] == 1


def project_scope(directory, runner):
    path = runner["canonical_path"](Path(directory).expanduser())
    member = runner["enrolled_project"](path)
    if not path.is_dir() or member is None:
        raise Refused("an enrolled project directory is required")
    projects, _ = runner["discover"](None, None, {}, [member])
    if (len(projects) != 1 or projects[0].unknown
            or runner["checkout_root"](path) != runner["checkout_root"](member)
            or runner["git_common_dir"](path) != runner["git_common_dir"](member)):
        raise Refused("project scope is unknown")
    return projects[0]


@contextmanager
def extract_directory(path):
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_NONBLOCK
    path = path.absolute()
    if ".." in path.parts:
        raise ValueError("extract path traversal")
    check_acl = helper("kaizen_friction_actions.py")["_check_acl"]
    with ExitStack() as stack:
        fd = os.open(path.anchor, flags)
        stack.callback(os.close, fd)
        for part in path.parts:
            if part != path.anchor:
                fd = os.open(part, flags, dir_fd=fd)
                stack.callback(os.close, fd)
            info = os.fstat(fd)
            if (info.st_uid not in (0, os.geteuid())
                    or info.st_mode & 0o022 and not info.st_mode & stat.S_ISVTX):
                raise ValueError("unsafe extract ancestor")
            check_acl(fd, "extract directory")
        yield fd


def extract_bytes(directory, name, expected):
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
    with os.fdopen(fd, "rb") as stream:
        info = os.fstat(fd)
        if (version(info) != expected or not stat.S_ISREG(info.st_mode) or info.st_uid not in (0, os.geteuid())
                or info.st_nlink != 1 or info.st_mode & 0o022):
            raise ValueError("unsafe extract file")
        helper("kaizen_friction_actions.py")["_check_acl"](fd, "extract file")
        raw = stream.read(EXTRACT_LIMIT + 1)
        if (len(raw) > EXTRACT_LIMIT or version(info) != version(os.fstat(fd))
                or version(info) != version(os.stat(name, dir_fd=directory, follow_symlinks=False))):
            raise ValueError("extract changed during read or exceeds its limit")
    return raw


def find_extract(audits, project, now):
    """Select the latest scoped audit across both stores, with no fallback."""
    members = {str(path) for path in project.paths}
    cutoff = (now - MAX_AGE).timestamp()
    with ExitStack() as stack:
        candidates = []
        primary = audits / "extracts"
        for directory in (primary, audits / "projects" / project.key):
            try:
                fd = stack.enter_context(extract_directory(directory))
            except FileNotFoundError:
                continue
            except (OSError, ValueError):
                raise Refused(UNSAFE_EXTRACTS) from None
            store = os.fstat(fd)
            private = store.st_uid == os.geteuid() and stat.S_IMODE(store.st_mode) == 0o700
            # The legacy location also holds ordinary reports and may have no extracts.
            if directory == primary and not private:
                raise Refused(UNSAFE_EXTRACTS)
            with os.scandir(fd) as entries:
                for entry in entries:
                    if not entry.name.endswith(".extract.json"):
                        continue
                    info = entry.stat(follow_symlinks=False)
                    if cutoff <= info.st_mtime <= now.timestamp():
                        if not private:
                            raise Refused(UNSAFE_EXTRACTS)
                        candidates.append((info.st_mtime_ns, fd, entry.name, version(info), directory != primary))
                        if len(candidates) > 512:
                            raise Refused("too many recent audit extracts")
        latest, tied = None, False
        for stamp, fd, name, expected, scoped_store in sorted(candidates, reverse=True):
            modified = datetime.fromtimestamp(stamp / 1e9, timezone.utc)
            if latest is not None and modified < latest[0]:
                break
            try:
                raw = extract_bytes(fd, name, expected)
            except (OSError, ValueError):
                raise Refused("unsafe or changed audit extract") from None
            try:
                data = json.loads(raw)
            except (ValueError, RecursionError):
                if scoped_store:
                    raise Refused("invalid project audit extract") from None
                continue
            scope = data.get("scope") if isinstance(data, dict) else None
            roots = scope.get("cwd") if isinstance(scope, dict) else None
            if isinstance(roots, list) and roots and all(isinstance(root, str) and root in members for root in roots):
                audited = audit_time(data, modified) or modified
                if latest is None or audited > latest[0]:
                    latest, tied = (audited, modified, raw), False
                elif audited == latest[0]:
                    tied = True
    if latest is not None and not tied:
        return json.loads(latest[2], object_pairs_hook=unique_object), latest[1]
    raise Refused("no recent audit extract with an exact project cwd scope")


def audit_time(extract, modified):
    try:
        stamp = datetime.fromisoformat(extract["friction"]["audited_at"])
        if stamp.tzinfo is not None and stamp <= modified:
            return stamp
    except (KeyError, ValueError, TypeError):
        pass


def check_evidence(extract, stamp, literal, now):
    scope, friction = extract["scope"], extract.get("friction")
    roots = scope["cwd"]
    if (not v1(extract) or not v1(scope) or not v1(friction)
            or scope.get("project") is not None or scope.get("project_dirs") != []
            or len(set(roots)) != len(roots)):
        raise Refused("unsupported or filtered audit extract")
    since = datetime.fromisoformat(extract["since"])
    audited = audit_time(extract, stamp)
    if audited is None:
        raise Refused("run a fresh scoped audit with a bounded evidence window")
    if since.tzinfo is None or not now - MAX_AGE <= since <= audited <= now:
        raise Refused("audit evidence must start within the last seven days; run a fresh scoped audit with --days 6")
    summary = friction.get("summary")
    rows = friction.get("permission_acceptance")
    if not isinstance(summary, dict) or summary.get("capped") is not False or not isinstance(rows, list):
        raise Refused("permission evidence is incomplete")
    members = {hashlib.sha256(root.encode()).hexdigest() for root in roots}
    seen, accepted = set(), 0
    for row in rows:
        if not isinstance(row, dict):
            raise Refused("invalid permission evidence row")
        if row.get("literal") != literal:
            continue
        member = row.get("cwd_id")
        counts = [row.get(field) for field in ("accepted", "denied", "ambiguous")]
        if (not isinstance(member, str) or member not in members or member in seen
                or any(type(count) is not int or count < 0 for count in counts)):
            raise Refused("invalid or repeated permission evidence for this literal")
        seen.add(member)
        if counts[1:] == [0, 0]:
            accepted = max(accepted, counts[0])
    if accepted < 10:
        raise Refused("one scope member needs ten verified acceptances and zero denials or ambiguities")
    return accepted


def read_settings(raw):
    data = json.loads(raw, object_pairs_hook=unique_object) if raw is not None else {}
    permissions = data.get("permissions", {}) if isinstance(data, dict) else None
    if not isinstance(permissions, dict):
        raise Refused("expected a settings object with a permissions object")
    for field in ("allow", "ask", "deny"):
        entries = permissions.get(field, [])
        if not isinstance(entries, list) or any(not isinstance(entry, str) for entry in entries):
            raise Refused("permission rules must be lists of strings")
    return data, permissions


def load_permissions(target):
    if target.parent.is_symlink() or (target.parent.exists() and not target.parent.is_dir()):
        raise Refused("expected a real .claude directory")
    try:
        regular_bytes = helper("kaizen_worktree_facts.py")["regular_bytes"]
        raw = regular_bytes(target, SETTINGS_LIMIT)
    except FileNotFoundError:
        raw = None
    return read_settings(raw)[1]


def runner_for():
    helper("kaizen_worktree_facts.py")
    runner = helper("kaizen-scheduled", "kaizen_credentials.py")
    runner["discover"].__globals__["_git"] = partial(runner["_git"], trusted_path=True)
    return runner


def grant_rule(literal):
    if literal not in LITERALS:
        raise Refused("expected one exact command: ls, ls -a, or ls -l")
    return f"Bash({literal})"


def host_store(runner):
    actions = helper("kaizen_friction_actions.py")["HostActions"]
    return actions(runner["audits_dir"](), runner["backup_root"](), runner["action_project"], runner["key"])


def evidence(runner, project, literal, secret=None):
    now = datetime.now(timezone.utc)
    extract, stamp = find_extract(runner["audits_dir"](), project, now)
    signature = extract.pop("allow_rule_mac", None)
    payload = json.dumps(extract, sort_keys=True, separators=(",", ":")).encode("ascii")
    if secret is not None or signature is not None:
        if secret is None:
            secret = host_store(runner)._secret()
        # Only v2 counters attest that permissions came from verified transcripts.
        expected = hmac.digest(secret, b"allow-rule-extract-v2\0" + payload, "sha256").hex()
        if not isinstance(signature, str) or not signature.isascii() or not hmac.compare_digest(signature, expected):
            raise Refused("run a fresh scoped audit because audit extract authentication failed")
    accepted = check_evidence(extract, stamp, literal, now)
    expires = datetime.fromisoformat(extract["since"]) + MAX_AGE
    return accepted, [hashlib.sha256(payload).hexdigest(), expires.isoformat()]


def check_conflicts(permissions, rule):
    # Catch direct conflicts locally. Effective matching remains a live Claude gate.
    conflicts = {"Bash", "Bash(*)", "Bash(ls:*)", rule, rule[:-1] + ":*)"}
    for field in ("deny", "ask"):
        if conflicts.intersection(permissions.get(field, [])):
            raise Refused(f"conflicting local permissions.{field} rule")


def prepare_add(directory, literal):
    rule = grant_rule(literal)
    runner = runner_for()
    project = project_scope(directory, runner)
    accepted, _ = evidence(runner, project, literal)
    target = project.canonical / TARGET
    permissions = load_permissions(target)
    check_conflicts(permissions, rule)
    return dict(operation="add", project=project.canonical, target=target, rule=rule,
                accepted=accepted, present=rule in permissions.get("allow", []))


def json_bytes(value):
    return (json.dumps(value, allow_nan=False, indent=2) + "\n").encode("ascii")


def version(info):
    return [info.st_dev, info.st_ino, getattr(info, "st_birthtime", None),
            info.st_ctime_ns, info.st_mtime_ns, info.st_mode, info.st_size]


def linux_owner(fd):
    try:
        return os.getxattr(fd, OWNER_ATTR).hex()
    except OSError as error:
        if error.errno != errno.ENODATA:
            raise


def snapshot(directory, name=TARGET.name):
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
    except FileNotFoundError:
        return None, None
    try:
        return snapshot_fd(directory, name, fd)
    finally:
        os.close(fd)


def snapshot_fd(directory, name, fd):
    info = os.fstat(fd)
    if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.geteuid()
            or info.st_mode & 0o022):
        raise Refused("unsafe settings file")
    helper("kaizen_friction_actions.py")["_check_acl"](fd, "settings file")
    with os.fdopen(fd, "rb", closefd=False) as stream:
        stream.seek(0)
        raw = stream.read(SETTINGS_LIMIT + 1)
    stamp = version(info)
    if (len(raw) > SETTINGS_LIMIT or stamp != version(os.fstat(fd))
            or not same_version(directory, name, stamp)):
        raise Refused("settings file changed during read or exceeds its limit")
    if sys.platform == "linux":
        stamp[2] = linux_owner(fd)
    return raw, stamp


def same_version(directory, name, stamp):
    try:
        info = os.stat(name, dir_fd=directory, follow_symlinks=False)
    except FileNotFoundError:
        return stamp is None
    return stamp is not None and matches_version(info, stamp)


def matches_version(info, stamp):
    current = version(info)
    # Linux stores the fd's ownership xattr in the birthtime slot.
    return current[:2] == stamp[:2] and current[3:] == stamp[3:] and (
        sys.platform == "linux" or current[2] == stamp[2])


def effect_id(raw, stamp):
    return [stamp[:3], stamp[5], hashlib.sha256(raw).hexdigest(), stamp[4]] if stamp is not None else None


def preimage(raw, stamp):
    return [stamp, effect_id(raw, stamp)]


def stage(directory, name, raw, mode):
    fd = os.open(name, os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_RDWR, 0o600, dir_fd=directory)
    try:
        with os.fdopen(fd, "wb", closefd=False) as stream:
            if sys.platform == "linux":
                os.setxattr(fd, OWNER_ATTR, os.urandom(16))
            stream.write(raw)
            stream.flush()
            os.fchmod(fd, stat.S_IMODE(mode))
            os.fsync(fd)
        observed, stamp = snapshot_fd(directory, name, fd)
        if observed != raw or stat.S_IMODE(stamp[5]) != stat.S_IMODE(mode):
            raise Refused("staged settings changed")
        os.fsync(directory)
    except BaseException:
        try:
            if same_version(directory, name, version(os.fstat(fd))):
                os.unlink(name, dir_fd=directory)
        finally:
            os.close(fd)
        raise
    return fd, effect_id(raw, stamp)


def rename_effect(directory, source, target, *, exchange=False):
    # An exchange keeps the actual displaced inode, including a concurrent
    # editor's replacement. No-replace handles creation and moving a deletion
    # aside without clobbering any name that appeared after our checks.
    libc = ctypes.CDLL(None, use_errno=True)
    if sys.platform == "darwin":
        rename = getattr(libc, "renameatx_np", None)
        flags = 2 if exchange else 4  # RENAME_SWAP / RENAME_EXCL
    elif sys.platform == "linux":
        rename = getattr(libc, "renameat2", None)
        flags = 2 if exchange else 1  # RENAME_EXCHANGE / RENAME_NOREPLACE
    else:
        rename = None
    if rename is None:
        raise Refused("safe settings rename is unavailable")
    rename.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
    rename.restype = ctypes.c_int
    if rename(directory, os.fsencode(source), directory, os.fsencode(target), flags) != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))


def named_version(directory, name):
    try:
        return version(os.stat(name, dir_fd=directory, follow_symlinks=False))
    except FileNotFoundError:
        return None


def write_effect(directory, path, pending, open_dir, staged_fd, save):
    temporary = pending["temp"]
    expected = pending["before"]
    with open_dir(path) as live:
        if not os.path.samestat(os.fstat(directory), os.fstat(live)):
            raise Refused("settings directory changed before publication")
        if temporary:
            raw, staged_stamp = snapshot_fd(directory, temporary, staged_fd)
            if effect_id(raw, staged_stamp) != pending["after"]:
                raise Refused("staged write changed before publication")
        if (preimage(*snapshot(directory)) != expected
                or not same_version(directory, TARGET.name, expected[0])
                or (temporary and (not matches_version(os.fstat(staged_fd), staged_stamp)
                                   or not same_version(directory, temporary, staged_stamp)))):
            raise Refused("settings or staged write changed before publication")

        target = TARGET.name
        displaced = (temporary or pending["backup"]) if expected[0] is not None else None
        exchange = bool(temporary and displaced)
        if temporary:
            rename_effect(directory, temporary, target, exchange=exchange)
        else:
            rename_effect(directory, target, displaced)

        # No inode-conditional rename exists here. A last-instant staged swap
        # can be briefly visible, and a third writer can race rollback too.
        # Keep the displaced inode so an editor's bytes can be restored.
        published = named_version(directory, target)
        parked = named_version(directory, displaced) if displaced else None
        current = (None, None)
        try:
            if temporary and published is not None and os.path.samestat(
                    os.fstat(staged_fd), os.stat(target, dir_fd=directory, follow_symlinks=False)):
                current = snapshot_fd(directory, target, staged_fd)
            verified = (effect_id(*current) == pending["after"] if temporary else published is None)
            if verified and displaced:
                verified = effect_id(*snapshot(directory, displaced)) == expected[1]
        except (OSError, ValueError, Refused):
            verified = False
        if not verified:
            if (same_version(directory, target, published)
                    and (displaced is None or same_version(directory, displaced, parked))):
                if exchange:
                    rename_effect(directory, displaced, target, exchange=True)
                elif temporary and published is not None:
                    rename_effect(directory, target, temporary)
                elif published is None and parked is not None:
                    rename_effect(directory, displaced, target)
                os.fsync(directory)
            raise Refused("settings publication raced with an edit or staged replacement")
        os.fsync(directory)
        pending["published"] = preimage(*current)
        save()
        if displaced and same_version(directory, displaced, parked):
            os.unlink(displaced, dir_fd=directory)
            os.fsync(directory)


def live_writes():
    host = os.getenv("KAIZEN_HOST")
    return WRITES_ENABLED and (host == "claude" or (
        host is None and os.getenv("CLAUDECODE") == "1"
        and not (os.getenv("PLUGIN_ROOT") or os.getenv("COPILOT_PLUGIN_ROOT"))))


def broker_id(secret, project, literal, generation):
    # P24 can derive this from the canonical scope and authenticated extract digest.
    scope = json.dumps([literal, *(str(path) for path in project.paths), generation], separators=(",", ":"))
    return helper("kaizen_friction_actions.py")["_id"](secret, str(project.canonical), "allow-rule", scope)


def transact(directory, literal=None, *, record=None, action_id=None):
    """A broker passes its action ID only through this fixed internal entry point."""
    undo = record is not None
    if not live_writes():
        raise Refused(PENDING)
    if "KAIZEN_RUN_ID" in os.environ:
        raise Refused("scheduled sessions cannot change settings directly")
    if ((undo and (action_id is not None or not RECORD.fullmatch(record)))
            or (action_id is not None and not (RECORD.fullmatch(action_id) and action_id.startswith("fa1_")))):
        raise Refused("invalid transaction identifier")
    rule = None if undo else grant_rule(literal)
    runner = runner_for()
    project = project_scope(directory, runner)
    identity = project.canonical.stat()
    root = str(project.canonical)
    lib = helper("kaizen_friction_actions.py")
    open_dir, read, replace = (lib[name] for name in ("_directory", "_read", "_replace"))
    store = host_store(runner)
    state_path = store.friction
    if state_path.resolve().is_relative_to(project.canonical):
        raise Refused("transaction state must be outside the project")
    try:
        key = store._secret()
    except FileNotFoundError:
        raise Refused("run a fresh scoped audit to create the audit extract authentication key") from None
    with open_dir(project.canonical) as project_fd, open_dir(state_path, private=True) as state:
        lib["fcntl"].flock(project_fd, lib["fcntl"].LOCK_EX)
        if not os.path.samestat(identity, os.fstat(project_fd)):
            raise Refused("project directory was replaced")
        with lib["_locked"](state, "allow-rules"):
            def read_journal():
                with open_dir(state_path, private=True) as live:
                    if not os.path.samestat(os.fstat(state), os.fstat(live)):
                        raise Refused("transaction state directory was replaced")
                try:
                    return read(state, STATE, EXTRACT_LIMIT)
                except FileNotFoundError:
                    return None

            previous = read_journal()
            started = os.path.lexists(state_path / WITNESS)
            if previous is None and (undo or started):
                raise Refused("transaction journal is missing")
            if read(state, "machine.key", 32) != key:
                raise Refused("audit extract authentication key changed")

            def seal(data):
                return hmac.digest(key, b"allow-rules-v1\0" + json_bytes(data), "sha256").hex()

            journal = dict(projects={}, records={})
            if previous is not None:
                journal = json.loads(previous, object_pairs_hook=unique_object)
                if not hmac.compare_digest(journal.pop("mac"), seal(journal)):
                    raise Refused("transaction journal authentication failed")

            def verify():
                if read_journal() != previous:
                    raise Refused("transaction journal changed")

            def save():
                nonlocal previous
                raw = json_bytes(dict(journal, mac=seal(journal)))
                if len(raw) > EXTRACT_LIMIT:
                    raise Refused("transaction journal exceeds its limit")
                verify()
                replace(state, STATE, raw)
                previous = raw

            def mark():
                if not started:
                    replace(state, WITNESS, b"1")
                verify()

            records = journal["records"]
            ident = record or action_id
            prior = records.get(ident)
            if undo:
                if prior is None:
                    raise Refused("unknown managed rule record")
                rule = prior[1]
            if prior is not None and prior[:2] != [root, rule]:
                raise Refused("transaction key is bound to another scope or rule")
            entry = journal["projects"].get(root)
            root_id = version(os.fstat(project_fd))[:3]
            if entry is not None and root_id != entry["bound"][0]:
                raise Refused("project directory was replaced")
            if prior is not None and prior[2] == "undone":
                if undo:
                    return dict(status="undone", record=ident)
                raise Refused("transaction was already revoked")
            target_dir = project.canonical / TARGET.parent

            def authorize(candidate):
                live = project_scope(directory, runner)
                if (live.canonical != project.canonical or live.paths != project.paths
                        or not os.path.samestat(identity, live.canonical.stat())):
                    raise Refused("project evidence scope changed")
                _, proof = evidence(runner, live, candidate[5:-1], key)
                return [proof, [str(path) for path in live.paths]]

            def authorize_request(candidate):
                proof = authorize(candidate)
                if action_id is not None and not hmac.compare_digest(
                        action_id, broker_id(key, project, literal, proof[0][0])):
                    raise Refused("unknown broker transaction binding")
                return proof

            local = named_version(project_fd, TARGET.parent.name)
            if entry is not None and (local is None or local[:3] != entry["bound"][1]):
                pending = entry["pending"]
                if pending is not None:
                    published = pending.get("published")
                    if published:
                        # The receipt belongs to the old directory, never its replacement.
                        finish_effect(entry, records, pending, published, save)
                        if undo and prior[2] == "undone":
                            return dict(status="undone", record=ident)
                    else:
                        cancel_pending(None, entry, records, save)
                if any(row[0] == root and row[2] == "applied" for row in records.values()):
                    if local is None and undo and prior[2] == "applied":
                        prior[2] = "undone"
                        save()
                        return dict(status="undone", record=ident)
                    raise Refused("recorded settings directory is missing" if local is None
                                  else "project settings directory was replaced")
                del journal["projects"][root]
                entry = None
                save()
            if prior is not None and prior[2] == "cancelled":
                raise Refused("managed rule transaction was cancelled")
            if local is None:
                if undo:
                    raise Refused("recorded settings directory is missing")
                authorize_request(rule)
                with open_dir(project.canonical) as live:
                    if not os.path.samestat(os.fstat(project_fd), os.fstat(live)):
                        raise Refused("project directory was replaced")
                    os.mkdir(TARGET.parent.name, 0o700, dir_fd=project_fd)
                    local = named_version(project_fd, TARGET.parent.name)
                    os.fsync(project_fd)
            with open_dir(target_dir) as settings:
                if local is None or local[:3] != version(os.fstat(settings))[:3]:
                    raise Refused("settings directory was replaced")
                bound = [root_id, version(os.fstat(settings))[:3]]
                if entry is None:
                    entry = journal["projects"][root] = dict(bound=bound, file=None, created=False, pending=None)
                if bound != entry["bound"]:
                    raise Refused("project settings directory was replaced")
                return update_rule(settings, target_dir, entry, records, ident, root, rule, undo, action_id,
                                   authorize, authorize_request, open_dir, save, mark)


def remove_stage(settings, temporary, expected):
    if settings is not None and temporary and expected is not None:
        try:
            raw, stamp = snapshot(settings, temporary)
            if effect_id(raw, stamp) == expected and same_version(settings, temporary, stamp):
                os.unlink(temporary, dir_fd=settings)
                os.fsync(settings)
        except (OSError, ValueError, Refused):
            pass  # An unverified file at that name belongs to whoever changed it.


def cancel_pending(settings, entry, records, save):
    pending = entry["pending"]
    if pending.get("published"):
        remove_stage(settings, pending["temp"] or pending.get("backup"), pending["before"][1])
    else:
        remove_stage(settings, pending["temp"], pending["after"])
    if pending["undo"]:
        entry["cancelled_undo"] = pending["id"]
    else:
        records[pending["id"]][2] = "cancelled"
    entry["pending"] = None
    save()


def distrust_other_grants(entry, records, ident):
    root = records[ident][0]
    entry["unverified"] = sorted(key for key, row in records.items()
                                 if key != ident and row[0] == root and row[2] == "applied")


def finish_effect(entry, records, pending, image, save, edited=False):
    status = "undone" if pending["undo"] else "applied"
    if edited:
        distrust_other_grants(entry, records, pending["id"])
    records[pending["id"]][2] = status
    exists = image[0] is not None
    entry.update(file=image if exists else None,
                 created=not edited and pending.get("created", entry["created"]) and exists, pending=None)
    save()
    return dict(status=status, record=pending["id"])


def pending_add_matches(settings, pending, before, authorize):
    if before != pending["before"] or "evidence" not in pending:
        return False
    try:
        if authorize(pending["rule"]) != pending["evidence"]:
            return False
        if pending["after"] is not None:
            return effect_id(*snapshot(settings, pending["temp"])) == pending["after"]
    except (OSError, ValueError, TypeError, KeyError, Refused):
        return False
    return True


def publication_recorded(settings, pending, before):
    if pending.get("published"):
        return True
    after = pending["after"]
    temporary = pending["temp"]
    if temporary:
        if after is None or before[0] is None or before[0][:3] != after[0]:
            return False
        parked_name = temporary
    else:
        if before[0] is not None or not pending.get("backup"):
            return False
        parked_name = pending["backup"]
    # A crash before the receipt can leave the preimage parked. Verify it
    # before accepting a staged inode the editor may have updated in place.
    parked = named_version(settings, parked_name)
    if parked is None:
        return bool(temporary)  # Creation or a completed exchange from the old journal format.
    try:
        if effect_id(*snapshot(settings, parked_name)) == pending["before"][1]:
            return True
    except (OSError, ValueError, Refused):
        pass
    if (same_version(settings, parked_name, parked)
            and same_version(settings, TARGET.name, before[0])):
        rename_effect(settings, parked_name, TARGET.name, exchange=bool(temporary))
        os.fsync(settings)
    raise Refused("interrupted publication raced with a settings edit")


def update_rule(settings, path, entry, records, ident, root, rule, undo, action_id,
                authorize, authorize_request, open_dir, save, mark):
    pending = entry["pending"]
    try:
        raw, stamp = snapshot(settings)
        data, permissions = read_settings(raw)
    except (OSError, ValueError, Refused):
        if pending is not None:
            if pending.get("published"):
                finish_effect(entry, records, pending, pending["published"], save)
            else:
                cancel_pending(settings, entry, records, save)
        raise
    before = preimage(raw, stamp)
    allow = permissions.get("allow", [])
    if pending is not None:
        same_request = (rule == pending["rule"] and undo == pending["undo"]
                        and (ident == pending["id"] or ident is None and pending["id"].startswith("direct_")))
        count = allow.count(pending["rule"])
        published = publication_recorded(settings, pending, before)
        # An editor can replace the published inode before the receipt is
        # durable. Keep a managed undo record whenever the exact grant remains.
        if (pending["undo"] and not count) or (not pending["undo"] and count):
            remove_stage(settings, pending["temp"] or pending.get("backup"),
                         pending["before"][1] if published else pending["after"])
            os.fsync(settings)
            result = finish_effect(entry, records, pending, before, save,
                                   edited=before[1] != pending["after"] or not published)
            if same_request:
                return result
            pending = None
        elif not pending["undo"] and not pending_add_matches(settings, pending, before, authorize):
            cancel_pending(settings, entry, records, save)
            if same_request:
                raise Refused("pending grant cancelled because settings, staged bytes, or evidence changed or expired")
            pending = None
        elif pending["undo"] and before != pending["before"]:
            distrust_other_grants(entry, records, pending["id"])
            if same_request and count == 1 and not published:
                # The pending undo already established ownership. Rebase only
                # that exact removal onto the editor's current settings.
                remove_stage(settings, pending["temp"], pending["after"])
                pending.update(before=before, after=None, temp=stage_name(), created=False)
                pending.pop("published", None)
                pending.pop("backup", None)
                save()
            else:
                entry["unverified"].append(pending["id"])
                cancel_pending(settings, entry, records, save)
                if same_request:
                    raise Refused("pending undo cancelled because ownership of the current entry cannot be verified")
                pending = None
        elif pending["undo"] and pending["temp"] and pending["after"] is not None and named_version(settings, pending["temp"]) is None:
            if same_request:
                pending.update(temp=stage_name(), after=None)
                save()
            else:
                cancel_pending(settings, entry, records, save)
                pending = None
        elif not same_request:
            raise Refused("another settings transaction is pending")

    if pending is None:
        owned = entry["file"] == before
        unverified = entry.get("unverified", [])
        active = next((key for key, value in records.items() if value == [root, rule, "applied"]), None)
        if not undo:
            check_conflicts(permissions, rule)
            if rule in allow:
                if owned and active is not None and active not in unverified and allow.count(rule) == 1 and action_id in (None, active):
                    return dict(status="applied", record=active)
                if action_id is None:
                    return dict(status="already-present")
                raise Refused("already present without a matching transaction")
            if ident in records or active is not None:
                raise Refused("managed rule was revoked or cancelled")
        else:
            if active != ident or (rule in allow and (not owned or ident in unverified or allow.count(rule) != 1)):
                raise Refused("managed rule ownership cannot be verified after a settings edit")
            if rule not in allow:
                records[ident][2] = "undone"
                save()
                return dict(status="undone", record=ident)

        for key, value in records.items():
            if value[0] == root and value[2] == "applied":
                count = allow.count(value[1])
                if count and key not in unverified and (not owned or count != 1):
                    raise Refused("managed rule ownership cannot be verified after a settings edit")
                if not count:
                    value[2] = "undone"

        proof = None if undo else authorize_request(rule)
        ident = ident or "direct_" + os.urandom(32).hex()
        delete = undo and owned and entry["created"] and data == {"permissions": {"allow": [rule]}}
        temporary = None if delete else stage_name()
        if sys.platform == "linux" and temporary:
            linux_owner(settings)  # Refuse unsupported filesystems before reserving an effect.
        created = entry["created"] if owned else raw is None
        entry["pending"] = pending = dict(id=ident, rule=rule, undo=undo, before=before, after=None,
                                           temp=temporary, created=created, evidence=proof)
        if delete:
            pending["backup"] = stage_name()
        if not undo:
            records[ident] = [root, rule, "pending"]
        save()

    if before != pending["before"]:
        raise Refused("settings changed since the pending transaction")
    if pending["temp"] is None and "backup" not in pending:
        pending["backup"] = stage_name()
        save()
    mark()  # A missing journal after this point must never initialize a new one.
    temporary = pending["temp"]
    with ExitStack() as stack:
        staged_fd = None
        if temporary:
            if pending["after"] is None:
                # A crash before recording a stage leaves an unowned name. Use
                # a new reservation and leave the unverified file untouched.
                if not same_version(settings, temporary, None):
                    temporary = pending["temp"] = stage_name()
                    save()
                allow = data.setdefault("permissions", {}).setdefault("allow", [])
                allow.remove(rule) if undo else allow.append(rule)
                staged_fd, pending["after"] = stage(settings, temporary, json_bytes(data), stamp[5] if stamp else 0o600)
                stack.callback(os.close, staged_fd)
                save()
            else:
                staged_fd = os.open(temporary, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=settings)
                stack.callback(os.close, staged_fd)
        if not undo:
            try:
                proof = authorize(rule)
            except (OSError, ValueError, TypeError, KeyError, Refused):
                proof = None
            if proof != pending["evidence"]:
                cancel_pending(settings, entry, records, save)
                raise Refused("pending grant cancelled because evidence changed or expired")
        write_effect(settings, path, pending, open_dir, staged_fd, save)
        with open_dir(path) as live:
            verified_raw, verified_stamp = snapshot(live)
            if (not os.path.samestat(os.fstat(settings), os.fstat(live))
                    or effect_id(verified_raw, verified_stamp) != pending["after"]):
                raise Refused("settings transaction could not be verified")
    os.fsync(settings)
    return finish_effect(entry, records, pending, preimage(verified_raw, verified_stamp), save)


def stage_name():
    return "settings.kaizen-" + os.urandom(16).hex() + ".json"


def main():
    parser = Parser(prog="kaizen-allow-rule", description=__doc__)
    commands = parser.add_subparsers(dest="operation", required=True)
    add = commands.add_parser("add", help="prepare an exact rule proposal")
    add.add_argument("--project", required=True, metavar="DIR")
    add.add_argument("--command", required=True)
    undo = commands.add_parser("undo", help="revoke a managed rule by record identifier")
    undo.add_argument("record")
    undo.add_argument("--project", required=True, metavar="DIR")
    args = parser.parse_args()
    try:
        if args.operation == "undo":
            print(json.dumps(transact(args.project, record=args.record)))
            return 0
        if live_writes() and "KAIZEN_RUN_ID" not in os.environ:
            print(json.dumps(transact(args.project, args.command)))
            return 0
        operation = prepare_add(args.project, args.command)
        print(json.dumps(dict(operation=operation["operation"], target=str(TARGET),
                              rule=operation["rule"], accepted=operation["accepted"],
                              status="already-present" if operation["present"] else "proposal-only")))
        return 0
    except Refused as exc:
        print(f"kaizen-allow-rule: {exc}", file=sys.stderr)
    except (OSError, ValueError, TypeError, KeyError, RuntimeError):
        print("kaizen-allow-rule: invalid or unreadable project, settings, or evidence", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
