#!/usr/bin/env python3
"""Backups, manifests and undo for Agent Kaizen changes (see docs/autonomy.md).

  kaizen-backup begin  --skill NAME --ledger TEXT [--run RUN_ID] [--repo DIR] FILE...
        Back up FILEs (existing ones are copied; missing ones are recorded as created)
        and print the change folder. Credential paths are refused. Run BEFORE editing.
  kaizen-backup finish CHANGE_DIR [--verification passed|failed]
        Record each file's sha256 after the edit. Run AFTER editing and verifying.
  kaizen-backup commit CHANGE_DIR
        Commit verified backup edits to a local kaizen ref.
  kaizen-backup action CHANGE_DIR --did CMD --undo CMD
        Record a non-file action (e.g. a package install) and its reverse command.
  kaizen-backup list [--all]
        List changes (newest first): change dir, run, skill, reverted, ledger text.
  kaizen-backup undo [last|run|CHANGE_DIR] [--force]
        Restore files; delete created files whose hash still matches; print recorded
        actions' undo commands (it never runs them). A file changed since `finish` is a
        conflict: nothing is restored unless --force. `undo run` takes the newest
        group of consecutive changes with one run id and session; older changes that
        reuse the id are left alone and named.
  kaizen-backup prune --older-than DAYS [--apply]
        List finished changes created more than DAYS days ago (DAYS >= 1). Dry run
        unless --apply, which deletes them. Unfinished changes, corrupt manifests and
        changes without created_at are never removed.

Backups live in KAIZEN_BACKUP_DIR (default <CLAUDE_CONFIG_DIR or ~/.claude>/kaizen-backups),
in folders only the owner can read.

Accepted same-UID risks include a filesystem symlink planted under refs/ that
resolves into refs/kaizen/, and a concurrent move of an undo target's parent
during the descriptor-bound copy. Undo rechecks the parent before the final
rename and anchors the rename to the directory descriptor.
"""
import argparse
import base64
import ctypes
import datetime
import errno
import hashlib
import json
import os
import re
import runpy
import select
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from contextlib import ExitStack, contextmanager
from pathlib import Path

try:
    import fcntl
except ImportError:
    fcntl = None


def claude_home():
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude").expanduser()


USER_ROOT = bool(os.environ.get("KAIZEN_BACKUP_DIR"))  # a root the user chose keeps its mode
BACKUP_ROOT = Path(os.environ.get("KAIZEN_BACKUP_DIR") or claude_home() / "kaizen-backups").expanduser()
ROOT = BACKUP_ROOT.resolve()
is_credential = runpy.run_path(str(Path(__file__).resolve().with_name("kaizen_credentials.py")))["is_credential"]


def sha(path):
    path = Path(path)
    if not path.is_file():
        return None
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


REQUIRED_KEYS = ("run_id", "change", "skill", "ledger", "files", "actions")


def check_manifest_depth(value, depth=1):
    if isinstance(value, (dict, list)):
        if depth > 32:
            raise ValueError("manifest nesting exceeds 32 levels")
        for child in value.values() if isinstance(value, dict) else value:
            check_manifest_depth(child, depth + 1)


def parse_manifest(path, raw):
    try:
        data = json.loads(raw)
        check_manifest_depth(data)
    except (ValueError, RecursionError) as error:
        raise ValueError(f"cannot read manifest {path}: {error}") from None
    if not isinstance(data, dict):
        raise ValueError(f"manifest {path} is not a JSON object")
    missing = [key for key in REQUIRED_KEYS if key not in data]
    if missing or not isinstance(data["files"], list) or not isinstance(data["actions"], list):
        raise ValueError(f"manifest {path} is missing or has bad keys: {', '.join(missing) or 'files/actions'}")
    return data


def read_manifest(path):
    try:
        raw = Path(path).read_text()
    except (OSError, ValueError) as error:
        raise ValueError(f"cannot read manifest {path}: {error}") from None
    return parse_manifest(path, raw)


def read_manifest_snapshot(change_fd, *, sync=False):
    path = "manifest.json"
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    try:
        with os.fdopen(os.open(path, flags, dir_fd=change_fd), "rb") as stream:
            info = os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= 1024 * 1024:
                raise ValueError("expected a nonempty regular manifest within 1 MiB")
            raw = stream.read(info.st_size + 1)
            data = parse_manifest(path, raw)
            if sync:
                os.fsync(stream.fileno())
            live = os.stat(path, dir_fd=change_fd, follow_symlinks=False)
            if len(raw) != info.st_size or file_version(live) != file_version(info):
                raise ValueError("manifest was replaced or edited during validation")
    except OSError as error:
        raise ValueError(f"cannot read manifest {path}: {error}") from None
    return data, hashlib.sha256(raw).hexdigest()


def load(change):
    refuse_symlinks(Path(change) / "manifest.json")
    return read_manifest(Path(change) / "manifest.json")


def save(change, manifest):
    tmp = Path(change) / "manifest.json.tmp"
    refuse_symlinks(tmp)
    refuse_symlinks(Path(change) / "manifest.json")
    tmp.write_text(json.dumps(manifest, indent=2) + "\n")
    tmp.replace(Path(change) / "manifest.json")


def changes(include_reverted=True):
    found = []
    for manifest in ROOT.glob("*/manifest.json"):
        try:
            data = read_manifest(manifest)
        except ValueError as error:
            print(f"kaizen-backup: skipping {error}", file=sys.stderr)
            continue
        if include_reverted or not data.get("reverted"):
            found.append((manifest.parent, data))
    # Newest first. Run ids are free text, so order by creation time; no created_at sorts oldest.
    return sorted(found, key=lambda item: (str(item[1].get("created_at") or ""), str(item[1]["run_id"]),
                                           str(item[1]["change"]).zfill(8)), reverse=True)


def change_numbers(run_id):
    for item in ROOT.iterdir():
        if item.name.startswith(run_id + "-"):
            match = re.match(r"(\d+)-", item.name[len(run_id) + 1:])
            if match and item.is_dir() and not item.is_symlink():
                yield int(match.group(1))


def next_number(run_id):
    """One more than the highest NN in existing folders named <run_id>-NN-<skill>."""
    return max(change_numbers(run_id), default=0) + 1


def allocate_change(run_id, skill):
    first = next_number(run_id)
    run_key = hashlib.sha256(os.fsencode(run_id)).hexdigest()
    for number in range(first, first + 1000):
        change = ROOT / f"{run_id}-{number:02d}-{skill}"
        change_dir(change)  # Refuse a path that resolves outside the backup root.
        # Reserve the number across all skills, including callers without a lock.
        slot = f".kaizen-slot.{run_key}.{number}"
        with open_directory(ROOT) as fd:
            try:
                os.mkdir(slot, 0o700, dir_fd=fd)
            except FileExistsError:
                continue
            try:
                if number in change_numbers(run_id):
                    continue  # Another caller finished allocating after our initial scan.
                os.mkdir(change, 0o700)
                return number, change
            except FileExistsError:
                continue
            finally:
                os.rmdir(slot, dir_fd=fd)
    raise ValueError(f"no available backup slot for run {run_id}")


def valid_id(value):
    if any(part in value for part in ("/", "..", "\0")):
        raise ValueError("--run and --skill must not contain /, .. or NUL")
    return value


def change_dir(path):
    resolved = Path(path).expanduser().resolve()
    if ROOT not in resolved.parents:
        raise ValueError(f"CHANGE_DIR must be inside the backups root: {resolved}")
    return resolved


def resolved_path(path):
    try:
        return path.resolve()
    except (OSError, RuntimeError) as error:
        raise ValueError(f"cannot resolve path: {path}") from error


def refuse_symlinks(path, roots=()):
    resolved = resolved_path(path)
    if path.is_symlink() or resolved != path:
        if any(resolved == root or root in resolved.parents for root in roots):
            raise ValueError(f"refusing to restore through symlink into plugin root: {path}; "
                             "run kaizen-link --unlink --restore-replaced first")
        raise ValueError(f"refusing to access target through symlink: {path}")


def validate_entry(change, entry, roots=()):
    if not isinstance(entry, dict) or not isinstance(entry.get("path"), str):
        raise ValueError("entry path must be an absolute normalised string")
    name = entry["path"]
    path = Path(name)
    if not path.is_absolute() or str(path) != name or ".." in path.parts or "\0" in name:
        raise ValueError(f"entry path must be absolute and normalised without ..: {name}")
    refuse_symlinks(path, roots)
    if not isinstance(entry.get("created"), bool):
        raise ValueError(f"entry created flag must be boolean: {name}")
    # Preflight all targets before undo changes anything, including with --force.
    if path.is_dir():
        raise ValueError(f"entry target is a directory: {path}")
    if not entry["created"] or entry.get("backup") is not None:
        if not isinstance(entry.get("backup"), str):
            raise ValueError(f"entry backup must name a file inside its change directory: {name}")
        backup = change / entry["backup"]
        if change not in resolved_path(backup).parents:
            raise ValueError(f"entry backup must resolve inside its change directory: {backup}")
        refuse_symlinks(backup)
        if not backup.is_file():
            raise ValueError(f"entry backup is not a regular file: {backup}")
    return path


def file_version(info):
    return info.st_dev, info.st_ino, info.st_mode, info.st_size, info.st_mtime_ns, info.st_ctime_ns


@contextmanager
def open_directory(path, *, dir_fd=None):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dir_fd)
    try:
        yield fd
    finally:
        os.close(fd)


@contextmanager
def open_directory_walk(path, *, create=False, search=False):
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    if search:
        # Darwin exposes O_SEARCH in fcntl.h but Python does not export it.
        flags |= getattr(os, "O_SEARCH", getattr(os, "O_PATH", 0x40000000 if sys.platform == "darwin" else 0))
    fd = os.open(path.anchor, flags)
    try:
        for part in path.parts[1:]:
            try:
                child = os.open(part, flags, dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    raise
                os.mkdir(part, 0o700, dir_fd=fd)
                if not search:
                    os.fsync(fd)
                child = os.open(part, flags, dir_fd=fd)
            os.close(fd)
            fd = child
        yield fd
    finally:
        os.close(fd)


def directory_stamp(path, fd):
    info = os.fstat(fd)
    return {"path": str(path), "dev": info.st_dev, "ino": info.st_ino}


def directory_identity(path):
    with open_directory(path) as fd:
        return directory_stamp(path, fd)


def backup_root_path(root):
    path = Path(root).expanduser()
    return Path(os.path.abspath(path.parent.resolve(strict=True) / path.name))


BACKUP_LOCK = ".kaizen-backup.lock"


@contextmanager
def open_backup_lock(root_fd):
    flags = os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK
    fd = os.open(BACKUP_LOCK, flags, mode=0o600, dir_fd=root_fd)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600
                or info.st_uid != os.getuid() or info.st_nlink != 1):
            raise ValueError("backup lock must be a private regular file")
        yield fd
    finally:
        os.close(fd)


def backup_root_stamp(path, fd):
    info = os.fstat(fd)
    lock = os.stat(BACKUP_LOCK, dir_fd=fd, follow_symlinks=False)
    stamp = {"path": str(path), "dev": info.st_dev, "ino": info.st_ino,
             "ctime_ns": info.st_ctime_ns, "lock": list(file_version(lock))}
    if sys.platform == "darwin":
        stamp["birthtime"] = info.st_birthtime
    return stamp


def backup_root_identity(root):
    """Capture this before launch in the trusted caller, after creating the backup root."""
    path = backup_root_path(root)
    with open_directory(path) as fd, open_backup_lock(fd) as lock_fd:
        stamp = backup_root_stamp(path, fd)
        if stamp["lock"] != list(file_version(os.fstat(lock_fd))):
            raise ValueError("backup lock was replaced")
        return stamp


def check_backup_root(root, expected):
    path = backup_root_path(root)
    with open_directory(path) as fd:
        if backup_root_stamp(path, fd) != expected:
            raise ValueError("backup root was replaced or changed during validation")


# Fixed locations in preference order; PATH is never consulted. On macOS the first is
# the root-owned xcrun shim, run with a fixed environment and no xcrun cache.
TRUSTED_GIT = ("/usr/bin/git", "/opt/homebrew/bin/git", "/usr/local/bin/git")
MAX_GIT_BYTES = 256 * 1024 * 1024


def trusted_owner(info):
    return info.st_uid in (0, os.getuid()) and not info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)


def check_trusted_parents(path):
    parent = os.path.dirname(path)
    while True:
        if not trusted_owner(os.lstat(parent)):
            raise ValueError(f"Git executable is not in a trusted directory: {parent}")
        if parent == os.path.dirname(parent):
            return
        parent = os.path.dirname(parent)


def git_executable(path):
    """Identity of the executable file at a canonical path, including a hash of its bytes."""
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    with os.fdopen(os.open(path, flags), "rb") as stream:
        info = os.fstat(stream.fileno())
        if (not stat.S_ISREG(info.st_mode) or not info.st_mode & stat.S_IXUSR or not trusted_owner(info)
                or info.st_size > MAX_GIT_BYTES):
            raise ValueError("Git executable is not a trusted regular executable")
        digest = hashlib.sha256()
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
        if file_version(os.lstat(path)) != file_version(info):
            raise ValueError("Git executable changed while it was hashed")
    return {"path": path, "dev": info.st_dev, "ino": info.st_ino, "size": info.st_size,
            "mtime_ns": info.st_mtime_ns, "ctime_ns": info.st_ctime_ns, "sha256": digest.hexdigest()}


# A user-writable Git executable can still be swapped between check and exec.
# An entry added after its directory was scanned can still yield a false advisory clean start.
def resolve_git():
    """Return the identity of the first Git at a fixed location; re-verify it before each later use."""
    for candidate in TRUSTED_GIT:
        if os.path.lexists(candidate):
            path = os.path.realpath(candidate)
            check_trusted_parents(candidate)
            check_trusted_parents(path)
            return git_executable(path)
    raise ValueError("no Git executable at a trusted location")


def verify_git(record):
    """Return the executable path only if resolution still yields this exact file and content."""
    if resolve_git() != record:
        raise ValueError("Git executable changed since capture")
    return record["path"]


def git_command(directory, *args, git_exe, git_dir=None, index=None):
    # Callers use metadata queries or plumbing with explicit bytes and index.
    info = os.lstat(git_exe["path"])
    if (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns) != tuple(
            git_exe[key] for key in ("dev", "ino", "size", "mtime_ns", "ctime_ns")):
        raise ValueError("Git executable changed since capture")
    directory = Path(directory)
    env = dict(PATH="/usr/bin:/bin", LC_ALL="C", GIT_TERMINAL_PROMPT="0", GIT_NO_LAZY_FETCH="1",
               GIT_ALLOW_PROTOCOL="", GIT_NO_REPLACE_OBJECTS="1", GIT_CONFIG_NOSYSTEM="1",
               GIT_CONFIG_GLOBAL=os.devnull, GIT_ATTR_NOSYSTEM="1", xcrun_nocache="1",
               GIT_CEILING_DIRECTORIES=str(directory.parent))
    scope = [] if git_dir is None else [f"--git-dir={git_dir}", f"--work-tree={directory}"]
    if index is not None:
        env["GIT_INDEX_FILE"] = str(index)
        scope.extend(("-c", "core.splitIndex=false"))
    return ([git_exe["path"], "--no-pager", "--no-optional-locks", "-C", str(directory), *scope,
             "-c", "core.fsmonitor=false", "-c", f"core.hooksPath={os.devnull}", "-c", "protocol.allow=never",
             "-c", "core.untrackedCache=false", "-c", "core.sparseCheckout=false",
             "-c", "core.fsync=all", "-c", "core.fsyncMethod=fsync", *args], env)


def git(directory, *args, input=None, **options):
    command, env = git_command(directory, *args, **options)
    return subprocess.run(
        command,
        env=env, input=input, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=True, timeout=10,
    ).stdout


MAX_INDEX_BYTES = 64 * 1024 * 1024


def read_index(path):
    refuse_symlinks(path)
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    with os.fdopen(os.open(path, flags), "rb") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= MAX_INDEX_BYTES:
            raise ValueError("Git index is not a regular file within the size limit")
        os.set_blocking(stream.fileno(), True)
        raw = stream.read(info.st_size + 1)
        if len(raw) != info.st_size or file_version(path.lstat()) != file_version(info):
            raise ValueError("Git index was edited during capture")
    return {"path": str(path), "dev": info.st_dev, "ino": info.st_ino,
            "sha256": hashlib.sha256(raw).hexdigest()}, raw


def git_snapshot(directory, git_exe):
    root = Path(directory).expanduser().resolve(strict=True)
    if not os.path.lexists(root / ".git"):
        raise ValueError("repository must be the exact Git worktree top level")
    worktree = directory_identity(root)
    top, common, index = (Path(os.fsdecode(git(root, "rev-parse", "--path-format=absolute",
                                             *args, git_exe=git_exe).removesuffix(b"\n")))
                          for args in (("--show-toplevel",), ("--git-common-dir",), ("--git-path", "index")))
    if not all(path.is_absolute() for path in (top, common, index)) or top.resolve(strict=True) != root:
        raise ValueError("repository must be the exact Git worktree top level")
    common = common.resolve(strict=True)
    common_dir = directory_identity(common)
    if (index.parent / "index.lock").exists():
        raise ValueError("locked Git index")
    # Snapshot only the ref ID. Content readers check the object bounds first.
    head = git(root, "rev-parse", "--verify", "HEAD", git_exe=git_exe).decode("ascii").strip()
    index_state, raw = read_index(index)
    if directory_identity(root) != worktree or directory_identity(common) != common_dir:
        raise ValueError("Git directories changed during capture")
    return {"root": str(root), "worktree": worktree, "head": head, "common_dir": common_dir,
            "index": index_state, "git_executable": git_exe}, raw


def git_identity(directory, git_exe):
    """Read the live identity using the supplied trusted Git executable."""
    return git_snapshot(directory, git_exe)[0]


def matches_blob(path, mode, oid, *, dir_fd=None, expected=None):
    if dir_fd is None and path.parent.resolve(strict=True) != path.parent:
        return False
    digest = hashlib.sha256() if len(oid) == 64 else hashlib.sha1()
    if mode == b"120000":
        raw = os.readlink(os.fsencode(path), dir_fd=dir_fd)
        digest.update(b"blob %d\0" % len(raw) + raw)
    else:
        flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
        with os.fdopen(os.open(path, flags, dir_fd=dir_fd), "rb") as stream:
            info = os.fstat(stream.fileno())
            if (not stat.S_ISREG(info.st_mode) or bool(info.st_mode & stat.S_IXUSR) != (mode == b"100755")
                    or (expected is not None and file_version(info) != expected)):
                return False
            digest.update(b"blob %d\0" % info.st_size)
            for chunk in iter(lambda: stream.read(65536), b""):
                digest.update(chunk)
            if file_version(os.stat(path, dir_fd=dir_fd, follow_symlinks=False)) != file_version(info):
                return False
    return digest.hexdigest().encode("ascii") == oid


# --debug exposes the intent-to-add bit even when an empty blob matches HEAD.
INDEX_ENTRY = re.compile(rb"H (100644|100755|120000) ([0-9a-f]+) 0\t([^\0]+)\0"
                         rb"(?:  [^\n]*\n){4}  size: [0-9]+\tflags: 0\n")


def worktree_listing(root):
    """Stamp each directory before listing it, so any later entry change alters a stamp."""
    directories, others, pending = {}, set(), [root]
    while pending:
        top = pending.pop()
        info = os.lstat(top)
        if not stat.S_ISDIR(info.st_mode):
            raise ValueError("worktree directory was replaced")
        directories[top] = (info.st_dev, info.st_ino, info.st_mtime_ns, info.st_ctime_ns)
        with os.scandir(top) as listing:
            for entry in listing:
                if top == root and entry.name == ".git":
                    continue
                (pending.append if entry.is_dir(follow_symlinks=False) else others.add)(top / entry.name)
    return directories, others


def still_clean(state, versions, listing):
    """Recheck an earlier capture; any change, new directory or new entry means not clean."""
    root = Path(state["root"])
    verify_git(state["git_executable"])
    return (git_identity(root, state["git_executable"]) == state and worktree_listing(root) == listing
            and all(path.parent.resolve(strict=True) == path.parent and file_version(path.lstat()) == version
                    for path, version in versions.items()))


def private_store():
    path = backup_root_path(BACKUP_ROOT) / ".kaizen-refs"
    if path.parent != ROOT or not trusted_owner(path.parent.lstat()):
        raise ValueError("backup root is not trusted for ref records")
    path.mkdir(mode=0o700, exist_ok=True)
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise ValueError("ref store must be a private directory")
    return path


def scratch_parent(root):
    override = next((os.environ[key] for key in ("TMPDIR", "TEMP", "TMP") if os.environ.get(key)), None)
    if override:
        try:
            candidate = Path(override).resolve(strict=True)
            if not candidate.is_relative_to(root) and candidate.is_dir():
                return candidate
        except (OSError, RuntimeError):
            pass
        if not ROOT.is_relative_to(root) and ROOT.is_dir():
            return private_store()
    candidate = Path("/tmp").resolve(strict=True)
    if candidate.is_relative_to(root):
        raise ValueError("no Git scratch directory outside the checkout")
    return candidate


def git_scratch(root):
    return tempfile.TemporaryDirectory(dir=scratch_parent(root))


MAX_GIT_OBJECT_BYTES = 64 * 1024 * 1024
MAX_GIT_METADATA_BYTES = 8 * 1024 * 1024
MAX_GIT_DELTA_DEPTH = 50


def check_object_packs(root, git_exe):
    directory = Path(os.fsdecode(git(root, "rev-parse", "--path-format=absolute", "--git-path", "objects",
                                    git_exe=git_exe).removesuffix(b"\n")))
    refuse_symlinks(directory / "pack")
    refuse_symlinks(directory / "info")
    if os.path.lexists(directory / "info" / "alternates"):
        raise ValueError("Git alternate object stores cannot be bounded")
    try:
        packs = list((directory / "pack").iterdir())
    except FileNotFoundError:
        return
    for pack in packs:
        if pack.suffix != ".pack":
            continue
        info = pack.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_GIT_OBJECT_BYTES:
            raise ValueError("Git pack is not a regular file within its size limit")


def bounded_object_size(root, kind, oid, git_exe):
    if not re.fullmatch(rb"[0-9a-f]{40}|[0-9a-f]{64}", oid):
        raise ValueError("invalid Git object ID")
    check_object_packs(root, git_exe)
    limit = MAX_GIT_OBJECT_BYTES if kind == "blob" else min(MAX_GIT_OBJECT_BYTES, MAX_GIT_METADATA_BYTES)
    fields = "%(objectsize) %(objectsize:disk) %(deltabase)"
    zero, current = b"0" * len(oid), oid
    expanded = disk = size = 0
    seen = set()
    # Asking for objecttype here would let Git walk the chain before its depth is checked.
    # Git can report any copy of a duplicate object. It may also see damaged packs or
    # a pack replaced between the checks and the read.
    for depth in range(MAX_GIT_DELTA_DEPTH + 1):
        metadata = git(root, "cat-file", f"--batch-check={fields}", git_exe=git_exe,
                       input=current + b"\n").split()
        if (len(metadata) != 3 or not all(value.isdigit() for value in metadata[:2])
                or len(metadata[2]) != len(oid) or not re.fullmatch(rb"[0-9a-f]+", metadata[2])):
            raise ValueError(f"invalid Git {kind} object metadata")
        inflated, stored = map(int, metadata[:2])
        expanded += inflated
        disk += stored
        if depth == 0:
            size = inflated
            if size > limit or disk > MAX_GIT_OBJECT_BYTES:
                raise ValueError("Git object exceeds its size limit")
        if max(expanded, disk) > MAX_GIT_OBJECT_BYTES:
            raise ValueError("Git delta chain exceeds its size limit")
        seen.add(current)
        current = metadata[2]
        if current == zero:
            return size
        if current in seen:
            raise ValueError("Git delta chain contains a cycle")
    raise ValueError("Git delta chain exceeds its depth limit")


def verify_object(root, kind, oid, git_exe):
    size = bounded_object_size(root, kind, oid, git_exe)
    kind_bytes = kind.encode("ascii")
    if git(root, "cat-file", "-t", oid.decode("ascii"), git_exe=git_exe).strip() != kind_bytes:
        raise ValueError(f"invalid Git {kind} object type")
    command, env = git_command(root, "cat-file", kind, oid.decode("ascii"), git_exe=git_exe)
    deadline = time.monotonic() + 10
    digest = hashlib.new("sha256" if len(oid) == 64 else "sha1", kind_bytes + b" %d\0" % size)
    data = bytearray()
    with subprocess.Popen(command, env=env, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL) as proc:
        try:
            fd = proc.stdout.fileno()
            remaining = size
            while True:
                wait = deadline - time.monotonic()
                if wait <= 0 or not select.select([fd], [], [], wait)[0]:
                    raise subprocess.TimeoutExpired(command, 10)
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                remaining -= len(chunk)
                if remaining < 0:
                    raise ValueError(f"Git {kind} object exceeds its declared size")
                digest.update(chunk)
                if kind != "blob":
                    data.extend(chunk)
            if (remaining or proc.wait(timeout=max(0, deadline - time.monotonic()))
                    or digest.hexdigest().encode("ascii") != oid):
                raise ValueError(f"Git {kind} object does not match its ID")
            return bytes(data)
        finally:
            if proc.poll() is None:
                proc.kill()


def verified_tree(root, tree, git_exe, *, tree_oids=None):
    entry = re.compile(rb"(40000|100644|100755|120000) ([^/\0]+)\0(.{%d})" % (len(tree) // 2), re.S)
    leaves, pending, budget = {}, [(b"", tree)], MAX_GIT_METADATA_BYTES
    while pending:
        prefix, oid = pending.pop()
        raw, offset, names = verify_object(root, "tree", oid, git_exe), 0, set()
        if tree_oids is not None:
            tree_oids.add(oid)
        if prefix and not raw:
            raise ValueError("Git tree contains an explicit empty subtree")
        while offset < len(raw):
            match = entry.match(raw, offset)
            if not match:
                raise ValueError("invalid Git tree entry")
            mode, name, child = match.groups()
            if name.lower() in (b".", b"..", b".git") or name in names:
                raise ValueError("invalid or duplicate Git tree path")
            names.add(name)
            path = prefix + name
            budget -= len(path) + 64
            if budget < 0:
                raise ValueError("expanded Git tree exceeds its size limit")
            child = child.hex().encode("ascii")
            if mode == b"40000":
                pending.append((path + b"/", child))
            else:
                leaves[path] = mode, child
            offset = match.end()
    return leaves


def capture_git_tree(directory, *, baseline=None, edits=None):
    git_exe = resolve_git() if baseline is None else baseline["git_executable"]
    if baseline is not None:
        verify_git(git_exe)
    state, raw = git_snapshot(directory, git_exe)
    root = Path(state["root"])
    if baseline is not None and dict(state, clean_start=True) != baseline:
        raise ValueError("Git HEAD, root or index differs from the baseline")
    algorithm = "sha256" if len(state["head"]) == 64 else "sha1"
    head = verify_object(root, "commit", state["head"].encode("ascii"), git_exe)
    leaves = verified_tree(root, head.split(b"\n", 1)[0].removeprefix(b"tree "), git_exe)
    # Before Git scans: a file created after Git passes a directory still changes its stamp.
    listing = worktree_listing(root)
    with git_scratch(root) as scratch, open_directory(scratch) as scratch_fd:
        # Isolate the copied index, including any split-index lookup, from real Git metadata.
        git(scratch, "init", "-q", "--bare", "--template=", f"--object-format={algorithm}", git_exe=git_exe)
        copy = Path(scratch) / "index"
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
        with os.fdopen(os.open("index", flags, 0o600, dir_fd=scratch_fd), "wb") as stream:
            stream.write(raw)
            stream.flush()
            copied = file_version(os.fstat(stream.fileno()))
        scratch_version = file_version(os.fstat(scratch_fd))
        records = git(root, "ls-files", "-v", "--stage", "--debug", "--sparse", "-z",
                      git_exe=git_exe, git_dir=scratch)
        # No exclude options: ignored files count too.
        if edits is None and git(root, "ls-files", "--others", "-z", git_exe=git_exe, git_dir=scratch):
            raise ValueError("worktree contains untracked files")
        entries, versions, offset = {}, {}, 0
        for tree_name, tree_entry in sorted(leaves.items()):
            match = INDEX_ENTRY.match(records, offset)
            if not match:
                raise ValueError("Git index has missing, hidden or nonstandard entries")
            mode, oid, name = match.groups()
            path = root / os.fsdecode(name)
            if edits is None or path not in edits:
                versions[path] = file_version(path.lstat())
                if not matches_blob(path, mode, oid):
                    raise ValueError("worktree differs from HEAD outside the verified files")
            if (name, (mode, oid)) != (tree_name, tree_entry):
                raise ValueError("index or worktree differs from HEAD")
            entries[path] = (mode, oid)
            offset = match.end()
        expected = set(entries)
        if edits is not None:
            for path, (_, _, version) in edits.items():
                expected.add(path)
                versions[path] = version
        if offset != len(records) or listing[1] != expected:
            raise ValueError("worktree entries differ from the index")
        if edits is None and git(root, "ls-files", "--others", "-z", git_exe=git_exe, git_dir=scratch):
            raise ValueError("worktree contains new untracked files")
        # Git read the copy by path; a rewrite or swap of it changes its change time.
        if (scratch_version != file_version(os.lstat(scratch)) or copied != file_version(copy.lstat())):
            raise ValueError("copied Git index changed during capture")
        flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
        with os.fdopen(os.open("index", flags, dir_fd=scratch_fd), "rb") as stream:
            info = os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or copied != file_version(info):
                raise ValueError("copied Git index changed during capture")
            digest = hashlib.sha256(stream.read(len(raw) + 1)).hexdigest()
            if digest != state["index"]["sha256"] or copied != file_version(os.fstat(stream.fileno())):
                raise ValueError("copied Git index changed during capture")
    check = state, versions, listing
    if not still_clean(*check):
        raise ValueError("repository changed during capture")
    return state, entries, check


def capture_git_baseline(directory):
    """Capture before launch and retain the result in trusted caller state."""
    try:
        return dict(capture_git_tree(directory)[0], clean_start=True)
    except Exception:  # Advisory: any failure only means "not clean".
        return None


@contextmanager
def open_handoff(root, change, root_identity):
    try:
        root_path = backup_root_path(root)
        with open_directory(root_path) as root_fd:
            stamp = backup_root_stamp(root_path, root_fd)
            # A directory fd cannot stay open across separate invocations. Creating
            # change folders advances root ctime, so compare it across each read and
            # use the private lock's version (and Darwin birthtime) across launch.
            ctime = root_identity.get("ctime_ns")
            if (type(ctime) is not int or stamp["ctime_ns"] < ctime
                    or dict(stamp, ctime_ns=ctime) != root_identity):
                raise ValueError("backup root was replaced")
            if change.parent != root_path or change.name == "..":
                raise ValueError("change folder is not a canonical child of the backups root")
            with open_directory(change.name, dir_fd=root_fd) as change_fd:
                info = os.fstat(change_fd)
                identity = (info.st_dev, info.st_ino)
                yield change_fd, identity
                check_backup_root(root, stamp)
                info = os.stat(change.name, dir_fd=root_fd, follow_symlinks=False)
                if not stat.S_ISDIR(info.st_mode) or (info.st_dev, info.st_ino) != identity:
                    raise ValueError("change folder was replaced during validation")
    except OSError as error:
        raise ValueError(f"cannot open backup root or change folder: {error}") from None


def validate_change_handoff(root, change, *, run_id, session_id, started, before, root_identity):
    """Return the parsed manifest, folder identity and SHA-256 of the validated bytes."""
    change = Path(change)
    with open_handoff(root, change, root_identity) as (change_fd, identity):
        if change in before[0] or identity in before[1]:
            raise ValueError("change folder is not new to this run")
        data, digest = read_manifest_snapshot(change_fd)
        # The manifest's clean_start stamp is advisory and never grants commit authority.
        if not session_id or data["run_id"] != run_id or data.get("session_id") != session_id:
            raise ValueError("change manifest does not match the run and session")
        number, skill = data["change"], data["skill"]
        if (type(number) is not int or number < 1 or not isinstance(skill, str)
                or change.name != f"{valid_id(run_id)}-{number:02d}-{valid_id(skill)}"):
            raise ValueError("change folder name does not match its manifest")
        created = data.get("created_at")
        if not isinstance(created, str):
            raise ValueError("change manifest has no creation timestamp")
        created = datetime.datetime.fromisoformat(created)
        if created.tzinfo is None or not started < created <= datetime.datetime.now(datetime.timezone.utc):
            raise ValueError("change manifest timestamp is outside the run")
    return data, identity, digest


def verify_change_handoff(root, change, *, root_identity, identity, manifest_sha256):
    """Reopen a handoff and return its manifest only if its folder and bytes match."""
    with open_handoff(root, Path(change), root_identity) as (change_fd, live_identity):
        if live_identity != tuple(identity):
            raise ValueError("change folder identity changed")
        data, digest = read_manifest_snapshot(change_fd)
        if digest != manifest_sha256:
            raise ValueError("change manifest hash changed")
    return data


LEDGER_PATH = "docs/kaizen/LEDGER.md"
MAX_LEDGER_BYTES = 1024 * 1024
MAX_COMMIT_BYTES = 64 * 1024 * 1024
SHA256 = re.compile(r"[0-9a-f]{64}")


def unique_fields(pairs):
    fields = dict(pairs)
    if len(fields) != len(pairs):
        raise ValueError("duplicate JSON field")
    return fields


def nonempty(value):
    return isinstance(value, str) and bool(value)


def v1_fields(value, keys):
    return isinstance(value, dict) and value.keys() == set(keys.split()) and type(value["v"]) is int and value["v"] == 1


def id_pair(value):
    return isinstance(value, list) and len(value) == 2 and all(type(part) is int and part >= 0 for part in value)


def checked_bytes(path, limit):
    refuse_symlinks(path)
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    with os.fdopen(os.open(path, flags), "rb") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_size > limit:
            raise ValueError("expected a regular file within the size limit")
        raw = stream.read(info.st_size + 1)
    refuse_symlinks(path)
    version = file_version(info)
    if len(raw) != info.st_size or file_version(path.lstat()) != version:
        raise ValueError("file changed while being read")
    return (b"100755" if info.st_mode & stat.S_IXUSR else b"100644"), raw, version


def ledger_append(proof, scope, root):
    if (not v1_fields(proof, "v run_id session_id ledger_relpath before_b64 before_sha256 after_sha256 manifest_ids")
            or any(proof[key] != scope[key] for key in ("run_id", "session_id"))
            or proof["ledger_relpath"] != LEDGER_PATH):
        raise ValueError("invalid ledger attestation scope")
    encoded, ids = proof["before_b64"], proof["manifest_ids"]
    if (not isinstance(encoded, str) or len(encoded) > 4 * ((MAX_LEDGER_BYTES + 2) // 3)
            or not isinstance(ids, list) or not ids or not all(nonempty(i) for i in ids)
            or len(set(ids)) != len(ids)):
        raise ValueError("invalid ledger attestation encoding or manifest IDs")
    before = base64.b64decode(encoded, validate=True)
    live = checked_bytes(root / LEDGER_PATH, MAX_LEDGER_BYTES)
    after = live[1]
    if (len(before) > MAX_LEDGER_BYTES or base64.b64encode(before).decode("ascii") != encoded
            or any(not isinstance(proof[key], str) or not SHA256.fullmatch(proof[key])
                   or hashlib.sha256(data).hexdigest() != proof[key]
                   for key, data in (("before_sha256", before), ("after_sha256", after)))
            or not after.startswith(before) or (before and not before.endswith(b"\n"))
            or not after.endswith(b"\n")):
        raise ValueError("ledger append bytes do not match the attestation")
    found = []
    for line in after[len(before):-1].decode("utf-8").split("\n"):
        if re.search(r"[\x00-\x08\x0a-\x1f\x7f]", line.removesuffix("\r")):
            raise ValueError("invalid control character in ledger row")
        row = line.strip().removeprefix("|").removesuffix("|")
        cells = [cell.strip() for cell in re.split(r"(?<!\\)\|", row)]
        if (len(cells) != 8 or not all(cells) or not re.fullmatch(r"`[^\x00`]+`", cells[6])
                or not all(re.fullmatch(r"\d{4}-\d{2}-\d{2}", cells[i]) for i in (0, 7))):
            raise ValueError("invalid appended ledger row")
        days = (datetime.date.fromisoformat(cells[7]) - datetime.date.fromisoformat(cells[0])).days
        tokens = (token.strip("`") for token in re.findall(r"`[^`]+`|[^`\s(),;]+", cells[1]))
        refs = [token for token in tokens
                if token in ids or token.startswith(f"{ROOT}/")
                or re.fullmatch(r"[^/]+-[0-9]{2,}-[A-Za-z][\w-]*", Path(token).name)]
        if not 0 <= days <= 30 or len(refs) != 1:
            raise ValueError("ledger row must reference one attested backup")
        found.append(refs[0].removeprefix(f"{ROOT}/"))
    if sorted(found) != sorted(ids):
        raise ValueError("ledger rows do not match the attested backups")
    return ids, before, live


def commit_preflight(change, scheduled=None, *, git_exe=None, backup_versions=None):
    root_identity = backup_root_identity(BACKUP_ROOT) if scheduled is None else scheduled["root_identity"]
    if scheduled is None:
        with open_handoff(BACKUP_ROOT, change, root_identity) as (fd, identity):
            manifest, digest = read_manifest_snapshot(fd)
        baseline = manifest.get("git")
        if manifest.get("session_id") is not None or manifest.get("git_reason") is not None:
            raise ValueError("no interactive clean-start baseline")
    else:
        if scheduled["change_id"] != change.name:
            raise ValueError("change folder is not authorized by the runner")
        baseline, before = scheduled["baseline"], scheduled["before"]
        if not isinstance(before, list) or len(before) != 2 or not all(isinstance(part, list) for part in before):
            raise ValueError("invalid runner exclusions")
        names, identities = before
        if (not isinstance(root_identity, dict)
                or not all(nonempty(name) and Path(name).parent == ROOT for name in names)
                or not all(id_pair(item) for item in identities) or not id_pair(scheduled["change_identity"])
                or not id_pair([root_identity.get(key) for key in ("dev", "ino")])):
            raise ValueError("invalid runner folder identities or exclusions")
        scope = dict(run_id=scheduled["run_id"], session_id=scheduled["session_id"],
                     started=datetime.datetime.fromisoformat(scheduled["started_at"]),
                     before=({Path(name) for name in names}, {tuple(item) for item in identities}),
                     root_identity=root_identity)
        manifest, identity, digest = validate_change_handoff(BACKUP_ROOT, change, **scope)
        if list(identity) != scheduled["change_identity"] or digest != scheduled["manifest_sha256"]:
            raise ValueError("runner-approved change folder or manifest changed")
    if not isinstance(baseline, dict) or baseline.get("clean_start") is not True:
        raise ValueError("no clean-start baseline")
    if git_exe is not None:  # A journaled transaction can recover with a newly trusted Git.
        baseline = dict(baseline, git_executable=git_exe)
    root = Path(baseline["root"])
    if not root.is_absolute() or root.resolve(strict=True) != root:
        raise ValueError("repository root must be canonical")

    manifests = {change: (manifest, identity, digest)}
    edits, files = {}, {}
    backup_versions = {} if backup_versions is None else backup_versions
    remaining = MAX_COMMIT_BYTES
    proof = None if scheduled is None else scheduled["ledger_attestation"]
    if proof is not None:
        ids, ledger_before, edits[root / LEDGER_PATH] = ledger_append(proof, scope, root)
        for folder in ids:
            sibling = ROOT / valid_id(folder)
            if sibling not in manifests:
                manifests[sibling] = validate_change_handoff(BACKUP_ROOT, sibling, **scope)
    for folder, (data, _, _) in manifests.items():
        if (data.get("finished") is not True or data.get("verification") != "passed"
                or data.get("reverted") is not None or "committed" in data or not data["files"]):
            raise ValueError("expected a verified, finished, unreverted file manifest")
        if scheduled is not None and ("git" in data or "git_reason" in data or data["actions"]):
            raise ValueError("scheduled commit requires an ordinary file backup")
        for entry in data["files"]:
            path = validate_entry(folder, entry, plugin_roots())
            if (not path.is_relative_to(root) or ".git" in path.relative_to(root).parts
                    or path == root / LEDGER_PATH or is_credential(str(path)) or path in files):
                raise ValueError("manifest file is outside the permitted scope or is repeated")
            live = checked_bytes(path, remaining)
            remaining -= len(live[1])
            if hashlib.sha256(live[1]).hexdigest() != entry["after_sha256"]:
                raise ValueError("manifest file changed after finish")
            if entry["created"] and (entry.get("backup") is not None or live[0] != b"100644"):
                raise ValueError("new files must be non-executable and have no before backup")
            backup = None if entry["created"] else folder / entry["backup"]
            if backup is not None:
                backup_versions[backup] = file_version(backup.lstat())
                checked_backup_mode(entry, backup_versions[backup][2], stat.S_IMODE(live[2][2]))
            files[path] = backup, live
            if folder == change:
                edits[path] = live
    state, entries, check = capture_git_tree(root, baseline=baseline, edits=edits)
    for path, (backup, live) in files.items():
        blob = entries.get(path)
        if (check[1].get(path) != live[2] or (blob is None) != (backup is None)
                or (blob is not None and (live[0] != blob[0]
                    or not matches_blob(backup, *blob, expected=backup_versions[backup])))):
            raise ValueError("manifest before bytes or mode differ from HEAD")
    if proof is not None:
        ledger = root / LEDGER_PATH
        mode, oid = entries.get(ledger, (None, b""))
        if mode != edits[ledger][0] or object_id("blob", ledger_before, len(oid)) != oid:
            raise ValueError("ledger baseline differs from HEAD")

    def recheck():
        for folder, (_, identity, digest) in manifests.items():
            verify_change_handoff(BACKUP_ROOT, folder, root_identity=root_identity,
                                  identity=identity, manifest_sha256=digest)
        if not still_clean(*check):
            raise ValueError("repository changed during commit preflight")
        if any(file_version(path.lstat()) != version for path, version in backup_versions.items()):
            raise ValueError("commit backup changed after preflight")

    recheck()
    return state, entries, {path: live[:2] for path, live in edits.items() if path != root / LEDGER_PATH}, recheck


def object_id(kind, raw, oid_length):
    algorithm = "sha256" if oid_length == 64 else "sha1"
    digest = hashlib.new(algorithm, kind.encode("ascii") + b" %d\0" % len(raw))
    digest.update(raw)
    return digest.hexdigest().encode("ascii")


def tree_from_files(state, entries, files, recheck):
    root, head, git_exe = Path(state["root"]), state["head"], state["git_executable"]
    recheck()
    entries = {os.fsencode(path.relative_to(root)): data for path, data in entries.items()}
    for path, (mode, raw) in files.items():
        oid = git(root, "hash-object", "-w", "--no-filters", "--stdin", git_exe=git_exe, input=raw).strip()
        if oid != object_id("blob", raw, len(head)):
            raise ValueError("stored Git blob differs from verified bytes")
        entries[os.fsencode(path.relative_to(root))] = mode, oid
    return entries


def write_tree(state, entries):
    root, git_exe = Path(state["root"]), state["git_executable"]
    with git_scratch(root) as directory:
        index = Path(directory) / "index"
        updates = b"".join(mode + b" " + oid + b"\t" + name + b"\0" for name, (mode, oid) in entries.items())
        git(root, "update-index", "-z", "--index-info", git_exe=git_exe, index=index, input=updates)
        tree = git(root, "write-tree", git_exe=git_exe, index=index).strip()
        if verified_tree(root, tree, git_exe) != entries:
            raise ValueError("built tree differs from verified files")
        return tree.decode("ascii")


@contextmanager
def ref_lock():
    if fcntl is None:
        raise ValueError("ref recovery requires file locking")
    with open_directory(ROOT) as fd, open_backup_lock(fd) as lock:
        lock_exclusive(lock)
        yield


@contextmanager
def file_undo_lock():
    with ExitStack() as stack:
        locked = False
        if os.path.lexists(ROOT / BACKUP_LOCK):
            try:
                stack.enter_context(ref_lock())
                locked = True
            except BlockingIOError:
                raise
            except (OSError, ValueError):
                pass  # Ordinary file backups can exist after a lock failure.
        yield locked


def legacy_record_name(name):
    return "r-" + hashlib.sha256(os.fsencode(name)).hexdigest()


def identity_record_name(identity):
    return "i-{:x}-{:x}".format(*identity)


def record_path(change):
    info = change.stat()
    return ROOT / ".kaizen-refs" / identity_record_name((info.st_dev, info.st_ino))


def has_record(change):
    return (os.path.lexists(record_path(change))
            or os.path.lexists(ROOT / ".kaizen-refs" / legacy_record_name(change.name)))


def local_ref():
    # Keep the ref outside refs/heads so ordinary checkout can only detach at it.
    return f"refs/kaizen/{datetime.date.today().isoformat()}"


def check_legacy_record(path, record, folders):
    identity, digest = record["manifest"]
    folder = folders.get(tuple(identity))
    if folder is None:
        raise ValueError(f"cannot locate the backup for legacy ref record {path.name}")
    with open_directory(folder) as fd:
        info = os.fstat(fd)
        data, live_digest = read_manifest_snapshot(fd)
    # The legacy writer serialized manifests like save(), with reverted initially null.
    if data.get("reverted") and (record.get("inverse", {}).get("done") or record["commit"].get("cancelled")):
        original = json.dumps(dict(data, reverted=None), indent=2) + "\n"
        live_digest = hashlib.sha256(original.encode("ascii")).hexdigest()
    if list(identity) != [info.st_dev, info.st_ino] or digest != live_digest:
        raise ValueError(f"manifest changed or foreign backup for legacy ref record {path.name}")


def read_records(*, tolerate_unrelated=False):
    store = ROOT / ".kaizen-refs"
    if not os.path.lexists(store):
        return {}
    records, owners, folders = {}, set(), None
    for path in private_store().iterdir():
        if path.name.startswith(".pending-"):
            continue
        try:
            _, raw, version = checked_bytes(path, MAX_LEDGER_BYTES)
            if stat.S_IMODE(version[2]) != 0o600 or path.lstat().st_uid != os.getuid():
                raise ValueError("ref record must be private")
            record = json.loads(raw, object_pairs_hook=unique_fields)
            name = record["change"]
            identity, digest = record["manifest"]
            if (not isinstance(name, str) or not re.fullmatch(r"[^\r\n\0/]+", name)
                    or not id_pair(identity) or not SHA256.fullmatch(digest)):
                raise ValueError("invalid ref record identity")
            modes = record.get("legacy_modes", {})
            if not isinstance(modes, dict) or any(type(mode) is not int or not 0 <= mode <= 0o7777
                                                   for mode in modes.values()):
                raise ValueError("invalid journaled backup modes")
        except (OSError, ValueError, KeyError, TypeError, IndexError, RecursionError) as error:
            # An unreadable legacy journal could own any renamed directory,
            # even if another directory now occupies its original name.
            if not tolerate_unrelated or not re.fullmatch(r"i-[0-9a-f]+-[0-9a-f]+", path.name):
                raise ValueError(f"cannot read ref record {path.name}: {error}") from None
            continue
        if (path.name not in (identity_record_name(identity), legacy_record_name(name))
                or name in records or tuple(identity) in owners):
            raise ValueError(f"foreign or duplicate ref record: {path.name}")
        if path.name.startswith("r-"):
            if folders is None:
                folders = {}
                for folder in ROOT.iterdir():
                    info = folder.lstat()
                    if stat.S_ISDIR(info.st_mode):
                        folders[info.st_dev, info.st_ino] = folder
            check_legacy_record(path, record, folders)
        records[name] = record
        owners.add(tuple(identity))
    return records


def record_for_change(change, identity, records):
    for name, record in records.items():
        if tuple(record["manifest"][0]) == identity:
            if name != change.name:
                raise ValueError(f"journaled backup was renamed; restore its folder name to {name}")
            return record
    if change.name in records:
        raise ValueError(f"foreign ref record for backup {change}")
    return None


def save_record(change, record):
    raw = json.dumps(record, sort_keys=True).encode("ascii")
    if len(raw) > MAX_LEDGER_BYTES:
        raise ValueError("ref record exceeds its size limit")
    store = private_store()
    path = record_path(change)
    if path.name != identity_record_name(record["manifest"][0]):
        raise ValueError("ref record directory changed")
    legacy = store / legacy_record_name(change.name)
    if os.path.lexists(legacy):
        path = legacy  # Keep the filename of an already validated legacy journal.
    with open_directory(ROOT) as root_fd, open_directory(store) as fd:
        os.fsync(root_fd)  # Persist the private directory before any effect.
        with tempfile.NamedTemporaryFile(dir=store, prefix=".pending-", delete=False) as stream:
            temporary = Path(stream.name)
            try:
                stream.write(raw)
                stream.flush()
                os.fsync(stream.fileno())
                os.replace(temporary, path)
                os.fsync(fd)
            finally:
                temporary.unlink(missing_ok=True)


def manifest_stamp(change):
    with open_handoff(BACKUP_ROOT, change, backup_root_identity(BACKUP_ROOT)) as (fd, identity):
        data, digest = read_manifest_snapshot(fd)
    if not re.fullmatch(r"[^\r\n\0/]+", change.name):
        raise ValueError("invalid commit trailer ID")
    return data, [list(identity), digest]


def checked_backup_mode(entry, mode, recorded=None, *, live_mode=None):
    mode = stat.S_IMODE(mode)
    expected = entry.get("before_mode", recorded)
    if "before_mode" not in entry and recorded is None:
        # A legacy backup is the only source of permissions if the target was removed.
        return mode & (0o777 if live_mode is None or mode == live_mode else 0o700)
    if type(expected) is not int or mode != expected:
        raise ValueError(f"undo backup mode cannot be verified: {entry['path']}")
    return expected


def sync_commit_backup(change, record, versions, git_exe):
    legacy = record.get("legacy_modes", {}).copy()
    if versions is None:
        # Republishing a completed transaction after a lost ref rename.
        old, state = record["commit"]["old"], record["state"]
        tree = commit_tree(record, old if old.strip("0") else state["head"], git_exe)
    with open_handoff(BACKUP_ROOT, change, backup_root_identity(BACKUP_ROOT)) as (change_fd, identity):
        data, digest = read_manifest_snapshot(change_fd, sync=True)
        if [list(identity), digest] != record["manifest"]:
            raise ValueError("commit manifest changed before backup sync")
        parents = set()
        for entry in data["files"]:
            if entry["created"]:
                continue
            path = change / entry["backup"]
            if change not in path.parents or ".." in path.parts:
                raise ValueError("commit backup must be inside its change directory")
            flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
            with open_directory_walk(path.parent) as fd:
                with os.fdopen(os.open(path.name, flags, dir_fd=fd), "rb") as backup:
                    info = os.fstat(backup.fileno())
                    version = file_version(info)
                    name = entry["backup"]
                    if versions is not None:
                        if version != versions.get(path):
                            raise ValueError("commit backup changed after preflight")
                        if "before_mode" not in entry:
                            legacy.setdefault(name, stat.S_IMODE(info.st_mode))
                    else:
                        blob = tree.get(os.fsencode(Path(entry["path"]).relative_to(state["root"])))
                        if not blob or not matches_blob(path.name, *blob, dir_fd=fd, expected=version):
                            raise ValueError("commit backup differs from the original Git tree")
                    checked_backup_mode(entry, info.st_mode, legacy.get(name))
                    os.fsync(backup.fileno())
                    if live_file_version(path.name, fd) != version:
                        raise ValueError("commit backup changed during sync")
            parents.update(parent for parent in path.parents if change in parent.parents)
        for parent in sorted(parents, key=lambda path: len(path.parts), reverse=True):
            with open_directory_walk(parent) as fd:
                os.fsync(fd)
        os.fsync(change_fd)
    for parent in change.parents:
        with open_directory(parent) as fd:
            os.fsync(fd)
    if legacy:
        record["legacy_modes"] = legacy


def ref_scope(record, git_exe):
    state = record["state"]
    root = Path(state["root"])
    live = git_identity(root, git_exe)
    if any(live[key] != state[key] for key in ("root", "worktree", "common_dir")):
        raise ValueError("Git repository identity changed")
    return root


def check_git_write_paths(record, *, objects=False, ref=None):
    common = Path(record["state"]["common_dir"]["path"])
    ref = ref or record["ref"]
    paths = [common / ref, common / "logs" / ref, common / "packed-refs"]
    regular_leaves = set(paths)
    if objects:
        directory = common / "objects"
        refuse_symlinks(directory)
        index = directory / "loose-object-idx"
        regular_leaves.add(index)
        paths.extend([directory, index, *(path for path in directory.iterdir()
                                          if re.fullmatch(r"[0-9a-f]{2}", path.name))])
    for path in paths:
        for item in (path, *path.parents):
            if item == common.parent:
                break
            if os.path.lexists(item):
                info = item.lstat()
                regular = stat.S_ISREG(info.st_mode) and info.st_nlink == 1
                if not trusted_owner(info) or not (stat.S_ISDIR(info.st_mode) or (item in regular_leaves and regular)):
                    raise ValueError("unsafe Git metadata path for ref or object writes")
    if os.path.lexists(common / "reftable"):
        raise ValueError("unsupported Git ref storage for backup writes")
    return common


def loose_symref(path, *, refuse_symlink=False):
    try:
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode):
            if refuse_symlink:
                raise ValueError(f"loose Git ref is a filesystem symlink: {path}")
            return os.fsencode(os.readlink(path))
        if stat.S_ISREG(info.st_mode):
            with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), "rb") as stream:
                raw = stream.read(4096)
            if raw.startswith(b"ref:"):
                return raw[4:].strip()
    except FileNotFoundError:
        pass
    return b""


def check_symbolic_refs(root, git_exe, common):
    prefix = b"refs/kaizen/"
    # Git's iterator omits dangling refs and can report the end of a symbolic chain.
    # Inspect loose refs and every HEAD for the immediate target as well.
    worktrees = common / "worktrees"
    refuse_symlinks(worktrees)
    for directory in (common, *(path for path in worktrees.glob("*") if path.is_dir())):
        refuse_symlinks(directory)
        if loose_symref(directory / "HEAD").lower().startswith(prefix):
            raise ValueError("kaizen ref is checked out or targeted by a symbolic HEAD")
        refs = directory / "refs"
        for path in refs.rglob("*"):
            if path.name.endswith(".lock"):
                continue
            refuse_symlink = path.relative_to(refs).parts[0].lower() in ("heads", "tags")
            target = loose_symref(path, refuse_symlink=refuse_symlink)
            if target.lower().startswith(prefix):
                raise ValueError(f"symbolic ref targets refs/kaizen/: {path}")
    for row in git(root, "for-each-ref", "--format=%(refname) %(symref)", git_exe=git_exe).splitlines():
        if row.partition(b" ")[2].lower().startswith(prefix):
            raise ValueError(f"symbolic ref targets refs/kaizen/: {os.fsdecode(row.partition(b' ')[0])}")


def checked_ref(record, records, phase, git_exe, observing=None):
    root = ref_scope(record, git_exe)
    ref = record["ref"]
    if not re.fullmatch(r"refs/kaizen/\d{4}-\d{2}-\d{2}", ref, re.ASCII):
        raise ValueError("invalid kaizen ref")
    common = check_git_write_paths(record)
    args = {"git_exe": git_exe}
    if b"branch " + ref.encode("ascii") in git(root, "worktree", "list", "--porcelain", "-z", **args).split(b"\0"):
        raise ValueError("kaizen ref is checked out")
    check_symbolic_refs(root, git_exe, common)
    try:
        git(root, "symbolic-ref", "--no-recurse", "-q", ref, **args)
    except subprocess.CalledProcessError as error:
        if error.returncode != 1:
            raise
    else:
        raise ValueError("kaizen ref is symbolic")
    rows = git(root, "for-each-ref", "--format=%(refname) %(objectname)", ref, **args).splitlines()
    zero = "0" * len(record["state"]["head"])
    tip = zero
    if rows:
        if len(rows) != 1 or not rows[0].startswith(ref.encode("ascii") + b" "):
            raise ValueError("unexpected refs under the kaizen ref")
        tip = rows[0].split(b" ", 1)[1].decode("ascii")

    completed, pending, bases = {}, None, set()
    for other in records.values():
        if other["ref"] != ref or other["state"]["common_dir"] != record["state"]["common_dir"]:
            continue
        for name in ("commit", "inverse"):
            effect = other.get(name)
            if effect is None or effect.get("cancelled"):
                continue
            if effect["done"]:
                if effect["old"] in completed:
                    raise ValueError("conflicting kaizen ref records")
                completed[effect["old"]] = (effect, other["change"], name)
                bases.update((effect["new"], other["state"]["head"]))
            elif ((other["change"], name) == (record["change"], phase)
                  or (other["change"], name) == (observing, "inverse")) and pending is None:
                pending = effect
            else:
                raise ValueError("kaizen ref has another pending transaction")
    expected, tail = zero, None
    while expected in completed:
        tail = completed.pop(expected)
        expected = tail[0]["new"]
    if completed or (pending and pending["old"] != expected):
        raise ValueError("kaizen ref records do not form a single history")
    if phase == "commit" and bases and record["state"]["head"] not in bases:
        raise ValueError("kaizen ref does not descend from the captured HEAD")
    if tip != expected and (pending is None or tip != pending["new"]):
        if tail and tip == tail[0]["old"]:
            if pending is None and tail[1:] == (record["change"], phase):
                return tip
            command = "commit" if tail[2] == "commit" else "undo"
            raise ValueError(f"kaizen ref moved to its previous value; retry {command} for {tail[1]}")
        if tip == zero and tail:
            raise ValueError(f"journaled kaizen ref is missing: {ref}; expected {expected}")
        raise ValueError("kaizen ref moved or has no journaled owner")
    return tip


def commit_tree(record, oid, git_exe):
    root = Path(record["state"]["root"])
    raw = verify_object(root, "commit", oid.encode("ascii"), git_exe)
    return verified_tree(root, raw.split(b"\n", 1)[0].removeprefix(b"tree "), git_exe)


def overlay(before, after, onto):
    merged = onto.copy()
    for name in before.keys() | after.keys():
        if before.get(name) == after.get(name):
            continue
        if before.get(name) != onto.get(name):
            raise ValueError("kaizen ref contains an overlapping change")
        if name in after:
            merged[name] = after[name]
        else:
            del merged[name]
    for name in merged:
        directory = name.rpartition(b"/")[0]
        while directory:
            if directory in merged:
                raise ValueError("kaizen ref contains an overlapping directory change")
            directory = directory.rpartition(b"/")[0]
    return merged


def effect_message(record, phase):
    subject = "verified backup" if phase == "commit" else f"revert {record['commit']['new']}"
    return f"kaizen: {subject}\n\nkaizen-backup change: {record['change']}"


def verify_effect(record, phase, git_exe, *, tree_oids=None):
    effect, state = record[phase], record["state"]
    parent = effect["old"] if effect["old"].strip("0") else state["head"]
    root = Path(state["root"])
    raw = verify_object(root, "commit", effect["new"].encode("ascii"), git_exe)
    headers, _, message = raw.partition(b"\n\n")
    expected = f"tree {effect['tree']}\nparent {parent}".encode("ascii").splitlines()
    if (headers.split(b"\n", 2)[:2] != expected
            or headers.count(b"\nparent ") != 1
            or message != os.fsencode(effect_message(record, phase) + "\n")):
        raise ValueError("kaizen commit parent, tree or trailer differs from its record")
    return verified_tree(root, effect["tree"].encode("ascii"), git_exe, tree_oids=tree_oids)


def refuse_ref_lock(path):
    lock = path.with_name(path.name + ".lock")
    if os.path.lexists(lock):
        raise ValueError(f"Git ref lock exists: {lock}. Check that no Git process is running, "
                         "then remove the lock manually and retry.")


def sync_ref_dirs(common, ref):
    # Sync new directory entries all the way up, including the parent of packed-refs.
    for directory in (common / ref).parents:
        if directory == common.parent:
            break
        try:
            with open_directory_walk(directory) as fd:
                os.fsync(fd)
        except FileNotFoundError:
            if directory == common:
                raise


def sync_object_dirs(common, oids):
    objects = common / "objects"
    # Git fsyncs object files. Persist loose fan-outs and any pack entries before the pin.
    directories = {objects / oid[:2].decode("ascii") for oid in oids}
    for directory in sorted(directories | {objects / "pack"}):
        try:
            with open_directory_walk(directory) as fd:
                os.fsync(fd)
        except FileNotFoundError:
            pass  # A referenced object may only exist in a pack.
    with open_directory_walk(objects) as fd:
        os.fsync(fd)


def pin_prefix():
    return "refs/kaizen/pending/" + hashlib.sha256(os.fsencode(ROOT)).hexdigest() + "/"


def pin_ref(record, phase):
    return pin_prefix() + legacy_record_name(record["change"]) + "-" + phase


def change_pin(record, ref, oid, git_exe, *, remove=False):
    common = check_git_write_paths(record, ref=ref)
    path = common / ref
    refuse_ref_lock(path)
    if loose_symref(path):
        raise ValueError(f"pending pin is a symbolic ref: {ref}")
    options = dict(git_exe=git_exe)
    root = record["state"]["root"]
    rows = git(root, "for-each-ref", "--format=%(refname) %(objectname)", ref, **options).splitlines()
    if rows and rows != [f"{ref} {oid}".encode("ascii")]:
        raise ValueError(f"pending pin differs from its ref transaction: {ref}")
    if remove and rows:
        git(root, "update-ref", "--no-deref", "-d", ref, oid, **options)
    if not remove:
        if not rows:
            git(root, "update-ref", "--no-deref", ref, oid, "0" * len(oid), **options)
        sync_ref_dirs(common, ref)


def cleanup_pins(record, records, git_exe, *, only=None):
    state = record["state"]
    prefix = pin_prefix()
    pending = {pin_ref(other, phase) for other in records.values()
               if other["state"]["common_dir"] == state["common_dir"]
               for phase in ("commit", "inverse") if phase in other
               and not (other[phase]["done"] or other[phase].get("cancelled"))}
    rows = git(state["root"], "for-each-ref", "--format=%(refname) %(objectname)", only or prefix,
               git_exe=git_exe).splitlines()
    for row in rows:
        ref, oid = row.decode("ascii").split(" ")
        if ((only is None or ref == only) and ref not in pending
                and re.fullmatch(re.escape(prefix) + r"r-[a-f0-9]{64}-(commit|inverse)", ref)):
            change_pin(record, ref, oid, git_exe, remove=True)


def update_ref(root, git_exe, ref, effect, check, *, verify_only=False):
    path = Path(os.fsdecode(git(root, "rev-parse", "--path-format=absolute", "--git-path", ref,
                               git_exe=git_exe).removesuffix(b"\n")))
    refuse_ref_lock(path)
    for oid in (effect["old"], effect["new"]):
        if not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", oid):
            raise ValueError("invalid ref transaction object ID")
    command, env = git_command(root, "update-ref", "--stdin", git_exe=git_exe)
    with subprocess.Popen(command, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL) as proc:
        def exchange(request, response):
            try:
                proc.stdin.write(request.encode("ascii"))
                proc.stdin.flush()
            except BrokenPipeError:
                refuse_ref_lock(path)
                raise
            if not select.select([proc.stdout], [], [], 10)[0] or proc.stdout.readline(128) != response:
                refuse_ref_lock(path)
                raise ValueError("Git refused the ref transaction")

        try:
            exchange("start\n", b"start: ok\n")
            old = effect["old"]
            operation = f"verify {ref} {old}" if verify_only else f"update {ref} {effect['new']} {old}"
            exchange(f"option no-deref\n{operation}\nprepare\n", b"prepare: ok\n")
            check()
            if not verify_only:
                exchange("commit\n", b"commit: ok\n")
        finally:
            try:
                proc.stdin.close()  # EOF aborts a prepared transaction and releases Git's ref lock.
            except BrokenPipeError:
                pass  # Git exited while receiving a request.
            try:
                status = proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                proc.kill()
                raise
        if status:
            raise ValueError("Git refused the ref transaction")


def transact_ref(change, record, records, phase, tip, entries, recheck, git_exe, *, backup_versions=None):
    state = record["state"]
    root = Path(state["root"])
    effect = record.get(phase)
    pin = pin_ref(record, phase)
    common = Path(state["common_dir"]["path"])
    if effect is None or tip == effect["old"]:
        refuse_ref_lock(common / record["ref"])
    oids = {oid for _, oid in entries.values()}
    for oid in oids:
        verify_object(root, "blob", oid, git_exe)
    if effect is None:
        parent = tip if tip.strip("0") else state["head"]
        if entries == commit_tree(record, parent, git_exe):
            raise ValueError("nothing to commit")
        check_git_write_paths(record, objects=True)
        if phase == "inverse":
            # The previous attempt may have pinned an inverse before saving its journal.
            cleanup_pins(record, records, git_exe, only=pin)
        tree = write_tree(dict(state, git_executable=git_exe), entries)
        new = git(root, "-c", "commit.gpgsign=false", "commit-tree", tree, "-p", parent,
                  "-m", effect_message(record, phase), git_exe=git_exe).decode("ascii").strip()
        record[phase] = effect = dict(old=tip, new=new, tree=tree, done=False)
    if verify_effect(record, phase, git_exe, tree_oids=oids) != entries:
        raise ValueError("kaizen commit differs from the verified tree")
    oids.add(effect["new"].encode("ascii"))
    sync_object_dirs(common, oids)
    if phase == "commit" and tip == effect["old"]:
        sync_commit_backup(change, record, backup_versions, git_exe)
    change_pin(record, pin, effect["new"], git_exe)
    if tip == effect["old"]:
        recheck()
        save_record(change, record)  # Sync again on retry after an interrupted record write.
        records[change.name] = record

        def check():
            recheck()
            if checked_ref(record, records, phase, git_exe) != tip:
                raise ValueError("kaizen ref moved before update")

        update_ref(root, git_exe, record["ref"], effect, check)
    if checked_ref(record, records, phase, git_exe) != effect["new"]:
        raise ValueError("kaizen ref moved after update")
    verify_effect(record, phase, git_exe)
    sync_ref_dirs(common, record["ref"])
    effect["done"] = True
    save_record(change, record)
    change_pin(record, pin, effect["new"], git_exe, remove=True)


def write_commit(change, scheduled, key, authorize=lambda: None):
    authorize()
    records = read_records()
    if key and any(other["key"] == key and other["change"] != change.name for other in records.values()):
        raise ValueError("action ID is already bound to another backup")
    _, stamp = manifest_stamp(change)
    if scheduled is not None and stamp != [scheduled["change_identity"], scheduled["manifest_sha256"]]:
        raise ValueError("runner-approved change folder or manifest changed")
    request = hashlib.sha256(json.dumps(scheduled, sort_keys=True).encode("ascii")).hexdigest()
    record = record_for_change(change, tuple(stamp[0]), records)
    git_exe, backup_versions = None, None
    if record is not None:
        if ((record["key"], record["request"], record["manifest"]) != (key, request, stamp)
                or "inverse" in record or record["commit"].get("cancelled")):
            raise ValueError("commit transaction scope differs or was reverted")
        # Keep the captured executable identity in the journal for diagnostics.
        git_exe = resolve_git()
        tip = checked_ref(record, records, "commit", git_exe)
        entries = verify_effect(record, "commit", git_exe)
        if record["commit"]["done"]:
            if tip == record["commit"]["old"]:
                transact_ref(change, record, records, "commit", tip, entries, authorize, git_exe)
            cleanup_pins(record, records, git_exe)
            return record
    if record is None or tip == record["commit"]["old"]:
        backup_versions = {}
        state, base, files, check = commit_preflight(change, scheduled, git_exe=git_exe,
                                                     backup_versions=backup_versions)
        git_exe = state["git_executable"]

        def recheck():
            authorize()
            check()
            if manifest_stamp(change)[1] != stamp:
                raise ValueError("commit manifest changed")

        if record is None:
            record = dict(change=change.name, key=key, request=request, manifest=stamp, state=state,
                          ref=local_ref())
            tip = checked_ref(record, records, "commit", git_exe)
            cleanup_pins(record, records, git_exe)
        elif state != dict(record["state"], git_executable=git_exe):
            raise ValueError("Git baseline differs from the pending commit")
        original = {os.fsencode(path.relative_to(state["root"])): entry for path, entry in base.items()}
        onto = commit_tree(record, tip, git_exe) if tip.strip("0") else original
        if any(base.get(path) != onto.get(os.fsencode(path.relative_to(state["root"]))) for path in files):
            raise ValueError("kaizen ref contains an overlapping change")
        check_git_write_paths(record, objects=True)
        merged = overlay(original, tree_from_files(state, base, files, recheck), onto)
        if "commit" in record and merged != entries:
            raise ValueError("pending commit differs from verified edits")
        entries = merged
    else:
        recheck = lambda: None
    transact_ref(change, record, records, "commit", tip, entries, recheck, git_exe,
                 backup_versions=backup_versions)
    cleanup_pins(record, records, git_exe)
    return record


def recover_commit(change, action_id, request, project):
    """Resolve a reserved commit through its native journal without starting a ref effect."""
    records = read_records()
    if not change.exists() and change.name not in records:
        return "absent"
    info = change.stat()
    record = record_for_change(change, (info.st_dev, info.st_ino), records)
    if record is None:
        return "absent"
    if ((record["key"], record["request"], record["state"]["root"]) != (action_id, request, project)
            or "inverse" in record or manifest_stamp(change)[1] != record["manifest"]):
        raise ValueError("commit journal does not match the broker reservation")
    git_exe = resolve_git()
    effect = record["commit"]
    pin = pin_ref(record, "commit")
    if effect.get("cancelled"):
        ref_scope(record, git_exe)
        cleanup_pins(record, records, git_exe, only=pin)
        return "cancelled"
    tip = checked_ref(record, records, "commit", git_exe)
    entries = verify_effect(record, "commit", git_exe)
    if tip == effect["old"]:
        if effect["done"]:
            raise ValueError("completed commit ref moved to its previous value")
        cancel_commit(change, record, records, tip, git_exe)
    elif not effect["done"]:
        transact_ref(change, record, records, "commit", tip, entries, lambda: None, git_exe)
    cleanup_pins(record, records, git_exe, only=pin)
    return "cancelled" if effect.get("cancelled") else f"verified {effect['new']}"


def cancel_commit(change, record, records, tip, git_exe, recheck=lambda: None):
    def cancel_prepared():
        recheck()
        if checked_ref(record, records, "commit", git_exe) != tip:
            raise ValueError("kaizen ref moved before cancelling the pending commit")
        record["commit"]["cancelled"] = True
        save_record(change, record)

    root = ref_scope(record, git_exe)
    update_ref(root, git_exe, record["ref"], record["commit"], cancel_prepared, verify_only=True)


def checked_inverse(change, data, record, records, git_exe, observing=None):
    original = record["commit"]
    live, stamp = manifest_stamp(change)
    if data != live or record["manifest"] != stamp:
        raise ValueError("commit manifest changed before undo")
    tip = None
    if original["done"]:
        tip = checked_ref(record, records, "inverse", git_exe, observing)
    elif not original.get("cancelled"):
        tip = checked_ref(record, records, "commit", git_exe)
        if tip != original["old"]:
            raise ValueError("complete the pending commit before undo")
    else:
        ref_scope(record, git_exe)
    after = verify_effect(record, "commit", git_exe) if original["done"] else None
    parent = original["old"] if original["old"].strip("0") else record["state"]["head"]
    before = commit_tree(record, parent, git_exe)
    root = Path(record["state"]["root"])
    backups = {}
    for entry in data["files"]:
        path = validate_entry(change, entry, plugin_roots())
        blob = before.get(os.fsencode(path.relative_to(root)))
        if entry["created"] != (blob is None) or (blob and not matches_blob(change / entry["backup"], *blob)):
            raise ValueError("undo backup differs from the original Git tree")
        backups[path] = blob
    if not original["done"]:
        return tip, None, original.get("cancelled"), backups
    inverse = record.get("inverse")
    entries = overlay(after, before, commit_tree(record, inverse["old"] if inverse else tip, git_exe))
    if inverse and verify_effect(record, "inverse", git_exe) != entries:
        raise ValueError("pending inverse differs from the verified inverse tree")
    applied = inverse and (inverse["done"] or tip == inverse["new"])
    return tip, entries, applied, backups


def commit(args):
    try:
        folder = Path(os.path.abspath(Path(args.change).expanduser()))
        scheduled, key = None, None
        if args.scheduled_recovery_stdin:
            raw = sys.stdin.buffer.read(8193)
            if len(raw) > 8192:
                raise ValueError("scheduled commit recovery binding exceeds its size limit")
            binding = json.loads(raw)
            if not isinstance(binding, list) or len(binding) != 3:
                raise ValueError("invalid scheduled commit recovery binding")
            action_id, request, project = binding
            if (not re.fullmatch(r"fa1_[0-9a-f]{64}", action_id) or not SHA256.fullmatch(request)
                    or not isinstance(project, str) or folder.parent != ROOT):
                raise ValueError("invalid scheduled commit recovery binding")
            scheduled_commit_authority(folder, action_id, request, project)
            with ref_lock():
                print(recover_commit(folder, action_id, request, project))
            return
        if args.scheduled_baseline_stdin:
            limit = 2 * MAX_LEDGER_BYTES
            raw = sys.stdin.buffer.read(limit + 1)
            if len(raw) > limit:
                raise ValueError("scheduled baseline exceeds its size limit")
            scheduled = json.loads(raw, object_pairs_hook=unique_fields)
            if isinstance(scheduled, dict) and "action_id" in scheduled:
                key = scheduled.pop("action_id")
                if not isinstance(key, str) or not re.fullmatch(r"fa1_[0-9a-f]{64}", key):
                    raise ValueError("invalid runner action ID")
            if (not v1_fields(scheduled, "v baseline root_identity run_id session_id started_at before "
                              "change_id change_identity manifest_sha256 ledger_attestation")
                    or not all(nonempty(scheduled[name]) for name in ("run_id", "session_id"))):
                raise ValueError("invalid scheduled baseline")
            if key is None:
                state, _, _, _ = commit_preflight(folder, scheduled)
                checked_ref(dict(change=folder.name, state=state, ref=local_ref()), read_records(),
                            "commit", state["git_executable"])
                print("commit preflight passed")
                return
        with ref_lock():
            if key is None:
                record = write_commit(folder, scheduled, key)
            else:
                request = hashlib.sha256(json.dumps(scheduled, sort_keys=True).encode("ascii")).hexdigest()
                authorize = scheduled_commit_authority(folder, key, request, scheduled["baseline"]["root"],
                                                       scheduled["run_id"])
                record = write_commit(folder, scheduled, key, authorize)
        print(f"committed {record['commit']['new']} on {record['ref']}")
    except (OSError, ValueError, KeyError, TypeError, IndexError, RuntimeError, subprocess.SubprocessError) as error:
        raise ValueError(f"commit refused: {capture_reason(error)}") from None


def scheduled_commit_authority(folder, key, request, project, run_id=None):
    runtime = runpy.run_path(str(Path(__file__).resolve().with_name("kaizen_friction_apply.py")))
    return runtime["commit_authority"](folder, key, request, project, globals(), run_id)


def begin(args):
    # Preflight every input before copying anything or creating a change folder.
    paths = []
    for name in args.files:
        # User paths may use a symlinked home or /tmp. Keep the checked canonical target.
        path = resolved_path(Path(name).expanduser())
        if is_credential(name) or is_credential(str(path)):
            raise ValueError(f"refusing to back up credential path: {name}")
        if path.exists() and not path.is_file():
            sys.exit(f"kaizen-backup: {path} is not a regular file")
        paths.append(path)
    # Serialize numbering and baseline capture across simultaneous begins. Any lock
    # problem drops only the clean-start stamp; the ordinary backup always proceeds.
    with ExitStack() as stack:
        try:
            if fcntl is None:
                raise ValueError("file locking is unavailable")
            root_fd = stack.enter_context(open_directory(ROOT))
            lock_fd = stack.enter_context(open_backup_lock(root_fd))
            lock_exclusive(lock_fd)
        except (OSError, ValueError) as error:
            stack.close()
            return write_backup(args, paths, reason=f"backup lock unavailable: {error}")
        return write_backup(args, paths, root_fd, lock_fd)


LOCK_WAIT_SECONDS = 10


def lock_exclusive(fd):
    deadline = time.monotonic() + LOCK_WAIT_SECONDS
    while True:
        try:
            return fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            if time.monotonic() >= deadline:
                raise
            time.sleep(0.05)


def capture_reason(error):
    if isinstance(error, subprocess.SubprocessError):
        return "a Git query failed"
    return str(error) or type(error).__name__


def copy_backup(path, destination):
    with ExitStack() as stack:
        flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
        try:
            fd = stack.enter_context(open_directory_walk(path.parent, search=True))
            source = stack.enter_context(os.fdopen(os.open(path.name, flags, dir_fd=fd), "rb"))
        except FileNotFoundError:
            return None
        info = os.fstat(source.fileno())
        if not stat.S_ISREG(info.st_mode):
            raise ValueError(f"{path} is not a regular file")
        with destination.open("wb") as backup:
            shutil.copyfileobj(source, backup)
        shutil.copystat(source.fileno(), destination)
        return stat.S_IMODE(info.st_mode)


def write_backup(args, paths, root_fd=None, lock_fd=None, reason=None):
    created_at = datetime.datetime.now(datetime.timezone.utc).isoformat()
    run_id = args.run or os.environ.get("KAIZEN_RUN_ID") or datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    session_id = os.environ.get("KAIZEN_SESSION_ID")
    valid_id(run_id)
    valid_id(args.skill)
    number, change = allocate_change(run_id, args.skill)
    # A previous manifest's advisory Git stamp is never reused.
    if reason is None and session_id is not None:
        reason = "scheduled runs record no clean-start stamp"
    elif reason is None and number != 1:
        reason = "only the first backup of a run records a clean-start stamp"
    baseline = None
    try:
        if args.repo is not None and reason is None:
            try:
                scratch_parent(Path(args.repo).expanduser().resolve(strict=True))
                root_stamp = backup_root_stamp(ROOT, root_fd)
                if root_stamp["lock"] != list(file_version(os.fstat(lock_fd))):
                    raise ValueError("backup lock was replaced")
                baseline, blobs, check = capture_git_tree(args.repo)
                repo = Path(baseline["root"])
                check_backup_root(BACKUP_ROOT, root_stamp)
            except Exception as error:  # Advisory: never let the capture block the backup.
                baseline, reason = None, capture_reason(error)
        (change / "files").mkdir(mode=0o700)
        entries = []
        for index, path in enumerate(paths, 1):
            backup = f"files/{index}"
            mode = copy_backup(path, change / backup)
            entry = {"path": str(path), "backup": None, "created": mode is None, "after_sha256": None}
            if mode is not None:
                entry.update(backup=backup, before_mode=mode)
            if baseline is not None and path.is_relative_to(repo):
                try:
                    blob = blobs.get(path)
                    backup = entry["backup"]
                    if not (backup is None if blob is None else (
                            backup is not None and matches_blob(change / backup, *blob))):
                        raise ValueError("a backed-up file differs from HEAD")
                except Exception as error:
                    baseline, reason = None, capture_reason(error)
            entries.append(entry)
        if baseline is not None:
            try:
                check_backup_root(BACKUP_ROOT, root_stamp)
                if not still_clean(*check):
                    raise ValueError("repository changed during backup")
            except Exception as error:
                baseline, reason = None, capture_reason(error)
        stamp = {}
        if args.repo is not None:
            stamp["git"] = dict(baseline, clean_start=True) if baseline is not None else None
            if baseline is None:
                stamp["git_reason"] = reason
        save(change, {"run_id": run_id, "change": number, "skill": args.skill, "ledger": args.ledger,
                      "created_at": created_at, "session_id": session_id, **stamp,
                      "files": entries, "actions": [], "finished": False, "verification": None,
                      "reverted": None})
    except BaseException:
        shutil.rmtree(change, ignore_errors=True)
        raise
    print(change)


def finish(args):
    args.change = change_dir(args.change)
    manifest = load(args.change)
    for entry in manifest["files"]:
        entry["after_sha256"] = sha(validate_entry(args.change, entry, plugin_roots()))
    manifest["finished"] = True
    manifest["verification"] = args.verification
    save(args.change, manifest)
    print(f"finished {args.change}: {len(manifest['files'])} file(s) recorded")


def action(args):
    manifest = load(args.change)
    manifest["actions"].append({"did": args.did, "undo": args.undo})
    save(args.change, manifest)
    print(f"recorded action in {args.change}")


def list_changes(args):
    for change, data in changes(include_reverted=args.all):
        state = f"reverted {data['reverted']}" if data.get("reverted") else ("open" if data.get("finished") else "unfinished")
        print(f"{change}\t{data['run_id']}\t{data['skill']}\t{state}\t{data['ledger']}")


def targets(which):
    if which not in ("last", "run"):
        change = Path(which).expanduser()
        change = change if change.is_absolute() else ROOT / change
        change = change_dir(change)
        return [(change, load(change))]
    open_changes = changes(include_reverted=False)
    if not open_changes:
        sys.exit("kaizen-backup: nothing to undo")
    if which == "last":
        return [open_changes[0]]
    # A run id can be reused by a later run. Take only the newest consecutive group
    # (same run id and session); older changes with that id are left alone and named.
    newest = open_changes[0][1]
    key = (newest["run_id"], newest.get("session_id"))
    group = []
    for item in changes():  # newest first, reverted ones included
        if (item[1]["run_id"], item[1].get("session_id")) != key:
            if group:
                break
            continue
        if not item[1].get("reverted"):
            group.append(item)
    left = [item[0].name for item in open_changes
            if item[1]["run_id"] == newest["run_id"] and item not in group]
    if left:
        print(f"kaizen-backup: run id {newest['run_id']} also appears on older changes; not undoing: {', '.join(left)}",
              file=sys.stderr)
    return group


def tree_size(path):
    return sum(item.stat().st_size for item in Path(path).rglob("*") if item.is_file() and not item.is_symlink())


def prune(args):
    if args.older_than < 1:
        raise ValueError("--older-than must be at least 1 day")
    cutoff = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(days=args.older_than)
    verb = "removed" if args.apply else "would remove"
    count = freed = 0
    records = read_records()
    retained = {tuple(record["manifest"][0]) for record in records.values()}
    for manifest in sorted(ROOT.glob("*/manifest.json")):
        folder = manifest.parent
        if folder.is_symlink():
            print(f"skipped {folder.name}: is a symlink")
            continue
        info = folder.stat()
        if folder.name in records or (info.st_dev, info.st_ino) in retained or has_record(folder):
            continue
        try:
            data = read_manifest(manifest)
        except ValueError as error:
            print(f"skipped {folder.name}: corrupt manifest ({error})")
            continue
        if not data.get("finished"):
            print(f"skipped {folder.name}: unfinished")
            continue
        try:
            created = datetime.datetime.fromisoformat(str(data.get("created_at")))
            if created.tzinfo is None:
                created = created.replace(tzinfo=datetime.timezone.utc)
        except ValueError:
            print(f"skipped {folder.name}: no usable created_at")
            continue
        if created >= cutoff:
            continue
        size = tree_size(folder)
        if args.apply:
            shutil.rmtree(change_dir(folder))
        print(f"{verb} {folder.name}\t{data['created_at']}\t{size} bytes")
        count += 1
        freed += size
    print(f"{verb} {count} change(s), {'freed' if args.apply else 'would free'} {freed} bytes")


def plugin_roots():
    source = Path(__file__).resolve().parent.parent
    roots = {source} if (source / ".claude-plugin/plugin.json").is_file() else set()
    if os.environ.get("CLAUDE_PLUGIN_ROOT"):
        roots.add(Path(os.environ["CLAUDE_PLUGIN_ROOT"]).expanduser().resolve())
    try:
        recorded = (Path(__file__).absolute().parent / ".kaizen-plugin-root").read_text().strip()
        if recorded:
            roots.add(Path(recorded).expanduser().resolve())
    except FileNotFoundError:
        pass
    return roots


def undo(args):
    with file_undo_lock() as locked:
        return undo_locked(args, locked)


def live_file_version(name, fd):
    try:
        return file_version(os.stat(name, dir_fd=fd, follow_symlinks=False))
    except FileNotFoundError:
        return None


def undo_file_hash(name, fd, version, *, restoring=False, replacement=None, ordinary=False):
    if version is None:
        return None
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    with os.fdopen(os.open(name, flags, dir_fd=fd), "rb") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or file_version(info) != version:
            raise ValueError("working file changed during undo")
        if restoring:
            if info.st_nlink != 1:
                raise ValueError("cannot replace a working file with hard links")
            check_restore_metadata(stream.fileno(), replacement, label="working file")
        elif not ordinary:
            check_inode_flags(stream.fileno(), "working file")
        digest = hashlib.sha256()
        remaining = info.st_size
        while remaining:
            chunk = stream.read(min(remaining, 65536))
            if not chunk:
                break
            digest.update(chunk)
            remaining -= len(chunk)
        if remaining or live_file_version(name, fd) != version:
            raise ValueError("working file changed during undo")
        return digest.hexdigest()


def undo_file_snapshot(path, *, restoring=False, ordinary=False):
    with ExitStack() as stack:
        try:
            fd = stack.enter_context(open_directory_walk(path.parent, search=ordinary))
        except FileNotFoundError:
            return None, None, None
        parent = os.fstat(fd)
        version = live_file_version(path.name, fd)
        digest = undo_file_hash(path.name, fd, version, restoring=restoring, ordinary=ordinary)
        return (parent.st_dev, parent.st_ino), version, digest


def undo_snapshot_matches(live, expected):
    # An earlier restore may have created a shared parent. The target must still be absent.
    return live == expected or (expected[0] is None and live[1] is None)


def tracked_undo_aliases(path, versions):
    if not versions:
        return []
    try:
        info = path.lstat()
    except (FileNotFoundError, NotADirectoryError):
        return []
    if not stat.S_ISREG(info.st_mode) or info.st_nlink < 2:
        return []
    identity = info.st_dev, info.st_ino
    return [alias for alias, (_, version, _) in versions.items()
            if alias != path and version is not None and version[:2] == identity]


def darwin_provenance(fd, label):
    # A new inode can inherit this kernel-managed attribute without copying it.
    name = b"com.apple.provenance"
    names = ctypes.create_string_buffer(len(name) + 1)
    libc = ctypes.CDLL(None, use_errno=True)
    size = libc.flistxattr(fd, names, len(names), 0)
    if size == 0:
        return b""
    if size == len(names) and names.value == name:
        value = ctypes.create_string_buffer(64)
        size = libc.fgetxattr(fd, name, value, len(value), 0, 0)
        if 0 < size <= len(value):
            return value.raw[:size]
    raise ValueError(f"cannot restore {label} with extended attributes")


def linux_inode_flags(fd, label):
    # FS_IOC_GETFLAGS encodes a native long but writes an unsigned int.
    flags = bytearray(ctypes.sizeof(ctypes.c_long))
    machine = os.uname().machine
    read = 0x40000000 if machine.startswith(("alpha", "mips", "parisc", "ppc", "sparc")) else 0x80000000
    request = read | (len(flags) << 16) | (ord("f") << 8) | 1
    try:
        fcntl.ioctl(fd, request, flags)
    except OSError as error:
        if error.errno in (errno.ENOTTY, errno.EOPNOTSUPP, errno.EINVAL):
            return 0
        raise ValueError(f"cannot verify {label} filesystem flags: {error}") from error
    return ctypes.c_uint.from_buffer(flags).value


def check_inode_flags(fd, label):
    info = os.fstat(fd)
    # FS_EXTENT_FL describes the normal on-disk layout of ext4 files.
    if getattr(info, "st_flags", 0) or (sys.platform == "linux" and linux_inode_flags(fd, label) & ~0x80000):
        raise ValueError(f"cannot restore {label} with filesystem flags")


def darwin_acl(fd, label, *, replacement=None):
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        get_acl = libc.acl_get_fd_np
        get_acl.argtypes = (ctypes.c_int, ctypes.c_int)
        get_acl.restype = ctypes.c_void_p
        free_acl = libc.acl_free
        free_acl.argtypes = (ctypes.c_void_p,)
        acl = get_acl(fd, 0x100)  # ACL_TYPE_EXTENDED
        if not acl:
            error = ctypes.get_errno()
            if error == errno.ENOENT:
                return None
            raise OSError(error, os.strerror(error))
        try:
            if replacement is not None:
                set_acl = libc.acl_set_fd_np
                set_acl.argtypes = (ctypes.c_int, ctypes.c_void_p, ctypes.c_int)
                if set_acl(replacement, acl, 0x100):
                    error = ctypes.get_errno()
                    raise OSError(error, os.strerror(error))
            size_acl = libc.acl_size
            size_acl.argtypes = (ctypes.c_void_p,)
            size_acl.restype = ctypes.c_ssize_t
            size = size_acl(acl)
            if size < 0:
                error = ctypes.get_errno()
                raise OSError(error, os.strerror(error))
            raw = ctypes.create_string_buffer(size)
            copy_acl = libc.acl_copy_ext
            copy_acl.argtypes = (ctypes.c_void_p, ctypes.c_void_p, ctypes.c_ssize_t)
            copy_acl.restype = ctypes.c_ssize_t
            if copy_acl(raw, acl, size) != size:
                error = ctypes.get_errno()
                raise OSError(error, os.strerror(error))
            return raw.raw
        finally:
            free_acl(acl)
    except (OSError, AttributeError) as error:
        raise ValueError(f"cannot verify {label} extended ACL: {error}") from error


def darwin_has_acl(fd, label):
    return darwin_acl(fd, label) is not None


def check_restore_metadata(fd, replacement=None, *, label="undo backup", allow_acl=False):
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode):
        raise ValueError(f"{label} must be a regular file")
    check_inode_flags(fd, label)
    if sys.platform == "darwin" and not allow_acl and darwin_has_acl(fd, label):
        raise ValueError(f"cannot restore {label} with extended ACL")
    if hasattr(os, "listxattr"):
        if os.listxattr(fd):
            raise ValueError(f"cannot restore {label} with extended attributes")
    elif sys.platform == "darwin":
        provenance = darwin_provenance(fd, label)
        if provenance:
            with ExitStack() as stack:
                if replacement is None:
                    replacement = stack.enter_context(tempfile.TemporaryFile(dir=ROOT)).fileno()
                if provenance != darwin_provenance(replacement, "undo replacement"):
                    raise ValueError(f"cannot preserve {label} provenance")
    else:
        raise ValueError(f"cannot verify {label} extended attributes")
    return info


def restore_ref_file(change, entry, path, snapshot, blob, before_hash, legacy_modes):
    parent, version, digest = snapshot
    if parent is None and entry["created"] and undo_file_snapshot(path) == snapshot:
        return snapshot
    with open_directory_walk(path.parent, create=parent is None and not entry["created"]) as fd:
        info = os.fstat(fd)
        identity = info.st_dev, info.st_ino
        if (parent is not None and identity != parent) or live_file_version(path.name, fd) != version:
            raise ValueError("working file or parent directory changed during undo")

        def recheck(replacement=None):
            if undo_file_hash(path.name, fd, version, restoring=replacement is not None, replacement=replacement) != digest:
                raise ValueError("working file changed during undo")
            with open_directory_walk(path.parent) as current:
                if not os.path.samestat(info, os.fstat(current)):
                    raise ValueError("working file parent directory changed during undo")
            if live_file_version(path.name, fd) != version:
                raise ValueError("working file changed during undo")

        if entry["created"]:
            recheck()
            if version is not None:
                os.unlink(path.name, dir_fd=fd)
            restored = None
        else:
            temporary = ".kaizen-restore-" + os.urandom(16).hex()
            flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
            temp_fd = os.open(temporary, flags, 0o600, dir_fd=fd)
            try:
                source = change / entry["backup"]
                read_flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
                with os.fdopen(temp_fd, "wb") as stream, os.fdopen(os.open(source, read_flags), "rb") as backup:
                    metadata = check_restore_metadata(backup.fileno(), temp_fd)
                    live_mode = stat.S_IMODE(version[2]) if version is not None else None
                    mode = checked_backup_mode(entry, metadata.st_mode, legacy_modes.get(entry["backup"]),
                                               live_mode=live_mode)
                    shutil.copyfileobj(backup, stream)
                    stream.flush()
                    os.fchmod(temp_fd, mode)
                    os.utime(temp_fd, ns=(metadata.st_atime_ns, metadata.st_mtime_ns))
                    os.fsync(temp_fd)
                    written = file_version(os.fstat(temp_fd))
                    if stat.S_IMODE(written[2]) != mode or not matches_blob(temporary, *blob, dir_fd=fd):
                        raise ValueError("undo backup changed during restore")
                    # POSIX rename has no conditional-on-inode variant. Check immediately
                    # before replacing and keep both names anchored to the verified parent.
                    recheck(temp_fd)
                    if live_file_version(temporary, fd) != written:
                        raise ValueError("undo backup changed during restore")
                    os.replace(temporary, path.name, src_dir_fd=fd, dst_dir_fd=fd)
                    # Rename can change ctime. Take it from our file descriptor, even
                    # if an editor has already replaced the name with a different file.
                    restored = (*written[:-1], os.fstat(temp_fd).st_ctime_ns)
            finally:
                try:
                    os.unlink(temporary, dir_fd=fd)
                except FileNotFoundError:
                    pass
        os.fsync(fd)
        return identity, restored, before_hash if restored is not None else None


def exchange_restore(temporary, name, fd):
    # Keep the exact displaced inode, including saves through an open descriptor
    # and replacements of the directory entry in the final check/rename window.
    symbol = "renameatx_np" if sys.platform == "darwin" else "renameat2"
    exchange = getattr(ctypes.CDLL(None, use_errno=True), symbol, None)
    if exchange is None:
        raise ValueError("atomic undo exchange is unavailable")
    # RENAME_SWAP on macOS and RENAME_EXCHANGE on Linux are both 0x2.
    if exchange(fd, os.fsencode(temporary), fd, os.fsencode(name), 0x2):
        error = ctypes.get_errno()
        raise OSError(error, f"atomic undo exchange failed: {os.strerror(error)}", name)


def truncate_undo_tail(stream, saved_fd):
    fd = stream.fileno()
    info = os.fstat(fd)
    end = stream.tell()
    if info.st_size != max(end, os.fstat(saved_fd).st_size):
        raise ValueError("working file changed during undo")
    # The copy leaves the old suffix in place. Detect an edit before discarding it.
    for offset in range(end, info.st_size, 65536):
        size = min(65536, info.st_size - offset)
        if os.pread(fd, size, offset) != os.pread(saved_fd, size, offset):
            raise ValueError("working file changed during undo")
    if file_version(os.fstat(fd)) != file_version(info):
        raise ValueError("working file changed during undo")
    if info.st_size != end:
        stream.truncate()


def copy_undo_backup(source, temp_fd, *, recheck=None, saved_fd=None, copy_permissions=True):
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    with os.fdopen(temp_fd, "wb") as stream, os.fdopen(os.open(source, flags), "rb") as backup:
        if recheck is not None:
            first = backup.read(65536)
            recheck()
            stream.write(first)
            stream.flush()
        shutil.copyfileobj(backup, stream)
        stream.flush()
        if saved_fd is not None:
            truncate_undo_tail(stream, saved_fd)
        if saved_fd is not None or not copy_permissions:
            info = os.fstat(backup.fileno())
            os.utime(temp_fd, ns=(info.st_atime_ns, info.st_mtime_ns))
        elif sys.platform == "darwin":
            # shutil.copystat calls path-only chflags on macOS.
            info = os.fstat(backup.fileno())
            os.fchmod(temp_fd, stat.S_IMODE(info.st_mode))
            os.utime(temp_fd, ns=(info.st_atime_ns, info.st_mtime_ns))
            if info.st_flags and ctypes.CDLL(None, use_errno=True).fchflags(temp_fd, info.st_flags):
                error = ctypes.get_errno()
                raise OSError(error, os.strerror(error), source)
        else:
            shutil.copystat(backup.fileno(), temp_fd)
        os.fsync(temp_fd)


def report_recovery(path):
    print(f"kaizen-backup: recover displaced file at {path}", file=sys.stderr)


def verify_displaced(name, fd, expected):
    version, digest = expected[1:]
    live = live_file_version(name, fd)
    # Rename changes ctime. Recheck the new version after reading its contents.
    if (live is None or live[:-1] != version[:-1]
            or undo_file_hash(name, fd, live, ordinary=True) != digest
            or live_file_version(name, fd) != live):
        raise ValueError("working file changed during undo")


def undo_permissions(info):
    return info.st_uid, info.st_gid, info.st_mode, getattr(info, "st_flags", 0)


def restore_shared_inode(source, path, fd, versions, aliases, before_hash):
    expected = versions[path]
    targets = [path, *aliases]
    if sha(source) != before_hash:
        raise ValueError("undo backup changed during restore")

    def check_targets():
        if any(undo_file_snapshot(target, ordinary=True) != versions[target] for target in targets):
            raise ValueError("working file changed during undo")

    if expected[2] == before_hash:
        check_targets()
        return

    with tempfile.NamedTemporaryFile(dir=ROOT, prefix=".kaizen-recovery-", delete=False) as saved:
        recovery = Path(saved.name)
        restoring = False
        try:
            if sys.platform == "darwin" and darwin_has_acl(saved.fileno(), "undo recovery copy"):
                raise ValueError("cannot keep undo recovery copy private with an inherited ACL")
            flags = os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK
            with os.fdopen(os.open(path.name, flags, dir_fd=fd), "r+b") as live:
                info = os.fstat(live.fileno())
                if file_version(info) != expected[1]:
                    raise ValueError("working file changed during undo")
                # In-place writes can clear set-ID bits and the macOS compressed flag.
                if (info.st_mode & (stat.S_ISUID | stat.S_ISGID)
                        or (sys.platform == "darwin" and info.st_flags & 0x20)):  # UF_COMPRESSED
                    raise ValueError("cannot preserve working file permissions or flags during in-place undo")
                shutil.copyfileobj(live, saved)
                saved.flush()
                os.fsync(saved.fileno())
                if sha(recovery) != expected[2]:
                    raise ValueError("working file changed during undo")
                live.seek(0)

                def recheck():
                    nonlocal restoring
                    check_targets()
                    if live_file_version(path.name, fd) != expected[1]:
                        raise ValueError("working file changed during undo")
                    restoring = True

                # POSIX provides no conditional in-place write. Keep the verified preimage.
                copy_undo_backup(source, os.dup(live.fileno()), recheck=recheck, saved_fd=saved.fileno())
                restored = os.fstat(live.fileno())
                if undo_permissions(restored) != undo_permissions(info):
                    raise ValueError("working file permissions changed during undo")
                written = file_version(restored)
                for target in targets:
                    snapshot = undo_file_snapshot(target, ordinary=True)
                    if (snapshot != (versions[target][0], written, before_hash)
                            or written[:2] != expected[1][:2]):
                        raise ValueError("working file changed during undo")
                # A save to the bytes we overwrote can leave the final hash unchanged.
                raise ValueError("in-place undo restored the backup and may have overwritten an intervening editor save")
        finally:
            if restoring:
                print(f"kaizen-backup: pre-undo recovery copy at {recovery}", file=sys.stderr)
            else:
                recovery.unlink()


def stage_ordinary_replacement(source, temp_fd, name, fd, version):
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    with os.fdopen(os.open(name, flags, dir_fd=fd), "rb") as live:
        live_fd = live.fileno()
        if file_version(os.fstat(live_fd)) != version:
            raise ValueError("working file changed during undo")
        try:
            info = check_restore_metadata(live_fd, temp_fd, label="working file", allow_acl=True)
            # Inherited permissions must never grant access to the staged bytes.
            stage = check_restore_metadata(temp_fd, live_fd, label="undo replacement")
        except (OSError, ValueError):
            return False
        copy_undo_backup(source, os.dup(temp_fd), copy_permissions=False)
        try:
            if (stage.st_uid, stage.st_gid) != (info.st_uid, info.st_gid):
                os.fchown(temp_fd, info.st_uid, info.st_gid)
            # Install per-file restrictions before granting access through the mode.
            acl = darwin_acl(live_fd, "working file", replacement=temp_fd) if sys.platform == "darwin" else None
            os.fchmod(temp_fd, stat.S_IMODE(info.st_mode))
            if sys.platform == "darwin" and darwin_acl(temp_fd, "undo replacement") != acl:
                return False
            check_inode_flags(temp_fd, "undo replacement")
        except (OSError, ValueError):
            return False
        if undo_permissions(os.fstat(temp_fd)) != undo_permissions(info):
            return False
        if file_version(os.fstat(live_fd)) != version:
            raise ValueError("working file changed during undo")
        os.fsync(temp_fd)
    return True


def restore_ordinary_file(source, path, versions, before_hash, retained_links):
    aliases = tracked_undo_aliases(path, versions)
    expected_links = 1 + len(aliases)
    stages, displaced, restored = [], [], {}
    with ExitStack() as stack:
        try:
            for index, target in enumerate([path, *aliases]):
                parent = versions[target][0]
                fd = stack.enter_context(open_directory_walk(target.parent, create=parent is None,
                                                             search=True))
                temporary = ".kaizen-recovery-" + os.urandom(16).hex()
                if index == 0 and versions[path][1] is not None:
                    info = os.stat(path.name, dir_fd=fd, follow_symlinks=False)
                    if file_version(info) != versions[path][1]:
                        raise ValueError("working file changed during undo")
                    expected_links += retained_links.get((info.st_dev, info.st_ino), 0)
                    if info.st_nlink > expected_links:
                        return restore_shared_inode(source, path, fd, versions, aliases, before_hash)
                try:
                    if index == 0:
                        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
                        temp_fd = os.open(temporary, flags, 0o600, dir_fd=fd)
                    else:
                        _, first_fd, first_name = stages[0]
                        os.link(first_name, temporary, src_dir_fd=first_fd, dst_dir_fd=fd, follow_symlinks=False)
                except OSError as error:
                    if versions[path][1] is None or error.errno not in (errno.EACCES, errno.EPERM, errno.EROFS):
                        raise
                    write_fd = stages[0][1] if stages else fd
                    return restore_shared_inode(source, path, write_fd, versions, aliases, before_hash)
                stages.append((target, fd, temporary))
                if index == 0:
                    version = versions[path][1]
                    if version is None:
                        copy_undo_backup(source, temp_fd)
                    else:
                        with os.fdopen(temp_fd, "wb"):
                            staged = stage_ordinary_replacement(source, temp_fd, path.name, fd, version)
                        if not staged:
                            return restore_shared_inode(source, path, fd, versions, aliases, before_hash)
            _, first_fd, first_name = stages[0]
            written = live_file_version(first_name, first_fd)
            if written is None or undo_file_hash(first_name, first_fd, written, ordinary=True) != before_hash:
                raise ValueError("undo backup changed during restore")

            for target, fd, temporary in stages:
                parent, version, digest = versions[target]
                info = os.fstat(fd)
                identity = info.st_dev, info.st_ino
                live = live_file_version(target.name, fd)
                # Earlier swaps also update ctime on any remaining hard links.
                if ((parent is not None and identity != parent)
                        or (live != version and (not displaced or live is None or version is None
                                                or live[:-1] != version[:-1]))
                        or undo_file_hash(target.name, fd, live, ordinary=True) != digest):
                    raise ValueError("working file changed during undo")
                if live is not None and os.stat(target.name, dir_fd=fd, follow_symlinks=False).st_nlink != expected_links:
                    raise ValueError(f"cannot safely restore a working file with untracked hard links: {target}")
                with open_directory_walk(target.parent, search=True) as current:
                    if not os.path.samestat(info, os.fstat(current)):
                        raise ValueError("working file parent directory changed during undo")
                staged = live_file_version(temporary, fd)
                if staged is None or staged[:-1] != written[:-1] or live_file_version(target.name, fd) != live:
                    raise ValueError("working file changed during undo")
                if live is None:
                    try:
                        os.link(temporary, target.name, src_dir_fd=fd, dst_dir_fd=fd, follow_symlinks=False)
                    except FileExistsError:
                        raise ValueError("working file changed during undo") from None
                    os.unlink(temporary, dir_fd=fd)
                else:
                    displaced.append((target, fd, temporary))
                    exchange_restore(temporary, target.name, fd)

            for target, fd, _ in stages:
                snapshot = undo_file_snapshot(target, ordinary=True)
                info = os.fstat(fd)
                if (snapshot[0] != (info.st_dev, info.st_ino) or snapshot[1] is None
                        or snapshot[1][:-1] != written[:-1] or snapshot[2] != before_hash):
                    raise ValueError("working file changed during undo")
                restored[target] = snapshot
            for target, fd, temporary in displaced:
                verify_displaced(temporary, fd, versions[target])
        finally:
            for stage in stages:
                target, fd, temporary = stage
                if stage in displaced:
                    # An interruption can arrive as the exchange returns to Python.
                    live = live_file_version(temporary, fd)
                    if live is not None and live[:2] != written[:2]:
                        # A writer may still hold this inode open after the final check.
                        report_recovery(target.with_name(temporary))
                        continue
                try:
                    os.unlink(temporary, dir_fd=fd)
                except FileNotFoundError:
                    pass
    versions.update(restored)


def remove_ordinary_created(path, versions, retained_links):
    expected = versions[path]
    aliases = tracked_undo_aliases(path, versions)
    with open_directory_walk(path.parent, search=True) as fd:
        temporary = ".kaizen-recovery-" + os.urandom(16).hex()
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
        with os.fdopen(os.open(temporary, flags, 0o600, dir_fd=fd), "wb") as spare:
            identity = file_version(os.fstat(spare.fileno()))[:2]
        try:
            info = os.fstat(fd)
            if (expected[0] != (info.st_dev, info.st_ino)
                    or undo_file_snapshot(path, ordinary=True) != expected
                    or live_file_version(path.name, fd) != expected[1]):
                raise ValueError("working file changed during undo")
            os.rename(path.name, temporary, src_dir_fd=fd, dst_dir_fd=fd)
            for alias in aliases:
                previous = versions[alias]
                snapshot = undo_file_snapshot(alias, ordinary=True)
                if (snapshot[0] != previous[0] or snapshot[1] is None
                        or snapshot[1][:-1] != previous[1][:-1] or snapshot[2] != previous[2]):
                    raise ValueError("working file changed during undo")
                versions[alias] = snapshot
            verify_displaced(temporary, fd, expected)
            removed = expected[1][:2]
            retained_links[removed] = retained_links.get(removed, 0) + 1
        finally:
            recovery = live_file_version(temporary, fd)
            if recovery is not None:
                if recovery[:2] == identity:
                    os.unlink(temporary, dir_fd=fd)
                else:
                    report_recovery(path.with_name(temporary))


def undo_locked(args, locked):
    plan = [(change_dir(change), data) for change, data in targets(args.target)]
    roots = plugin_roots()
    ref_backed = any(has_record(change) for change, _ in plan)
    records = read_records(tolerate_unrelated=not ref_backed)
    if records:
        for change, _ in plan:
            info = change.stat()
            record_for_change(change, (info.st_dev, info.st_ino), records)
    observing = next((change.name for change, _ in plan if change.name in records), None)
    if observing is not None and not locked:
        raise ValueError("git undo requires the private ref lock")
    git_exe = resolve_git() if observing is not None else None
    conflicts = []
    backups, versions, before_hashes = {}, {}, {}
    retained_links = {}  # Moving a created hard link aside adds a known name for its inode.
    seen = {}  # the plan is newest first: path -> (newer change name, hash of its backup, i.e. the state it began from)
    for change, data in plan:
        record = records.get(change.name)
        if args.scheduled_action is not None and (record is None or record["key"] != args.scheduled_action):
            raise ValueError("undo does not match the scheduled action")
        if data.get("reverted"):
            if record and record.get("inverse", {}).get("done"):
                inverse = record["inverse"]
                if checked_ref(record, records, "inverse", git_exe) == inverse["old"]:
                    raise ValueError(f"completed inverse ref {record['ref']} is at its previous value; "
                                     f"the reverted backup record expects {inverse['new']}")
                if args.scheduled_action is not None:
                    verify_effect(record, "inverse", git_exe)
                    return 0
            sys.exit(f"kaizen-backup: {change} was already reverted on {data['reverted']}")
        if "committed" in data or "revert_commit" in data:
            raise ValueError("undo requires a tool-owned commit record")
        applied = False
        if record:
            _, _, applied, backups[change] = checked_inverse(change, data, record, records, git_exe, observing)
        for entry in data["files"]:
            path = validate_entry(change, entry, roots)
            if record:
                snapshot = undo_file_snapshot(path, restoring=not entry["created"])
                if versions.setdefault(path, snapshot) != snapshot:
                    raise ValueError("working file changed during undo preflight")
                _, version, live_hash = versions[path]
                if entry.get("backup"):
                    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
                    with os.fdopen(os.open(change / entry["backup"], flags), "rb") as source:
                        metadata = check_restore_metadata(source.fileno())
                        checked_backup_mode(entry, metadata.st_mode,
                                            record.get("legacy_modes", {}).get(entry["backup"]))
                blob = backups[change][path]
                if path not in seen and version and (not stat.S_ISREG(version[2]) or
                        bool(version[2] & stat.S_IXUSR) != (blob is not None and blob[0] == b"100755")):
                    conflicts.append(f"{path} changed mode after {change.name}")
            else:
                if path not in versions:
                    versions[path] = undo_file_snapshot(path, ordinary=True)
                live_hash = versions[path][2]
            before = sha(change / entry["backup"]) if entry.get("backup") else None
            before_hashes[change, path] = before
            if not data.get("finished"):
                if entry["created"] and path.exists():
                    conflicts.append(f"{entry['path']} was created by {change.name}, which was never finished")
            elif path not in seen and live_hash not in (entry.get("after_sha256"),
                                                        before if applied else entry.get("after_sha256")):
                conflicts.append(f"{entry['path']} changed after {change.name}")
            elif path in seen and seen[path][0] != change.name and seen[path][1] != entry.get("after_sha256"):
                conflicts.append(f"{entry['path']} was edited between {change.name} and {seen[path][0]}")
            seen[path] = (change.name, before)
    if conflicts and not args.force:
        print("CONFLICT (nothing restored; re-run with --force to overwrite):")
        print("\n".join(f"  {line}" for line in conflicts))
        return 2
    for change, data in plan:  # newest change first
        record = records.get(change.name)
        if record and not record["commit"].get("cancelled"):
            tip, entries, _, _ = checked_inverse(change, data, record, records, git_exe)

            def recheck():
                if manifest_stamp(change)[1] != record["manifest"]:
                    raise ValueError("commit manifest changed before inverse update")
                if any(not undo_snapshot_matches(undo_file_snapshot(path), versions[path])
                       for path in backups[change]):
                    raise ValueError("working file changed before inverse update")

            if entries is None:
                cancel_commit(change, record, records, tip, git_exe, recheck)
            elif not record.get("inverse", {}).get("done") or tip == record["inverse"]["old"]:
                transact_ref(change, record, records, "inverse", tip, entries, recheck, git_exe)
        if record:
            cleanup_pins(record, records, git_exe)
        for entry in data["files"]:
            path = validate_entry(change, entry, roots)
            before = before_hashes[change, path]
            if record:
                versions[path] = restore_ref_file(change, entry, path, versions[path], backups[change][path],
                                                  before, record.get("legacy_modes", {}))
                print(f"{'removed created' if entry['created'] else 'restored'} {path}")
            elif entry["created"]:
                live = undo_file_snapshot(path, ordinary=True)
                if not undo_snapshot_matches(live, versions[path]):
                    raise ValueError("working file changed during undo")
                if live[1] is not None and (args.force or live[2] == entry["after_sha256"]):
                    remove_ordinary_created(path, versions, retained_links)
                    print(f"removed created {path}")
                versions[path] = undo_file_snapshot(path, ordinary=True)
                if versions[path][1] is not None:
                    raise ValueError("working file changed during undo")
            else:
                restore_ordinary_file(change / entry["backup"], path, versions, before, retained_links)
                print(f"restored {path}")
        for act in data["actions"]:
            print(f"ACTION to reverse by hand (not run): {act['undo']}   # was: {act['did']}")
        data["reverted"] = datetime.date.today().isoformat()
        save(change, data)
        print(f"reverted {change.name}: {data['ledger']}")
    return 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("begin")
    p.add_argument("--skill", required=True)
    p.add_argument("--ledger", required=True)
    p.add_argument("--run")
    p.add_argument("--repo", metavar="DIR",
                   help="record an advisory clean-start stamp at the first interactive backup")
    p.add_argument("files", nargs="+")
    p.set_defaults(func=begin)
    p = sub.add_parser("finish")
    p.add_argument("change")
    p.add_argument("--verification", choices=("passed", "failed"), default="passed")
    p.set_defaults(func=finish)
    p = sub.add_parser("commit", allow_abbrev=False)
    private = p.add_mutually_exclusive_group()
    private.add_argument("--scheduled-baseline-stdin", action="store_true", help=argparse.SUPPRESS)
    private.add_argument("--scheduled-recovery-stdin", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("change", metavar="CHANGE_DIR")
    p.set_defaults(func=commit)
    p = sub.add_parser("action")
    p.add_argument("change")
    p.add_argument("--did", required=True)
    p.add_argument("--undo", required=True)
    p.set_defaults(func=action)
    p = sub.add_parser("list")
    p.add_argument("--all", action="store_true")
    p.set_defaults(func=list_changes)
    p = sub.add_parser("undo")
    p.add_argument("target", nargs="?", default="last")
    p.add_argument("--force", action="store_true")
    p.add_argument("--scheduled-action", help=argparse.SUPPRESS)
    p.set_defaults(func=undo)
    p = sub.add_parser("prune")
    p.add_argument("--older-than", type=int, required=True, metavar="DAYS")
    p.add_argument("--apply", action="store_true")
    p.set_defaults(func=prune)
    args = parser.parse_args(argv)
    try:
        if args.command == "commit":
            for operation in ("scheduled_baseline_stdin", "scheduled_recovery_stdin"):
                if getattr(args, operation) and argv != ["commit", "--" + operation.replace("_", "-"), args.change]:
                    raise ValueError("invalid scheduled commit invocation")
            return commit(args)
        if args.command == "undo" and args.scheduled_action is not None:
            if (argv != ["undo", "--scheduled-action", args.scheduled_action, args.target]
                    or not re.fullmatch(r"fa1_[0-9a-f]{64}", args.scheduled_action)
                    or Path(args.target).parent != ROOT):
                raise ValueError("invalid scheduled undo invocation")
        ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
        if not USER_ROOT:
            try:
                ROOT.chmod(0o700)
            except OSError:
                pass  # a root we do not own stays as it is
        if args.command in ("action", "finish", "prune"):
            with file_undo_lock():
                if args.command != "prune":
                    change = Path(args.change).expanduser().resolve()
                    if change.parent == ROOT and change.is_dir() and has_record(change):
                        raise ValueError("manifest is bound to a ref transaction")
                return args.func(args) or 0
        return args.func(args) or 0
    except (OSError, ValueError, KeyError, TypeError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"kaizen-backup: {capture_reason(error)}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
