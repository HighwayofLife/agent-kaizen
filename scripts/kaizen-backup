#!/usr/bin/env python3
"""Backups, manifests and undo for Agent Kaizen changes (see docs/autonomy.md).

  kaizen-backup begin  --skill NAME --ledger TEXT [--run RUN_ID] [--repo DIR] FILE...
        Back up FILEs (existing ones are copied; missing ones are recorded as created)
        and print the change folder. Credential paths are refused. Run BEFORE editing.
  kaizen-backup finish CHANGE_DIR [--verification passed|failed]
        Record each file's sha256 after the edit. Run AFTER editing and verifying.
  kaizen-backup action CHANGE_DIR --did CMD --undo CMD
        Record a non-file action (e.g. a package install) and its reverse command.
  kaizen-backup list [--all]
        List changes (newest first): change dir, run, skill, reverted, ledger text.
  kaizen-backup undo [last|run|CHANGE_DIR] [--force]
        Restore files; delete created files whose hash still matches; print recorded
        actions' undo commands (it never runs them). A file changed since `finish` is a
        conflict: nothing is restored unless --force. `undo run` takes the newest
        group of consecutive changes with one run id and session; older changes that
        reuse the id are left alone and named.
  kaizen-backup prune --older-than DAYS [--apply]
        List finished changes created more than DAYS days ago (DAYS >= 1). Dry run
        unless --apply, which deletes them. Unfinished changes, corrupt manifests and
        changes without created_at are never removed.

Backups live in KAIZEN_BACKUP_DIR (default <CLAUDE_CONFIG_DIR or ~/.claude>/kaizen-backups),
in folders only the owner can read.
"""
import argparse
import datetime
import hashlib
import json
import os
import re
import runpy
import shutil
import stat
import subprocess
import sys
import tempfile
from contextlib import contextmanager
from pathlib import Path

try:
    import fcntl
except ImportError:
    fcntl = None


def claude_home():
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude").expanduser()


USER_ROOT = bool(os.environ.get("KAIZEN_BACKUP_DIR"))  # a root the user chose keeps its mode
BACKUP_ROOT = Path(os.environ.get("KAIZEN_BACKUP_DIR") or claude_home() / "kaizen-backups").expanduser()
ROOT = BACKUP_ROOT.resolve()
is_credential = runpy.run_path(str(Path(__file__).resolve().with_name("kaizen_credentials.py")))["is_credential"]


def sha(path):
    path = Path(path)
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None


REQUIRED_KEYS = ("run_id", "change", "skill", "ledger", "files", "actions")


def read_manifest(path, *, dir_fd=None):
    """Read one manifest; any problem raises ValueError that names the file."""
    try:
        if dir_fd is not None:
            limit = 1024 * 1024
            flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
            with os.fdopen(os.open(path, flags, dir_fd=dir_fd), "rb") as stream:
                info = os.fstat(stream.fileno())
                if not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= limit:
                    raise ValueError("expected a nonempty regular manifest within 1 MiB")
                data = json.loads(stream.read(info.st_size))
                live = os.stat(path, dir_fd=dir_fd, follow_symlinks=False)
                if file_version(live) != file_version(info):
                    raise ValueError("manifest was replaced or edited during validation")
        else:
            data = json.loads(Path(path).read_text())
    except (OSError, ValueError) as error:
        raise ValueError(f"cannot read manifest {path}: {error}") from None
    if not isinstance(data, dict):
        raise ValueError(f"manifest {path} is not a JSON object")
    missing = [key for key in REQUIRED_KEYS if key not in data]
    if missing or not isinstance(data["files"], list) or not isinstance(data["actions"], list):
        raise ValueError(f"manifest {path} is missing or has bad keys: {', '.join(missing) or 'files/actions'}")
    return data


def load(change):
    refuse_symlinks(Path(change) / "manifest.json")
    return read_manifest(Path(change) / "manifest.json")


def save(change, manifest):
    tmp = Path(change) / "manifest.json.tmp"
    refuse_symlinks(tmp)
    refuse_symlinks(Path(change) / "manifest.json")
    tmp.write_text(json.dumps(manifest, indent=2) + "\n")
    tmp.replace(Path(change) / "manifest.json")


def changes(include_reverted=True):
    found = []
    for manifest in ROOT.glob("*/manifest.json"):
        try:
            data = read_manifest(manifest)
        except ValueError as error:
            print(f"kaizen-backup: skipping {error}", file=sys.stderr)
            continue
        if include_reverted or not data.get("reverted"):
            found.append((manifest.parent, data))
    # Newest first. Run ids are free text, so order by creation time; no created_at sorts oldest.
    return sorted(found, key=lambda item: (str(item[1].get("created_at") or ""), str(item[1]["run_id"]),
                                           str(item[1]["change"]).zfill(8)), reverse=True)


def next_number(run_id):
    """One more than the highest NN in existing folders named <run_id>-NN-<skill>."""
    numbers = [0]
    for item in ROOT.iterdir():
        if item.is_dir() and not item.is_symlink() and item.name.startswith(run_id + "-"):
            match = re.match(r"(\d+)-", item.name[len(run_id) + 1:])
            if match:
                numbers.append(int(match.group(1)))
    return max(numbers) + 1


def valid_id(value):
    if any(part in value for part in ("/", "..", "\0")):
        raise ValueError("--run and --skill must not contain /, .. or NUL")
    return value


def change_dir(path):
    resolved = Path(path).expanduser().resolve()
    if ROOT not in resolved.parents:
        raise ValueError(f"CHANGE_DIR must be inside the backups root: {resolved}")
    return resolved


def refuse_symlinks(path, roots=()):
    resolved = path.resolve()
    if path.is_symlink() or resolved != path:
        if any(resolved == root or root in resolved.parents for root in roots):
            raise ValueError(f"refusing to restore through symlink into plugin root: {path}; "
                             "run kaizen-link --unlink --restore-replaced first")
        raise ValueError(f"refusing to access target through symlink: {path}")


def validate_entry(change, entry, roots=()):
    if not isinstance(entry, dict) or not isinstance(entry.get("path"), str):
        raise ValueError("entry path must be an absolute normalised string")
    name = entry["path"]
    path = Path(name)
    if not path.is_absolute() or str(path) != name or ".." in path.parts or "\0" in name:
        raise ValueError(f"entry path must be absolute and normalised without ..: {name}")
    refuse_symlinks(path, roots)
    if not isinstance(entry.get("created"), bool):
        raise ValueError(f"entry created flag must be boolean: {name}")
    # Preflight all targets before undo changes anything, including with --force.
    if path.is_dir():
        raise ValueError(f"entry target is a directory: {path}")
    if not entry["created"] or entry.get("backup") is not None:
        if not isinstance(entry.get("backup"), str):
            raise ValueError(f"entry backup must name a file inside its change directory: {name}")
        backup = change / entry["backup"]
        if change.resolve() not in backup.resolve().parents:
            raise ValueError(f"entry backup must resolve inside its change directory: {backup}")
        refuse_symlinks(backup)
        if not backup.is_file():
            raise ValueError(f"entry backup is not a regular file: {backup}")
    return path


def file_version(info):
    return info.st_dev, info.st_ino, info.st_mode, info.st_size, info.st_mtime_ns, info.st_ctime_ns


@contextmanager
def open_directory(path, *, dir_fd=None):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dir_fd)
    try:
        yield fd
    finally:
        os.close(fd)


def directory_stamp(path, fd):
    info = os.fstat(fd)
    return {"path": str(path), "dev": info.st_dev, "ino": info.st_ino}


def directory_identity(path):
    with open_directory(path) as fd:
        return directory_stamp(path, fd)


def backup_root_path(root):
    path = Path(root).expanduser()
    return Path(os.path.abspath(path.parent.resolve(strict=True) / path.name))


def backup_root_identity(root):
    """Capture this before launch in the trusted caller, after creating the backup root."""
    return directory_identity(backup_root_path(root))


def git(directory, *args, git_dir=None):
    # Only use metadata queries here. No status, diffs or worktree conversion.
    directory = Path(directory)
    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    env.update(GIT_TERMINAL_PROMPT="0", GIT_NO_LAZY_FETCH="1", GIT_ALLOW_PROTOCOL="",
               GIT_NO_REPLACE_OBJECTS="1", GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL=os.devnull,
               GIT_ATTR_NOSYSTEM="1", GIT_CEILING_DIRECTORIES=str(directory.parent))
    scope = [] if git_dir is None else [f"--git-dir={git_dir}", f"--work-tree={directory}"]
    return subprocess.run(
        ["git", "--no-pager", "--no-optional-locks", "-C", str(directory), *scope,
         "-c", "core.fsmonitor=false", "-c", f"core.hooksPath={os.devnull}",
         "-c", "core.untrackedCache=false", "-c", "core.sparseCheckout=false", *args],
        env=env, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=True, timeout=10,
    ).stdout


MAX_INDEX_BYTES = 64 * 1024 * 1024
GIT_ERRORS = (OSError, ValueError, RuntimeError, subprocess.SubprocessError)


def read_index(path):
    refuse_symlinks(path)
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    with os.fdopen(os.open(path, flags), "rb") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= MAX_INDEX_BYTES:
            raise ValueError("Git index is not a regular file within the size limit")
        os.set_blocking(stream.fileno(), True)
        raw = stream.read(info.st_size + 1)
        if len(raw) != info.st_size or file_version(path.lstat()) != file_version(info):
            raise ValueError("Git index was edited during capture")
    return {"path": str(path), "dev": info.st_dev, "ino": info.st_ino,
            "sha256": hashlib.sha256(raw).hexdigest()}, raw


def git_snapshot(directory):
    root = Path(directory).expanduser().resolve(strict=True)
    if not os.path.lexists(root / ".git"):
        raise ValueError("repository must be the exact Git worktree top level")
    worktree = directory_identity(root)
    top, common, index = (Path(os.fsdecode(git(root, "rev-parse", "--path-format=absolute",
                                             *args).removesuffix(b"\n")))
                          for args in (("--show-toplevel",), ("--git-common-dir",), ("--git-path", "index")))
    if not all(path.is_absolute() for path in (top, common, index)) or top.resolve(strict=True) != root:
        raise ValueError("repository must be the exact Git worktree top level")
    common = common.resolve(strict=True)
    common_dir = directory_identity(common)
    if (index.parent / "index.lock").exists():
        raise ValueError("locked Git index")
    head = git(root, "rev-parse", "--verify", "HEAD^{commit}").decode("ascii").strip()
    index_state, raw = read_index(index)
    if directory_identity(root) != worktree or directory_identity(common) != common_dir:
        raise ValueError("Git directories changed during capture")
    return {"root": str(root), "worktree": worktree, "head": head, "common_dir": common_dir,
            "index": index_state}, raw


def git_identity(directory):
    """Read the live identity for comparison, even when the worktree has edits."""
    return git_snapshot(directory)[0]


def matches_blob(path, mode, oid):
    if path.parent.resolve(strict=True) != path.parent:
        return False
    digest = hashlib.sha256() if len(oid) == 64 else hashlib.sha1()
    if mode == b"120000":
        raw = os.readlink(os.fsencode(path))
        digest.update(b"blob %d\0" % len(raw) + raw)
    else:
        flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
        with os.fdopen(os.open(path, flags), "rb") as stream:
            info = os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or bool(info.st_mode & stat.S_IXUSR) != (mode == b"100755"):
                return False
            digest.update(b"blob %d\0" % info.st_size)
            for chunk in iter(lambda: stream.read(65536), b""):
                digest.update(chunk)
            if file_version(path.lstat()) != file_version(info):
                return False
    return digest.hexdigest().encode("ascii") == oid


# --debug exposes the intent-to-add bit even when an empty blob matches HEAD.
INDEX_ENTRY = re.compile(rb"H (100644|100755|120000) ([0-9a-f]+) 0\t([^\0]+)\0"
                         rb"(?:  [^\n]*\n){4}  size: [0-9]+\tflags: 0\n")


def capture_git_tree(directory):
    state, raw = git_snapshot(directory)
    root = Path(state["root"])
    algorithm = "sha256" if len(state["head"]) == 64 else "sha1"
    tree = git(root, "ls-tree", "-rz", state["head"]).split(b"\0")[:-1]
    with tempfile.TemporaryDirectory() as scratch:
        # Isolate the copied index, including any split-index lookup, from real Git metadata.
        git(scratch, "init", "-q", "--bare", "--template=", f"--object-format={algorithm}")
        (Path(scratch) / "index").write_bytes(raw)
        records = git(root, "ls-files", "-v", "--stage", "--debug", "--sparse", "-z", git_dir=scratch)
        # No exclude options: ignored files count too.
        if git(root, "ls-files", "--others", "-z", git_dir=scratch):
            raise ValueError("worktree contains untracked files")
    entries, offset = {}, 0
    for row in tree:
        match = INDEX_ENTRY.match(records, offset)
        if not match:
            raise ValueError("Git index has missing, hidden or nonstandard entries")
        mode, oid, name = match.groups()
        path = root / os.fsdecode(name)
        if row != mode + b" blob " + oid + b"\t" + name or not matches_blob(path, mode, oid):
            raise ValueError("index or worktree differs from HEAD")
        entries[path] = (mode, oid)
        offset = match.end()
    if offset != len(records) or git_identity(root) != state:
        raise ValueError("index or repository identity changed")
    return dict(state, clean_start=True), entries


def capture_git_baseline(directory):
    """Capture before launch and retain the result in trusted caller state."""
    try:
        return capture_git_tree(directory)[0]
    except GIT_ERRORS:
        return None


def validate_change_handoff(root, change, *, run_id, session_id, started, before, root_identity):
    """Read an ordinary manifest against independently captured run state."""
    change = Path(change)
    try:
        root_path = backup_root_path(root)
        with open_directory(root_path) as root_fd:
            if directory_stamp(root_path, root_fd) != root_identity:
                raise ValueError("backup root was replaced")
            if change.parent != root_path or change.name == "..":
                raise ValueError("change folder is not a canonical child of the backups root")
            with open_directory(change.name, dir_fd=root_fd) as change_fd:
                info = os.fstat(change_fd)
                identity = (info.st_dev, info.st_ino)
                if change in before[0] or identity in before[1]:
                    raise ValueError("change folder is not new to this run")
                data = read_manifest("manifest.json", dir_fd=change_fd)
    except OSError as error:
        raise ValueError(f"cannot open backup root or change folder: {error}") from None
    if not session_id or data["run_id"] != run_id or data.get("session_id") != session_id or "git" in data:
        raise ValueError("change manifest does not match the ordinary run and session")
    number, skill = data["change"], data["skill"]
    if (type(number) is not int or number < 1 or not isinstance(skill, str)
            or change.name != f"{valid_id(run_id)}-{number:02d}-{valid_id(skill)}"):
        raise ValueError("change folder name does not match its manifest")
    created = data.get("created_at")
    if not isinstance(created, str):
        raise ValueError("change manifest has no creation timestamp")
    created = datetime.datetime.fromisoformat(created)
    if created.tzinfo is None or not started < created <= datetime.datetime.now(datetime.timezone.utc):
        raise ValueError("change manifest timestamp is outside the run")
    if backup_root_identity(root) != root_identity:
        raise ValueError("backup root was replaced")
    info = change.lstat()
    if not stat.S_ISDIR(info.st_mode) or (info.st_dev, info.st_ino) != identity:
        raise ValueError("change folder was replaced during validation")
    return data, identity


def begin(args):
    # Preflight every input before copying anything or creating a change folder.
    for name in args.files:
        if is_credential(name):
            raise ValueError(f"refusing to back up credential path: {name}")
        path = Path(name).expanduser().resolve()
        if path.exists() and not path.is_file():
            sys.exit(f"kaizen-backup: {path} is not a regular file")
    if fcntl is None:
        return write_backup(args)
    # Serialize numbering and baseline capture across simultaneous begins.
    descriptor = os.open(ROOT, os.O_RDONLY)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        return write_backup(args, descriptor)
    finally:
        os.close(descriptor)


def write_backup(args, root_fd=None):
    created_at = datetime.datetime.now(datetime.timezone.utc).isoformat()
    run_id = args.run or os.environ.get("KAIZEN_RUN_ID") or datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    session_id = os.environ.get("KAIZEN_SESSION_ID")
    valid_id(run_id)
    valid_id(args.skill)
    number = next_number(run_id)
    baseline = None
    # A manifest is evidence only. Never reuse a previous manifest's Git stamp.
    if args.repo is not None and root_fd is not None and session_id is None and number == 1:
        try:
            root_identity = backup_root_identity(BACKUP_ROOT)
            if root_identity == directory_stamp(ROOT, root_fd):
                baseline, blobs = capture_git_tree(args.repo)
                repo = Path(baseline["root"])
        except GIT_ERRORS:
            baseline = None
    change = change_dir(ROOT / f"{run_id}-{number:02d}-{args.skill}")
    change.mkdir(mode=0o700)
    try:
        (change / "files").mkdir(mode=0o700)
        entries = []
        for index, name in enumerate(args.files, 1):
            # User paths may use a symlinked home or /tmp; store their canonical target.
            path = Path(name).expanduser().resolve()
            entry = {"path": str(path), "backup": None, "created": not path.exists(), "after_sha256": None}
            if path.is_file():
                entry["backup"] = f"files/{index}"
                shutil.copy2(path, change / entry["backup"])
            if baseline is not None and path.is_relative_to(repo):
                try:
                    blob = blobs.get(path)
                    backup = entry["backup"]
                    clean = backup is None if blob is None else (
                        backup is not None and matches_blob(change / backup, *blob))
                    if not clean:
                        baseline = None
                except GIT_ERRORS:
                    baseline = None
            entries.append(entry)
        if baseline is not None:
            try:
                if (backup_root_identity(BACKUP_ROOT) != root_identity
                        or dict(git_identity(repo), clean_start=True) != baseline):
                    baseline = None
            except GIT_ERRORS:
                baseline = None
        stamp = {"git": baseline} if args.repo is not None else {}
        save(change, {"run_id": run_id, "change": number, "skill": args.skill, "ledger": args.ledger,
                      "created_at": created_at, "session_id": session_id, **stamp,
                      "files": entries, "actions": [], "finished": False, "verification": None,
                      "reverted": None})
    except BaseException:
        shutil.rmtree(change, ignore_errors=True)
        raise
    print(change)


def finish(args):
    args.change = change_dir(args.change)
    manifest = load(args.change)
    for entry in manifest["files"]:
        entry["after_sha256"] = sha(validate_entry(args.change, entry, plugin_roots()))
    manifest["finished"] = True
    manifest["verification"] = args.verification
    save(args.change, manifest)
    print(f"finished {args.change}: {len(manifest['files'])} file(s) recorded")


def action(args):
    manifest = load(args.change)
    manifest["actions"].append({"did": args.did, "undo": args.undo})
    save(args.change, manifest)
    print(f"recorded action in {args.change}")


def list_changes(args):
    for change, data in changes(include_reverted=args.all):
        state = f"reverted {data['reverted']}" if data.get("reverted") else ("open" if data.get("finished") else "unfinished")
        print(f"{change}\t{data['run_id']}\t{data['skill']}\t{state}\t{data['ledger']}")


def targets(which):
    if which not in ("last", "run"):
        change = Path(which).expanduser()
        change = change if change.is_absolute() else ROOT / change
        change = change_dir(change)
        return [(change, load(change))]
    open_changes = changes(include_reverted=False)
    if not open_changes:
        sys.exit("kaizen-backup: nothing to undo")
    if which == "last":
        return [open_changes[0]]
    # A run id can be reused by a later run. Take only the newest consecutive group
    # (same run id and session); older changes with that id are left alone and named.
    newest = open_changes[0][1]
    key = (newest["run_id"], newest.get("session_id"))
    group = []
    for item in changes():  # newest first, reverted ones included
        if (item[1]["run_id"], item[1].get("session_id")) != key:
            if group:
                break
            continue
        if not item[1].get("reverted"):
            group.append(item)
    left = [item[0].name for item in open_changes
            if item[1]["run_id"] == newest["run_id"] and item not in group]
    if left:
        print(f"kaizen-backup: run id {newest['run_id']} also appears on older changes; not undoing: {', '.join(left)}",
              file=sys.stderr)
    return group


def tree_size(path):
    return sum(item.stat().st_size for item in Path(path).rglob("*") if item.is_file() and not item.is_symlink())


def prune(args):
    if args.older_than < 1:
        raise ValueError("--older-than must be at least 1 day")
    cutoff = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(days=args.older_than)
    verb = "removed" if args.apply else "would remove"
    count = freed = 0
    for manifest in sorted(ROOT.glob("*/manifest.json")):
        folder = manifest.parent
        if folder.is_symlink():
            print(f"skipped {folder.name}: is a symlink")
            continue
        try:
            data = read_manifest(manifest)
        except ValueError as error:
            print(f"skipped {folder.name}: corrupt manifest ({error})")
            continue
        if not data.get("finished"):
            print(f"skipped {folder.name}: unfinished")
            continue
        try:
            created = datetime.datetime.fromisoformat(str(data.get("created_at")))
            if created.tzinfo is None:
                created = created.replace(tzinfo=datetime.timezone.utc)
        except ValueError:
            print(f"skipped {folder.name}: no usable created_at")
            continue
        if created >= cutoff:
            continue
        size = tree_size(folder)
        if args.apply:
            shutil.rmtree(change_dir(folder))
        print(f"{verb} {folder.name}\t{data['created_at']}\t{size} bytes")
        count += 1
        freed += size
    print(f"{verb} {count} change(s), {'freed' if args.apply else 'would free'} {freed} bytes")


def plugin_roots():
    source = Path(__file__).resolve().parent.parent
    roots = {source} if (source / ".claude-plugin/plugin.json").is_file() else set()
    if os.environ.get("CLAUDE_PLUGIN_ROOT"):
        roots.add(Path(os.environ["CLAUDE_PLUGIN_ROOT"]).expanduser().resolve())
    try:
        recorded = (Path(__file__).absolute().parent / ".kaizen-plugin-root").read_text().strip()
        if recorded:
            roots.add(Path(recorded).expanduser().resolve())
    except FileNotFoundError:
        pass
    return roots


def undo(args):
    plan = targets(args.target)
    roots = plugin_roots()
    conflicts = []
    seen = {}  # the plan is newest first: path -> (newer change name, hash of its backup, i.e. the state it began from)
    for change, data in plan:
        if data.get("reverted"):
            sys.exit(f"kaizen-backup: {change} was already reverted on {data['reverted']}")
        change = change_dir(change)
        for entry in data["files"]:
            path = validate_entry(change, entry, roots)
            if not data.get("finished"):
                if entry["created"] and path.exists():
                    conflicts.append(f"{entry['path']} was created by {change.name}, which was never finished")
            elif path not in seen and sha(path) != entry.get("after_sha256"):
                conflicts.append(f"{entry['path']} changed after {change.name}")
            elif path in seen and seen[path][0] != change.name and seen[path][1] != entry.get("after_sha256"):
                conflicts.append(f"{entry['path']} was edited between {change.name} and {seen[path][0]}")
            before = sha(change / entry["backup"]) if entry.get("backup") else None
            seen[path] = (change.name, before)
    if conflicts and not args.force:
        print("CONFLICT (nothing restored; re-run with --force to overwrite):")
        print("\n".join(f"  {line}" for line in conflicts))
        return 2
    for change, data in plan:  # newest change first
        for entry in data["files"]:
            path = validate_entry(change, entry, roots)
            if entry["created"]:
                if path.exists() and (args.force or sha(path) == entry["after_sha256"]):
                    path.unlink()
                    print(f"removed created {path}")
            else:
                path.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(change / entry["backup"], path)
                print(f"restored {path}")
        for act in data["actions"]:
            print(f"ACTION to reverse by hand (not run): {act['undo']}   # was: {act['did']}")
        data["reverted"] = datetime.date.today().isoformat()
        save(change, data)
        print(f"reverted {change.name}: {data['ledger']}")
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("begin")
    p.add_argument("--skill", required=True)
    p.add_argument("--ledger", required=True)
    p.add_argument("--run")
    p.add_argument("--repo", metavar="DIR", help="capture a clean Git baseline at the first interactive backup")
    p.add_argument("files", nargs="+")
    p.set_defaults(func=begin)
    p = sub.add_parser("finish")
    p.add_argument("change")
    p.add_argument("--verification", choices=("passed", "failed"), default="passed")
    p.set_defaults(func=finish)
    p = sub.add_parser("action")
    p.add_argument("change")
    p.add_argument("--did", required=True)
    p.add_argument("--undo", required=True)
    p.set_defaults(func=action)
    p = sub.add_parser("list")
    p.add_argument("--all", action="store_true")
    p.set_defaults(func=list_changes)
    p = sub.add_parser("undo")
    p.add_argument("target", nargs="?", default="last")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=undo)
    p = sub.add_parser("prune")
    p.add_argument("--older-than", type=int, required=True, metavar="DAYS")
    p.add_argument("--apply", action="store_true")
    p.set_defaults(func=prune)
    args = parser.parse_args(argv)
    try:
        ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
        if not USER_ROOT:
            try:
                ROOT.chmod(0o700)
            except OSError:
                pass  # a root we do not own stays as it is
        return args.func(args) or 0
    except (OSError, ValueError) as error:
        print(f"kaizen-backup: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
