#!/usr/bin/env python3
"""Backups, manifests and undo for Agent Kaizen changes (see docs/autonomy.md).

  kaizen-backup begin  --skill NAME --ledger TEXT [--run RUN_ID] FILE...
        Back up FILEs (existing ones are copied; missing ones are recorded as created)
        and print the change folder. Credential paths are refused. Run BEFORE editing.
  kaizen-backup finish CHANGE_DIR [--verification passed|failed]
        Record each file's sha256 after the edit. Run AFTER editing and verifying.
  kaizen-backup action CHANGE_DIR --did CMD --undo CMD
        Record a non-file action (e.g. a package install) and its reverse command.
  kaizen-backup list [--all]
        List changes (newest first): change dir, run, skill, reverted, ledger text.
  kaizen-backup undo [last|run|CHANGE_DIR] [--force]
        Restore files; delete created files whose hash still matches; print recorded
        actions' undo commands (it never runs them). A file changed since `finish` is a
        conflict: nothing is restored unless --force.

Backups live in KAIZEN_BACKUP_DIR (default <CLAUDE_CONFIG_DIR or ~/.claude>/kaizen-backups),
in folders only the owner can read.
"""
import argparse
import datetime
import hashlib
import json
import os
import re
import runpy
import shutil
import sys
from pathlib import Path



def claude_home():
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude").expanduser()


USER_ROOT = bool(os.environ.get("KAIZEN_BACKUP_DIR"))  # a root the user chose keeps its mode
ROOT = Path(os.environ.get("KAIZEN_BACKUP_DIR") or claude_home() / "kaizen-backups").expanduser().resolve()
is_credential = runpy.run_path(str(Path(__file__).resolve().with_name("kaizen_credentials.py")))["is_credential"]


def sha(path):
    path = Path(path)
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None


REQUIRED_KEYS = ("run_id", "change", "skill", "ledger", "files", "actions")


def read_manifest(path):
    """Read one manifest; any problem raises ValueError that names the file."""
    try:
        data = json.loads(Path(path).read_text())
    except (OSError, ValueError) as error:
        raise ValueError(f"cannot read manifest {path}: {error}") from None
    if not isinstance(data, dict):
        raise ValueError(f"manifest {path} is not a JSON object")
    missing = [key for key in REQUIRED_KEYS if key not in data]
    if missing or not isinstance(data["files"], list) or not isinstance(data["actions"], list):
        raise ValueError(f"manifest {path} is missing or has bad keys: {', '.join(missing) or 'files/actions'}")
    return data


def load(change):
    refuse_symlinks(Path(change) / "manifest.json")
    return read_manifest(Path(change) / "manifest.json")


def save(change, manifest):
    tmp = Path(change) / "manifest.json.tmp"
    refuse_symlinks(tmp)
    refuse_symlinks(Path(change) / "manifest.json")
    tmp.write_text(json.dumps(manifest, indent=2) + "\n")
    tmp.replace(Path(change) / "manifest.json")


def changes(include_reverted=True):
    found = []
    for manifest in ROOT.glob("*/manifest.json"):
        try:
            data = read_manifest(manifest)
        except ValueError as error:
            print(f"kaizen-backup: skipping {error}", file=sys.stderr)
            continue
        if include_reverted or not data.get("reverted"):
            found.append((manifest.parent, data))
    # Newest first. Run ids are free text, so order by creation time; no created_at sorts oldest.
    return sorted(found, key=lambda item: (str(item[1].get("created_at") or ""), str(item[1]["run_id"]),
                                           str(item[1]["change"]).zfill(8)), reverse=True)


def next_number(run_id):
    """One more than the highest NN in existing folders named <run_id>-NN-<skill>."""
    numbers = [0]
    for item in ROOT.iterdir():
        if item.is_dir() and not item.is_symlink() and item.name.startswith(run_id + "-"):
            match = re.match(r"(\d+)-", item.name[len(run_id) + 1:])
            if match:
                numbers.append(int(match.group(1)))
    return max(numbers) + 1


def valid_id(value):
    if any(part in value for part in ("/", "..", "\0")):
        raise ValueError("--run and --skill must not contain /, .. or NUL")
    return value


def change_dir(path):
    resolved = Path(path).expanduser().resolve()
    if ROOT not in resolved.parents:
        raise ValueError(f"CHANGE_DIR must be inside the backups root: {resolved}")
    return resolved


def refuse_symlinks(path, roots=()):
    resolved = path.resolve()
    if path.is_symlink() or resolved != path:
        if any(resolved == root or root in resolved.parents for root in roots):
            raise ValueError(f"refusing to restore through symlink into plugin root: {path}; "
                             "run kaizen-link --unlink --restore-replaced first")
        raise ValueError(f"refusing to access target through symlink: {path}")


def validate_entry(change, entry, roots=()):
    if not isinstance(entry, dict) or not isinstance(entry.get("path"), str):
        raise ValueError("entry path must be an absolute normalised string")
    name = entry["path"]
    path = Path(name)
    if not path.is_absolute() or str(path) != name or ".." in path.parts or "\0" in name:
        raise ValueError(f"entry path must be absolute and normalised without ..: {name}")
    refuse_symlinks(path, roots)
    if not isinstance(entry.get("created"), bool):
        raise ValueError(f"entry created flag must be boolean: {name}")
    # Preflight all targets before undo changes anything, including with --force.
    if path.is_dir():
        raise ValueError(f"entry target is a directory: {path}")
    if not entry["created"] or entry.get("backup") is not None:
        if not isinstance(entry.get("backup"), str):
            raise ValueError(f"entry backup must name a file inside its change directory: {name}")
        backup = change / entry["backup"]
        if change.resolve() not in backup.resolve().parents:
            raise ValueError(f"entry backup must resolve inside its change directory: {backup}")
        refuse_symlinks(backup)
        if not backup.is_file():
            raise ValueError(f"entry backup is not a regular file: {backup}")
    return path


def begin(args):
    # Preflight every input before copying anything or creating a change folder.
    for name in args.files:
        if is_credential(name):
            raise ValueError(f"refusing to back up credential path: {name}")
        path = Path(name).expanduser().resolve()
        if path.exists() and not path.is_file():
            sys.exit(f"kaizen-backup: {path} is not a regular file")
    created_at = datetime.datetime.now(datetime.timezone.utc).isoformat()
    run_id = args.run or os.environ.get("KAIZEN_RUN_ID") or datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    valid_id(run_id)
    valid_id(args.skill)
    number = next_number(run_id)
    change = change_dir(ROOT / f"{run_id}-{number:02d}-{args.skill}")
    change.mkdir(mode=0o700)
    try:
        (change / "files").mkdir(mode=0o700)
        entries = []
        for index, name in enumerate(args.files, 1):
            # User paths may use a symlinked home or /tmp; store their canonical target.
            path = Path(name).expanduser().resolve()
            entry = {"path": str(path), "backup": None, "created": not path.exists(), "after_sha256": None}
            if path.is_file():
                entry["backup"] = f"files/{index}"
                shutil.copy2(path, change / entry["backup"])
            entries.append(entry)
        save(change, {"run_id": run_id, "change": number, "skill": args.skill, "ledger": args.ledger,
                      "created_at": created_at, "session_id": os.environ.get("KAIZEN_SESSION_ID"),
                      "files": entries, "actions": [], "finished": False, "verification": None,
                      "reverted": None})
    except BaseException:
        shutil.rmtree(change, ignore_errors=True)
        raise
    print(change)


def finish(args):
    args.change = change_dir(args.change)
    manifest = load(args.change)
    for entry in manifest["files"]:
        entry["after_sha256"] = sha(validate_entry(args.change, entry, plugin_roots()))
    manifest["finished"] = True
    manifest["verification"] = args.verification
    save(args.change, manifest)
    print(f"finished {args.change}: {len(manifest['files'])} file(s) recorded")


def action(args):
    manifest = load(args.change)
    manifest["actions"].append({"did": args.did, "undo": args.undo})
    save(args.change, manifest)
    print(f"recorded action in {args.change}")


def list_changes(args):
    for change, data in changes(include_reverted=args.all):
        state = f"reverted {data['reverted']}" if data.get("reverted") else ("open" if data.get("finished") else "unfinished")
        print(f"{change}\t{data['run_id']}\t{data['skill']}\t{state}\t{data['ledger']}")


def targets(which):
    if which not in ("last", "run"):
        change = Path(which).expanduser()
        change = change if change.is_absolute() else ROOT / change
        change = change_dir(change)
        return [(change, load(change))]
    open_changes = changes(include_reverted=False)
    if not open_changes:
        sys.exit("kaizen-backup: nothing to undo")
    if which == "last":
        return [open_changes[0]]
    if which == "run":
        run_id = open_changes[0][1]["run_id"]
        return [item for item in open_changes if item[1]["run_id"] == run_id]


def plugin_roots():
    source = Path(__file__).resolve().parent.parent
    roots = {source} if (source / ".claude-plugin/plugin.json").is_file() else set()
    if os.environ.get("CLAUDE_PLUGIN_ROOT"):
        roots.add(Path(os.environ["CLAUDE_PLUGIN_ROOT"]).expanduser().resolve())
    try:
        recorded = (Path(__file__).absolute().parent / ".kaizen-plugin-root").read_text().strip()
        if recorded:
            roots.add(Path(recorded).expanduser().resolve())
    except FileNotFoundError:
        pass
    return roots


def undo(args):
    plan = targets(args.target)
    roots = plugin_roots()
    conflicts = []
    seen = {}  # the plan is newest first: path -> (newer change name, hash of its backup, i.e. the state it began from)
    for change, data in plan:
        if data.get("reverted"):
            sys.exit(f"kaizen-backup: {change} was already reverted on {data['reverted']}")
        change = change_dir(change)
        for entry in data["files"]:
            path = validate_entry(change, entry, roots)
            if not data.get("finished"):
                if entry["created"] and path.exists():
                    conflicts.append(f"{entry['path']} was created by {change.name}, which was never finished")
            elif path not in seen and sha(path) != entry.get("after_sha256"):
                conflicts.append(f"{entry['path']} changed after {change.name}")
            elif path in seen and seen[path][0] != change.name and seen[path][1] != entry.get("after_sha256"):
                conflicts.append(f"{entry['path']} was edited between {change.name} and {seen[path][0]}")
            before = sha(change / entry["backup"]) if entry.get("backup") else None
            seen[path] = (change.name, before)
    if conflicts and not args.force:
        print("CONFLICT (nothing restored; re-run with --force to overwrite):")
        print("\n".join(f"  {line}" for line in conflicts))
        return 2
    for change, data in plan:  # newest change first
        for entry in data["files"]:
            path = validate_entry(change, entry, roots)
            if entry["created"]:
                if path.exists() and (args.force or sha(path) == entry["after_sha256"]):
                    path.unlink()
                    print(f"removed created {path}")
            else:
                path.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(change / entry["backup"], path)
                print(f"restored {path}")
        for act in data["actions"]:
            print(f"ACTION to reverse by hand (not run): {act['undo']}   # was: {act['did']}")
        data["reverted"] = datetime.date.today().isoformat()
        save(change, data)
        print(f"reverted {change.name}: {data['ledger']}")
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("begin")
    p.add_argument("--skill", required=True)
    p.add_argument("--ledger", required=True)
    p.add_argument("--run")
    p.add_argument("files", nargs="+")
    p.set_defaults(func=begin)
    p = sub.add_parser("finish")
    p.add_argument("change")
    p.add_argument("--verification", choices=("passed", "failed"), default="passed")
    p.set_defaults(func=finish)
    p = sub.add_parser("action")
    p.add_argument("change")
    p.add_argument("--did", required=True)
    p.add_argument("--undo", required=True)
    p.set_defaults(func=action)
    p = sub.add_parser("list")
    p.add_argument("--all", action="store_true")
    p.set_defaults(func=list_changes)
    p = sub.add_parser("undo")
    p.add_argument("target", nargs="?", default="last")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=undo)
    args = parser.parse_args(argv)
    try:
        ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
        if not USER_ROOT:
            try:
                ROOT.chmod(0o700)
            except OSError:
                pass  # a root we do not own stays as it is
        return args.func(args) or 0
    except (OSError, ValueError) as error:
        print(f"kaizen-backup: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
