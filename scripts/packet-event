#!/usr/bin/env python3
"""Append a packet state event to a JSONL log."""

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import sys


STATES = ('queued', 'dispatched', 'checks', 'slot-wait', 'review', 'ready',
          'landed', 'failed')


def invalid(message):
    print('packet-event: ' + message, file=sys.stderr)
    return 2


def main():
    parser = argparse.ArgumentParser(
        description='Append a packet event. States: queued, dispatched, round-N '
                    '(positive integer), checks, slot-wait, review, ready, landed, failed.',
        epilog='Default file: out/packet-events.jsonl. Exit codes: 0 written; '
               '1 write failed; 2 invalid input.')
    parser.add_argument('id', help='non-empty packet ID without a newline')
    parser.add_argument('state', help='packet state')
    parser.add_argument('--file', default='out/packet-events.jsonl', help='event log path')
    parser.add_argument('--ts', help='timezone-aware ISO timestamp (default: current UTC time)')
    parser.add_argument('--detail', help='optional event detail')
    args = parser.parse_args()

    if not args.id or '\n' in args.id or '\r' in args.id:
        return invalid('ID must be non-empty and contain no newline')
    if args.state not in STATES and not re.fullmatch(r'round-[1-9][0-9]*', args.state):
        return invalid('invalid state')
    if args.ts is None:
        timestamp = datetime.now(timezone.utc)
    else:
        try:
            timestamp = datetime.fromisoformat(args.ts.replace('Z', '+00:00'))
            if timestamp.tzinfo is None or timestamp.utcoffset() is None:
                raise ValueError('timezone required')
            timestamp = timestamp.astimezone(timezone.utc)
        except (ValueError, OverflowError):
            return invalid('--ts must be a timezone-aware ISO timestamp')
    event = {'ts': timestamp.isoformat(timespec='microseconds' if timestamp.microsecond else 'seconds')
             .replace('+00:00', 'Z'), 'id': args.id, 'state': args.state}
    if args.detail is not None:
        event['detail'] = args.detail
    line = (json.dumps(event, ensure_ascii=False, separators=(',', ':')) + '\n').encode('utf-8')
    if len(line) > 4096:
        return invalid('event line exceeds 4096 bytes')

    try:
        path = Path(args.file)
        path.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        try:
            written = os.write(fd, line)
            if written != len(line):
                print('packet-event: short write (%d of %d bytes)' % (written, len(line)),
                      file=sys.stderr)
                return 1
        finally:
            os.close(fd)
    except OSError as error:
        print('packet-event: %s' % error, file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
