#!/usr/bin/env python3
"""Flag stale wording in Claude and repository instruction files."""
import argparse
import glob
import json
import os
from pathlib import Path
import re
import sys


def claude_home():
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude").expanduser()


def patterns(paths):
    result = []
    for path in paths:
        try:
            with path.open(encoding="utf-8", errors="replace") as source:
                for number, line in enumerate(source, 1):
                    pattern = line.split("#", 1)[0].strip()
                    if pattern:
                        try:
                            result.append((pattern, re.compile(pattern)))
                        except re.error as exc:
                            raise ValueError(f"bad pattern {path}:{number}: {exc}") from exc
        except FileNotFoundError:
            continue
    return result


def scan_files(home, repos):
    globs = [glob.escape(str(home)) + "/CLAUDE.md", glob.escape(str(home)) + "/agents/*.md"]
    settings = home / "agent-kaizen.json"
    try:
        with settings.open(encoding="utf-8", errors="replace") as source:
            config = json.load(source)
    except FileNotFoundError:
        config = {}
    if not isinstance(config, dict):
        raise ValueError("settings must be a JSON object")
    extra = config.get("rulesLintFiles", [])
    if not isinstance(extra, list) or not all(isinstance(item, str) for item in extra):
        raise ValueError("rulesLintFiles must be a list of strings")
    for item in extra:
        path = Path(item).expanduser()
        globs.append(str(path) if path.is_absolute() else glob.escape(str(home)) + "/" + str(path))
    for repo in repos:
        for item in ("CLAUDE.md", "AGENTS.md", "docs/agents/*.md",
                     ".claude/agent-context/*.md", ".claude/agents/*.md"):
            globs.append(glob.escape(str(repo)) + "/" + item)
    excluded = {Path(__file__).resolve().with_name("rules-lint.patterns")}
    excluded.update((repo / "docs/kaizen/rules-lint.txt").resolve() for repo in repos)
    seen = set()
    for pattern in globs:
        for name in sorted(glob.glob(pattern)):
            path = Path(name)
            resolved = path.resolve()
            if path.name != "DROPPED.md" and resolved not in seen and resolved not in excluded:
                seen.add(resolved)
                yield path


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", action="append", default=[], metavar="DIR")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    repos = [Path(repo) for repo in args.repo]
    if not repos and (Path("CLAUDE.md").is_file() or Path("AGENTS.md").is_file()):
        repos = [Path.cwd()]
    home = claude_home()
    sources = [Path(__file__).resolve().with_name("rules-lint.patterns"),
               home / "kaizen-rules-lint.txt"]
    sources.extend(repo / "docs/kaizen/rules-lint.txt" for repo in repos)
    try:
        regs = patterns(sources)
        if not regs:
            print("rules-lint: no patterns configured")
            return 0
        hits = []
        for path in scan_files(home, repos):
            with path.open(encoding="utf-8", errors="replace") as source:
                for number, line in enumerate(source, 1):
                    if "rules-lint: allow" in line:
                        continue
                    for pattern, regex in regs:
                        if regex.search(line):
                            hits.append({"path": str(path), "line": number,
                                         "pattern": pattern, "text": line.strip()})
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"rules-lint: {exc}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps({"count": len(hits), "hits": hits}))
    else:
        for hit in hits:
            print(f"{hit['path']}:{hit['line']}: {hit['pattern']}: {hit['text']}")
        print(f"rules-lint: {len(hits)} stale-rule hit(s)")
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main())
