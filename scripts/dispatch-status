#!/usr/bin/env python3
"""Show running dispatch commands and the latest saved report per repository."""
import argparse
from pathlib import Path
import subprocess


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('directories', nargs='*', type=Path, help='repository/worktree paths (default: current directory)')
    args = parser.parse_args()
    print('RUNNING (pid, elapsed, command)')
    try:
        result = subprocess.run(['ps', '-eo', 'pid=,etime=,args='], capture_output=True, text=True, check=False)
        for line in result.stdout.splitlines():
            if 'codex-dispatch' in line and 'dispatch-status' not in line:
                print(line.strip())
    except OSError as exc:
        print(f'Process listing unavailable: {exc}')
    print('\nLATEST REPORT PER DIRECTORY')
    for directory in args.directories or [Path.cwd()]:
        root = directory.expanduser().resolve()
        reports = list((root / 'out/dispatch').glob('*/report.md'))
        if not reports:
            print(f'{root}: no reports')
            continue
        latest = max(reports, key=lambda p: (p.stat().st_mtime_ns, str(p)))
        status = [line for line in latest.read_text(errors='replace').splitlines() if line.startswith('STATUS:')]
        print(f'{root}: {status[-1] if status else "STATUS: unknown"} ({latest})')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
