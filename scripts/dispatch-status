#!/usr/bin/env python3
"""Show running dispatch commands and the latest saved report per repository."""
import argparse
import ctypes
import os
from pathlib import Path
import re
import shlex
import struct
import subprocess
import sys
import time


def git(directory, *arguments, executable='git', env=None):
    try:
        return subprocess.run([executable, '-C', str(directory), *arguments], env=env,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False)
    except OSError:
        return None


def worktrees(directory):
    result = git(directory, 'worktree', 'list', '--porcelain', '-z')
    separator = b'\0'
    if result is not None and result.returncode:
        # Git older than 2.36 has no -z for this command.
        result = git(directory, 'worktree', 'list', '--porcelain')
        separator = b'\n'
    if result is None or result.returncode:
        return [directory]
    return [Path(os.fsdecode(field[9:]))
            for field in result.stdout.split(separator) if field.startswith(b'worktree ')]


def dirty_row(directory):
    result = git(directory, 'status', '--porcelain', '-z', '--untracked-files=all', '--', '.', ':!out')
    if result is None or result.returncode:
        return None
    fields = result.stdout.split(b'\0')
    paths = []
    index = 0
    while index < len(fields) and fields[index]:
        entry = fields[index]
        paths.append(Path(os.fsdecode(entry[3:])))
        index += 2 if b'R' in entry[:2] or b'C' in entry[:2] else 1
    if not paths:
        return None
    times = []
    for path in paths:
        candidate = directory / path
        while not candidate.exists() and candidate != candidate.parent:
            candidate = candidate.parent
        try:
            times.append(candidate.stat().st_mtime)
        except OSError:
            continue
    seconds = max(0, time.time() - max(times, default=time.time()))
    age = f'{int(seconds / 86400)}d' if seconds >= 86400 else f'{int(seconds / 3600)}h' if seconds >= 3600 else f'{int(seconds / 60)}m'
    result = git(directory, 'log', '-1', '--format=%s')
    subject = result.stdout.decode(errors='replace').strip()[:70] if result and result.returncode == 0 else ''
    return f'{directory}: {len(paths)} paths, {age}, {subject}'


def advisory_status(run, path):
    return run(path, '-c', 'status.showUntrackedFiles=all', 'status', '--porcelain=v1',
               '-z', '--untracked-files=all', '--ignored=matching')


def process_args(pid):
    if sys.platform.startswith('linux'):
        raw = Path(f'/proc/{pid}/cmdline').read_bytes()
        return [os.fsdecode(arg) for arg in raw.split(b'\0')[:-1]]
    if sys.platform == 'darwin':
        # CTL_KERN/KERN_PROCARGS2 returns argc, the executable, argv and env.
        mib = (ctypes.c_int * 3)(1, 49, pid)
        data = ctypes.create_string_buffer(os.sysconf('SC_ARG_MAX'))
        size = ctypes.c_size_t(len(data))
        if ctypes.CDLL(None).sysctl(mib, len(mib), data, ctypes.byref(size), None, 0) != 0:
            return []
        count, = struct.unpack_from('@i', data)
        argv = data.raw[struct.calcsize('@i'):size.value].partition(b'\0')[2].lstrip(b'\0')
        return [os.fsdecode(arg) for arg in argv.split(b'\0', count)[:count]]
    return []


def process_details(pid):
    command = process_args(pid)
    if not command:
        return [], None
    if sys.platform.startswith('linux'):
        cwd = Path(os.readlink(f'/proc/{pid}/cwd'))
    else:
        result = subprocess.run(['/usr/sbin/lsof', '-nP', '-a', '-p', str(pid), '-d', 'cwd', '-Fn0'],
                                capture_output=True, timeout=1, check=False)
        cwd = next((Path(os.fsdecode(field[1:])) for field in result.stdout.split(b'\0')
                    if field.startswith(b'n/')), None)
    return (command, cwd) if process_args(pid) == command else ([], None)


def repository_identity(directory):
    directory = directory.resolve(strict=True)
    try:
        from kaizen_worktree_facts import repository_dirs
    except ImportError:
        env = dict(PATH='/usr/bin:/bin', GIT_CONFIG_NOSYSTEM='1', GIT_CONFIG_GLOBAL=os.devnull)
        for executable in ('/usr/bin/git', '/opt/homebrew/bin/git', '/usr/local/bin/git'):
            result = git(directory, 'rev-parse', '--git-common-dir', executable=executable, env=env)
            if result is not None and result.returncode == 0 and result.stdout:
                return (directory / os.fsdecode(result.stdout.rstrip(b'\n'))).stat()
        return None
    dirs = repository_dirs(directory)
    return dirs[2 if len(dirs) > 2 else 1].stat() if len(dirs) >= 2 else None


def running(all_processes):
    print('RUNNING (pid, elapsed, command)')
    try:
        result = subprocess.run(['ps', '-ww', '-eo', 'pid=,etime=,args='],
                                capture_output=True, text=True, errors='surrogateescape', check=False)
    except OSError as exc:
        print(f'Process listing unavailable: {exc}')
        return
    hidden = 0
    scope = None
    if not all_processes:
        try:
            scope = repository_identity(Path.cwd())
        except (ImportError, OSError, ValueError, RuntimeError):
            pass
    parser = argparse.ArgumentParser(add_help=False, allow_abbrev=False, exit_on_error=False)
    parser.add_argument('-C', type=Path)
    for line in result.stdout.splitlines():
        fields = line.split(maxsplit=2)
        if (len(fields) != 3 or not re.fullmatch(r'[0-9]+', fields[0])
                or not re.fullmatch(r'(?:[0-9]+-)?(?:[0-9]+:)?[0-9]{2}:[0-9]{2}', fields[1])
                or not any(os.path.basename(word) == 'codex-dispatch' for word in fields[2].split())):
            continue
        if all_processes:
            print(line.strip())
            continue
        if scope is not None:
            try:
                command, cwd = process_details(int(fields[0]))
                script = next((i for i, arg in enumerate(command[:2])
                               if os.path.basename(arg) == 'codex-dispatch'), None)
                if script is not None:
                    target = parser.parse_known_args(command[script + 1:])[0].C
                    if target is None:
                        target = cwd
                    elif not target.is_absolute():
                        target = cwd / target if cwd is not None else None
                    identity = repository_identity(target) if target is not None else None
                    if identity is not None and os.path.samestat(scope, identity):
                        print(fields[0], fields[1], shlex.join(command))
                        continue
            except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired, argparse.ArgumentError):
                pass
        hidden += 1
    if hidden:
        print(f'{hidden} other or unverified dispatches')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('directories', nargs='*', type=Path, help='repository/worktree paths (default: current directory)')
    parser.add_argument('--worktree-facts', action='store_true', help='show advisory Git worktree facts')
    parser.add_argument('--all', action='store_true', help='show machine-wide running dispatch commands')
    args = parser.parse_args()
    running(args.all)
    print('\nLATEST REPORT PER DIRECTORY')
    for directory in args.directories or [Path.cwd()]:
        root = directory.expanduser().resolve()
        reports = list((root / 'out/dispatch').glob('*/report.md'))
        if not reports:
            print(f'{root}: no reports')
            continue
        latest = max(reports, key=lambda p: (p.stat().st_mtime_ns, str(p)))
        status = [line for line in latest.read_text(errors='replace').splitlines() if line.startswith('STATUS:')]
        print(f'{root}: {status[-1] if status else "STATUS: unknown"} ({latest})')
    print('\nDIRTY WORKTREES (uncommitted paths outside out/, newest change age)')
    if args.worktree_facts:
        print('Unavailable in advisory mode')
    else:
        directories = args.directories or worktrees(Path.cwd())
        seen = set()
        for directory in directories:
            root = directory.expanduser().resolve()
            # Status paths are relative to Git's repository root.
            result = git(root, 'rev-parse', '--show-toplevel')
            if result and result.returncode == 0:
                root = Path(os.fsdecode(result.stdout.rstrip(b'\n'))).resolve()
            if root in seen:
                continue
            seen.add(root)
            row = dirty_row(root)
            if row:
                print(row)
    if args.worktree_facts:
        print('\nWORKTREE FACTS (advisory)')
        try:
            from kaizen_worktree_facts import read_facts, repository_dirs
        except ImportError:
            print('Worktree facts unavailable')
        else:
            shown = set()
            for directory in args.directories or [Path.cwd()]:
                facts = read_facts(directory.expanduser(), advisory_status)
                if facts is None:
                    print(f'{directory}: unknown')
                    continue
                selected = None
                if args.directories:
                    selected = directory.expanduser().resolve()
                    try:
                        roots = repository_dirs(selected)
                        if roots:
                            selected = roots[0]
                    except (OSError, ValueError, RuntimeError):
                        pass
                matched = False
                for fact in facts:
                    path = fact['path']
                    if selected is not None and path != selected:
                        try:
                            if not path.samefile(selected):
                                continue
                        except OSError:
                            continue
                    matched = True
                    if path in shown:
                        continue
                    shown.add(path)
                    def value(item):
                        return 'unknown' if item is None else str(item).lower() if isinstance(item, bool) else str(item)
                    print(' '.join(f'{key}={value(fact[key])}' for key in
                                   ('path', 'branch', 'tip', 'primary', 'linked', 'locked', 'detached',
                                    'clean', 'merged', 'git_source') if key in fact))
                if selected is not None and not matched:
                    print(f'{directory}: unknown')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
