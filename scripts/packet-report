#!/usr/bin/env python3
"""Read-only packet outcomes and calibration proposals.

JSON keys: groups, area_groups (model, effort, optional area, n, first_pass_n,
first_pass, fix_rate, median_rounds, median_wall_s, median_lines); totals
(packets, span_days, merges_per_day); fix_origins (origin: count); proposals
(model, effort, optional area, direction); escalations (count, pairs);
dispatch_models_coverage (n_with, n_total); unknown_models, data_coverage,
landed_failing, review_economics; rule, disclaimer. UP proposals include fix_evidence
and may be HOLD or include hold_blocked. Thresholds are set by --small-fix-lines
and --small-fix-tokens. HOLD requires complete, strictly below-threshold fix evidence. The new keys follow --since/--until filters.
Rates are fractions;
null first_pass means no eligible samples. n includes fixes, but first_pass_n
and first_pass exclude packets with a fix_origin. Span uses inclusive UTC dates.
--since/--until filter counts and samples; fixes from the entire file inform
rates and HOLD attribution.
"""
import argparse
from collections import Counter, defaultdict
from datetime import date, datetime, timezone
import json
import math
import re
import os
from pathlib import Path
from statistics import median
import sys

BUILTIN_MODELS = {'haiku', 'sonnet', 'opus', 'terra', 'sol'}
DEFAULT_LADDER = ['haiku', 'sonnet medium', 'sonnet high', 'opus high']
RULE = 'Rules: n >= 8; UP if first-pass < 70% or fix rate > 30%; HOLD instead of UP when attributed fixes have complete small evidence; DOWN if first-pass >= 95% and no batch-review/final-audit fixes.'
DISCLAIMER = 'Proposals only: the owner decides'


def packet_date(row):
    return datetime.fromisoformat(row['ts'].replace('Z', '+00:00')).astimezone(timezone.utc).date()


def parse_ladder(value):
    if not isinstance(value, list) or not value:
        raise ValueError('ladder must be a nonempty list of rungs')
    result = []
    for rung in value:
        if not isinstance(rung, str) or not 1 <= len(rung.split()) <= 2:
            raise ValueError('each ladder rung must be a model or model and effort')
        parts = rung.split()
        result.append((parts[0], parts[1] if len(parts) == 2 else ''))
    return result


def normalize_model(model, models):
    model = model.lower()
    known = BUILTIN_MODELS | {name.lower() for name in models}
    if model in known:
        return model
    matches = set(re.split('[-:]', model)) & known
    return next(iter(matches)) if len(matches) == 1 else model


def evidence_states(row):
    """Classify optional evidence without treating missing values as zero."""
    states = {}
    for key in ('tokens_in', 'tokens_out', 'cost'):
        value = row.get(key)
        valid = (isinstance(value, (int, float)) and not isinstance(value, bool)
                 and (not isinstance(value, float) or math.isfinite(value)) and value >= 0)
        states[key] = ('missing' if not valid else
                       'zero' if key == 'tokens_in' and value == 0 else 'known')
    return states


def summarize(rows, since=None, until=None, ladder=None, small_fix_lines=100, small_fix_tokens=4000000):
    ladder = ladder or parse_ladder(DEFAULT_LADDER)
    ladder = [(normalize_model(model, set()), effort.lower()) for model, effort in ladder]
    models = {model for model, _ in ladder}
    fixed = {packet for row in rows for packet in row['fixes'] if packet != row['id']}
    audited = {packet for row in rows if row['fix_origin'] in ('batch-review', 'final-audit')
               for packet in row['fixes'] if packet != row['id']}
    selected = []
    for row in rows:
        day = packet_date(row)
        if (since is not None and day < since) or (until is not None and day >= until):
            continue
        selected.append(dict(row, model=normalize_model(row['model'], models)))
    unknown_ids = [row['id'] for row in selected if row['model'] == 'unknown']
    failing_ids = [row['id'] for row in selected
                   if isinstance(row.get('merge_sha'), str) and row['merge_sha'].strip()
                   and row['status'] == 'CHECKS FAILING']
    evidence = [(row['id'], evidence_states(row)) for row in selected]
    coverage_data = {'rows': len(selected)}
    for key in ('tokens_in', 'tokens_out', 'cost'):
        states = ('known', 'zero', 'missing') if key == 'tokens_in' else ('known', 'missing')
        counts = {state: sum(values[key] == state for _, values in evidence) for state in states}
        counts.update({state + '_ids': [packet_id for packet_id, values in evidence
                                       if values[key] == state]
                       for state in states if state != 'known'})
        coverage_data[key] = counts
    fixes = [row for row in selected if row['fix_origin'] is not None]
    all_ids = {row['id'] for row in rows}
    fix_ids = {row['id'] for row in rows if row['fix_origin'] is not None}
    landed = sum(bool(isinstance(row.get('merge_sha'), str) and row['merge_sha'].strip()) for row in selected)
    fix_of_fix = sum(any(ref != row['id'] and ref in fix_ids for ref in row['fixes']) for row in fixes)
    unknown_refs = sum(ref not in all_ids for row in fixes for ref in row['fixes'])
    known_severity = [row for row in fixes if isinstance(row.get('review_severities'), list)
                      and all(isinstance(value, str) for value in row['review_severities'])]
    no_must = [row['id'] for row in known_severity
               if not any(value.upper() == 'MUST-FIX' for value in row['review_severities'])]
    unknown_severity = [row['id'] for row in fixes if row not in known_severity]
    economics = dict(landed=landed, fix_packets=len(fixes),
                     fix_per_landed=len(fixes) / landed if landed else None,
                     fix_of_fix=dict(count=fix_of_fix, rate=fix_of_fix / len(fixes) if fixes else None,
                                     unknown_references=unknown_refs),
                     no_must_fix=dict(count=len(no_must), ids=no_must),
                     severity_coverage=dict(known=len(known_severity), unknown=len(unknown_severity),
                                            unknown_ids=unknown_severity),
                     thresholds=dict(small_fix_lines=small_fix_lines, small_fix_tokens=small_fix_tokens))
    proposals = []

    def groups(keys):
        buckets = defaultdict(list)
        for row in selected:
            buckets[tuple(row[key] for key in keys)].append(row)
        result = []
        for key, samples in sorted(buckets.items()):
            eligible = [row for row in samples if row['fix_origin'] is None]
            first = sum(row['status'] == 'DONE' and row['dispatches'] == 1 and row['rounds'] == 0
                        for row in eligible) / len(eligible) if eligible else None
            rate = sum(row['id'] in fixed for row in samples) / len(samples)
            group = dict(zip(keys, key), n=len(samples), first_pass_n=len(eligible),
                         first_pass=first, fix_rate=rate,
                         median_rounds=median(row['rounds'] for row in samples),
                         median_wall_s=median(walls) if (walls := [row['wall_s'] for row in samples if row['wall_s'] is not None]) else None,
                         median_lines=median(row['lines'] for row in samples))
            result.append(group)
            rung = (group['model'], group['effort'])
            if (group['model'], '') in ladder:
                rung = (group['model'], '')
            direction = None
            if len(samples) >= 8 and rung in ladder:
                if (first is not None and first < .70) or rate > .30:
                    direction = 'UP'
                elif first is not None and first >= .95 and not any(row['id'] in audited for row in samples):
                    direction = 'DOWN'
            if direction:
                proposal = dict(zip(keys, key), direction=direction)
                if direction == 'UP':
                    sample_ids = {row['id'] for row in samples}
                    attributed = [row for row in rows if row['fix_origin'] is not None
                                  and any(ref in sample_ids and ref != row['id'] for ref in row['fixes'])]
                    incomplete = [row['id'] for row in attributed if not row['lines_known'] or
                                  any(evidence_states(row)[k] != 'known' for k in ('tokens_in', 'tokens_out'))]
                    large = [row['id'] for row in attributed if row['id'] not in incomplete and
                             (row['lines'] >= small_fix_lines or
                              row['tokens_in'] + row['tokens_out'] >= small_fix_tokens)]
                    proposal['fix_evidence'] = dict(attributed=len(attributed),
                                                    complete=bool(attributed) and not incomplete,
                                                    small=bool(attributed) and not incomplete and not large)
                    if not attributed:
                        proposal['hold_blocked'] = 'no attributed fixes'
                    elif incomplete:
                        proposal['hold_blocked'] = 'unknown evidence: ' + ', '.join(incomplete)
                    elif large:
                        proposal['hold_blocked'] = 'fix not small: ' + ', '.join(large)
                    else:
                        proposal['direction'] = 'HOLD'
                        proposal['reason'] = 'all attributed fixes are complete and small'
                proposals.append(proposal)
        return result

    overall = groups(('model', 'effort'))
    areas = groups(('model', 'effort', 'area'))
    dates = [packet_date(row) for row in selected]
    span = (max(dates) - min(dates)).days + 1 if dates else 0
    histories = [row['dispatch_models'] for row in selected if row['dispatch_models'] is not None]
    paths = []
    for history in histories:
        path = []
        for dispatch in history:
            step = (normalize_model(dispatch['model'], models), dispatch['effort'])
            if not path or path[-1] != step:
                path.append(step)
        if len(set(path)) > 1:
            if len({effort for _, effort in path}) == 1:
                # Only the model changed: label by the distinct model path.
                names = [name for name, _ in path]
                paths.append('->'.join(names[i] for i in range(len(names)) if not i or names[i] != names[i - 1]))
            else:
                paths.append('->'.join(f'{name}:{effort}' for name, effort in path))
    pairs = Counter(paths)
    return dict(unknown_models=dict(count=len(unknown_ids), ids=unknown_ids),
                data_coverage=coverage_data, review_economics=economics,
                landed_failing=dict(count=len(failing_ids), ids=failing_ids),
                groups=overall, area_groups=areas,
                escalations=dict(count=sum(pairs.values()),
                                 pairs=dict(sorted(pairs.items(), key=lambda item: (-item[1], item[0])))),
                dispatch_models_coverage=dict(n_with=len(histories), n_total=len(selected)),
                totals=dict(packets=len(selected), span_days=span,
                            merges_per_day=len(selected) / span if span else 0),
                fix_origins=dict(sorted(Counter(row['fix_origin'] for row in selected
                                               if row['fix_origin'] is not None).items())),
                proposals=proposals, rule=RULE, disclaimer=DISCLAIMER)


def render(result, markdown=False):
    def bounded(rows, limit):
        return rows if len(rows) <= limit else rows[:limit - 1] + [f'... {len(rows) - limit + 1} rows omitted']

    lines = ['Packet outcomes']
    if not result['totals']['packets']:
        lines.append('No packet data yet')
    header = 'model effort / area | n | first-pass % | fix rate % | median rounds | median wall min | median lines'
    lines.append(('| ' + header + ' |') if markdown else header.replace(' | ', '  '))
    if markdown:
        lines.append('| --- | ---: | ---: | ---: | ---: | ---: | ---: |')
    rows = []
    for group in result['groups'] + result['area_groups']:
        name = f"{group['model']} {group['effort']}" + (f" / {group['area']}" if 'area' in group else '')
        first = 'unknown' if group['first_pass'] is None else f"{group['first_pass'] * 100:.1f}"
        values = [name, str(group['n']), first, f"{group['fix_rate'] * 100:.1f}",
                  f"{group['median_rounds']:g}", (f"{group['median_wall_s'] / 60:.1f}" if group['median_wall_s'] is not None else "unknown"), f"{group['median_lines']:g}"]
        rows.append('| ' + ' | '.join(values) + ' |' if markdown else '  '.join(values))
    lines += bounded(rows, 8)
    total = result['totals']
    lines += [f"Totals: {total['packets']} packets; {total['merges_per_day']:.2f} merges/day over {total['span_days']} days",
              'Fix origins']
    lines += bounded([f'{key}: {value}' for key, value in result['fix_origins'].items()] or ['none'], 3)
    coverage = result['dispatch_models_coverage']
    escalations = result['escalations']
    lines += ['Escalations', f"{escalations['count']} packets; dispatch models known for {coverage['n_with']}/{coverage['n_total']}"]
    lines += bounded([f'{pair}: {count}' for pair, count in escalations['pairs'].items()] or ['none'], 5)
    def ids_text(ids):
        return ', '.join(ids[:10] + ([f'... {len(ids) - 10} more'] if len(ids) > 10 else [])) or 'none'

    unknown = result['unknown_models']
    failing = result['landed_failing']
    lines += ['Data quality', f"Unknown models: {unknown['count']}; ids: {ids_text(unknown['ids'])}"]
    for key in ('tokens_in', 'tokens_out', 'cost'):
        item = result['data_coverage'][key]
        parts = [f"known: {item['known']}"]
        for state in ('zero', 'missing'):
            if state in item:
                parts.append(f"{state}: {item[state]} (ids: {ids_text(item[state + '_ids'])})")
        lines.append(f"{key}: " + '; '.join(parts))
    econ = result['review_economics']
    fof = econ['fix_of_fix']
    severity = econ['severity_coverage']
    def rate(value):
        return 'unknown' if value is None else f'{value * 100:.1f}%'
    lines += [f"Landed with failing checks: {failing['count']}; ids: {ids_text(failing['ids'])}",
              'Review economics',
              f"Landed: {econ['landed']}; fix packets: {econ['fix_packets']}; fixes/landed: {rate(econ['fix_per_landed'])} ({econ['fix_packets']}/{econ['landed']})",
              f"Fix-of-fix: {fof['count']}/{econ['fix_packets']} ({rate(fof['rate'])}); unknown references: {fof['unknown_references']}",
              f"Severity coverage: {severity['known']}/{econ['fix_packets']} known; {severity['unknown']} unknown; ids: {ids_text(severity['unknown_ids'])}",
              f"No MUST-FIX: {econ['no_must_fix']['count']}; ids: {ids_text(econ['no_must_fix']['ids'])}",
              f"Small fix thresholds: {econ['thresholds']['small_fix_lines']} lines, {econ['thresholds']['small_fix_tokens']} tokens",
              'Calibration proposals', result['rule']]

    thresholds = econ['thresholds']
    proposals = []
    for p in result['proposals']:
        name = f"{p['model']} {p['effort']}" + (f" / {p['area']}" if 'area' in p else '')
        if p['direction'] == 'HOLD':
            detail = f"HOLD ({p['reason']}; thresholds {thresholds['small_fix_lines']} lines, {thresholds['small_fix_tokens']} tokens)"
        else:
            detail = f"propose {p['direction']} one rung"
            if 'hold_blocked' in p:
                detail += f" (hold not applied: {p['hold_blocked']})"
        proposals.append(f'{name}: {detail}')
    proposals += [f"{g['model']} {g['effort']}" + (f" / {g['area']}" if 'area' in g else '')
                  + f": n={g['n']} (too few)" for g in result['groups'] + result['area_groups'] if g['n'] < 8]
    lines += bounded(proposals or ['none'], 5)
    return '\n'.join(lines + [result['disclaimer']])


DEFAULTS = dict(fix_origin=None, fixes=[], dispatches=1, rounds=0,
                status='unknown', wall_s=None, lines=0, area='mixed', risk='untagged',
                dispatch_models=None)


def read_rows(path):
    rows = []
    skipped = 0
    try:
        stream = path.open(encoding='utf-8')
    except FileNotFoundError:
        return rows
    with stream:
        for line in stream:
            if not line.strip():
                continue
            try:
                row = json.loads(line)
                if not isinstance(row, dict):
                    raise ValueError('row is not an object')
                value = row.get('lines')
                lines_known = (isinstance(value, (int, float)) and not isinstance(value, bool)
                               and math.isfinite(value) and value >= 0)
                row = dict(DEFAULTS, **row)
                row['lines_known'] = lines_known
                if not lines_known:
                    row['lines'] = 0
                if any(not isinstance(row[k], str) or not row[k] for k in ('ts', 'id', 'model', 'effort')):
                    raise ValueError('missing or invalid required field')
                packet_date(row)
                if (not isinstance(row['fixes'], list) or
                    any(not isinstance(x, str) for x in row['fixes']) or
                    row['fix_origin'] is not None and not isinstance(row['fix_origin'], str) or
                    not isinstance(row['area'], str) or not isinstance(row['status'], str) or
                    any(not isinstance(row[k], (int, float)) or isinstance(row[k], bool)
                        for k in ('dispatches', 'rounds', 'lines')) or
                    row['wall_s'] is not None and (not isinstance(row['wall_s'], (int, float)) or isinstance(row['wall_s'], bool))):
                    raise ValueError('invalid field')
                history = row['dispatch_models']
                if (not isinstance(history, list) or not history or
                    any(not isinstance(item, dict) or
                        any(not isinstance(item.get(k), str) or not item[k] for k in ('model', 'effort')) or
                        not isinstance(item.get('rounds'), (int, float)) or isinstance(item['rounds'], bool) or
                        isinstance(item['rounds'], float) and not item['rounds'].is_integer()
                        for item in history)):
                    row['dispatch_models'] = None
                rows.append(row)
            except (ValueError, TypeError, KeyError, OverflowError):
                skipped += 1
    if skipped:
        print(f'skipped {skipped} malformed rows', file=sys.stderr)
    return rows


def nonnegative_int(value):
    number = int(value)
    if number < 0:
        raise argparse.ArgumentTypeError('must be at least 0')
    return number


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    source = parser.add_mutually_exclusive_group()
    source.add_argument('--packets', type=Path)
    source.add_argument('--project', type=Path)
    parser.add_argument('--since', type=date.fromisoformat)
    parser.add_argument('--until', type=date.fromisoformat)
    parser.add_argument('--small-fix-lines', type=nonnegative_int, default=100)
    parser.add_argument('--small-fix-tokens', type=nonnegative_int, default=4000000)
    parser.add_argument('--ladder', help='comma-separated model and optional effort rungs')
    output = parser.add_mutually_exclusive_group()
    output.add_argument('--markdown', action='store_true')
    output.add_argument('--json', action='store_true')
    args = parser.parse_args()
    try:
        if args.ladder is not None:
            ladder = parse_ladder(args.ladder.split(','))
        else:
            config = Path(os.environ.get('CLAUDE_CONFIG_DIR') or Path.home() / '.claude').expanduser() / 'agent-kaizen.json'
            try:
                with config.open(encoding='utf-8') as stream:
                    settings = json.load(stream)
            except FileNotFoundError:
                settings = {}
            ladder = parse_ladder(settings.get('calibrationLadder', DEFAULT_LADDER))
        path = args.packets or (args.project / 'out/packets.jsonl' if args.project else Path('out/packets.jsonl'))
        result = summarize(read_rows(path), args.since, args.until, ladder,
                           args.small_fix_lines, args.small_fix_tokens)
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
        print(f'packet-report: {error}', file=sys.stderr)
        return 2
    print(json.dumps(result, sort_keys=True) if args.json else render(result, args.markdown))
    return 0


if __name__ == '__main__':
    sys.exit(main())
