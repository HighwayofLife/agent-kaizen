#!/usr/bin/env python3
"""Check project experiment ledger dates and metadata without running commands."""
import argparse
from datetime import date
import json
import os
from pathlib import Path
import re
import sys

METADATA_SINCE = date(2026, 11, 17)
KINDS = ('past_review', 'pending_too_long', 'missing_metadata', 'malformed')
TITLES = ('Past review date', 'Pending too long', 'Missing metadata', 'Malformed')


def iso(value):
    if not re.fullmatch(r'\d{4}-\d{2}-\d{2}', value):
        raise ValueError('expected YYYY-MM-DD')
    return date.fromisoformat(value)


def positive(value):
    try:
        number = int(value)
        if number < 1:
            raise ValueError()
        return number
    except ValueError:
        raise argparse.ArgumentTypeError('must be an integer of at least 1')


def pending_days(flag, project):
    if flag is not None:
        return flag
    global_dir = Path(os.environ.get('CLAUDE_CONFIG_DIR') or Path.home() / '.claude').expanduser()
    for path in (project / 'docs/kaizen/config.json', global_dir / 'agent-kaizen.json'):
        try:
            config = json.loads(path.read_text(encoding='utf-8'))
        except FileNotFoundError:
            continue
        except (OSError, ValueError) as error:
            print(f'experiment-check: ignoring config {path}: {error}', file=sys.stderr)
            continue
        if not isinstance(config, dict) or 'pendingDays' not in config:
            continue
        value = config['pendingDays']
        if type(value) is int and value >= 1:
            return value
        print(f'experiment-check: ignoring invalid pendingDays in {path}', file=sys.stderr)
    return 10


def cells(line):
    line = line.strip()
    if line.startswith('|'):
        line = line[1:]
    if line.endswith('|') and not line.endswith('\\|'):
        line = line[:-1]
    return [part.strip().replace('\\|', '|') for part in re.split(r'(?<!\\)\|', line)]


def empty(value):
    return value.strip().lower() in ('', 'n/a', '-', 'none')


def check(path, today, days):
    lines = path.read_text(encoding='utf-8').splitlines()
    columns = None
    findings = []
    legacy_rows = 0
    row = 0
    for line in lines:
        if '|' not in line:
            continue
        parts = cells(line)
        names = [part.lower() for part in parts]
        if 'date' in names and 'measured effect' in names:
            columns = {name: index for index, name in enumerate(names)}
            continue
        if columns is None or all(re.fullmatch(r':?-{3,}:?', part) for part in parts):
            continue
        row += 1
        def get(name):
            index = columns.get(name, len(parts))
            return parts[index] if index < len(parts) else ''
        raw_date, change, measured, kept = (get(name) for name in
                                             ('date', 'change', 'measured effect', 'keep/revert'))
        metric, review = get('metric command'), get('review date')
        metric = None if empty(metric) else metric.strip('`')
        review = None if empty(review) else review
        try:
            day = iso(raw_date)
        except ValueError:
            day = None
        try:
            review_day = iso(review) if review else None
        except ValueError:
            review_day = None
        age = (today - day).days if day else None
        is_open = (not measured or measured.lower().startswith('pending')) and not kept.lower().startswith('reverted')
        if day and day < METADATA_SINCE and (not metric or not review):
            legacy_rows += 1
        if not is_open:
            continue
        base = dict(row=row, date=raw_date, change=change, age_days=age,
                    metric_command=metric, review_date=review)
        def add(kind, reason):
            findings.append(dict(kind=kind, **base, reason=reason))
        if review_day and review_day < today:
            add('past_review', 'review date has passed')
        if age is not None and age > days:
            add('pending_too_long', f'pending {age} days (limit {days})')
        if day and day >= METADATA_SINCE and all(name in columns for name in ('metric command', 'review date')) and (not metric or not review):
            add('missing_metadata', 'missing metric command or review date')
        problems = []
        if change and day is None:
            problems.append('invalid date')
        if review and review_day is None:
            problems.append('invalid review date')
        if problems:
            add('malformed', ', '.join(problems))
    if columns is None:
        raise ValueError('ledger missing date or measured effect header')
    return findings, legacy_rows, not all(name in columns for name in ('metric command', 'review date'))


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog='Exit codes: 0 no findings, 1 findings, 2 usage or ledger error. pendingDays is read from project then global config.')
    parser.add_argument('--project', required=True, type=Path)
    parser.add_argument('--pending-days', type=positive)
    parser.add_argument('--today', type=iso, default=date.today())
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args()
    project = args.project.expanduser().resolve()
    days = pending_days(args.pending_days, project)
    path = project / 'docs/kaizen/LEDGER.md'
    try:
        findings, legacy_rows, legacy_table = check(path, args.today, days)
        ledger = str(path)
    except FileNotFoundError:
        findings, legacy_rows, legacy_table, ledger = [], 0, False, None
    except (OSError, UnicodeError, ValueError) as error:
        print(f'experiment-check: {error}', file=sys.stderr)
        return 2
    counts = {kind: sum(f['kind'] == kind for f in findings) for kind in KINDS}
    result = dict(project=str(project), today=args.today.isoformat(), pending_days=days,
                  ledger=ledger, legacy_table=legacy_table, legacy_rows=legacy_rows,
                  metadata_since=METADATA_SINCE.isoformat(), findings=findings, counts=counts,
                  status='findings' if findings else 'ok')
    if args.json:
        print(json.dumps(result))
    else:
        print(f'experiment-check: {len(findings)} finding(s)')
        if ledger is None:
            print('no ledger')
        for kind, title in zip(KINDS, TITLES):
            group = [f for f in findings if f['kind'] == kind]
            if group:
                print(f'## {title}')
                for item in group[:8]:
                    print(f"- {item['date']} {item['change'][:60]} | review {item['review_date'] or '-'} | {item['reason']}")
                if len(group) > 8:
                    print(f'... {len(group) - 8} more')
        if legacy_table or legacy_rows:
            print(f'legacy: {legacy_rows} row(s) have no metric command or review date (not a finding)')
    return bool(findings)


if __name__ == '__main__':
    sys.exit(main())
