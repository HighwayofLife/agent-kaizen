#!/usr/bin/env python3
"""Record and update changes in the configured notes ledger."""
import argparse
import csv
import datetime as dt
import html
import io
import json
import os
from pathlib import Path
import re
import sys
import subprocess
import tempfile

try:
    import fcntl
except ImportError:  # no file locking on this platform
    fcntl = None

HEADER = ['date', 'category', 'change', 'source', 'status', 'measured']
HEADING = re.compile(r'^## (\d{4}-\d{2}-\d{2}) to (\d{4}-\d{2}-\d{2})\s*$')


def claude_home():
    return Path(os.environ.get('CLAUDE_CONFIG_DIR') or Path.home() / '.claude').expanduser()


def config():
    try:
        with (claude_home() / 'agent-kaizen.json').open(encoding='utf-8') as f:
            settings = json.load(f)
            ledger = settings.get('notesLedger', {}) if isinstance(settings, dict) else {}
    except FileNotFoundError:
        ledger = {}
    if not isinstance(ledger, dict) or not ledger.get('csv'):
        print('notes-ledger: no notesLedger.csv in agent-kaizen.json', file=sys.stderr)
        raise SystemExit(3)
    return path_setting(ledger, 'csv'), (path_setting(ledger, 'timeline') if ledger.get('timeline') else None)


def path_setting(ledger, key):
    if not isinstance(ledger[key], str):
        raise ValueError('notesLedger.{} in agent-kaizen.json must be a string path'.format(key))
    return Path(ledger[key]).expanduser()


def physical_lines(data):
    """Split on \\n, \\r\\n and \\r only, the way the csv module counts lines."""
    return io.StringIO(data, newline='').readlines()


def read_csv(path):
    try:
        with path.open(encoding='utf-8', newline='') as f:
            data = f.read()
    except FileNotFoundError:
        raise FileNotFoundError('ledger {} does not exist. It must exist with the header {}; '
                                'add does not create it'.format(path, ','.join(HEADER))) from None
    lines = physical_lines(data)
    # A leading BOM stays in the file; only the parser skips it.
    reader = csv.reader(io.StringIO(data[1:] if data.startswith('\ufeff') else data, newline=''))
    records = []
    start = 0
    try:
        for row in reader:
            if row:  # blank lines are kept in the file but are not rows
                records.append((row, start, reader.line_num))
            start = reader.line_num
    except csv.Error as exc:
        raise ValueError('invalid CSV row {}: {}'.format(start + 1, exc)) from None
    if not records or records[0][0] != HEADER:
        raise ValueError('invalid CSV header in row {}: expected {}'.format(
            records[0][1] + 1 if records else 1, ','.join(HEADER)))
    for row, first, _ in records[1:]:
        if len(row) != len(HEADER):
            raise ValueError('invalid CSV row {}: expected {} columns, found {}'.format(
                first + 1, len(HEADER), len(row)))
    return data, lines, records


def csv_line(row, ending='\n'):
    out = io.StringIO(newline='')
    csv.writer(out, lineterminator=ending).writerow(row)
    return out.getvalue()


def atomic_write(path, data):
    path = Path(os.path.realpath(path))  # a symlinked file stays a link; its target is replaced
    mode = path.stat().st_mode
    name = None
    try:
        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', newline='', dir=str(path.parent), delete=False) as f:
            name = f.name
            if hasattr(os, 'fchmod'):
                os.fchmod(f.fileno(), mode & 0o7777)
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(name, path)
    finally:
        if name and os.path.exists(name):
            os.unlink(name)


def timeline_info(path):
    with path.open(encoding='utf-8', newline='') as f:
        data = f.read()
    lines = physical_lines(data)
    headings = []
    rows = []
    for i, line in enumerate(lines):
        match = HEADING.match(line.rstrip('\r\n'))
        if match:
            headings.append((i, dt.date.fromisoformat(match[1]), dt.date.fromisoformat(match[2])))
        if line.startswith('|'):
            cells = [c.strip() for c in line.rstrip('\r\n').strip('|').split('|')]
            if len(cells) == 4 and re.fullmatch(r'\d{4}-\d{2}-\d{2}', cells[0]):
                rows.append((i, cells))
    return data, lines, headings, rows


def timeline_cell(text):
    return text.replace('|', '&#124;').replace('\n', ' ').replace('\r', ' ')


def equivalent(short, full):
    short = timeline_cell(html.unescape(short))
    full = timeline_cell(full)
    # The short text is the change itself; the CSV text continues with " Why: ...".
    return bool(short) and (full == short or full.startswith(short + ' Why: '))


def timeline_add(path, date, change):
    data, lines, headings, rows = timeline_info(path)
    cell = timeline_cell(change).strip()
    if any(row[0] == date and bool(row[1]) and timeline_cell(html.unescape(row[1])).strip() == cell for _, row in rows):
        return None
    day = dt.date.fromisoformat(date)
    row = '| {} | {} | {} | {} |\n'
    # Status is filled by the caller.
    return data, lines, headings, day, cell, row


def add(args, csv_path, timeline_path):
    if not re.fullmatch(r'\d{4}-\d{2}-\d{2}', args.date):
        raise ValueError('date must be YYYY-MM-DD')
    dt.date.fromisoformat(args.date)
    data, csv_lines, records = read_csv(csv_path)
    change = '{} Why: {} Measure: {}'.format(args.change, args.why, args.measure)
    row = [args.date, args.category, change, args.source, args.status, 'no']
    csv_exists = any(r[0] == args.date and bool(r[2]) and (change.startswith(r[2]) or r[2].startswith(change)) for r, _, _ in records[1:])
    timeline = timeline_add(timeline_path, args.date, args.change) if timeline_path else None
    if csv_exists and timeline is None:
        print('already recorded')
        return
    new_timeline = None
    if timeline:
        original, lines, headings, day, cell, template = timeline
        # The shorter timeline text is the change itself, with table delimiters escaped.
        cell = timeline_cell(args.change)
        entry = template.format(args.date, cell, args.status, 'no')
        covering = [(n, start, end) for n, start, end in headings if start <= day <= end]
        if covering:
            n = covering[0][0]
            end = next((h[0] for h in headings if h[0] > n), len(lines))
            table_rows = [i for i in range(n + 1, end) if lines[i].startswith('|')]
            if len(table_rows) < 2:
                raise ValueError('timeline block has no table')
            insert = table_rows[-1] + 1
            if insert and not lines[insert - 1].endswith(('\n', '\r')):
                raise ValueError('timeline table lacks a final newline')
            lines.insert(insert, entry)
            new_timeline = ''.join(lines)
        else:
            if not headings:
                raise ValueError('timeline has no block heading to establish cadence')
            last = headings[-1][1]
            start = last + dt.timedelta(days=((day - last).days // 7) * 7)
            end = start + dt.timedelta(days=6)
            prefix = '' if not original or original.endswith('\n\n') else ('\n' if original.endswith('\n') else '\n\n')
            new_timeline = original + prefix + '## {} to {}\n\n| date | change | status | measured |\n| --- | --- | --- | --- |\n'.format(start, end) + entry
    if args.dry_run:
        print('would add: ' + csv_line(row).rstrip('\n'))
        return
    if not csv_exists:
        if data and not data.endswith(('\n', '\r')):
            raise ValueError('CSV lacks a final newline')
        last = csv_lines[-1]
        ending = '\r\n' if last.endswith('\r\n') else ('\r' if last.endswith('\r') else '\n')
        with csv_path.open('a', encoding='utf-8', newline='') as f:
            f.write(csv_line(row, ending))
            f.flush()
            os.fsync(f.fileno())
        if os.environ.get('NOTES_LEDGER_FAIL_AFTER_CSV') == '1':
            raise RuntimeError('simulated failure after CSV write')
    if new_timeline is not None:
        atomic_write(timeline_path, new_timeline)
    print('recorded')


def set_row(args, csv_path, timeline_path):
    _, lines, records = read_csv(csv_path)
    matches = [(r, start, end) for r, start, end in records[1:] if args.match in r[2]]
    if len(matches) != 1:
        raise ValueError('match must select exactly one CSV row')
    old, start, end = matches[0]
    new = old.copy()
    if args.status is not None:
        new[4] = args.status
    if args.measured is not None:
        new[5] = args.measured
    if args.effect is not None:
        suffix = ' Result: ' + args.effect
        if not new[2].endswith(suffix):
            new[2] += suffix
    timeline_data = None
    if timeline_path:
        _, timeline_lines, _, rows = timeline_info(timeline_path)
        same_date = [(i, cells) for i, cells in rows if cells[0] == old[0]]
        matching = [(i, cells) for i, cells in same_date if equivalent(cells[1], old[2])]
        if not matching:
            # A timeline cell shortened by hand: accept it when it is the only same-date fragment
            # and no other CSV row of that date already owns it.
            others = [r[2] for r, _, _ in records[1:] if r is not old and r[0] == old[0]]
            matching = [(i, cells) for i, cells in same_date
                        if cells[1] and timeline_cell(html.unescape(cells[1])) in timeline_cell(old[2])
                        and not any(equivalent(cells[1], other) for other in others)]
        if len(matching) != 1:
            raise ValueError('match must select exactly one timeline row')
        i, cells = matching[0]
        # Preserve all whitespace and cell text except the two updated values.
        parts = timeline_lines[i].split('|')
        for index, value in ((3, new[4]), (4, new[5])):
            parts[index] = re.sub(r'^(\s*).*?(\s*)$', lambda m: m[1] + value + m[2], parts[index])
        timeline_lines[i] = '|'.join(parts)
        timeline_data = ''.join(timeline_lines)
    print('before: ' + csv_line(old).rstrip('\n'))
    print('after:  ' + csv_line(new).rstrip('\n'))
    if not args.dry_run:
        ending = '\r\n' if lines[end - 1].endswith('\r\n') else '\n'
        replacement = csv_line(new, ending)
        if not lines[end - 1].endswith(('\n', '\r')):
            replacement = replacement[:-len(ending)]
        lines[start:end] = [replacement]
        atomic_write(csv_path, ''.join(lines))
        if timeline_data is not None:
            atomic_write(timeline_path, timeline_data)



INTENSITY = ('claude_context_per_call', 'claude_output_per_call',
             'image_reads_per_100_calls', 'brief_chars_median',
             'codex_tokens_per_session', 'codex_brief_chars_median')
SCOPE_KEYS = {'codex', 'cwd', 'project', 'project_dirs', 'v', 'window'}


def audit_reports():
    root = claude_home() / 'audits'
    paths = list(root.glob('token-audit-*.md'))
    paths += list((root / 'projects').glob('*/token-audit-*.md'))
    reports = []
    for path in paths:
        match = re.match(r'token-audit-(\d{8}T\d{6}.*Z|\d{4}-\d{2}-\d{2})\.md$', path.name)
        if not match:
            continue
        try:
            stamp = match[1]
            day = dt.datetime.strptime(stamp[:8], '%Y%m%d').date() if 'T' in stamp else dt.date.fromisoformat(stamp)
            headline = scope = None
            with path.open(encoding='utf-8') as stream:
                for line in stream:
                    for tag in ('headline', 'scope'):
                        prefix = '<!-- token-audit-' + tag + ' '
                        if line.startswith(prefix) and line.rstrip().endswith(' -->'):
                            value = json.loads(line[len(prefix):].rstrip()[:-4])
                            if tag == 'headline':
                                headline = value
                            else:
                                scope = value
            if isinstance(headline, dict) and isinstance(scope, dict) and set(scope) == SCOPE_KEYS:
                reports.append((day, path.name, path.parent == root, scope, headline))
        except (OSError, ValueError, TypeError):
            continue
    return reports


def packet_comparisons(projects, settings, date):
    comparisons = []
    commands = settings.get('projectCommands', {})
    for raw in projects:
        project = Path(raw).expanduser().resolve()
        options = next((v for k, v in commands.items() if Path(k).expanduser().resolve() == project), {})
        log = project / options.get('outcomeLog', 'out/packets.jsonl')
        if not log.is_file():
            continue
        results = []
        for flag in ('--until', '--since'):
            result = subprocess.run([sys.executable, str(Path(__file__).resolve().parent / 'packet-report'),
                                     '--packets', str(log), flag, date, '--json'],
                                    capture_output=True, text=True, check=True)
            results.append(json.loads(result.stdout))
        before, after = results
        item = {'project': str(project), 'before_n': before['totals']['packets'],
                'after_n': after['totals']['packets']}
        if min(item['before_n'], item['after_n']) < 8:
            item['reason'] = 'too few packets'
        else:
            item['before_groups'] = before['groups']
            item['after_groups'] = after['groups']
        comparisons.append(item)
    return comparisons


def due(args):
    try:
        with (claude_home() / 'agent-kaizen.json').open(encoding='utf-8') as stream:
            settings = json.load(stream)
    except FileNotFoundError:
        settings = {}
    if not isinstance(settings, dict):
        settings = {}
    ledger = settings.get('notesLedger', {})
    if not isinstance(ledger, dict) or not ledger.get('csv'):
        print('notes-ledger: not configured')
        return
    days = ledger.get('measureAfterDays', 7)
    if type(days) is not int or days < 1:
        days = 7
    _, _, rows = read_csv(path_setting(ledger, 'csv'))
    reports = audit_reports()
    for row, start, _ in rows[1:]:
        if row[4] != 'active' or row[5] != 'no':
            continue
        try:
            day = dt.date.fromisoformat(row[0])
        except ValueError:
            print(f'notes-ledger: skipping row {start + 1}: invalid date {row[0]!r}', file=sys.stderr)
            continue
        measure = row[2].partition('Measure:')[2]
        item = {'date': row[0], 'change': row[2], 'measure': measure,
                'intensity': {}, 'packets': []}
        if (dt.date.today() - day).days < days:
            item['reason'] = 'row too new'
        else:
            before = [r for r in reports if r[0] < day]
            after = [r for r in reports if r[0] > day]
            pairs = [(b, a) for b in before for a in after if b[3] == a[3]]
            eligible = [(b, a) for b, a in pairs if sum(r[3] == a[3] for r in after) >= 2]
            if not pairs:
                item['reason'] = 'no comparable scope' if before and after else 'too few reports'
            elif not eligible:
                item['reason'] = 'too few reports'
            else:
                b, a = max(eligible, key=lambda pair: (pair[1][2] and pair[0][2], pair[1][0], pair[1][1], pair[0][0], pair[0][1]))
                for key in INTENSITY:
                    old, new = b[4].get(key), a[4].get(key)
                    if type(old) in (int, float) and type(new) in (int, float):
                        item['intensity'][key] = {'before': old, 'after': new,
                                                  'percent_change': (new - old) / old * 100 if old else None}
                item['before_report'], item['after_report'] = b[1], a[1]
                item['scope'] = a[3]
                item['after_report_count'] = sum(r[3] == a[3] for r in after)
                item['packets'] = packet_comparisons(args.project, settings, row[0])
                if not item['intensity']:
                    item['reason'] = 'no comparable intensity values'
                else:
                    values = [f"{k} {v['before']} → {v['after']} (" +
                              (f"{v['percent_change']:+.1f}%" if v['percent_change'] is not None else 'percent unavailable') + ')'
                              for k, v in item['intensity'].items()]
                    item['proposal'] = '; '.join(values) + f"; audit reports n={item['after_report_count']} after"
                    for packet in item['packets']:
                        if 'reason' not in packet:
                            for side in ('before', 'after'):
                                for group in packet[side + '_groups']:
                                    item['proposal'] += (f"; {packet['project']} {side} {group['model']} {group['effort']}"
                                                         f" n={group['n']}, first-pass={group['first_pass']},"
                                                         f" fix rate={group['fix_rate']}, median wall s={group['median_wall_s']}")
        if args.json:
            print(json.dumps(item, sort_keys=True))
            continue
        print(f"Row: {row[0]} {row[2][:80]}")
        print('Measure:' + measure)
        for key, value in item['intensity'].items():
            percent = f"{value['percent_change']:+.1f}%" if value['percent_change'] is not None else 'percent unavailable'
            print(f"{key}: {value['before']} → {value['after']} ({percent})")
        for packet in item['packets']:
            print('Project: ' + packet['project'])
            if 'reason' in packet:
                print(f"too few packets (before n={packet['before_n']}, after n={packet['after_n']})")
            else:
                for side in ('before', 'after'):
                    for group in packet[side + '_groups']:
                        print(f"{side} {group['model']} {group['effort']}: n={group['n']}, first-pass={group['first_pass']}, fix rate={group['fix_rate']}, median wall s={group['median_wall_s']}")
        print(('Not enough data: ' + item['reason']) if 'reason' in item else
              ('Proposed measured effect: ' + item['proposal']))

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    a = sub.add_parser('add', help='append a change')
    for name in ('date', 'category', 'change', 'why', 'measure', 'source'):
        a.add_argument('--' + name, required=True)
    a.add_argument('--status', choices=('planned', 'active'), default='active')
    a.add_argument('--dry-run', action='store_true')
    s = sub.add_parser('set', help='update a change')
    s.add_argument('--match', required=True)
    s.add_argument('--status', choices=('planned', 'active', 'superseded', 'reverted'))
    s.add_argument('--measured', choices=('yes', 'no'))
    s.add_argument('--effect')
    s.add_argument('--dry-run', action='store_true')
    d = sub.add_parser('due', help='propose measurements for active changes')
    d.add_argument('--project', action='append', default=[])
    d.add_argument('--json', action='store_true')
    args = parser.parse_args()
    try:
        if args.command == 'due':
            due(args)
            return 0
        csv_path, timeline_path = config()
        action = add if args.command == 'add' else set_row
        if args.dry_run:
            action(args, csv_path, timeline_path)
        else:
            if fcntl is None:
                action(args, csv_path, timeline_path)
            else:
                with open(str(csv_path) + '.lock', 'a') as lock:
                    fcntl.flock(lock, fcntl.LOCK_EX)
                    action(args, csv_path, timeline_path)
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError, json.JSONDecodeError) as exc:
        print('notes-ledger: {}'.format(exc), file=sys.stderr)
        return 1 if isinstance(exc, (OSError, RuntimeError)) else 2
    return 0


if __name__ == '__main__':
    sys.exit(main())
