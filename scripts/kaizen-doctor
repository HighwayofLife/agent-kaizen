#!/usr/bin/env python3
"""Check installation and audit data health without changing state."""
import argparse
from datetime import datetime, timezone
import itertools
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import sqlite3
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
record = Path(__file__).absolute().parent / '.kaizen-plugin-root'
if not (ROOT / 'scripts').is_dir() and record.is_file():
    try:
        ROOT = Path(record.read_text().strip()).expanduser()
    except OSError:
        pass
HOME = Path(os.environ.get('CLAUDE_CONFIG_DIR') or Path.home() / '.claude').expanduser()


def emit(level, message, fix=''):
    print('{} {}{}'.format(level, message, '; fix: ' + fix if fix else ''))


def read_json(path):
    with path.open(encoding='utf-8') as stream:
        return json.load(stream)


def command(args, timeout=10):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--plugin-root', type=Path, default=ROOT, help='plugin source root')
    parser.add_argument('--project', type=Path, default=Path.cwd(), help='project whose config to check')
    args = parser.parse_args()
    root = args.plugin_root.expanduser().resolve()
    link = root / 'scripts/kaizen-link'
    fix_link = 'kaizen-link --check --plugin-root DIR'
    result = command([sys.executable, str(link), '--check', '--json', '--plugin-root', str(root)])
    try:
        entries = json.loads(result.stdout)['entries'] if result else None
        if not isinstance(entries, list):
            raise ValueError()
        bad = [e for e in entries if e['status'] in ('DRIFT', 'BROKEN', 'ABSENT')]
        stale = [e for e in entries if e['status'] == 'STALE-CACHE']
        emit('WARN' if bad else 'PASS', 'managed links: {} need attention'.format(len(bad)),
             'kaizen-link --apply' if bad else '')
        registry = HOME / 'plugins/installed_plugins.json'
        data = read_json(registry)
        name = read_json(root / '.claude-plugin/plugin.json')['name']
        plugins = data['plugins']
        installed = any(k.split('@', 1)[0] == name and isinstance(v, list) and
                        any(isinstance(item, dict) and item.get('installPath') for item in v)
                        for k, v in plugins.items())
        if stale:
            emit('WARN', 'installed cache differs from plugin root', 'claude plugin update agent-kaizen')
        elif installed:
            emit('PASS', 'installed cache matches plugin root')
        else:
            emit('WARN', 'installed cache not found', 'claude plugin list')
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        emit('WARN', 'link or installed cache status unknown', fix_link)

    expected = [('SessionStart', 'startup|resume', 'audit-notice.sh'),
                ('SessionStart', 'startup|resume', 'session-audit.sh'),
                ('UserPromptSubmit', None, 'bash-burst.sh'),
                ('PostToolUse', 'Bash', 'bash-burst.sh'),
                ('PostToolUseFailure', 'Bash', 'bash-burst.sh')]
    try:
        hooks = read_json(root / 'hooks/hooks.json')['hooks']
        for event, matcher, script in expected:
            rows = hooks[event]
            if not any(row.get('matcher') == matcher and any(
                    item.get('type') == 'command' and (script != 'session-audit.sh' or item.get('async') is True) and item.get('command') ==
                    'bash "${{CLAUDE_PLUGIN_ROOT}}/hooks/{}"'.format(script)
                    for item in row.get('hooks', [])) for row in rows):
                raise ValueError()
            path = root / 'hooks' / script
            if not path.is_file() or not os.access(path, os.R_OK):
                raise ValueError()
        emit('PASS', 'plugin hook registration and scripts')
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        emit('FAIL', 'plugin hook registration or script missing or malformed', 'claude plugin install agent-kaizen')

    for name, minimum in [('jq', None), ('python3', (3, 9))]:
        path = shutil.which(name)
        result = command([path, '--version']) if path else None
        match = re.search(r'(\d+)\.(\d+)', (result.stdout + result.stderr) if result else '')
        if not result or result.returncode or not match:
            emit('WARN', name + ' missing or version unknown', 'brew install ' + name)
        elif minimum and tuple(map(int, match.groups())) < minimum:
            emit('WARN', name + ' is older than 3.9', 'brew install python')
        else:
            emit('PASS', name + ' version ' + match.group(0))
    for name in ('bash', 'git'):
        if shutil.which(name):
            emit('PASS', name + ' executable available')
        else:
            emit('WARN', name + ' executable missing', 'command -v ' + name)

    timers = [Path.home() / 'Library/LaunchAgents/com.agent-kaizen.audit.plist',
              Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'systemd/user/agent-kaizen-audit.timer']
    cron = command(['crontab', '-l'], timeout=2)
    cron_found = bool(cron and cron.returncode == 0 and any(
        line.rstrip().endswith('# agent-kaizen-audit') for line in cron.stdout.splitlines()))
    if cron_found or any(p.is_file() for p in timers):
        emit('WARN', 'scheduler job file found; active status unknown', 'install-schedule --help')
    else:
        emit('WARN', 'optional scheduler not detected; hooks run automatically', 'install-schedule --help')

    try:
        scheduled = runpy.run_path(str(root / 'scripts/kaizen-scheduled'))
        for path, project in ((HOME / 'agent-kaizen.json', False), (args.project / 'docs/kaizen/config.json', True)):
            if not path.exists():
                continue
            cfg = read_json(path)
            if not isinstance(cfg, dict):
                raise ValueError()
            for key, value in cfg.items():
                if key in scheduled['SCHEMA'] and (not scheduled['valid_value'](key, value) or
                        (project and scheduled['SCHEMA'][key].get('global_only'))):
                    raise ValueError()
        emit('PASS', 'scheduled config valid')
    except (OSError, ValueError, TypeError, KeyError):
        emit('WARN', 'scheduled config invalid or unreadable; inspect and correct it', 'kaizen-scheduled config show')

    try:
        date = datetime.strptime(read_json(root / 'scripts/pricing.json')['source']['checked'], '%Y-%m-%d').date()
        age = (datetime.now(timezone.utc).date() - date).days
        if age < 0 or age > 60:
            raise ValueError()
        emit('PASS', 'pricing checked {} days ago'.format(age))
    except (OSError, ValueError, TypeError, KeyError):
        emit('WARN', 'pricing date missing, invalid, or over 60 days old', 'kaizen-link --apply --replace-prefixed after updating pricing.json')

    try:
        db = Path(os.environ.get('KAIZEN_USAGE_DB') or HOME / 'kaizen-usage.db').expanduser()
        if Path(str(db) + '-wal').exists():
            raise ValueError()
        with sqlite3.connect(db.resolve().as_uri() + '?mode=ro&immutable=1', uri=True, timeout=1) as conn:
            conn.set_progress_handler(lambda: 1, 100000)
            value = conn.execute('SELECT max(ingested_at) FROM files').fetchone()[0]
        stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))
        if stamp.tzinfo is None:
            stamp = stamp.replace(tzinfo=timezone.utc)
        age = (datetime.now(timezone.utc) - stamp).total_seconds() / 86400
        if age < 0 or age > 7:
            raise ValueError()
        emit('PASS', 'usage database ingest within 7 days')
    except (OSError, sqlite3.Error, ValueError, TypeError, AttributeError, IndexError):
        emit('WARN', 'usage database ingest missing, unknown, or over 7 days old', 'usage-db ingest')

    try:
        reports = list(itertools.islice((HOME / 'audits').glob('token-audit-*.md'), 10001))
        if not reports or len(reports) > 10000:
            raise ValueError()
        latest = max(reports, key=lambda p: p.name)
        canary = None
        with latest.open(encoding='utf-8') as stream:
            for line in itertools.islice(stream, 10000):
                if line.startswith('<!-- token-audit-headline ') and line.rstrip().endswith(' -->'):
                    canary = json.loads(line[len('<!-- token-audit-headline '):].rstrip()[:-4]).get('format_canary')
                    break
        match = re.fullmatch(r'(?:format_canary: )?v1 unknown_records=(\d+) missing_usage=(\d+) cli=(\S+)', canary or '')
        if not match or match.group(3).lower() in ('unknown', 'none', 'n/a'):
            raise ValueError()
        if int(match.group(1)) or int(match.group(2)):
            emit('WARN', 'latest audit reports transcript format drift', 'token-audit')
        else:
            emit('PASS', 'latest audit format canary clean')
    except (OSError, ValueError, TypeError, AttributeError):
        emit('WARN', 'latest audit format canary missing or unknown', 'token-audit')
    return 0


if __name__ == '__main__':
    sys.exit(main())
