#!/usr/bin/env python3
"""Stream Claude project transcripts and Codex sessions into a compact audit."""
import argparse
from collections import Counter, defaultdict
from datetime import datetime, timedelta, timezone
import json
import math
import os
from pathlib import Path
import re
import shlex
import statistics
import sys
import tempfile


# --- paths helper ---
def claude_home():
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude").expanduser()


def claude_json():
    root = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(root).expanduser() / ".claude.json" if root else Path.home() / ".claude.json"


def codex_home():
    return Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").expanduser()
# --- end paths helper ---


TIMESTAMP = re.compile(rb'"timestamp"\s*:\s*"([^"\n]+)"')
MARKERS = (b'"usage"', b'"tool_result"', b'"timestamp"')
INJECTED_PREFIXES = ("# AGENTS.md instructions", "<environment_context>", "<user_instructions>",
                     "<user_action>", "<turn_aborted>", "<image", "</image>")
USER_ROW = re.compile(rb'"type"\s*:\s*"user"')
MESSAGE_ROW = re.compile(rb'"type"\s*:\s*"(?:user|assistant)"')
TOOL_METADATA = (b'"api-request-shape"', b'"deferred_tools_delta"', b'"mcp_instructions_delta"')
EXIT_HEADER = re.compile(r"^Exit code\s*:?\s*(-?\d+)\s*$", re.I)
BENIGN_EXITS = {"grep": {1}, "rg": {1}, "test": {1}, "[": {1}, "diff": {1}, "cmp": {1},
                "sed -n": {141, -13}, "wc": {141, -13}, "head": {141, -13}}
SHELL_NO_HINT = frozenset(("for", "while", "if", "then", "do", "case", "cat", "echo", "cd", "printf"))
SECRET = re.compile(r"sk-[A-Za-z0-9_-]+|ghp_[A-Za-z0-9_]+|xox[a-z]*-[A-Za-z0-9-]+|AKIA[A-Z0-9]+|"
                    r"(?<![A-Za-z0-9_])[A-Za-z0-9+/=_-]{32,}(?![A-Za-z0-9_])")
JSON_DECODER = json.JSONDecoder()
METADATA_FIELDS = {key: re.compile(('"' + key + r'"\s*:\s*').encode()) for key in (
    "tools", "addedNames", "readdedNames", "surfacedDefinitions", "removedNames")}
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z_0-9]*=")
CHEAPER_MODEL_THRESHOLDS = dict(cost_share=0.05, calls_median=15, result_chars_median=4000)


def date_time(value):
    dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
    return dt.replace(tzinfo=timezone.utc) if dt.tzinfo is None else dt.astimezone(timezone.utc)


def metadata_row(line, timestamp):
    shape = b'"api-request-shape"' in line[:256]
    kind = "api-request-shape" if shape else "attachment"
    attachment = "deferred_tools_delta" if b'"deferred_tools_delta"' in line[:1024] else "mcp_instructions_delta"
    value = {}
    for key in (("tools",) if shape else ("addedNames", "readdedNames", "surfacedDefinitions", "removedNames")):
        match = METADATA_FIELDS[key].search(line)
        if match:
            value[key] = JSON_DECODER.raw_decode(line[match.end():].decode("utf-8"))[0]
    return dict(type=kind, timestamp=timestamp, **({"shape": value} if shape else {
        "attachment": dict(type=attachment, **value)}))


def rows(path, since, warnings, keep_model=False, keep_tools=False):
    """Timestamp and record-type gates run before decoding large content."""
    cutoff = since.strftime("%Y-%m-%dT%H:%M:%S")
    saved_shape, saved_deltas, before_user = None, [], False
    try:
        with path.open("rb") as stream:
            for line in stream:
                prefix = line[:1024]
                metadata = keep_tools and any(marker in prefix for marker in TOOL_METADATA)
                if keep_tools and not (metadata or b'"message"' in prefix or MESSAGE_ROW.search(prefix) or b'"usage"' in prefix):
                    continue
                if keep_model and not (b'"token_count"' in prefix or b'"user_message"' in prefix or b'"role":"user"' in prefix or b'"role": "user"' in prefix or b'"model"' in line):
                    continue
                if not any(marker in line for marker in MARKERS):
                    continue
                match = TIMESTAMP.search(line)
                if not match:
                    continue
                timestamp = match[1].decode("ascii", "replace")
                try:
                    old = (timestamp[:19] < cutoff if timestamp.endswith(("Z", "+00:00"))
                           else date_time(timestamp) < since)
                    if old and keep_tools:
                        if metadata:
                            if b'"api-request-shape"' in prefix:
                                saved_shape = (line, timestamp)
                            else:
                                saved_deltas.append((line, timestamp))
                        elif (USER_ROW.search(line) and b'"tool_result"' not in line
                              and b'"isMeta":true' not in prefix and b'"isMeta": true' not in prefix
                              and b'<task-notification>' not in line):
                            before_user = True
                        continue
                    if old and not (keep_model and (b'"model"' in line or b'"user_message"' in prefix or b'"role":"user"' in prefix or b'"role": "user"' in prefix)):
                        continue
                    if keep_tools and (saved_shape or saved_deltas or before_user):
                        for saved, ts in ([saved_shape] if saved_shape else []) + saved_deltas:
                            try:
                                yield dict(metadata_row(saved, ts), _before_window=True)
                            except (ValueError, UnicodeError):
                                warnings["malformed rows"] += 1
                        if before_user:
                            yield dict(type="user", message={}, _before_window=True)
                        saved_shape, saved_deltas, before_user = None, [], False
                    row = metadata_row(line, timestamp) if metadata else json.loads(line)
                    if isinstance(row, dict):
                        if old:
                            row["_before_window"] = True
                        yield row
                except (ValueError, TypeError, UnicodeError):
                    warnings["malformed rows"] += 1
    except OSError:
        warnings["unreadable files"] += 1


def context(usage):
    return sum(usage.get(key, 0) or 0 for key in (
        "input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))


def add(counter, usage):
    ctx = context(usage)
    counter.update(calls=1, context=ctx, cache_read=usage.get("cache_read_input_tokens", 0) or 0,
                   cache_write=usage.get("cache_creation_input_tokens", 0) or 0,
                   output=usage.get("output_tokens", 0) or 0)
    counter["peak"] = max(counter["peak"], ctx)


def image_count(content):
    if isinstance(content, dict):
        return int(content.get("type") == "image") + sum(image_count(v) for v in content.values())
    if isinstance(content, list):
        return sum(map(image_count, content))
    return 0


def bash_head(command, words_limit=2):
    segments = [part.strip() for part in re.split(r"&&|;|\n|\|", command) if part.strip()]
    for segment in segments:
        try:
            words = shlex.split(segment)
        except ValueError:
            words = segment.split()
        if not words or words[0] in ("cd", "export", "set"):
            continue
        while words and ASSIGNMENT.match(words[0]):
            words.pop(0)
        if words and words[0] in ("cd", "export", "set"):
            continue
        if words:
            return redact(" ".join(words[:words_limit]))[:40]
    return "(cd/vars only)"


def blocks(message):
    content = message.get("content")
    return [item for item in content if isinstance(item, dict)] if isinstance(content, list) else []


def load_pricing(path):
    try:
        value = json.loads(path.read_text())
        if not isinstance(value.get("models"), dict) or not isinstance(value.get("aliases", {}), dict):
            raise ValueError("expected models and aliases objects")
        return value, None
    except (OSError, ValueError, AttributeError) as exc:
        return {}, f"Pricing file unavailable: {path} ({exc})"


def pricing_key(pricing, model):
    key = model if model in pricing.get("models", {}) else next((
        pricing["aliases"][prefix] for prefix in sorted(pricing.get("aliases", {}), key=len, reverse=True)
        if model.startswith(prefix)), None)
    return key if key in pricing.get("models", {}) else None


def price(data, model, agent, usage, codex=False):
    pricing = data["_pricing"]
    key = pricing_key(pricing, model)
    rates = pricing.get("models", {}).get(key)
    if codex:
        cached = usage.get("cached_input_tokens", 0) or 0
        output = usage.get("output_tokens", 0) or 0
        # Codex normally reports reasoning as a subset of output. Only add it
        # when the billed total explicitly places it outside output_tokens.
        extra = max(0, (usage.get("total_tokens", 0) or 0) - (usage.get("input_tokens", 0) or 0) - output)
        output += min(extra, usage.get("reasoning_output_tokens", 0) or 0)
        tokens = dict(uncached_input=max(0, (usage.get("input_tokens", 0) or 0) - cached),
                      cache_read=cached, cache_write_5m=0, cache_write_1h=0, output=output)
    else:
        breakdown = usage.get("cache_creation") or {}
        write = usage.get("cache_creation_input_tokens", 0) or 0
        hour = min(write, breakdown.get("ephemeral_1h_input_tokens", 0) or 0)
        tokens = dict(uncached_input=usage.get("input_tokens", 0) or 0,
                      cache_read=usage.get("cache_read_input_tokens", 0) or 0,
                      cache_write_5m=write - hour, cache_write_1h=hour,
                      output=usage.get("output_tokens", 0) or 0)
    if not any(tokens.values()):
        return 0
    if rates is None:
        data["cost"]["unpriced"].setdefault(model, Counter()).update(tokens)
        return 0
    threshold = rates.get("over_threshold")
    if not codex and threshold and context(usage) >= threshold["prompt_tokens"]:
        rates = dict(rates, **threshold)
    components = Counter()
    for component, count in tokens.items():
        rate = "input" if component == "uncached_input" else component
        if codex and component == "cache_read":
            rate = "cached_input"
        group = "cache_write" if component.startswith("cache_write") else component
        components[group] += count * rates.get(rate, 0) / 1000000
    cost = sum(components.values())
    data["cost"]["components"].update(components)
    data["cost"]["by_model"][model] += cost
    data["cost"]["by_agent"][agent] += cost
    data["cost"]["total"] += cost
    return cost


def redact(text):
    return SECRET.sub("[redacted]", str(text))


def result_text(content):
    if isinstance(content, list):
        return "\n".join(str(b.get("text", "")) for b in content if isinstance(b, dict))
    return str(content or "")


def error_line(content):
    text = next((line.strip() for line in result_text(content).splitlines()
                 if line.strip() and not EXIT_HEADER.match(line.strip())), "(empty error)")
    text = redact(text)
    text = re.sub(r"/(?:private/)?(?:tmp|var/folders)/[^\s:]+", "<tmp>", text)
    text = re.sub(r"\b(?:0x[0-9a-f]+|[0-9a-f]{8,}(?:-[0-9a-f]+)*)\b", "<id>", text, flags=re.I)
    return re.sub(r"\d+", "#", text)


def signature_text(signature):
    tool, target, code, error = signature
    return f"{tool} {redact(target)}" + (f" [exit {code}]" if code is not None else "") + f": {redact(error)[:120]}"


def command_info(command):
    env, cwd, words = [], "", []
    for segment in re.split(r"&&|;|\n|\|", command):
        try:
            words = shlex.split(segment)
        except ValueError:
            return None
        if not words:
            continue
        if words[0] == "cd":
            cwd = words[1] if len(words) == 2 else cwd
            continue
        if words[0] == "export":
            env.extend(w for w in words[1:] if ASSIGNMENT.match(w))
            continue
        while words and ASSIGNMENT.match(words[0]):
            env.append(words.pop(0))
        if words and words[0] == "env":
            words.pop(0)
            while words and ASSIGNMENT.match(words[0]):
                env.append(words.pop(0))
        if words:
            break
    if not words or Path(words[0]).name in SHELL_NO_HINT:
        return None
    launcher, offset = "direct", 0
    first = Path(words[0]).name
    if first.startswith("python") and len(words) > 2 and words[1] == "-m":
        launcher, offset = " ".join(words[:2]), 2
    elif first in ("uv", "poetry") and len(words) > 2 and words[1] == "run":
        launcher, offset = first + " run", 2
    elif first in ("npx", "uvx") and len(words) > 1 and not words[1].startswith("-"):
        launcher, offset = first, 1
    elif "/node_modules/.bin/" in words[0]:
        launcher = "node_modules/.bin"
    elif first.startswith("python") and len(words) > 1 and not words[1].startswith("-"):
        launcher, offset = first, 1
    target = Path(words[offset]).name
    subcommand = words[offset + 1] if target == "git" and len(words) > offset + 1 else ""
    head = " ".join(words[:offset + 1] if offset else words[:2])
    if env:
        head = " ".join(env) + " " + head
    if cwd:
        head = "cd " + cwd + " && " + head
    return dict(program=target, launcher=launcher, env=tuple(sorted(env)), cwd=cwd,
                subcommand=subcommand, head=redact(head)[:120])


def plausible_fix(failure, success):
    return (failure and success and failure["program"] == success["program"]
            and failure["subcommand"] == success["subcommand"]
            and any(failure[k] != success[k] for k in ("launcher", "env", "cwd")))


def benign_exit(head, code):
    words = head.split()
    if not words:
        return False
    name = Path(words[0]).name
    key = "sed -n" if name == "sed" and len(words) > 1 and words[1] == "-n" else name
    return code in BENIGN_EXITS.get(key, ())


def tool_metadata(row, session):
    definitions = (row.get("shape") or {}).get("tools") if row.get("type") == "api-request-shape" else None
    if isinstance(definitions, list):
        session["known"] = True
        for tool in definitions:
            if isinstance(tool, dict) and tool.get("name"):
                session["available"].add(tool["name"])
                session["loading"][tool["name"]].add("deferred" if tool.get("defer_loading") else "loaded in full")
    attachment = row.get("attachment") or {}
    if attachment.get("type") == "deferred_tools_delta":
        session["known"] = True
        for name in attachment.get("addedNames", []) + attachment.get("readdedNames", []):
            session["available"].add(name)
            session["loading"][name].add("deferred")
        for tool in attachment.get("surfacedDefinitions", []):
            if isinstance(tool, dict) and tool.get("name"):
                session["available"].add(tool["name"])
                session["loading"][tool["name"]].add("loaded in full")
    if attachment.get("type") == "mcp_instructions_delta":
        session["servers"].update(attachment.get("addedNames", []))


def finish_turn(turn, project, session_id, agent, data):
    if turn is None or not turn["active"]:
        return
    stuck = data["stuck_turns"]
    stuck["turns"] += 1
    data["_agent_turns"][agent] += 1
    failures = Counter(event[0] for event in turn["failures"])
    flagged = [(signature, count) for signature, count in failures.items() if count >= data["_options"]["stuck_repeats"]]
    if flagged:
        stuck["flagged_turns"] += 1
        data["_agent_flagged"][agent] += 1
        stuck["tool_calls"] += turn["calls"]
        stuck["cost"] += turn["cost"]
        for signature, count in flagged:
            stuck["signatures"].append(dict(project=project, agent=agent, repeats=count,
                                             session=session_id, signature=signature_text(signature), _turn=stuck["turns"]))
    for signature, head, order in turn["failures"]:
        fact = data["_failures"][(project, signature)]
        fact["sessions"].add(session_id)
        fact["occurrences"] += 1
        if fact["worked_instead"]:
            continue
        # The next call on this program must succeed nearby; unrelated later
        # commands and changes of flags/subcommands do not establish a fix.
        for later, (candidate, outcome) in sorted(turn["bash_calls"].items()):
            if later <= order or later > order + 3 or not candidate or not head:
                continue
            if candidate["program"] == head["program"]:
                if outcome is True and plausible_fix(head, candidate):
                    fact["worked_instead"].add(candidate["head"])
                break


def scan_claude(path, agent, since, data, seen_messages, project):
    main = agent is None
    counter = Counter()
    tools = {}
    pending = None
    first, last, session_id = None, None, path.stem
    observed = dict(main=main, known=False, available=set(), loading=defaultdict(set), servers=set(),
                    used=set(), prompts=0, cwd=None, active=False)
    turn = None
    for row in rows(path, since, data["warnings"], keep_tools=True):
        if row.get("type") in ("api-request-shape", "attachment"):
            tool_metadata(row, observed)
            continue
        observed["cwd"] = row.get("cwd") or observed["cwd"]
        if row.get("_before_window"):
            raw = (row.get("message") or {}).get("content", "")
            if (row.get("type") == "user" and not row.get("isMeta")
                    and "<task-notification>" not in str(raw)):
                turn = dict(calls=0, cost=0, failures=[], bash_calls={}, active=False)
            continue
        observed["active"] = True
        ts = row.get("timestamp", "")
        first = min(first, ts) if first else ts
        last = max(last, ts) if last else ts
        session_id = row.get("sessionId") or session_id
        message = row.get("message") or {}
        if not isinstance(message, dict):
            continue
        # One assistant message can span several rows (one per content block), and resumed
        # sessions can repeat rows from another file: count usage once per message id and
        # each tool call or result once per tool-use id, but keep every row's blocks.
        message_id = message.get("id")
        usage_seen = False
        if row.get("type") == "assistant" and message_id:
            usage_seen = message_id in seen_messages
            seen_messages.add(message_id)
        content = blocks(message)
        if row.get("type") == "user" and main:
            raw = message.get("content", "")
            if any(item.get("type") == "tool_result" for item in content):
                pending = "tool result"
            elif "<task-notification>" in (raw if isinstance(raw, str) else str(raw)):
                pending = "task notification"
            else:
                pending = "human"
        raw = message.get("content", "")
        if (row.get("type") == "user" and not row.get("isMeta")
                and not any(item.get("type") == "tool_result" for item in content)
                and "<task-notification>" not in (raw if isinstance(raw, str) else str(raw))):
            prompt_id = row.get("uuid")
            if not prompt_id or ("prompt", prompt_id) not in seen_messages:
                if prompt_id:
                    seen_messages.add(("prompt", prompt_id))
                finish_turn(turn, project, session_id, agent or "main", data)
                turn = dict(calls=0, cost=0, failures=[], bash_calls={}, active=True)
                observed["prompts"] += int(main)
        usage = message.get("usage")
        if row.get("type") == "assistant" and isinstance(usage, dict) and usage and not usage_seen:
            model = message.get("model", "unknown")
            if not isinstance(model, str):
                model = "unknown"
            if not main:
                label = row.get("perTurnEffort") or row.get("effort") or "unknown"
                data["_agent_models"][agent][model] += 1
                data["_agent_effort"][agent][label if isinstance(label, str) else "unknown"] += 1
            add(data["models"][model], usage)
            add(counter, usage)
            cost = price(data, model, agent or "main", usage)
            if turn is not None:
                turn["active"] = True
                turn["cost"] += cost
            if main and pending:
                add(data["triggers"][pending], usage)
                pending = None
        for block in content:
            if block.get("type") == "tool_use":
                name, head = block.get("name", "unknown"), None
                observed["used"].add(name)
                data["_tool_universe"].add(name)
                if ("use", block.get("id")) in seen_messages:
                    continue
                seen_messages.add(("use", block.get("id")))
                tool_input = block.get("input") or {}
                if turn is not None:
                    turn["active"] = True
                    turn["calls"] += 1
                original_name = name
                target = str(tool_input.get("file_path") or tool_input.get("path") or tool_input.get("filePath") or "")
                failure_head = bash_head(tool_input.get("command", "")) if name == "Bash" else redact(target)
                order = turn["calls"] if turn is not None else 0
                match_head = None
                if name == "Bash" and turn is not None:
                    match_head = command_info(tool_input.get("command", ""))
                    turn["bash_calls"][order] = (match_head, None)
                if name == "Agent":
                    agent_type = str(tool_input.get("subagent_type", "unknown"))
                    data["briefs"][agent_type].append(len(tool_input.get("prompt") or ""))
                    name += ":" + agent_type
                if name == "Bash" and not main:
                    head = bash_head(tool_input.get("command", ""))
                    data["bash"][agent][head] += 1
                tools[block.get("id")] = (name, head, original_name, failure_head, match_head, order)
            elif block.get("type") == "tool_result":
                if ("result", block.get("tool_use_id")) in seen_messages:
                    continue
                seen_messages.add(("result", block.get("tool_use_id")))
                name, head, original_name, failure_head, match_head, order = tools.get(
                    block.get("tool_use_id"), ("unknown", None, "unknown", "", None, 0))
                result = block.get("content")
                failed = block.get("is_error") is True
                exit_code = None
                if original_name == "Bash":
                    if failed:
                        first_line = result_text(result).partition("\n")[0].strip()
                        exit_match = EXIT_HEADER.match(first_line)
                        if exit_match:
                            exit_code = int(exit_match[1])
                        failed = not benign_exit(failure_head, exit_code)
                    if turn is not None:
                        turn["bash_calls"][order] = (match_head, not failed)
                if turn is not None and failed:
                    signature = (original_name, failure_head, exit_code, error_line(result))
                    turn["failures"].append((signature, match_head, order))
                chars = len(json.dumps(result))
                if main:
                    data["tool_chars"][name] += chars
                    data["tool_counts"][name] += 1
                    data["images"] += image_count(result)
                    if original_name == "Agent" and name.startswith("Agent:"):
                        data["_agent_result_chars"][name[len("Agent:"):]].append(chars)
                else:
                    data["_agent_results"][agent] += 1
                    data["_agent_failed"][agent] += int(failed)
                    if head:
                        data["bash_chars"][agent][head] += chars
    finish_turn(turn, project, session_id, agent or "main", data)
    if observed["active"]:
        data["_observed"][project].append((session_id, observed))
    if not counter["calls"]:
        return
    minutes = 0
    if first and last:
        try:
            minutes = max(0, (date_time(last) - date_time(first)).total_seconds() / 60)
        except ValueError:
            pass
    if main:
        data["sessions"].append(dict(id=session_id, date=first[:10], **counter))
    else:
        data["agents"][agent].append(dict(minutes=minutes, **counter))


def too_old(path, since):
    try:
        return path.stat().st_mtime < since.timestamp()
    except OSError:
        return False


# Bound each JSONL line read; a huge first line is not a session header.
LINE_LIMIT = 1 << 20


def cwd_of_file(path, limit=50):
    """Read only the first cwd recorded near the start of a Claude transcript."""
    try:
        with path.open("rb") as stream:
            for _ in range(limit):
                line = stream.readline(LINE_LIMIT)
                if not line:
                    break
                if b'"cwd"' not in line:
                    continue
                try:
                    row = json.loads(line)
                except (ValueError, RecursionError):
                    continue
                if isinstance(row, dict) and isinstance(row.get("cwd"), str):
                    return row["cwd"]
    except OSError:
        pass
    return None


def cwd_matches(raw, targets, realpaths):
    if not isinstance(raw, str):
        return False
    if raw not in realpaths:
        try:
            realpaths[raw] = os.path.realpath(raw)
        except (OSError, ValueError):  # e.g. an embedded NUL in a malformed row
            realpaths[raw] = raw
    return any(value == target or value.startswith(target.rstrip(os.sep) + os.sep)
               for target in targets for value in (raw, realpaths[raw]))


def scan_codex(root, since, data, cwd=None, realpaths=None):
    if realpaths is None:
        realpaths = {}
    # Session filenames are usually rollout-*.jsonl; scan the standard date tree.
    for path in root.glob("*/*/*/*.jsonl"):
        if too_old(path, since):
            continue
        if cwd is not None:
            try:
                with path.open("rb") as stream:
                    row = json.loads(stream.readline(LINE_LIMIT))
                payload = row.get("payload") if isinstance(row, dict) else None
                if not isinstance(payload, dict) or not cwd_matches(payload.get("cwd"), cwd, realpaths):
                    continue
            except (OSError, ValueError, RecursionError):
                continue
        data["codex_files_scanned"] += 1
        model, final, brief = "unknown", None, None
        prior_usage = Counter()
        # Older session files can contain recent resumes. Keep earlier model
        # metadata, but count only sessions with a token_count in the window.
        for row in rows(path, since, data["warnings"], keep_model=True):
            payload = row.get("payload") or {}
            if not isinstance(payload, dict):
                continue
            if row.get("model"):
                model = row["model"]
            if payload.get("model"):
                model = payload["model"]
            if row.get("type") == "event_msg" and payload.get("type") == "user_message" and brief is None:
                brief = len(payload.get("message") or "")
            if row.get("type") == "response_item" and payload.get("role") == "user" and brief is None:
                texts = [item.get("text") or "" for item in payload.get("content") or [] if isinstance(item, dict)]
                length = sum(len(text) for text in texts if text and not text.startswith(INJECTED_PREFIXES))
                if length:
                    brief = length
            if payload.get("type") == "token_count" and not row.get("_before_window"):
                info = payload.get("info") or {}
                usage = info.get("total_token_usage")
                if isinstance(usage, dict):
                    final = dict(usage)
                    delta = {key: max(0, value - prior_usage[key]) for key, value in usage.items()
                             if isinstance(value, (int, float))}
                    price(data, model, "codex", delta, codex=True)
                    prior_usage = Counter(usage)
        if final is not None:
            if brief is not None:
                data["codex_briefs"][model].append(brief)
            total = data["codex"][model]
            total.update(sessions=1, input=final.get("input_tokens", 0),
                         cached_input=final.get("cached_input_tokens", 0),
                         output=final.get("output_tokens", 0),
                         tokens=final.get("total_tokens", final.get("input_tokens", 0) + final.get("output_tokens", 0)))


def collect(projects, codex_root, since, pricing, pricing_error, options, cwd=None):
    data = dict(models=defaultdict(Counter), sessions=[], agents=defaultdict(list),
                triggers=defaultdict(Counter), tool_chars=Counter(), tool_counts=Counter(),
                images=0, bash=defaultdict(Counter), bash_chars=defaultdict(Counter),
                codex=defaultdict(Counter), briefs=defaultdict(list), codex_briefs=defaultdict(list), warnings=Counter(), codex_files_scanned=0)
    data.update(cost=dict(total=0, by_agent=Counter(), by_model=Counter(), components=Counter(),
                          unpriced={}, pricing_error=pricing_error),
                deferred_tools_unused=0, stuck_turns=dict(turns=0, flagged_turns=0, tool_calls=0, cost=0, signatures=[]),
                repeat_failures=[], unused_tools=[])
    data.update(_pricing=pricing, _options=options, _observed=defaultdict(list), _tool_universe=set(),
                _agent_models=defaultdict(Counter), _agent_effort=defaultdict(Counter),
                _agent_turns=Counter(), _agent_flagged=Counter(), _agent_results=Counter(),
                _agent_failed=Counter(), _agent_result_chars=defaultdict(list),
                _cwd=cwd, _cwd_observed=defaultdict(set),
                _failures=defaultdict(lambda: dict(sessions=set(), occurrences=0, worked_instead=set())))
    seen = set()
    seen_messages = set()
    decisions, realpaths = {}, {}
    encoded = {re.sub(r"[^a-zA-Z0-9]", "-", target) for target in cwd or []}

    def belongs(path, folder_name):
        if cwd is None:
            return True
        if path.parent.name == "subagents":
            parent = path.parent.parent.parent / (path.parent.parent.name + ".jsonl")
            if parent.is_file():
                path = parent
        if path not in decisions:
            raw = cwd_of_file(path)
            decisions[path] = (folder_name in encoded if raw is None else cwd_matches(raw, cwd, realpaths))
            if decisions[path] and raw is not None:
                data["_cwd_observed"][folder_name].add(raw)
        return decisions[path]

    for project in projects:
        for path in project.glob("*.jsonl"):
            if too_old(path, since):
                continue
            real = path.resolve()
            if real not in seen and belongs(path, project.name):
                seen.add(real)
                scan_claude(path, None, since, data, seen_messages, project.name)
        for path in project.glob("*/subagents/*.jsonl"):
            if too_old(path, since):
                continue
            real = path.resolve()
            if real in seen or not belongs(path, project.name):
                continue
            seen.add(real)
            meta = path.with_name(path.stem + ".meta.json")
            agent = "unknown"
            if meta.is_file():
                try:
                    agent = str(json.loads(meta.read_text()).get("agentType") or "unknown")
                except (OSError, ValueError, AttributeError):
                    data["warnings"]["malformed metadata"] += 1
            scan_claude(path, agent, since, data, seen_messages, project.name)
    scan_codex(codex_root, since, data, cwd, realpaths)
    data["files_scanned"] = len(seen)
    data["headline"] = {
        "claude_calls": sum(c["calls"] for c in data["models"].values()),
        "claude_context": sum(c["context"] for c in data["models"].values()),
        "claude_output": sum(c["output"] for c in data["models"].values()),
        "codex_sessions": sum(c["sessions"] for c in data["codex"].values()),
        "codex_tokens": sum(c["tokens"] for c in data["codex"].values()),
        "image_reads": data["images"],
        "brief_chars_median": int(statistics.median([n for values in data["briefs"].values() for n in values])) if data["briefs"] else 0,
        "codex_brief_chars_median": int(statistics.median([n for values in data["codex_briefs"].values() for n in values])) if data["codex_briefs"] else 0,
    }
    h = data["headline"]
    h.update(claude_context_per_call=h["claude_context"] // h["claude_calls"] if h["claude_calls"] else 0,
             claude_output_per_call=h["claude_output"] // h["claude_calls"] if h["claude_calls"] else 0,
             image_reads_per_100_calls=round(100 * h["image_reads"] / h["claude_calls"], 1) if h["claude_calls"] else 0,
             codex_tokens_per_session=h["codex_tokens"] // h["codex_sessions"] if h["codex_sessions"] else 0)
    data["parser_warnings"] = []
    if data["files_scanned"] and not data["headline"]["claude_calls"]:
        data["parser_warnings"].append(
            "WARNING: transcript format may have changed; token-audit's parser needs updating "
            f"({data['files_scanned']} files scanned, 0 usage rows)")
    if data["codex_files_scanned"] and not data["headline"]["codex_sessions"]:
        data["parser_warnings"].append(
            "WARNING: Codex transcript format may have changed; token-audit's parser needs updating "
            f"({data['codex_files_scanned']} files scanned, 0 token_count rows)")
    data["parser_warning"] = bool(data["parser_warnings"])
    for key in ("briefs", "codex_briefs"):
        data[key] = {name: dict(median=statistics.median(values), max=max(values), count=len(values))
                     for name, values in data[key].items()}
    finalize_measurements(data, seen, since)
    data["since"] = since.isoformat()
    return data


def configured_servers(project, observed, config, cwd=None, observed_cwds=()):
    servers = set(config.get("mcpServers", {}))
    paths = {entry["cwd"] for _, entry in observed if entry["cwd"]}
    if cwd is not None:
        # Only the selected paths this folder's sessions actually ran in, not every --cwd.
        paths.update(observed_cwds)
        paths.update(target for target in cwd if any(cwd_matches(seen, [target], {}) for seen in observed_cwds))
    for config_cwd, settings in config.get("projects", {}).items():
        if config_cwd in paths or (cwd is None and re.sub(r"[^a-zA-Z0-9]", "-", config_cwd) == project):
            paths.add(config_cwd)
            servers.update(settings.get("mcpServers", {}))
    for cwd in paths:
        try:
            value = json.loads((Path(cwd) / ".mcp.json").read_text())
            servers.update(value.get("mcpServers", {}))
        except (OSError, ValueError, AttributeError):
            pass
    return servers


def agent_usage(data):
    pricing = data["_pricing"]
    rates = pricing.get("models", {})
    cheapest = min((rate.get("output", 0) for key, rate in rates.items()
                    if key.startswith("claude-")), default=None)
    result = []
    for agent, spawns in data["agents"].items():
        calls = sorted(spawn["calls"] for spawn in spawns)
        cost = data["cost"]["by_agent"].get(agent, 0)
        share = cost / data["cost"]["total"] if data["cost"]["total"] else 0
        models = dict(data["_agent_models"][agent])
        chars = data["_agent_result_chars"][agent]
        median_chars = round(statistics.median(chars)) if chars else None
        median_calls = statistics.median(calls)
        thresholds = CHEAPER_MODEL_THRESHOLDS
        candidate = (share >= thresholds["cost_share"] and median_calls <= thresholds["calls_median"]
                     and median_chars is not None and median_chars <= thresholds["result_chars_median"]
                     and cheapest is not None and any(
                         rates[key].get("output", 0) > cheapest for model in models
                         for key in [pricing_key(pricing, model)] if key is not None))
        result.append(dict(agent=agent, spawns=len(spawns), calls_median=median_calls,
            calls_p90=calls[math.ceil(0.9 * len(calls)) - 1], cost=round(cost, 6), cost_share=round(share, 6),
            models=models, effort=dict(data["_agent_effort"][agent]), result_chars_median=median_chars,
            stuck_share=round(data["_agent_flagged"][agent] / max(1, data["_agent_turns"][agent]), 6),
            failure_rate=round(data["_agent_failed"][agent] / max(1, data["_agent_results"][agent]), 6),
            cheaper_model_candidate=candidate))
    return sorted(result, key=lambda row: (-row["cost"], row["agent"]))


def finalize_measurements(data, scanned, since):
    cost, stuck = data["cost"], data["stuck_turns"]
    cost["shares"] = {key: value / cost["total"] if cost["total"] else 0
                      for key, value in cost["components"].items()}
    data["agent_usage"] = agent_usage(data)
    stuck["share"] = stuck["flagged_turns"] / max(1, stuck["turns"])
    stuck["cost_share"] = stuck["cost"] / cost["total"] if cost["total"] else 0
    grouped = {}
    for row in stuck["signatures"]:
        key = tuple(row[k] for k in ("project", "agent", "session", "signature"))
        if key not in grouped:
            grouped[key] = dict(row, repeats=0, turns=set())
            del grouped[key]["_turn"]
        grouped[key]["repeats"] += row["repeats"]
        grouped[key]["turns"].add(row["_turn"])
    for row in grouped.values():
        row["turns"] = len(row["turns"])
    stuck["signatures"] = sorted(grouped.values(), key=lambda v: (
        -v["repeats"], -v["turns"], v["project"], v["agent"], v["session"], v["signature"]))[:10]
    for row in stuck["signatures"]:
        row["session"] = row["session"][:12]
    for (project, signature), fact in sorted(data["_failures"].items(), key=lambda item: (
            -len(item[1]["sessions"]), -item[1]["occurrences"], str(item[0]))):
        if len(fact["sessions"]) >= data["_options"]["fact_sessions"]:
            data["repeat_failures"].append(dict(project=project, signature=signature_text(signature),
                sessions=len(fact["sessions"]), occurrences=fact["occurrences"],
                worked_instead=next(iter(fact["worked_instead"]), "")))
    # Filters should not shrink the fallback universe to tools used in that project.
    root = claude_home() / "projects"
    for directory in root.iterdir() if root.is_dir() else []:
        if not directory.is_dir():
            continue
        paths = list(directory.glob("*.jsonl")) + list(directory.glob("*/subagents/*.jsonl"))
        for path in paths:
            if path in scanned or too_old(path, since) or path.resolve() in scanned:
                continue
            # Only parse potential tool-use records from unscanned files.
            try:
                with path.open("rb") as stream:
                    for line in stream:
                        if b'"tool_use"' not in line:
                            continue
                        match = TIMESTAMP.search(line)
                        if not match or date_time(match[1].decode()) < since:
                            continue
                        try:
                            row = json.loads(line)
                            data["_tool_universe"].update(b["name"] for b in blocks(row.get("message") or {})
                                if b.get("type") == "tool_use" and b.get("name"))
                        except (ValueError, TypeError):
                            pass
            except (OSError, ValueError):
                pass
    try:
        config = json.loads(claude_json().read_text())
    except (OSError, ValueError):
        config = {}
    prune_tools(data, config)
    for key in list(data):
        if key.startswith("_"):
            del data[key]


def server_name(name):
    return re.sub(r"[^a-z0-9]", "_", name.lower())


def tool_server(name):
    return server_name(name.split("__", 2)[1]) if name.startswith("mcp__") and name.count("__") >= 2 else None


def prune_tools(data, config):
    for project, observed in sorted(data["_observed"].items()):
        configured = {server_name(name) for name in configured_servers(
            project, observed, config, data["_cwd"], data["_cwd_observed"][project])}
        sessions = {}
        used = set().union(*(entry["used"] for _, entry in observed))
        used_servers = {tool_server(name) for name in used if tool_server(name)}
        for session_id, entry in observed:
            if not entry["main"]:
                continue
            if session_id not in sessions:
                sessions[session_id] = dict(known=False, available=set(), servers=set(), prompts=0,
                                            loading=defaultdict(set))
            session = sessions[session_id]
            session["known"] |= entry["known"]
            session["available"].update(entry["available"] | entry["used"])
            session["servers"].update(server_name(name) for name in entry["servers"])
            session["prompts"] += entry["prompts"]
            for name, states in entry["loading"].items():
                session["loading"][name].update(states)
        candidates = defaultdict(lambda: dict(sessions=set(), prompts=0, loading=set(), tools=set(), instructions=False))
        deferred = defaultdict(lambda: dict(sessions=set(), prompts=0))
        all_loading = defaultdict(set)
        for session in sessions.values():
            for name, states in session["loading"].items():
                all_loading[name].update(states)
        for session_id, session in sessions.items():
            universe = session["available"] if session["known"] else data["_tool_universe"]
            grouped = defaultdict(set)
            for name in universe:
                server = tool_server(name)
                if server:
                    grouped[server].add(name)
                if name not in used and "deferred" in all_loading[name] and "loaded in full" not in all_loading[name]:
                    deferred[name]["sessions"].add(session_id)
                    deferred[name]["prompts"] += session["prompts"]
            names = {(name, "MCP server") for name in configured | session["servers"] | set(grouped)}
            for name, kind in names:
                if name in used_servers:
                    continue
                candidate = candidates[(name, kind)]
                candidate["sessions"].add(session_id)
                candidate["prompts"] += session["prompts"]
                candidate["tools"].update(grouped[name])
                candidate["instructions"] |= name in session["servers"]
                for tool in grouped[name]:
                    candidate["loading"].update(session["loading"].get(tool, {"unknown"}))
        options = data["_options"]
        def eligible(candidate):
            count = len(candidate["sessions"])
            return ((candidate["prompts"] >= options["prune_prompts"] and count >= options["prune_min_sessions"])
                    or count >= options["prune_sessions"])
        data["deferred_tools_unused"] += sum(eligible(candidate) for candidate in deferred.values())
        for (name, kind), candidate in candidates.items():
            states = candidate["loading"]
            if not eligible(candidate):
                continue
            if not candidate["instructions"] and "deferred" in states and "loaded in full" not in states:
                continue
            if candidate["instructions"]:
                states.add("loaded in full (instructions)")
            data["unused_tools"].append(dict(project=project, candidate=name, kind=kind,
                sessions=len(candidate["sessions"]), prompts=candidate["prompts"], tools=len(candidate["tools"]),
                loading=", ".join(sorted(states or {"unknown"}))))
    def saving(row):
        loaded = "loaded in full" in row["loading"]
        priority = 3 if loaded and row["kind"] == "MCP server" else 2 if loaded else 1 if row["kind"] == "MCP server" else 0
        return (-priority, -row["sessions"], -row["prompts"], row["project"], row["candidate"])
    data["unused_tools"].sort(key=saving)


def money(value):
    return f"${value:,.2f}"


def loading_state(value):
    if "instructions" in value:
        return "full + instructions"
    if "loaded in full" in value:
        return "full"
    return "deferred" if "deferred" in value else "unknown"


def measurement_sections(data):
    cost, stuck = data["cost"], data["stuck_turns"]
    lines = ["", "## Cost (API-equivalent)",
             "API-equivalent $ is a comparison weighting, not a subscription bill."]
    lines.append("Codex resumed sessions may be over-counted: pre-window cumulative usage is not seeded.")
    if cost["pricing_error"]:
        lines.append(cost["pricing_error"])
    lines.append(f"Total API-equivalent cost: {money(cost['total'])}")
    for label, mapping in (("Agent", cost["by_agent"]), ("Model", cost["by_model"])):
        lines += [f"{label} | API-equivalent $ | Share", "--- | --- | ---"]
        lines += [f"{cell(name)} | {money(value)} | {value / cost['total'] if cost['total'] else 0:.1%}"
                  for name, value in sorted(mapping.items(), key=lambda pair: (-pair[1], pair[0]))]
    lines += ["Component | API-equivalent $ | Share", "--- | --- | ---"]
    lines += [f"{name} | {money(cost['components'].get(name, 0))} | {cost['shares'].get(name, 0):.1%}"
              for name in ("cache_read", "cache_write", "uncached_input", "output")]
    if cost["unpriced"]:
        lines += ["Unpriced model | Token totals", "--- | ---"]
        lines += [f"{cell(model)} | " + ", ".join(f"{k}={v}" for k, v in tokens.items())
                  for model, tokens in sorted(cost["unpriced"].items())]
    lines += ["", "## Stuck turns",
              f"{stuck['flagged_turns']} of {stuck['turns']} turns ({stuck['share']:.1%}); "
              f"{stuck['tool_calls']} tool calls; API-equivalent cost {money(stuck['cost'])} ({stuck['cost_share']:.1%} of cost).",
              "Project | Agent | Repeats | Turns | Session | Signature", "--- | --- | --- | --- | --- | ---"]
    lines += [" | ".join(cell(row[k]) for k in ("project", "agent", "repeats", "turns", "session", "signature"))
              for row in stuck["signatures"]] or ["None."]
    lines += ["", "## Repeated failures across sessions", "Project | Signature | Sessions | Occurrences | Worked instead",
              "--- | --- | --- | --- | ---"]
    lines += [" | ".join(cell(row[k]) for k in ("project", "signature", "sessions", "occurrences", "worked_instead"))
              for row in data["repeat_failures"]] or ["None."]
    lines += ["", "## Unused tools and MCP servers",
              "A deny rule takes effect for new sessions. Changing the tool set invalidates the prompt cache of a resumed conversation.",
              "Universe: recorded tool definitions/deferred names and MCP instructions when available; otherwise tools used across all projects in the window plus user/project MCP configuration. Loading state is unknown without evidence.",
              f"{data['deferred_tools_unused']} deferred tools unused (names only, ~negligible per turn)",
              "Project | Candidate | Kind | Sessions without use | Prompts without use | Tools | Loading",
              "--- | --- | --- | --- | --- | --- | ---"]
    lines += [" | ".join(cell(row[k]) for k in ("project", "candidate", "kind", "sessions", "prompts")) +
              " | " + (f"{row['tools']} tools" if row["kind"] == "MCP server" else "—") +
              " | " + loading_state(row["loading"])
              for row in data["unused_tools"][:25]] or ["None."]
    if len(data["unused_tools"]) > 25:
        lines.append(f"+{len(data['unused_tools']) - 25} more; use --json for all details.")
    projects = len({r["project"] for r in data["unused_tools"]})
    headline = [f"API-equivalent cost {money(cost['total'])} (cache reads {cost['shares'].get('cache_read', 0):.1%})",
                f"Stuck turns: {stuck['flagged_turns']} of {stuck['turns']} ({stuck['cost_share']:.1%} of cost)",
                f"Repo-fact candidates: {len(data['repeat_failures'])}",
                f"Pruning candidates: {len(data['unused_tools'])} across {projects} project{'s' if projects != 1 else ''}"]
    return lines, headline


def cell(value):
    return str(value).replace("|", "\\|").replace("\n", " ").replace("\r", " ")


def avg(counter):
    return round(counter["context"] / max(1, counter["calls"]))


def agent_stats(data):
    result = []
    usage = {row["agent"]: row for row in data["agent_usage"]}
    for name, spawns in data["agents"].items():
        calls = [spawn["calls"] for spawn in spawns]
        median = statistics.median(calls)
        ctx = sum(spawn["context"] for spawn in spawns)
        flag = " ⚠" if median > 120 else ""
        brief = data["briefs"].get(name)
        brief_text = f"{brief['median']:g}/{brief['max']}" if brief else "-"
        row = usage[name]
        models = ", ".join(sorted(row["models"], key=lambda model: (-row["models"][model], model))[:3]) or "-"
        effort = ", ".join(f"{label} {count}" for label, count in sorted(
            row["effort"].items(), key=lambda pair: (-pair[1], pair[0]))) or "-"
        values = (name + flag, len(spawns), f"{median:g}/{max(calls)}", ctx, round(ctx / sum(calls)),
                  f"{statistics.median(s['minutes'] for s in spawns):.1f}", brief_text,
                  f"{row['cost_share']:.1%}", models, effort)
        result.append((ctx, name, " | ".join(cell(value) for value in values)))
    return sorted(result, reverse=True)


def previous_audit(out, scope):
    candidates = sorted((p for p in out.parent.glob("token-audit-*.md") if p != out),
                        key=lambda p: (p.stat().st_mtime_ns, p.name), reverse=True)
    match, other = None, None
    for path in candidates:
        try:
            with path.open() as stream:
                for line in stream:
                    if line.startswith("<!-- token-audit-headline "):
                        value = json.loads(line.removeprefix("<!-- token-audit-headline ").rstrip("\r\n").removesuffix(" -->"))
                        if not isinstance(value, dict):
                            break
                        metadata = None
                        line = next(stream, "")
                        if line.startswith("<!-- token-audit-scope "):
                            try:
                                metadata = json.loads(line.removeprefix("<!-- token-audit-scope ").rstrip("\r\n").removesuffix(" -->"))
                            except ValueError:
                                pass
                        # Partial or other-format scope lines count as no scope, never as a crash.
                        if not isinstance(metadata, dict) or set(metadata) != set(scope):
                            metadata = None
                        entry = (path, value, metadata)
                        if match is None and metadata == scope:
                            match = entry
                        elif other is None:
                            other = entry
                        break
        except (OSError, ValueError):
            continue
        if match is not None and other is not None:
            break
    return match, other


def describe(scope):
    if scope["cwd"] is not None:
        projects = "cwd " + ", ".join(scope["cwd"])
    elif scope["project_dirs"]:
        projects = "project dirs " + ", ".join(scope["project_dirs"])
    else:
        projects = "all projects"
    if scope["project"] is not None:
        project = "project " + json.dumps(scope["project"])
        projects = projects + ", " + project if scope["project_dirs"] or scope["cwd"] is not None else project
    return "window " + scope["window"] + ", " + projects


def report(data, out, scope):
    h = data["headline"]
    headline = [f"Claude: {h['claude_calls']:,} calls; {h['claude_context']:,} context tokens; {h['claude_output']:,} output tokens.",
                f"Codex: {h['codex_sessions']:,} sessions; {h['codex_tokens']:,} tokens."]
    sections = []
    sections.append(("1. Totals by model (Claude)",
                     ["Model | Calls | Context | Cache-read share | Output"],
                     [f"{cell(name)} | {c['calls']} | {c['context']} | {c['cache_read'] / max(1, c['context']):.1%} | {c['output']}"
                      for name, c in sorted(data["models"].items(), key=lambda pair: -pair[1]["context"])]))
    sessions = sorted(data["sessions"], key=lambda s: -s["context"])
    sections.append(("2. Main sessions", ["ID | Date | Calls | Avg context | Peak context"],
                     [f"{cell(s['id'])}{' ⚠' if s['context'] > s['calls'] * 150000 or s['peak'] > 250000 else ''} | "
                      f"{s['date']} | {s['calls']} | {avg(s)} | {s['peak']}" for s in sessions]))
    agents = agent_stats(data)
    sections.append(("3. By agent type", ["Agent | Spawns | Median/max calls | Context | Avg context | Median minutes | Median/max brief chars | Cost share | Models | Effort"],
                     [row for _, _, row in agents]))
    sections.append(("4. Orchestrator turns by trigger", ["Trigger | Turns | Avg context"],
                     [f"{trigger} | {data['triggers'][trigger]['calls']} | {avg(data['triggers'][trigger])}"
                      for trigger in ("human", "tool result", "task notification")]))
    sections.append(("5. Main-session tool results",
                     [f"Image blocks read: {data['images']}{' ⚠ images in main session' if data['images'] else ''}",
                      "Tool | Results | Chars"],
                     [f"{cell(tool)} | {data['tool_counts'][tool]} | {chars}"
                      for tool, chars in data["tool_chars"].most_common()]))
    heavy = [name for _, name, _ in agents if any(s["calls"] > 8 for s in data["agents"][name])]
    sections.append(("6. Top Bash command heads per heavy agent", [],
                     [f"{cell(name)}: " + "; ".join(
                         f"{cell(head)} ({count} calls, {data['bash_chars'][name][head]} chars)"
                         for head, count in data["bash"][name].most_common(6)) for name in heavy]))
    sections.append(("7. Codex by model", ["Model | Sessions | Input (cached subset) | Output | Tokens | Median brief chars"],
                     [f"{cell(name)} | {c['sessions']} | {c['input']} ({c['cached_input']}) | {c['output']} | {c['tokens']} | "
                      f"{data['codex_briefs'][name]['median']:g}" if name in data["codex_briefs"] else
                      f"{cell(name)} | {c['sessions']} | {c['input']} ({c['cached_input']}) | {c['output']} | {c['tokens']} | -"
                      for name, c in sorted(data["codex"].items(), key=lambda pair: -pair[1]["tokens"])]))
    match, other = previous_audit(out, scope)
    volume = ("claude_calls", "claude_context", "claude_output", "codex_sessions", "codex_tokens", "image_reads")
    intensity = ("claude_context_per_call", "claude_output_per_call", "image_reads_per_100_calls",
                 "brief_chars_median", "codex_tokens_per_session", "codex_brief_chars_median")
    changes = ["No earlier token-audit report."]
    old = match[1] if match is not None else None
    if match is not None:
        deltas = []
        for key in intensity:
            if key not in old:
                deltas.append(f"{key} new")
            else:
                percent = f" ({(h[key] - old[key]) / old[key] * 100:+.1f}%)" if old[key] else ""
                deltas.append(f"{key} {old[key]:,} → {h[key]:,}{percent}")
        changes = [f"Compared with {match[0].name} (same scope: {describe(scope)}).",
                   "Activity (never flagged): " + "; ".join(
                       f"{key} {h[key] - old[key]:+,}" if key in old else f"{key} new" for key in volume) + ".",
                   "Intensity: " + "; ".join(deltas) + "."]
    elif other is not None:
        prior_scope = describe(other[2]) if other[2] is not None else "no scope metadata, before 0.4.0"
        changes = [f"Not comparable: no earlier report with the same scope ({describe(scope)}). "
                   f"Newest other report: {other[0].name} ({prior_scope})."]
    sections.append(("8. Changes since last audit", [], changes))
    data["flagged"] = []
    flags = []
    for key in intensity:
        if old is None or key not in old:
            continue
        before = old[key]
        sample, minimum = ("codex_sessions", 3) if key.startswith("codex_") else ("claude_calls", 20)
        if before <= 0 or old.get(sample, 0) < minimum:
            flags.append(f"{key}: baseline too small to compare")
            continue
        value = h[key]
        if (value - before) * 100 > before * 20:
            data["flagged"].append(dict(metric=key, old=before, new=value,
                                        percent_change=(value - before) / before * 100))
    for flag in data["flagged"]:
        percent = f"{flag['percent_change']:.1f}" if flag['percent_change'] is not None else "∞"
        flags.append(f"{flag['metric']}: {flag['old']:,} → {flag['new']:,} (+{percent}%).")
    sections.append(("9. Flagged", [], flags or [
        "Nothing flagged: no comparable report." if match is None and other is not None else
        "no previous audit to compare" if match is None else "None."]))
    # A pipe header needs a separator row to render as a Markdown table.
    for _, headers, _ in sections:
        if headers and " | " in headers[-1]:
            headers.append(" | ".join("---" for _ in headers[-1].split(" | ")))
    lines = [*data["parser_warnings"], "# Token audit", f"Since: {data['since']} (UTC; Claude calls in window, Codex final session totals).",
             *headline, "<!-- token-audit-headline " + json.dumps(h) + " -->",
             "<!-- token-audit-scope " + json.dumps(scope, sort_keys=True) + " -->",
             "<!-- token-audit-extract " + json.dumps(dict(v=1, file=out.stem + ".extract.json")) + " -->"]
    if data["warnings"]:
        lines.append("Skipped: " + "; ".join(f"{n} {key}" for key, n in data["warnings"].items()))
    # Fairly share the remaining 80-line budget; JSON retains every row.
    budgets = [0] * len(sections)
    remaining = 80 - len(lines) - sum(2 + len(headers) for _, headers, _ in sections)
    # Always show comparison details and every regression.
    budgets[-2] = len(changes)
    budgets[-1] = len(sections[-1][2])
    remaining -= budgets[-2] + budgets[-1]
    needs = [max(1, len(rows)) for _, _, rows in sections]
    while remaining > 0 and any(b < n for b, n in zip(budgets, needs)):
        for i, need in enumerate(needs):
            if remaining and budgets[i] < need:
                budgets[i] += 1
                remaining -= 1
    for (title, headers, body), budget in zip(sections, budgets):
        lines += ["", "## " + title] + headers
        if not body:
            lines.append("None.")
        elif len(body) > budget:
            lines += body[:max(0, budget - 1)] + [f"… {len(body) - max(0, budget - 1)} more rows; use --json for all details."]
        else:
            lines += body
    extra, headlines = measurement_sections(data)
    return "\n".join(lines + extra) + "\n", headline + headlines


def write_extract(data, out, directory, scope):
    temporary = None
    try:
        directory = directory.expanduser().resolve()
        directory.mkdir(parents=True, exist_ok=True)
        path = directory / (out.stem + ".extract.json")
        value = dict(v=1, scope=scope, since=data["since"], report=out.name,
                     usage=dict(agents=data["agent_usage"], sessions=[], task_switches=[], instructions=[]))
        with tempfile.NamedTemporaryFile(mode="w", dir=directory, delete=False) as stream:
            temporary = stream.name
            json.dump(value, stream)
            stream.write("\n")
        os.replace(temporary, path)
        return str(path)
    except OSError as exc:
        print(f"token-audit: extract not written ({exc})", file=sys.stderr)
        return None
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary)
            except OSError:
                pass


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    period = parser.add_mutually_exclusive_group()
    period.add_argument("--days", type=int, default=3)
    period.add_argument("--since", type=lambda s: datetime.strptime(s, "%Y-%m-%d").replace(tzinfo=timezone.utc))
    selection = parser.add_mutually_exclusive_group()
    selection.add_argument("--project", help="filter project folder names by substring")
    selection.add_argument("--cwd", action="append", metavar="PATH", help="select transcripts by working directory (repeatable)")
    parser.add_argument("--project-dir", action="append", default=[], type=Path)
    parser.add_argument("--codex", action="store_true", help="include Codex sessions (also included by default)")
    parser.add_argument("--out", type=Path)
    parser.add_argument("--extract-out", type=Path, default=claude_home() / "audits" / "extracts",
                        help="extract directory (default: Claude config dir/audits/extracts)")
    parser.add_argument("--json", action="store_true", help="print full structured data instead of headline stdout")
    parser.add_argument("--pricing", type=Path, default=Path(__file__).resolve().with_name("pricing.json"))
    for flag, default in (("stuck-repeats", 3), ("fact-sessions", 3), ("prune-prompts", 10),
                          ("prune-min-sessions", 2), ("prune-sessions", 5)):
        parser.add_argument("--" + flag, type=int, default=default)
    args = parser.parse_args()
    options = {key: getattr(args, key) for key in ("stuck_repeats", "fact_sessions", "prune_prompts",
                                                  "prune_min_sessions", "prune_sessions")}
    if any(value < 1 for value in options.values()):
        parser.error("measurement thresholds must be positive")
    if args.days < 0:
        parser.error("--days must be nonnegative")
    now = datetime.now(timezone.utc)
    since = args.since or (now - timedelta(days=args.days)).replace(microsecond=0)
    root = claude_home() / "projects"
    projects = [p.expanduser().resolve() for p in args.project_dir] if args.project_dir else (
        sorted(p for p in root.iterdir() if p.is_dir()) if root.is_dir() else [])
    codex_root = codex_home() / "sessions"
    cwd = sorted({str(Path(p).expanduser().resolve()) for p in args.cwd}) if args.cwd else None
    scope = dict(codex=("cwd" if cwd is not None else "all") if codex_root.exists() else "none", cwd=cwd,
                 project=args.project.casefold() if args.project else None,
                 project_dirs=sorted({str(p.expanduser().resolve()) for p in args.project_dir}), v=1,
                 window="since:" + args.since.strftime("%Y-%m-%d") if args.since else f"{args.days}d")
    if not args.project_dir and not projects and not next(codex_root.glob("*/*/*/*.jsonl"), None):
        print(f"token-audit: no Claude Code projects under {root} "
              "(set CLAUDE_CONFIG_DIR if they live elsewhere)", file=sys.stderr)
    if args.project:
        projects = [p for p in projects if args.project.casefold() in p.name.casefold()]
    directory = (args.out or claude_home() / "audits").expanduser().resolve()
    out = directory / f"token-audit-{now:%Y%m%dT%H%M%S.%fZ}.md"
    try:
        for path in projects:
            if not path.is_dir():
                raise ValueError(f"project directory missing: {path}")
        pricing, pricing_error = load_pricing(args.pricing.expanduser())
        data = collect(projects, codex_root, since, pricing, pricing_error, options, cwd)
        data["scope"] = scope
        for warning in data["parser_warnings"]:
            print(warning, file=sys.stderr)
        text, headline = report(data, out, scope)
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(text)
        extract_path = write_extract(data, out, args.extract_out, scope)
        if args.json:
            print(json.dumps(dict(report_path=str(out), extract_path=extract_path, **data), indent=2))
        else:
            print(str(out) + "\n" + "\n".join(headline))
        return 0
    except (OSError, ValueError) as exc:
        print(f"token-audit: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
