# --- paths helper ---
def claude_home():
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude").expanduser()


def claude_json():
    root = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(root).expanduser() / ".claude.json" if root else Path.home() / ".claude.json"


def codex_home():
    return Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").expanduser()
# --- end paths helper ---


TIMESTAMP = re.compile(rb'"timestamp"\s*:\s*"([^"\n]+)"')
MARKERS = (b'"usage"', b'"tool_result"', b'"timestamp"')
INJECTED_PREFIXES = ("# AGENTS.md instructions", "<environment_context>", "<user_instructions>",
                     "<user_action>", "<turn_aborted>", "<image", "</image>")
USER_ROW = re.compile(rb'"type"\s*:\s*"user"')
MESSAGE_ROW = re.compile(rb'"type"\s*:\s*"(?:user|assistant)"')
CODEX_ROW = re.compile(rb'"(?:token_count|user_message|role"\s*:\s*"user|turn_context)"')
TOOL_METADATA = (b'"api-request-shape"', b'"deferred_tools_delta"', b'"mcp_instructions_delta"')
EXIT_HEADER = re.compile(r"^Exit code\s*:?\s*(-?\d+)\s*$", re.I)
BENIGN_EXITS = {"grep": {1}, "rg": {1}, "test": {1}, "[": {1}, "diff": {1}, "cmp": {1},
                "sed -n": {141, -13}, "wc": {141, -13}, "head": {141, -13}}
SHELL_NO_HINT = frozenset(("for", "while", "if", "then", "do", "case", "cat", "echo", "cd", "printf"))
SECRET = re.compile(r"sk-[A-Za-z0-9_-]+|ghp_[A-Za-z0-9_]+|xox[a-z]*-[A-Za-z0-9-]+|AKIA[A-Z0-9]+|"
                    r"(?<![A-Za-z0-9_])[A-Za-z0-9+/=_-]{32,}(?![A-Za-z0-9_])")
JSON_DECODER = json.JSONDecoder()
METADATA_FIELDS = {key: re.compile(('"' + key + r'"\s*:\s*').encode()) for key in (
    "tools", "addedNames", "readdedNames", "surfacedDefinitions", "removedNames")}
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z_0-9]*=")
CHEAPER_MODEL_THRESHOLDS = dict(cost_share=0.05, calls_median=15, result_chars_median=4000)
FRICTION_THRESHOLDS = dict(slow_call_seconds=120, heavy_seconds=60)
FRICTION_PAIR_LIMIT = 16384
FRICTION_REJECTED_LIMIT = 16384
MAX_TIMING_MS = timedelta.max.total_seconds() * 1000
TIMED_TOOLS = frozenset(("Read", "Write", "Edit", "Glob", "Grep", "WebFetch", "WebSearch",
                         "NotebookEdit", "Skill", "LSP"))
UNTIMED_TOOLS = frozenset(("Agent", "Task", "SendMessage", "AskUserQuestion"))
SHELL_PROGRAMS = frozenset("ls rg grep find make cmake pytest sleep curl wget rsync sed awk cat diff".split())
SHELL_VERBS = {
    "cargo": "build check clippy fmt run test",
    "docker": "build compose pull run",
    "git": "add blame checkout clone commit diff fetch log merge pull push rebase show status switch",
    "go": "build run test vet",
    "gradlew": "build check test",
    "npm": "build ci install run test",
    "pnpm": "build install run test",
    "yarn": "build install run test",
}


@lru_cache(maxsize=256)
def date_time(value):
    dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
    return dt.replace(tzinfo=timezone.utc) if dt.tzinfo is None else dt.astimezone(timezone.utc)


def metadata_row(line, timestamp):
    shape = b'"api-request-shape"' in line[:256]
    kind = "api-request-shape" if shape else "attachment"
    attachment = "deferred_tools_delta" if b'"deferred_tools_delta"' in line[:1024] else "mcp_instructions_delta"
    value = {}
    for key in (("tools",) if shape else ("addedNames", "readdedNames", "surfacedDefinitions", "removedNames")):
        match = METADATA_FIELDS[key].search(line)
        if match:
            value[key] = JSON_DECODER.raw_decode(line[match.end():].decode("utf-8"))[0]
    return dict(type=kind, timestamp=timestamp, **({"shape": value} if shape else {
        "attachment": dict(type=attachment, **value)}))


# Top-level record kinds emitted by the two transcript formats.
CLAUDE_TYPES = frozenset(("user", "assistant", "system", "progress", "file-history-snapshot",
                          "queue-operation", "summary", "custom-title", "attachment", "api-request-shape",
                          "last-prompt", "pr-link", "api-request", "api-request-blob", "atis-latch",
                          "session-owner", "mode", "ai-title", "permission-mode", "tools-used",
                          "cost-state", "file-history-delta"))
CODEX_TYPES = frozenset(("session_meta", "turn_context", "response_item", "event_msg", "compacted",
                         "token_usage_record", "world_state"))
TYPE_FIELD = re.compile(rb'"type"\s*:\s*"([^"\\]+)"')
VERSION_FIELD = re.compile(rb'"(?:version|cli_version)"\s*:')
CODEX_CALL_TYPES = frozenset((b"function_call", b"custom_tool_call"))
CODEX_OUTPUT_TYPES = frozenset(kind + b"_output" for kind in CODEX_CALL_TYPES)
CODEX_FIELD = re.compile(rb'\s*(?:[{,])\s*"([a-z_]+)"\s*:\s*')
CODEX_STRING = re.compile(rb'"(?:[^"\\]|\\.)*"')
CODEX_SCALAR = re.compile(CODEX_STRING.pattern + rb'|null|true|false|-?[0-9.]+')
CODEX_EVIDENCE_LIMIT = 400
CODEX_WALL = re.compile(r"^Wall time:? ([0-9]+(?:\.[0-9]+)?) seconds\b", re.M)
CODEX_OUTPUT_START = re.compile(r"^(?:Original output|Final output|Output|Stdout):", re.M | re.I)
CODEX_OUTPUT_END = re.compile(rb'(?:"|[0-9]|true|false|null)\s*(?:}\s*\]\s*)?(}\s*}?)\s*$')
CODEX_EXIT = re.compile(r"^(?:Process exited with code|Exit code:?) (-?\d+)\s*$", re.M | re.I)
CODEX_ERROR = re.compile(r"^(?:Stderr|Error):[ \t]*(.*)", re.M | re.I | re.S)
CODEX_TIMEOUT = re.compile(r"\b(?:timed out|os error 60|(?:Process exited with code|Exit code:?) (?:124|137|143))\b", re.I)
CODEX_LOCK = re.compile(r"\b(?:database is locked|EBUSY|(?:could not|unable to) (?:get|acquire) (?:the )?lock|waiting for .{0,60}?lock)\b", re.I)
CODEX_INOTIFY = re.compile(r"upper limit on inotify watches reached|user limit of inotify instances reached", re.I)
CODEX_COMMAND = re.compile(r'^(?:text\(\s*)?(?:await\s+)?(?:tools\.)?exec_command\(\s*\{\s*"?cmd"?\s*:\s*["\x27]([^"\x27\n]{1,200})')


def codex_fields(prefix, pos=0, wrapped=False):
    """Read scalar header fields. Leave the output value as raw bytes."""
    fields = {}
    while match := CODEX_FIELD.match(prefix, pos):
        key, start = match[1], match.end()
        if key == b"payload" and not wrapped and prefix[start:start + 1] == b"{":
            fields[key] = codex_fields(prefix, start, wrapped=True)
            break
        if key == b"output":
            fields[key] = start
            break
        value = CODEX_SCALAR.match(prefix, start)
        if not value or key in fields:
            break
        fields[key] = value[0]
        pos = value.end()
    return fields


def envelope_timestamp(line, require_closed_envelope=False):
    # The usual envelope puts the timestamp first or just after type.
    lead = re.match(rb'^\s*\{\s*(?:"type"\s*:\s*"[^"\\]*"\s*,\s*)?"timestamp"\s*:\s*"([^"\n]+)"', line)
    stamp = None
    depth, pos = 0, 0
    if lead:
        stamp = lead[1].decode('ascii', 'replace')
        if not require_closed_envelope:
            return stamp
        depth, pos = 1, lead.end()
    # Skip nested values and strings without decoding potentially huge outputs.
    token = re.compile(rb'["{}\[\]]')
    while match := token.search(line, pos):
        value = match.group()
        pos = match.end()
        if value == b'"':
            start = match.start()
            while True:
                end = line.find(b'"', pos)
                if end < 0:
                    return None
                slash = end
                while slash > start and line[slash - 1] == 92:
                    slash -= 1
                pos = end + 1
                if (end - slash) % 2 == 0:
                    break
            if stamp is None and depth == 1 and end - start == 10 and line[start:pos] == b'"timestamp"':
                tail = re.match(rb'\s*:\s*"([^"\n]+)"', line[pos:pos + 100])
                if tail:
                    stamp = tail[1].decode('ascii', 'replace')
                    if not require_closed_envelope:
                        return stamp
        elif value in (b'{', b'['):
            depth += 1
        else:
            depth -= 1
            if require_closed_envelope and depth == 0:
                return stamp if value == b'}' and re.compile(rb'\s*\Z').match(line, pos) else None
    return None


def codex_tool_header(line, keep_calls):
    fields = codex_fields(line[:4096])
    outer = fields.get(b"type", b"")[1:-1]
    fields = fields.get(b"payload", {}) if outer == b"response_item" else fields
    if not isinstance(fields, dict):
        return None
    kind = fields.get(b"type", b"")[1:-1]
    if kind in CODEX_OUTPUT_TYPES or (keep_calls and kind in CODEX_CALL_TYPES):
        return outer, kind, fields
    return None


def invalid_json_constant(value):
    raise ValueError(value)


def bounded_turn_id(value):
    if value is None or isinstance(value, str) and len(value) <= 256:
        return value
    # A tagged digest cannot collide with an ordinary string ID.
    encoded = json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(',', ':')).encode('ascii')
    return (hashlib.sha256(encoded).digest(),)


def codex_call_row(line, kind, fields, wrapped):
    ident = None
    try:
        limit = LINE_LIMIT if kind in CODEX_OUTPUT_TYPES else 4096
        if len(line) <= limit:
            record = json.loads(line, parse_constant=invalid_json_constant)
            call = record.get("payload") if wrapped and isinstance(record, dict) else record
            if not isinstance(call, dict) or call.get("type") != kind.decode("ascii"):
                return None, None
            ident = call.get("call_id")
        else:
            call = None
        if call is None:
            raw = fields.get(b"call_id", b"")
            if raw.startswith(b'"') and 2 < len(raw) <= 258:
                ident = json.loads(raw)
            return ident, None
        if not isinstance(ident, str) or not 0 < len(ident) <= 256:
            return None, None
        location = dict(cwd=call.get("cwd", record.get("cwd")),
                        turn_id=bounded_turn_id(call.get("turn_id", record.get("turn_id"))))
        if kind in CODEX_OUTPUT_TYPES:
            return ident, dict(location, **codex_output(call), fingerprint=hash(line))
        args = call.get("arguments")
        args = json.loads(args) if isinstance(args, str) else args
        command = args.get("cmd") if isinstance(args, dict) else None
        legacy = args.get("command") if isinstance(args, dict) else None
        if command is None and isinstance(legacy, list) and "-lc" in legacy:
            index = legacy.index("-lc") + 1
            command = legacy[index] if index < len(legacy) else None
        if command is None and isinstance(call.get("input"), str):
            match = CODEX_COMMAND.match(call["input"])
            command = match[1] if match else None
        signature = friction_signature(command) if isinstance(command, str) else "(tool)"
        return ident, dict(location, signature=signature, poll=is_polling(command), fingerprint=hash(line))
    except (ValueError, TypeError, RecursionError):
        raw = fields.get(b"call_id", b"")
        if ident is None and raw.startswith(b'"') and 2 < len(raw) <= 258:
            try:
                ident = json.loads(raw)
            except ValueError:
                pass
        return ident, None


def codex_output(call):
    output = call.get("output")
    if isinstance(output, list) and output and isinstance(output[0], dict) and output[0].get("type") == "input_text":
        output = output[0].get("text")
    evidence = codex_evidence(output)
    marker = CODEX_OUTPUT_START.search(evidence)
    header = evidence[:marker.start()] if marker else evidence
    error = CODEX_ERROR.search(header)
    header = header[:error.start()] if error else header
    wall = CODEX_WALL.search(header)
    seconds = float(wall[1]) if wall else None
    if seconds is not None and seconds > MAX_TIMING_MS / 1000:
        seconds = None
    code = call.get("exit_code")
    exit_match = CODEX_EXIT.search(header) if type(code) is not int else None
    failed = (type(code) is int and code != 0 or exit_match is not None and int(exit_match[1]) != 0
              or call.get("status") in ("error", "failed") or call.get("is_error") is True)
    lock = failed and (any(CODEX_LOCK.search(codex_evidence(call.get(field))) for field in ("stderr", "error"))
                       or bool(error and CODEX_LOCK.search(error[1]))
                       or bool(marker and CODEX_LOCK.search(evidence[marker.end():])))
    return dict(seconds=seconds, timeout=bool(CODEX_TIMEOUT.search(evidence)),
                lock=lock, inotify=bool(CODEX_INOTIFY.search(evidence)))


def codex_evidence(value):
    if not isinstance(value, str):
        return ""
    prefix = value[:CODEX_EVIDENCE_LIMIT]
    if prefix.isascii():
        return prefix
    return prefix.encode("utf-8", "surrogatepass")[:CODEX_EVIDENCE_LIMIT].decode("utf-8", "ignore")


UNPARSED = object()


def canary_row(line, since, counts, codex, session_version, output_type=None, row=UNPARSED, envelope_stamp=UNPARSED, nested_output=False):
    # Decode candidate records for classification; never retain their content.
    known = CODEX_TYPES if codex else CLAUDE_TYPES
    prefix = line[:1024] if codex else b""
    match = TYPE_FIELD.search(prefix) if codex and len(line) > 2048 else None
    # Large ordinary Codex response items are content, not usage records.
    # Their session metadata carries the version; avoid decoding their bodies.
    if output_type is not None or (match and match[1] == b"response_item" and not VERSION_FIELD.search(prefix)):
        suffix = line[-64:]
        if (output_type is not None and nested_output and not suffix.rstrip().endswith(b'}}')
                and not re.search(rb'}\s*}\s*$', suffix)):
            if len(line) <= LINE_LIMIT:
                try:
                    json.loads(line)
                except (ValueError, RecursionError):
                    return session_version
            elif envelope_timestamp(line, require_closed_envelope=True) is None:
                return session_version
        stamp = envelope_timestamp(line) if envelope_stamp is UNPARSED else envelope_stamp
        if stamp and (output_type is None or CODEX_OUTPUT_END.search(suffix)):
            try:
                if (stamp_time := friction_stamp(stamp)) is not None and stamp_time >= since:
                    entry = counts[session_version or "unknown"]
                    entry["records"] += 1
                    if output_type is not None and output_type not in known:
                        entry["unknown_records"] += 1
                        entry[("unknown_type", output_type)] += 1
            except (ValueError, TypeError, UnicodeError, OverflowError):
                pass
        return session_version
    try:
        if row is UNPARSED:
            row = json.loads(line)
        if not isinstance(row, dict):
            return session_version
        payload = row.get("payload") if isinstance(row.get("payload"), dict) else {}
        version = row.get("version") or row.get("cli_version") or (payload.get("cli_version") if codex else None)
        if isinstance(version, str) and re.fullmatch(r"[A-Za-z0-9._+-]{1,64}", version):
            session_version = version
        version = (session_version if codex else (version if isinstance(version, str) and re.fullmatch(r"[A-Za-z0-9._+-]{1,64}", version) else None)) or "unknown"
        timestamp = row.get("timestamp")
        if not isinstance(timestamp, str) or date_time(timestamp) < since:
            return session_version
        kind = row.get("type")
        entry = counts[version]
        entry["records"] += 1
        if not isinstance(kind, str) or kind not in known:
            entry["unknown_records"] += 1
            name = kind if isinstance(kind, str) and re.fullmatch(r"[A-Za-z0-9_.-]{1,40}", kind) else "<other>"
            entry[("unknown_type", name)] += 1
        if not codex and kind == "assistant":
            message = row.get("message")
            if isinstance(message, dict) and message.get("model") != "<synthetic>":
                usage = message.get("usage")
                if not isinstance(usage, dict) or not all(k in usage for k in ("input_tokens", "output_tokens")):
                    entry["missing_usage"] += 1
        if codex and kind == "event_msg" and payload.get("type") == "token_count":
            info = payload.get("info")
            usage = info.get("total_token_usage") if isinstance(info, dict) else None
            if not isinstance(usage, dict) or not all(k in usage for k in ("input_tokens", "output_tokens", "total_tokens")):
                entry["missing_usage"] += 1
    except (ValueError, TypeError, UnicodeError, OverflowError, RecursionError):
        pass
    return session_version


def canary_summary(counts):
    unknown = sum(c["unknown_records"] for c in counts.values())
    missing = sum(c["missing_usage"] for c in counts.values())
    versions = ",".join(sorted(counts)) or "none"
    return f"format_canary: v1 unknown_records={unknown} missing_usage={missing} cli={versions}"


def rows(path, since, warnings, keep_model=False, keep_tools=False, bounds=None, canary=None,
         keep_signals=False, keep_codex=False, admit=None, source=None):
    """Timestamp and record-type gates run before decoding large content."""
    cutoff = since.strftime("%Y-%m-%dT%H:%M:%S")
    saved_shape, saved_deltas, before_user = None, [], False
    saved_call = None
    last_prefix, last_timestamp, last_stamp = None, None, None
    session_version = None
    try:
        with (open_untrusted_transcript(path) if source is None else nullcontext(source)) as stream:
            first_row = None
            lines = stream
            if admit is not None:
                first_line = stream.readline(LINE_LIMIT)
                try:
                    first_row = json.loads(first_line)
                except (ValueError, RecursionError):
                    return
                if not admit(first_row):
                    return
                lines = chain((first_line,), stream)
            for line_number, line in enumerate(lines):
                prefix = line[:1024]
                decoded = UNPARSED
                tool = codex_tool_header(line, keep_codex) if keep_model and b'_call' in prefix else None
                output_type = tool[0].decode("ascii") if tool and tool[1] in CODEX_OUTPUT_TYPES else None
                tool_stamp = envelope_timestamp(line) if tool else None
                session_meta = keep_codex and b'"session_meta"' in prefix
                if canary is not None and (b'"timestamp"' in prefix or tool is not None):
                    stamp = TIMESTAMP.search(line)
                    if stamp:
                        value = (tool_stamp if keep_model and tool else
                                 stamp[1].decode("ascii", "replace"))
                        try:
                            recent = value is not None and (value[:19] >= cutoff if value.endswith(("Z", "+00:00"))
                                      else date_time(value) >= since)
                            if recent or (keep_model and b'"session_meta"' in prefix):
                                if not keep_model:
                                    decoded = json.loads(line)
                                session_version = canary_row(line, since, canary, keep_model, session_version,
                                                             output_type, decoded,
                                                             tool_stamp if tool else UNPARSED, bool(tool and tool[0] == b"response_item"))
                        except (ValueError, TypeError, OverflowError, RecursionError):
                            pass
                if (bounds is not None and last_stamp is not None and last_prefix is not None and line.startswith(last_prefix)
                        and keep_model and not keep_tools and not (tool or session_meta or CODEX_ROW.search(prefix))
                        and b'"model"' not in line):
                    continue
                if bounds is None and b'"timestamp"' not in prefix and not any(marker in line for marker in MARKERS):
                    if keep_signals and b'"tool_use"' in line:
                        warnings["malformed rows"] += 1
                    continue
                if bounds is not None:
                    if last_prefix is None or not line.startswith(last_prefix):
                        match = TIMESTAMP.search(prefix if tool else line)
                        outer_stamp = tool_stamp
                        if (tool and outer_stamp is None) or (not tool and not match):
                            if tool is not None and keep_codex:
                                outer, kind, fields = tool
                                yield dict(_codex_tool=(kind, *codex_call_row(line, kind, fields, outer == b"response_item")),
                                           timestamp=None)
                            continue
                        last_prefix = None if tool else line[:match.end()]
                        last_timestamp = outer_stamp if tool else match[1].decode("ascii", "replace")
                        try:
                            last_stamp = date_time(last_timestamp)
                        except (ValueError, TypeError, UnicodeError, OverflowError):
                            last_stamp = None
                        if last_stamp is not None:
                            if bounds[0] is None or last_stamp < bounds[0]:
                                bounds[0] = last_stamp
                            if bounds[1] is None or last_stamp > bounds[1]:
                                bounds[1] = last_stamp
                    if last_stamp is None:
                        warnings["malformed rows"] += 1
                        if tool is None or not keep_codex:
                            continue
                if tool is not None:
                    if keep_codex:
                        outer, kind, fields = tool
                        yield dict(_codex_tool=(kind, *codex_call_row(line, kind, fields, outer == b"response_item")),
                                   timestamp=last_stamp)
                    continue
                metadata = keep_tools and any(marker in prefix for marker in TOOL_METADATA)
                if keep_tools and not (metadata or b'"message"' in prefix or MESSAGE_ROW.search(prefix) or b'"usage"' in prefix
                                       or (keep_signals and b'"system"' in prefix and b'"informational"' in prefix)):
                    continue
                if keep_model and not (session_meta or b'"token_count"' in prefix or b'"user_message"' in prefix or b'"role":"user"' in prefix or b'"role": "user"' in prefix or b'"model"' in line or (bounds is not None and b'"turn_context"' in prefix)):
                    continue
                if bounds is not None:
                    timestamp = last_timestamp
                else:
                    signal_row = keep_signals and (b'"tool_use"' in line or b'"tool_result"' in line)
                    if signal_row:
                        timestamp = envelope_timestamp(line)
                        if timestamp is not None and (len(timestamp) > 40 or friction_stamp(timestamp) is None):
                            timestamp = None
                    else:
                        match = TIMESTAMP.search(line)
                        timestamp = match[1].decode("ascii", "replace") if match else None
                    if timestamp is None:
                        if signal_row:
                            # Missing and malformed tool timestamps still affect replay reconciliation.
                            warnings["malformed rows"] += 1
                            try:
                                row = json.loads(line) if decoded is UNPARSED else decoded
                                if isinstance(row, dict):
                                    yield dict(row, _invalid_friction_timestamp=True)
                            except (ValueError, RecursionError):
                                pass
                        continue
                try:
                    old = (timestamp[:19] < cutoff if timestamp.endswith(("Z", "+00:00"))
                           else date_time(timestamp) < since)
                    if old and keep_tools:
                        if b'"usage"' in line and b'"assistant"' in prefix:
                            try:
                                candidate = json.loads(line)
                                message = candidate.get("message") or {}
                                usage = message.get("usage") or {}
                                if (message.get("model") != "<synthetic>" and isinstance(usage, dict)
                                        and (context(usage) or usage.get("output_tokens"))):
                                    saved_call = (line, timestamp)
                            except (ValueError, TypeError, AttributeError):
                                pass
                        if metadata:
                            if b'"api-request-shape"' in prefix:
                                saved_shape = (line, timestamp)
                            else:
                                saved_deltas.append((line, timestamp))
                        elif (USER_ROW.search(line) and b'"tool_result"' not in line
                              and b'"isMeta":true' not in prefix and b'"isMeta": true' not in prefix
                              and b'<task-notification>' not in line):
                            before_user = True
                        continue
                    if old and not (keep_model and (session_meta or b'"model"' in line or b'"token_count"' in prefix or b'"user_message"' in prefix or b'"role":"user"' in prefix or b'"role": "user"' in prefix or (bounds is not None and b'"turn_context"' in prefix))):
                        continue
                    if keep_tools and (saved_shape or saved_deltas or before_user or saved_call):
                        for saved, ts in ([saved_shape] if saved_shape else []) + saved_deltas:
                            try:
                                yield dict(metadata_row(saved, ts), _before_window=True)
                            except (ValueError, UnicodeError):
                                warnings["malformed rows"] += 1
                        if saved_call:
                            try:
                                yield dict(json.loads(saved_call[0]), _before_window=True)
                            except (ValueError, UnicodeError):
                                warnings["malformed rows"] += 1
                            saved_call = None
                        if before_user:
                            yield dict(type="user", message={}, _before_window=True)
                        saved_shape, saved_deltas, before_user = None, [], False
                    row = (metadata_row(line, timestamp) if metadata else
                           first_row if line_number == 0 and first_row is not None else
                           decoded if decoded is not UNPARSED else json.loads(line))
                    if isinstance(row, dict):
                        if old:
                            row["_before_window"] = True
                        yield row
                except (ValueError, TypeError, UnicodeError):
                    warnings["malformed rows"] += 1
    except (OSError, ValueError):
        warnings["unreadable files"] += 1


def context(usage):
    return sum(usage.get(key, 0) or 0 for key in (
        "input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))



CACHE_BUCKETS = ("first", "unknown", "le_5m", "gt_5m_le_60m", "gt_60m")


def cache_bucket(previous, current, first=False):
    if current is None or (previous is None and not first):
        return "unknown"
    if previous is None:
        return "first"
    seconds = (current - previous).total_seconds()
    if seconds < 0:
        return "unknown"
    return "le_5m" if seconds <= 300 else "gt_5m_le_60m" if seconds <= 3600 else "gt_60m"


def cache_add(groups, bucket, write, ctx):
    entry = groups[bucket]
    entry.update(writes=1, write_tokens=write, full_rewrites=int(ctx > 0 and write * 5 >= ctx * 4))

def empty_synthetic(message, usage):
    """Claude Code writes zero-usage <synthetic> assistant rows; they are not model calls."""
    return message.get("model") == "<synthetic>" and not (context(usage) or usage.get("output_tokens"))


def add(counter, usage):
    ctx = context(usage)
    counter.update(calls=1, context=ctx, cache_read=usage.get("cache_read_input_tokens", 0) or 0,
                   cache_write=usage.get("cache_creation_input_tokens", 0) or 0,
                   output=usage.get("output_tokens", 0) or 0)
    counter["peak"] = max(counter["peak"], ctx)


def codex_delta(previous, usage):
    """Turn cumulative Codex totals into (delta since `previous`, current numeric totals).

    A decrease in the input, output or total tokens means the counter was reset, so the
    delta is the current value. Used by token-audit and usage-series.
    """
    current = {key: value for key, value in usage.items() if isinstance(value, (int, float))}
    if any(current.get(key, 0) < previous.get(key, 0) for key in ("input_tokens", "output_tokens", "total_tokens")):
        return dict(current), current
    return {key: max(0, value - previous.get(key, 0)) for key, value in current.items()}, current


def image_count(content):
    if isinstance(content, dict):
        return int(content.get("type") == "image") + sum(image_count(v) for v in content.values())
    if isinstance(content, list):
        return sum(map(image_count, content))
    return 0


def bash_head(command, words_limit=2):
    segments = [part.strip() for part in re.split(r"&&|;|\n|\|", command) if part.strip()]
    for segment in segments:
        try:
            words = shlex.split(segment)
        except ValueError:
            words = segment.split()
        if not words or words[0] in ("cd", "export", "set"):
            continue
        while words and ASSIGNMENT.match(words[0]):
            words.pop(0)
        if words and words[0] in ("cd", "export", "set"):
            continue
        if words:
            return redact(" ".join(words[:words_limit]))[:40]
    return "(cd/vars only)"


def blocks(message):
    content = message.get("content")
    return [item for item in content if isinstance(item, dict)] if isinstance(content, list) else []


def load_pricing(path):
    try:
        value = json.loads(path.read_text())
        if not isinstance(value.get("models"), dict) or not isinstance(value.get("aliases", {}), dict):
            raise ValueError("expected models and aliases objects")
        return value, None
    except (OSError, ValueError, AttributeError) as exc:
        return {}, f"Pricing file unavailable: {path} ({exc})"


PRICING_MAX_AGE_DAYS = 60


def pricing_age_warning(pricing, today):
    """One line when pricing.json source.checked is over 60 days old; None if missing or unparsable."""
    source = pricing.get("source")
    checked = source.get("checked") if isinstance(source, dict) else None
    try:
        age = (today.date() - datetime.strptime(checked, "%Y-%m-%d").date()).days
    except (TypeError, ValueError):
        return None
    if age > PRICING_MAX_AGE_DAYS:
        return f"Pricing last checked {checked} ({age} days before this audit); rates may be out of date."
    return None


# A key or alias matches a model id only if the rest is empty, a dated snapshot
# (-YYYYMMDD) and/or a bracketed suffix such as [1m]. Newer minor versions stay unpriced.
MODEL_SUFFIX = re.compile(r"(?:-\d{8})?(?:\[[^\]]*\])?")


def pricing_key(pricing, model):
    models, aliases = pricing.get("models", {}), pricing.get("aliases", {})
    if model in models:
        return model
    matching = [name for name in (*models, *aliases) if model.startswith(name)
                and MODEL_SUFFIX.fullmatch(model, len(name))]
    if not matching:
        return None
    name = max(matching, key=len)
    key = name if name in models else aliases[name]
    return key if key in models else None


def price(data, model, agent, usage, codex=False):
    pricing = data["_pricing"]
    key = pricing_key(pricing, model)
    rates = pricing.get("models", {}).get(key)
    if codex:
        cached = usage.get("cached_input_tokens", 0) or 0
        output = usage.get("output_tokens", 0) or 0
        # Codex normally reports reasoning as a subset of output. Only add it
        # when the billed total explicitly places it outside output_tokens.
        extra = max(0, (usage.get("total_tokens", 0) or 0) - (usage.get("input_tokens", 0) or 0) - output)
        output += min(extra, usage.get("reasoning_output_tokens", 0) or 0)
        tokens = dict(uncached_input=max(0, (usage.get("input_tokens", 0) or 0) - cached),
                      cache_read=cached, cache_write_5m=0, cache_write_1h=0, output=output)
    else:
        breakdown = usage.get("cache_creation") or {}
        write = usage.get("cache_creation_input_tokens", 0) or 0
        hour = min(write, breakdown.get("ephemeral_1h_input_tokens", 0) or 0)
        tokens = dict(uncached_input=usage.get("input_tokens", 0) or 0,
                      cache_read=usage.get("cache_read_input_tokens", 0) or 0,
                      cache_write_5m=write - hour, cache_write_1h=hour,
                      output=usage.get("output_tokens", 0) or 0)
    if not any(tokens.values()):
        return 0
    if rates is None:
        data["cost"]["unpriced"].setdefault(model, Counter()).update(tokens)
        return 0
    threshold = rates.get("over_threshold")
    if not codex and threshold and context(usage) >= threshold["prompt_tokens"]:
        rates = dict(rates, **threshold)
    components = Counter()
    for component, count in tokens.items():
        rate = "input" if component == "uncached_input" else component
        if codex and component == "cache_read":
            rate = "cached_input"
        group = "cache_write" if component.startswith("cache_write") else component
        components[group] += count * rates.get(rate, 0) / 1000000
    cost = sum(components.values())
    data["cost"]["components"].update(components)
    data["cost"]["by_model"][model] += cost
    data["cost"]["by_agent"][agent] += cost
    data["cost"]["total"] += cost
    return cost


def redact(text):
    return SECRET.sub("[redacted]", str(text))


def result_text(content):
    if isinstance(content, list):
        return "\n".join(str(b.get("text", "")) for b in content if isinstance(b, dict))
    return str(content or "")


def error_line(content):
    text = next((line.strip() for line in result_text(content).splitlines()
                 if line.strip() and not EXIT_HEADER.match(line.strip())), "(empty error)")
    text = redact(text)
    text = re.sub(r"/(?:private/)?(?:tmp|var/folders)/[^\s:]+", "<tmp>", text)
    text = re.sub(r"\b(?:0x[0-9a-f]+|[0-9a-f]{8,}(?:-[0-9a-f]+)*)\b", "<id>", text, flags=re.I)
    return re.sub(r"\d+", "#", text)


def signature_text(signature):
    tool, target, code, error = signature
    return f"{tool} {redact(target)}" + (f" [exit {code}]" if code is not None else "") + f": {redact(error)[:120]}"


def command_info(command):
    env, cwd, words = [], "", []
    for segment in re.split(r"&&|;|\n|\|", command):
        try:
            words = shlex.split(segment)
        except ValueError:
            return None
        if not words:
            continue
        if words[0] == "cd":
            cwd = words[1] if len(words) == 2 else cwd
            continue
        if words[0] == "export":
            env.extend(w for w in words[1:] if ASSIGNMENT.match(w))
            continue
        while words and ASSIGNMENT.match(words[0]):
            env.append(words.pop(0))
        if words and words[0] == "env":
            words.pop(0)
            while words and ASSIGNMENT.match(words[0]):
                env.append(words.pop(0))
        if words:
            break
    if not words or Path(words[0]).name in SHELL_NO_HINT:
        return None
    launcher, offset = "direct", 0
    first = Path(words[0]).name
    if first.startswith("python") and len(words) > 2 and words[1] == "-m":
        launcher, offset = " ".join(words[:2]), 2
    elif first in ("uv", "poetry") and len(words) > 2 and words[1] == "run":
        launcher, offset = first + " run", 2
    elif first in ("npx", "uvx") and len(words) > 1 and not words[1].startswith("-"):
        launcher, offset = first, 1
    elif "/node_modules/.bin/" in words[0]:
        launcher = "node_modules/.bin"
    elif first.startswith("python") and len(words) > 1 and not words[1].startswith("-"):
        launcher, offset = first, 1
    target = Path(words[offset]).name
    subcommand = words[offset + 1] if target == "git" and len(words) > offset + 1 else ""
    head = " ".join(words[:offset + 1] if offset else words[:2])
    if env:
        head = " ".join(env) + " " + head
    if cwd:
        head = "cd " + cwd + " && " + head
    return dict(program=target, launcher=launcher, env=tuple(sorted(env)), cwd=cwd,
                subcommand=subcommand, head=redact(head)[:120])


def plausible_fix(failure, success):
    return (failure and success and failure["program"] == success["program"]
            and failure["subcommand"] == success["subcommand"]
            and any(failure[k] != success[k] for k in ("launcher", "env", "cwd")))


def benign_exit(head, code):
    words = head.split()
    if not words:
        return False
    name = Path(words[0]).name
    key = "sed -n" if name == "sed" and len(words) > 1 and words[1] == "-n" else name
    return code in BENIGN_EXITS.get(key, ())


def tool_metadata(row, session):
    definitions = (row.get("shape") or {}).get("tools") if row.get("type") == "api-request-shape" else None
    if isinstance(definitions, list):
        session["known"] = True
        for tool in definitions:
            if isinstance(tool, dict) and tool.get("name"):
                session["available"].add(tool["name"])
                session["loading"][tool["name"]].add("deferred" if tool.get("defer_loading") else "loaded in full")
    attachment = row.get("attachment") or {}
    if attachment.get("type") == "deferred_tools_delta":
        session["known"] = True
        for name in attachment.get("addedNames", []) + attachment.get("readdedNames", []):
            session["available"].add(name)
            session["loading"][name].add("deferred")
        for tool in attachment.get("surfacedDefinitions", []):
            if isinstance(tool, dict) and tool.get("name"):
                session["available"].add(tool["name"])
                session["loading"][tool["name"]].add("loaded in full")
    if attachment.get("type") == "mcp_instructions_delta":
        session["servers"].update(attachment.get("addedNames", []))


def finish_turn(turn, project, session_id, agent, data):
    if turn is None or not turn["active"]:
        return
    stuck = data["stuck_turns"]
    stuck["turns"] += 1
    data["_agent_turns"][agent] += 1
    failures = Counter(event[0] for event in turn["failures"])
    flagged = [(signature, count) for signature, count in failures.items() if count >= data["_options"]["stuck_repeats"]]
    if flagged:
        stuck["flagged_turns"] += 1
        data["_agent_flagged"][agent] += 1
        stuck["tool_calls"] += turn["calls"]
        stuck["cost"] += turn["cost"]
        for signature, count in flagged:
            stuck["signatures"].append(dict(project=project, agent=agent, repeats=count,
                                             session=session_id, signature=signature_text(signature), _turn=stuck["turns"]))
    for signature, head, order in turn["failures"]:
        fact = data["_failures"][(project, signature)]
        fact["sessions"].add(session_id)
        fact["occurrences"] += 1
        if fact["worked_instead"]:
            continue
        # The next call on this program must succeed nearby; unrelated later
        # commands and changes of flags/subcommands do not establish a fix.
        for later, (candidate, outcome) in sorted(turn["bash_calls"].items()):
            if later <= order or later > order + 3 or not candidate or not head:
                continue
            if candidate["program"] == head["program"]:
                if outcome is True and plausible_fix(head, candidate):
                    fact["worked_instead"].add(candidate["head"])
                break


def friction_signature(command):
    # Only emit fixed vocabulary. Executable names, script names, and arguments
    # can all contain private data, even after path and secret redaction.
    if isinstance(command, str):
        for segment in re.split(r"&&|[;\n|]", command[:1024]):
            words = segment.split()
            while words and (ASSIGNMENT.match(words[0]) or
                             words[0] in ("time", "nohup", "nice", "command", "exec")):
                words.pop(0)
            if not words or words[0] in ("cd", "export", "set"):
                continue
            program = words[0].strip("\"'").replace("\\", "/").rsplit("/", 1)[-1]
            if program in SHELL_VERBS:
                verb = words[1] if len(words) > 1 else ""
                return program + " " + verb if verb in SHELL_VERBS[program].split() else program
            if program in ("python", "python3"):
                return "python -m unittest" if words[1:3] == ["-m", "unittest"] else "python"
            if program in SHELL_PROGRAMS:
                return program
            break
    return "(shell)"


@lru_cache(maxsize=256)
def friction_stamp(stamp):
    try:
        return date_time(stamp)
    except (ValueError, OverflowError):
        return None


REPLAY_ENCODER = json.JSONEncoder(separators=(",", ":"))


def replay_fingerprint(value):
    # Encode the full value so both element boundaries and trailing changes matter.
    encoded = REPLAY_ENCODER.encode(value).encode("ascii")
    digest = hashlib.sha256(len(encoded).to_bytes(8, "big"))
    digest.update(encoded)
    return digest.digest()


def permission_observation(state, key, row, block, start, result_count):
    # Evidence is limited to explicitly selected, canonical cwd members.
    if not state["cwd"]:
        return
    raw = row.get("cwd")
    root = None
    if isinstance(raw, str) and os.path.isabs(raw):
        try:
            candidate = str(Path(raw).resolve())
            if candidate in state["cwd"]:
                root = candidate
        except (OSError, ValueError, RuntimeError):
            pass
    if start:
        tool_input = block.get("input")
        command = tool_input.get("command") if isinstance(tool_input, dict) else None
        if block.get("name") != "Bash" or command not in ("ls", "ls -a", "ls -l"):
            return
    observations = state["permissions"]
    if key not in observations:
        if len(observations) >= FRICTION_PAIR_LIMIT:
            state["capped"] = True
            return
        observations[key] = [set(), set()]
    if start:
        tool_input = block.get("input")
        command = tool_input.get("command") if isinstance(tool_input, dict) else None
        literal = command if block.get("name") == "Bash" and command in ("ls", "ls -a", "ls -l") else None
        value = (root, literal, replay_fingerprint(block))
    else:
        decision = row.get("permissionDecision")
        decision = decision if isinstance(decision, dict) else {}
        source, outcome = decision.get("source"), decision.get("decision")
        trusted = source in ("user", "user_permanent")
        single = result_count == 1
        status = ("denied" if trusted and outcome == "reject" and single else
                  "accepted" if trusted and outcome == "accept" and single
                  and isinstance(row.get("toolUseResult"), dict)
                  and (type(row["toolUseResult"].get("durationMs")) in (int, float)
                       and row["toolUseResult"]["durationMs"] >= 0
                       or any(isinstance(row["toolUseResult"].get(k), str) for k in ("stdout", "stderr")))
                  and row["toolUseResult"].get("interrupted") is not True
                  and block.get("is_error") is not True else "ambiguous")
        fingerprint = replay_fingerprint([block, row.get("permissionDecision"),
                                          row.get("toolUseResult"), row.get("uuid")])
        value = (root, status, fingerprint)
    # A conflicting replay remains ambiguous without retaining private text.
    slot = observations[key][0 if start else 1]
    if len(slot) < 16:
        slot.add(value)
    elif value not in slot:
        state["capped"] = True


def permission_rows(state):
    counts = defaultdict(Counter)
    for key, (starts, results) in state["permissions"].items():
        attributed = {(root, literal) for root, literal, _ in starts if root and literal}
        for root, literal in attributed:
            matching = {status for result_root, status, _ in results if result_root == root}
            pair = state["pairs"].get(key)
            valid = pair is not None and None not in pair and pair[1][0] >= pair[0][0]
            status = (next(iter(matching)) if valid and len(starts) == 1 and len(results) == 1
                      and len(matching) == 1 else "ambiguous")
            counts[(root, literal)][status] += 1
    return [dict(cwd_id=hashlib.sha256(root.encode()).hexdigest(), literal=literal,
                 accepted=count["accepted"], denied=count["denied"], ambiguous=count["ambiguous"])
            for (root, literal), count in sorted(counts.items())]


def friction_block(state, row, block, start, result_count=0, row_event=None, trusted_source=False):
    if row.get("type") != ("assistant" if start else "user"):
        return
    session_id = row.get("sessionId")
    tool_id = block.get("id" if start else "tool_use_id")
    if not (isinstance(session_id, str) and 0 < len(session_id) <= 256 and
            isinstance(tool_id, str) and 0 < len(tool_id) <= 256):
        return
    ts = row.get("timestamp")
    stamp = friction_stamp(ts) if isinstance(ts, str) and len(ts) <= 40 else None
    if stamp is not None and stamp > state["until"]:
        return
    key = (session_id, tool_id)
    pairs = state["pairs"]
    if key not in pairs:
        if len(pairs) >= FRICTION_PAIR_LIMIT:
            state["capped"] = True
            return
        pairs[key] = [None, None]
    pair = pairs[key]
    if pair is None and not trusted_source:
        return
    if stamp is None or stamp < state["since"]:
        if stamp is None:
            state["warnings"]["malformed rows"] += 1
        pairs[key] = None
        if trusted_source:
            state["trusted_pairs"][key] = None
        return
    if trusted_source:
        permission_observation(state, key, row, block, start, result_count)
    row_id = row.get("uuid") or (row["message"].get("id") if start else None)
    identity = row_id if isinstance(row_id, str) and 0 < len(row_id) <= 256 else None
    if start:
        name, tool_input = block.get("name"), block.get("input")
        tool_input = tool_input if isinstance(tool_input, dict) else {}
        command = tool_input.get("command") if name == "Bash" else None
        signature = friction_signature(command) if name == "Bash" else name if name in TIMED_TOOLS else "(tool)"
        skipped = name in UNTIMED_TOOLS or tool_input.get("run_in_background") is True
        # Keep only a fingerprint for conflict detection, including starts whose
        # private arguments collapse to the same public signature.
        fingerprint = replay_fingerprint([name, tool_input])
        value = (stamp, identity, signature, skipped, fingerprint, name, is_polling(command))
    else:
        details = row.get("toolUseResult")
        details = details if isinstance(details, dict) else {}
        decision = row.get("permissionDecision")
        source = decision.get("source") if isinstance(decision, dict) else None
        prompted = isinstance(source, str) and source.startswith("user")
        duration = details.get("durationMs")
        # Row-level duration is attributable only when exactly one result owns it.
        measured = (duration / 1000 if type(duration) in (float, int)
                    and 0 <= duration <= MAX_TIMING_MS
                    and result_count == 1
                    else None)
        result = block.get("content")
        result_hash = replay_fingerprint(result)
        text = result_text(result)[:2000] if block.get("is_error") is True else ""
        timeout = details.get("timedOutAfterMs")
        timeout = type(timeout) is int and timeout >= 0
        hint = bool(re.search(r"\bos error 60\b", text, re.I))
        exit_match = EXIT_HEADER.match(text.partition("\n")[0].strip())
        hint = hint or bool(exit_match and int(exit_match[1]) in (124, 137, 143))
        lock = bool(re.search(r"\b(?:could not (?:get|acquire) (?:the )?lock|unable to acquire (?:the )?lock|waiting for (?:the )?lock)\b", text, re.I))
        value = (stamp, identity, measured, prompted, bool(details.get("backgroundTaskId")),
                 result_hash, block.get("is_error") is True,
                 timeout, hint, details.get("interrupted") is True, lock, row_event)
    slot = 0 if start else 1
    # Retain both observations until the scan ends, so later replayed rows can
    # invalidate an otherwise plausible but conflicting pair.
    if pair is not None:
        if pair[slot] is None:
            pair[slot] = value
        elif pair[slot] != value:
            pairs[key] = None
    if trusted_source:
        trusted = state["trusted_pairs"].setdefault(key, [None, None])
        if trusted is not None:
            if trusted[slot] is None:
                trusted[slot] = value
            elif trusted[slot] != value:
                state["trusted_pairs"][key] = None


SAMPLE_MAX_BYTES = 50 * 1024 * 1024
SAMPLE_MAX_ROWS = 100000
SAMPLE_MAX_DAYS = 64
SAMPLE_JOIN_SECONDS = 5


def default_samples_dir():
    return Path(os.environ.get("AUDIT_DIR") or claude_home() / "audits").expanduser() / "samples"


def trusted_audit_directory(stack, path, check_acl=None):
    path = path.absolute()
    if ".." in path.parts:
        raise ValueError("audit path traversal")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_NONBLOCK
    fd = os.open(path.anchor, flags)
    stack.callback(os.close, fd)
    for part in path.parts:
        if part != path.anchor:
            fd = os.open(part, flags, dir_fd=fd)
            stack.callback(os.close, fd)
        info = os.fstat(fd)
        if (info.st_uid not in (0, os.geteuid()) or
                info.st_mode & 0o022 and not info.st_mode & stat.S_ISVTX):
            raise ValueError("unsafe audit ancestor")
        if check_acl is not None and check_acl(fd):
            raise ValueError("unsafe audit ancestor ACL")
    return fd


@lru_cache(maxsize=1)
def sample_reader():
    spec = importlib.util.spec_from_file_location("kaizen_sample_reader",
        Path(__file__).resolve().with_name("kaizen_friction_sample.py"))
    helper = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(helper)
    return helper


def has_allow_acl(fd):
    """Deny-only Darwin ACLs cannot grant write access to another user."""
    libc = ctypes.CDLL(None, use_errno=True)
    get_acl = libc.acl_get_fd_np
    get_acl.argtypes = (ctypes.c_int, ctypes.c_int)
    get_acl.restype = ctypes.c_void_p
    libc.acl_free.argtypes = (ctypes.c_void_p,)
    libc.acl_get_entry.argtypes = (ctypes.c_void_p, ctypes.c_int, ctypes.POINTER(ctypes.c_void_p))
    libc.acl_get_tag_type.argtypes = (ctypes.c_void_p, ctypes.POINTER(ctypes.c_int))
    acl = get_acl(fd, 0x100)
    if not acl:
        error = ctypes.get_errno()
        if error != errno.ENOENT:
            raise OSError(error, "cannot verify transcript ACL")
        return False
    try:
        entry = ctypes.c_void_p()
        index = 0
        while True:
            result = libc.acl_get_entry(acl, index, ctypes.byref(entry))
            if result != 0:
                if index == -1 and ctypes.get_errno() == errno.EINVAL:
                    return False
                raise OSError(ctypes.get_errno(), "cannot inspect transcript ACL")
            tag = ctypes.c_int()
            if libc.acl_get_tag_type(entry, ctypes.byref(tag)) != 0:
                raise OSError(ctypes.get_errno(), "cannot inspect transcript ACL tag")
            if tag.value != 2:  # ACL_EXTENDED_DENY; unknown tags fail closed.
                return True
            index = -1  # ACL_NEXT_ENTRY
    finally:
        libc.acl_free(acl)


def open_untrusted_transcript(path):
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_NONBLOCK", 0))
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise ValueError("not a regular transcript")
        return os.fdopen(fd, "rb")
    except BaseException:
        os.close(fd)
        raise


def open_permission_transcript(path):
    check_acl = has_allow_acl if sys.platform == "darwin" else None
    with ExitStack() as stack:
        directory = trusted_audit_directory(stack, path.parent, check_acl)
        fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
        try:
            info = os.fstat(fd)
            if (not stat.S_ISREG(info.st_mode) or info.st_uid not in (0, os.geteuid())
                    or info.st_mode & 0o022 or (check_acl is not None and check_acl(fd))):
                raise ValueError("unsafe permission transcript")
            return os.fdopen(fd, "rb")
        except BaseException:
            os.close(fd)
            raise


def read_samples(directory, since, warnings, until=None):
    """Pin private storage, then read only bounded UTC days; never create storage."""
    result = dict(events={}, load=[], procs=[], hours=set(), skipped_days=set())
    until = until or datetime.now(timezone.utc)
    if not hasattr(os, "O_NOFOLLOW") or not hasattr(os, "geteuid"):
        return result
    try:
        with ExitStack() as stack:
            fd = trusted_audit_directory(stack, Path(directory).expanduser())
            info = os.fstat(fd)
            if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
                raise ValueError("unsafe sample directory")
            helper = sample_reader()
            if sys.platform == "darwin" and helper.has_extended_acl(fd):
                raise ValueError("sample ACL")
            first = since.astimezone(timezone.utc).date().isoformat()
            last = (until.astimezone(timezone.utc) + timedelta(seconds=SAMPLE_JOIN_SECONDS)).date().isoformat()
            paths = []
            with os.scandir(fd) as entries:
                for count, entry in enumerate(entries):
                    if count >= 4096:
                        raise ValueError("sample directory limit")
                    if re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}\.tsv", entry.name) and first <= entry.name[:10] <= last:
                        paths.append(entry.name)
            if len(paths) > SAMPLE_MAX_DAYS:
                raise ValueError("sample day limit")
            remaining, rows = SAMPLE_MAX_BYTES, SAMPLE_MAX_ROWS
            for name in sorted(paths):
                day = name[:10]
                try:
                    child = os.open(day + ".tsv", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
                    try:
                        if not stat.S_ISREG(os.fstat(child).st_mode):
                            raise ValueError("not a regular sample file")
                        stream = os.fdopen(child, "rb")
                    except BaseException:
                        os.close(child)
                        raise
                    with stream:
                        size = helper.file_info(fd, day + ".tsv", stream.fileno()).st_size
                        if sys.platform == "darwin" and helper.has_extended_acl(stream.fileno()):
                            raise ValueError("sample ACL")
                        if size > 5 * 1024 * 1024 or size > remaining:
                            raise ValueError("sample byte limit")
                        remaining -= size
                        oversized = False
                        while size > 0:
                            raw = stream.readline(min(4097, size))
                            if not raw:
                                break  # Retention/truncation raced the pinned file.
                            size -= len(raw)
                            rows -= 1
                            if rows < 0 or len(result["events"]) >= FRICTION_PAIR_LIMIT:
                                warnings["sample limits"] += 1
                                result["events"].clear()  # Unseen conflicts cannot validate a join.
                                return result
                            if oversized:
                                oversized = not raw.endswith(b"\n")
                                continue
                            try:
                                if len(raw) > 4096 or not raw.endswith(b"\n"):
                                    oversized = not raw.endswith(b"\n")
                                    raise ValueError("incomplete sample")
                                fields = raw.decode("ascii").rstrip("\n").split("\t")
                                proc = fields[0] == "P"
                                if not (5 <= len(fields) <= 14 if proc else len(fields) == 6):
                                    raise ValueError("sample fields")
                                ms, load, cpu = (fields[1], fields[2], fields[3]) if proc else (fields[0], fields[4], fields[5])
                                if not re.fullmatch(r"[0-9]{1,16}", ms):
                                    raise ValueError("sample timestamp")
                                epoch = int(ms) / 1000
                                if not since.timestamp() <= epoch <= until.timestamp():
                                    continue
                                if datetime.fromtimestamp(epoch, timezone.utc).date().isoformat() != day:
                                    raise ValueError("sample day")
                                if len(load) > 32 or proc and (not load or not cpu):
                                    raise ValueError("sample load")
                                ratio = float(load) if load else None
                                cores = int(cpu) if re.fullmatch(r"[0-9]{1,8}", cpu) else None
                                if ((ratio is not None and (not math.isfinite(ratio) or ratio < 0)) or
                                        (cpu and (cores is None or not 1 <= cores <= 65536))):
                                    raise ValueError("sample load")
                                metric = (epoch, ratio / cores, cores) if ratio is not None and cores else None
                                if proc:
                                    if any(not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", name) for name in fields[4:]):
                                        raise ValueError("process name")
                                    result["procs"].append((epoch, fields[4:]))
                                else:
                                    session, tool, duration = fields[1:4]
                                    if any(not re.fullmatch(r"[A-Za-z0-9_-]{0,64}", value) for value in (session, tool)):
                                        raise ValueError("sample IDs")
                                    if duration and (not re.fullmatch(r"[0-9]{1,32}", duration) or int(duration) >= MAX_TIMING_MS):
                                        raise ValueError("sample duration")
                                    if session and tool:
                                        key = (session, tool)
                                        value = (epoch, int(duration) / 1000 if duration else None, metric)
                                        if result["events"].setdefault(key, value) != value:
                                            result["events"][key] = None
                                if metric:
                                    result["load"].append(metric)
                                result["hours"].add(int(epoch // 3600))
                            except (ValueError, OverflowError, UnicodeError):
                                warnings["malformed samples"] += 1
                except FileNotFoundError:
                    continue  # Missing days and retention races are normal.
                except (OSError, ValueError):
                    warnings["skipped sample files"] += 1
                    result["skipped_days"].add(day)
    except FileNotFoundError:
        pass
    except (OSError, ValueError, ImportError, AttributeError):
        warnings["unavailable samples"] += 1
    return result


def host_load_summary(samples):
    if not samples["load"] and not samples["procs"]:
        return None
    try:
        path = Path(__file__).resolve().with_name("kaizen-friction-catalog.json")
        with (path if path.is_file() else path.with_name("friction-catalog.json")).open("rb") as stream:
            raw = stream.read(65537)
        catalog = json.loads(raw)["processes"] if len(raw) <= 65536 else {}
        patterns = {category: spec["names"] for category, spec in list(catalog.items())[:32]}
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        patterns = {}
    hits = Counter()
    for _, names in {stamp: names for stamp, names in samples["procs"]}.items():
        hits.update(category for category, globs in patterns.items()
                    if any(fnmatch.fnmatchcase(name.lower(), pattern.lower()) for name in names for pattern in globs))
    hours = len(samples["hours"])
    return dict(samples=len(set(samples["load"])), sampled_hours=hours,
                process_hits={category: dict(hits=count, per_hour=round(count / hours, 2) if hours else 0)
                              for category, count in sorted(hits.items())})


def median_load_ratio(samples, intervals, minimum=3):
    # Unique timestamps prevent duplicates or simultaneous hooks inflating evidence.
    merged = []
    for start, end in sorted(intervals):
        if merged and start <= merged[-1][1]:
            merged[-1] = (merged[-1][0], max(end, merged[-1][1]))
        else:
            merged.append((start, end))
    values, index = {}, 0
    for stamp, ratio, cpu in sorted(set(samples)):
        while index < len(merged) and merged[index][1] < stamp:
            index += 1
        if index < len(merged) and merged[index][0] <= stamp <= merged[index][1]:
            values.setdefault(stamp, set()).add((ratio, cpu))
    if any(len(value) != 1 for value in values.values()):
        return None
    points = [next(iter(value)) for value in values.values()]
    return (statistics.median(ratio for ratio, _ in points)
            if len(points) >= minimum and len({cpu for _, cpu in points}) == 1 else None)


def friction_basis(measured, estimated):
    return "mixed" if measured and estimated else "measured" if measured else "row_gap" if estimated else "none"


def is_polling(command):
    return isinstance(command, str) and bool(re.search(
        r"(?:^|&&|[;\n|])\s*sleep\s+\d|\b(?:while|until|for)\b[^\n]*\bsleep\s+", command[:1024]))


def timeline_call(calls, start, end, seconds, signature, measured, poll=False, session=None):
    # Timing duration and occupancy are different evidence. A measured wall time
    # is anchored at the result, bounded by the paired timestamps. Row gaps can
    # include time outside execution and must not inflate measured waiting.
    if measured:
        start = end - timedelta(seconds=min(seconds, (end - start).total_seconds()))
    if len(calls) < FRICTION_PAIR_LIMIT and end > start:
        calls.append((start.timestamp(), end.timestamp(), seconds, signature,
                      "measured" if measured else "row_gap", poll, session))


def contention_intervals(occupancy, local_intervals, local_ends):
    intervals = []
    for start, end in occupancy:
        j = bisect.bisect_right(local_ends, start)
        while j < len(local_intervals):
            local_start, local_end = local_intervals[j]
            if local_start >= end:
                break
            intervals.append((max(start, local_start), min(end, local_end)))
            j += 1
    return intervals


def heavy_timeline(calls, thresholds, samples=(), local_calls=()):
    groups = defaultdict(list)
    local_counts = Counter(local_calls)
    for call in calls:
        if not call[5] and call[2] > 0:
            groups[(call[3], call[4])].append(call)
    heavy = {key for key, group in groups.items() if len(group) >= 3
             and statistics.median(call[2] for call in group) >= thresholds["heavy_seconds"]}
    ordered = sorted(call for key in heavy for call in groups[key])
    active, unmarked, overlapped = [], set(), set()
    peak = 0
    for ident, call in enumerate(ordered):
        while active and active[0][0] <= call[0]:
            _, expired = heapq.heappop(active)
            unmarked.discard(expired)
        if active:
            overlapped.add(ident)
            overlapped.update(unmarked)
            unmarked.clear()
        else:
            unmarked.add(ident)
        heapq.heappush(active, (call[1], ident))
        peak = max(peak, len(active))
    cohorts = defaultdict(lambda: ([], []))
    over_groups = defaultdict(list)
    for ident, call in enumerate(ordered):
        cohorts[(call[3], call[4])][0 if ident in overlapped else 1].append(call[2])
        if ident in overlapped:
            over_groups[(call[3], call[4])].append(call)
    # Only local calls can establish that a local load sample describes the overlap.
    local_events = Counter()
    for call in ordered:
        if local_counts[call]:
            local_counts[call] -= 1
            local_events[call[0]] += 1
            local_events[call[1]] -= 1
    local_counts = Counter(local_calls)
    active, previous, local_intervals = 0, None, []
    for stamp, delta in sorted(local_events.items()):
        if active >= 2 and previous is not None:
            if local_intervals and local_intervals[-1][1] == previous:
                local_intervals[-1] = (local_intervals[-1][0], stamp)
            else:
                local_intervals.append((previous, stamp))
        active += delta
        previous = stamp
    local_ends = [interval[1] for interval in local_intervals]
    contention = []
    for (signature, basis), (over, alone) in sorted(cohorts.items()):
        ratio = None
        if len(over) >= 3 and len(alone) >= 3 and statistics.median(alone) > 0:
            ratio = statistics.median(over) / statistics.median(alone)
        cohort = over_groups[(signature, basis)]
        # Merge cohort occupancy before intersecting: expanding each call against
        # every overlap segment uses quadratic memory for staggered calls.
        occupancy = []
        local_cohort = cohort and not (Counter(cohort) - local_counts)
        for c in cohort if local_cohort else ():
            if occupancy and c[0] <= occupancy[-1][1]:
                occupancy[-1] = (occupancy[-1][0], max(occupancy[-1][1], c[1]))
            else:
                occupancy.append((c[0], c[1]))
        intervals = contention_intervals(occupancy, local_intervals, local_ends) if local_cohort else ()
        load = median_load_ratio(samples, intervals) if local_cohort else None
        status = "insufficient" if ratio is None else "unconfirmed" if ratio >= 1.5 else "ok"
        if ratio is not None and ratio >= 1.5 and load is not None:
            status = "flagged" if load >= 0.8 else "ok"
        contention.append(dict(signature=signature, basis=basis, overlapped_n=len(over), alone_n=len(alone),
                               ratio=round(ratio, 3) if ratio is not None else None, status=status))
    events = Counter()
    for call in ordered:
        events[call[0]] += 1
        events[call[1]] -= 1
    active, previous, intervals = 0, None, []
    for stamp, delta in sorted(events.items()):
        if active >= 2 and previous is not None:
            intervals.append((previous, stamp))
        active += delta
        previous = stamp
    over_calls = [c for i, c in enumerate(ordered) if i in overlapped]
    load = median_load_ratio(samples, intervals) if over_calls and not (Counter(over_calls) - local_counts) else None
    status = "unconfirmed" if peak >= 2 else "ok"
    cpus = {cpu for _, _, cpu in samples}
    if load is not None and len(cpus) == 1 and (peak > 3 or peak > next(iter(cpus)) / 2):
        status = "flagged" if load >= 0.8 else "ok"
    return contention, dict(peak=peak, status=status, load_ratio_median=load)


def polling_summary(calls, slow_seconds):
    # Merge waiting intervals within each session so fan-out cannot multiply wait.
    siblings = defaultdict(lambda: ([], []))
    for start, end, seconds, _, _, poll, session in calls:
        if poll:
            siblings[session][0].append((start, end))
        elif seconds >= slow_seconds:
            siblings[session][1].append((start, end))
    count = 0
    seconds = 0
    overlap = flagged = False
    for waiting, slow in siblings.values():
        if not waiting:
            continue
        count += len(waiting)
        merged = []
        for start, end in sorted(waiting):
            if merged and start <= merged[-1][1]:
                merged[-1] = (merged[-1][0], max(end, merged[-1][1]))
            else:
                merged.append((start, end))
        wait = sum(end - start for start, end in merged)
        seconds += wait
        slow.sort()
        index = 0
        for start, end in merged:
            while index < len(slow) and slow[index][1] <= start:
                index += 1
            if index < len(slow) and slow[index][0] < end:
                overlap = True
                flagged = flagged or wait >= 600
                break
    return dict(count=count, seconds=round(seconds, 3), slow_overlap=overlap, flagged=flagged)


def finalize_friction(state, thresholds, window):
    grouped = state["codex_calls"]
    comparison_groups = defaultdict(list, {key: list(value) for key, value in state["trusted_codex_calls"].items()})
    signals = state["codex_signals"]
    calls = state.get("timeline", [])
    question_wait, prompted_wait, local_load, local_calls = [], [], [], []
    sample_data = state.get("samples", dict(events={}, load=[], procs=[], hours=set()))
    timeout_events, interrupt_events = set(), set()
    for key, pair in state["pairs"].items():
        if pair is None or None in pair:
            continue
        (start, _, signature, skipped, _, name, poll), (end, _, measured, prompted, background, _, _,
                                                  timeout, hint, interrupted, lock, row_event) = pair
        if end < start:
            state["warnings"]["malformed rows"] += 1
            continue
        if timeout:
            timeout_events.add(row_event)
        if interrupted:
            interrupt_events.add(row_event)
        signals["timeout_hints"] += int(hint and not timeout)
        signals["lock_phrases"] += int(lock)
        if name == "AskUserQuestion" and end >= start and not background:
            question_wait.append((end - start).total_seconds())
        sample = sample_data["events"].get(key) if name == "Bash" else None
        join_days = {(end + timedelta(seconds=offset)).astimezone(timezone.utc).date().isoformat()
                     for offset in (-SAMPLE_JOIN_SECONDS, SAMPLE_JOIN_SECONDS)}
        incomplete = name == "Bash" and bool(join_days.intersection(sample_data.get("skipped_days", ())))
        comparable = (sample is not None and not incomplete
                      and abs(sample[0] - end.timestamp()) <= SAMPLE_JOIN_SECONDS)
        if comparable and measured is not None and sample[1] is not None and abs(measured - sample[1]) > 0.001:
            comparable = False
        if comparable and measured is None:
            measured = sample[1]
        if prompted and not skipped and not background:
            gap = (end - start).total_seconds()
            prompted_wait.append((max(0, gap - measured) if measured is not None else gap, measured is not None))
        if skipped or background or (prompted and measured is None):
            continue
        seconds = measured if measured is not None else (end - start).total_seconds()
        grouped[signature].append((seconds, measured is not None))
        if len(calls) >= FRICTION_PAIR_LIMIT:
            state["capped"] = True
        before = len(calls)
        timeline_call(calls, start, end, seconds, signature, measured is not None, poll, ("claude", key[0]))
        if comparable and measured is not None and sample[2] and len(calls) > before:
            local_calls.append(calls[-1])
            local_load.append(sample[2])
    signals["timeouts"] += len(timeout_events)
    signals["interrupts"] += len(interrupt_events)
    rows, flags = [], []
    for ident, count in (("usage-limits", len(state["usage_limits"])),
                         ("timeouts", signals["timeouts"]), ("interrupts", signals["interrupts"]),
                         ("lock-contention", signals["lock_phrases"])):
        if count:
            flags.append(dict(id=ident, subject="", value=count,
                              detail=f"{count} confirmed {ident.replace('-', ' ')} events in the window (threshold: 1)."))
    measured = samples = 0
    for signature, group in grouped.items():
        values = sorted(seconds for seconds, _ in group)
        count = len(group)
        measured_count = sum(is_measured for _, is_measured in group)
        measured += measured_count
        samples += count
        p50 = statistics.median(values)
        slow = sum(value >= thresholds["slow_call_seconds"] for value in values)
        heavy = count >= 3 and p50 >= thresholds["heavy_seconds"]
        if slow or heavy:
            rows.append(dict(signature=signature, count=count, slow=slow, heavy=heavy,
                             seconds_total=round(sum(values), 3), p50=round(p50, 3),
                             p90=round(values[math.ceil(0.9 * count) - 1], 3),
                             basis=friction_basis(measured_count, count - measured_count)))
    rows.sort(key=lambda row: (-row["seconds_total"], row["signature"]))
    for row in rows[:10]:
        if row["slow"]:
            flags.append(dict(id="slow-calls", subject=row["signature"], value=row["slow"],
                              detail=f"{row['slow']} calls met the slow threshold."))
        if row["heavy"]:
            flags.append(dict(id="heavy-calls", subject=row["signature"], value=row["p50"],
                              detail=f"Median timing was {row['p50']:g} seconds."))
    contention, parallel = heavy_timeline(calls, thresholds, local_load, local_calls)
    host = host_load_summary(sample_data)
    for row in contention:
        if row["status"] == "flagged":
            flags.append(dict(id="contention", subject=row["signature"], value=row["ratio"], detail="Overlapped measured calls slowed down with local load evidence."))
    if parallel["status"] == "flagged":
        flags.append(dict(id="parallel-heavy", subject="", value=parallel["peak"], detail="Parallel measured calls coincided with local load evidence."))
    polling = polling_summary(calls, thresholds["slow_call_seconds"])
    if polling["flagged"]:
        flags.append(dict(id="polling", subject="", value=polling["seconds"],
                          detail="At least ten minutes waiting overlapped slow work."))
    comparison = []
    for key, pair in state["trusted_pairs"].items():
        if pair is None or None in pair:
            continue
        (start, _, signature, skipped, _, name, _), (end, _, cohort_measured, prompted, background, *_) = pair
        if end < start or skipped or background:
            continue
        sample = sample_data["events"].get(key) if name == "Bash" else None
        join_days = {(end + timedelta(seconds=offset)).astimezone(timezone.utc).date().isoformat()
                     for offset in (-SAMPLE_JOIN_SECONDS, SAMPLE_JOIN_SECONDS)}
        incomplete = name == "Bash" and bool(join_days.intersection(sample_data.get("skipped_days", ())))
        if (sample is not None and not incomplete and cohort_measured is None
                and abs(sample[0] - end.timestamp()) <= SAMPLE_JOIN_SECONDS):
            cohort_measured = sample[1]
        if prompted and cohort_measured is None:
            continue
        seconds = cohort_measured if cohort_measured is not None else (end - start).total_seconds()
        comparison_groups[signature].append((seconds, cohort_measured is not None))
    for signature, group in sorted(comparison_groups.items()):
        for measured_basis in (True, False):
            values = [seconds for seconds, measured in group if measured == measured_basis]
            if len(values) >= 3:
                comparison.append(dict(signature=signature, basis="measured" if measured_basis else "row_gap",
                                       count=len(values), p50=statistics.median(values)))
    return dict(v=1, thresholds=thresholds, window=window, basis=friction_basis(measured, samples - measured),
                contention=contention, parallel_heavy=parallel, polling=polling,
                comparisons=comparison, regressions=[], host_load=host,
                permission_waits=dict(count=len(prompted_wait), seconds=round(sum(v for v, _ in prompted_wait), 3),
                    basis=friction_basis(sum(m for _, m in prompted_wait), sum(not m for _, m in prompted_wait)).replace("row_gap", "upper_bound")),
                summary=dict(samples=samples, measured=measured, estimated=samples - measured,
                             capped=state["capped"], slow_calls=rows[:50]), flags=flags,
                permission_acceptance=permission_rows(state),
                signals=dict(usage_limits=len(state["usage_limits"]), timeouts=signals["timeouts"], timeout_hints=signals["timeout_hints"],
                             interrupts=signals["interrupts"], lock_phrases=signals["lock_phrases"],
                             user_questions=len(question_wait),
                             user_question_wait_upper_bound_seconds=round(sum(question_wait), 3),
                             **({"inotify": signals["inotify"]} if signals["inotify"] else {})))


def friction_sections(friction):
    summary = friction["summary"]
    thresholds = friction["thresholds"]
    lines = ["", "## Friction",
             f"Timed calls {summary['samples']} ({summary['measured']} measured, "
             f"{summary['estimated']} estimated from row gaps). "
             f"Slow ≥ {thresholds['slow_call_seconds']}s, heavy median ≥ {thresholds['heavy_seconds']}s."]
    signals = friction["signals"]
    if any(signals.values()):
        lines.append(f"Usage limits: {signals['usage_limits']}; timeouts: {signals['timeouts']}; timeout hints: {signals['timeout_hints']}; "
                     f"interrupts: {signals['interrupts']}; lock phrases: {signals['lock_phrases']}; "
                     f"user questions: {signals['user_questions']} "
                     f"(up to {signals['user_question_wait_upper_bound_seconds']:g}s).")
    if signals.get("inotify"):
        lines.append(f"Inotify limit hints: {signals['inotify']}.")
    if friction.get("permission_waits", {}).get("count"):
        lines.append(f"Prompted wait: {friction['permission_waits']['seconds']:g}s ({friction['permission_waits']['basis']}).")
    if friction.get("host_load"):
        for category, hits in friction["host_load"]["process_hits"].items():
            lines.append(f"Host samples: {category}: {hits['hits']} hits ({hits['per_hour']:g}/hour).")
    if summary["capped"]:
        lines.append("Timing reached its pair limit. Counts and percentiles cover retained pairs.")
    if "parallel_heavy" in friction:
        parallel, polling = friction["parallel_heavy"], friction["polling"]
        lines.append(f"Parallel heavy peak: {parallel['peak']} ({parallel['status']}); "
                     f"polling: {polling['seconds']:g}s; regressions: {len(friction['regressions'])}.")
        for row in friction["contention"][:5]:
            if row["ratio"] is not None and row["ratio"] >= 1.5:
                lines.append(f"Contention {row['signature']} ({row['basis']}): {row['ratio']:g}x, {row['status']}.")
    if summary["slow_calls"]:
        lines += ["Signature | p50 (s) | p90 (s) | Samples | Basis", "--- | --- | --- | --- | ---"]
        lines += [" | ".join(str(row[key]) for key in ("signature", "p50", "p90", "count", "basis"))
                  for row in summary["slow_calls"][:5]]
    return lines


def scan_claude(path, agent, since, data, seen_messages, project, source=None, trusted=True):
    main = agent is None
    counter = Counter()
    tools = {}
    pending = None
    first, last, session_id = None, None, path.stem
    observed = dict(main=main, known=False, available=set(), loading=defaultdict(set), servers=set(),
                    used=set(), prompts=0, cwd=None, active=False)
    turn = None
    cache_previous = None
    cache_seen = False
    friction = data.get("_friction")
    cached_head = lru_cache(maxsize=64)(bash_head)
    cached_command = lru_cache(maxsize=64)(command_info)
    for row in rows(path, since, data["warnings"], keep_tools=True, canary=data["format_canary"],
                    keep_signals=friction is not None, source=source):
        if row.get("_invalid_friction_timestamp"):
            message = row.get("message")
            content = blocks(message) if isinstance(message, dict) else []
            results = sum(block.get("type") == "tool_result" for block in content)
            for block in content:
                if block.get("type") in ("tool_use", "tool_result"):
                    friction_block(friction, row, block, block["type"] == "tool_use", results,
                                   trusted_source=source is not None and trusted)
            continue
        if row.get("type") in ("api-request-shape", "attachment"):
            tool_metadata(row, observed)
            continue
        if (friction is not None and row.get("type") == "system"
                and row.get("subtype") == "informational" and not row.get("_before_window")):
            text = row.get("content")
            timestamp = row.get("timestamp")
            stamp = friction_stamp(timestamp) if isinstance(timestamp, str) and len(timestamp) <= 40 else None
            if stamp is not None and stamp <= friction["until"] and isinstance(text, str) and "usage limit" in text[:400].lower():
                if len(friction["usage_limits"]) < FRICTION_PAIR_LIMIT:
                    friction["usage_limits"].add(tuple(str(row.get(key, ""))[:256]
                                                       for key in ("sessionId", "uuid", "timestamp")))
                else:
                    friction["capped"] = True
        observed["cwd"] = row.get("cwd") or observed["cwd"]
        if row.get("_before_window"):
            message = row.get("message") or {}
            usage = message.get("usage") if isinstance(message, dict) else None
            if row.get("type") == "assistant" and isinstance(usage, dict) and usage and not empty_synthetic(message, usage):
                try:
                    cache_previous = date_time(row.get("timestamp", ""))
                except (ValueError, TypeError, OverflowError):
                    cache_previous = None
                cache_seen = True
            raw = (row.get("message") or {}).get("content", "")
            if (row.get("type") == "user" and not row.get("isMeta")
                    and "<task-notification>" not in str(raw)):
                turn = dict(calls=0, cost=0, failures=[], bash_calls={}, active=False)
            continue
        observed["active"] = True
        ts = row.get("timestamp", "")
        first = min(first, ts) if first else ts
        last = max(last, ts) if last else ts
        session_id = row.get("sessionId") or session_id
        message = row.get("message") or {}
        if not isinstance(message, dict):
            continue
        # One assistant message can span several rows (one per content block), and resumed
        # sessions can repeat rows from another file: count usage once per message id and
        # each tool call or result once per tool-use id, but keep every row's blocks.
        message_id = message.get("id")
        usage_seen = False
        if row.get("type") == "assistant" and message_id:
            usage_seen = message_id in seen_messages
            seen_messages.add(message_id)
        content = blocks(message)
        if row.get("type") == "user" and main:
            raw = message.get("content", "")
            if any(item.get("type") == "tool_result" for item in content):
                pending = "tool result"
            elif "<task-notification>" in (raw if isinstance(raw, str) else str(raw)):
                pending = "task notification"
            else:
                pending = "human"
        raw = message.get("content", "")
        if (row.get("type") == "user" and not row.get("isMeta")
                and not any(item.get("type") == "tool_result" for item in content)
                and "<task-notification>" not in (raw if isinstance(raw, str) else str(raw))):
            prompt_id = row.get("uuid")
            if not prompt_id or ("prompt", prompt_id) not in seen_messages:
                if prompt_id:
                    seen_messages.add(("prompt", prompt_id))
                finish_turn(turn, project, session_id, agent or "main", data)
                turn = dict(calls=0, cost=0, failures=[], bash_calls={}, active=True)
                observed["prompts"] += int(main)
        usage = message.get("usage")
        if (row.get("type") == "assistant" and isinstance(usage, dict) and usage and not usage_seen
                and not empty_synthetic(message, usage)):
            model = message.get("model", "unknown")
            if not isinstance(model, str):
                model = "unknown"
            if not main:
                label = row.get("perTurnEffort") or row.get("effort") or "unknown"
                data["_agent_models"][agent][model] += 1
                data["_agent_effort"][agent][label if isinstance(label, str) else "unknown"] += 1
            try:
                cache_time = date_time(ts)
            except (ValueError, TypeError, OverflowError):
                cache_time = None
            write = usage.get("cache_creation_input_tokens", 0) or 0
            if write > 0:
                cache_add(data["cache_writes"]["main" if main else "subagent"],
                          cache_bucket(cache_previous, cache_time, first=not cache_seen), write, context(usage))
            cache_previous = cache_time
            cache_seen = True
            add(data["models"][model], usage)
            add(counter, usage)
            cost = price(data, model, agent or "main", usage)
            if turn is not None:
                turn["active"] = True
                turn["cost"] += cost
            if main and pending:
                add(data["triggers"][pending], usage)
                pending = None
        row_event = None
        for block in content:
            if block.get("type") == "tool_use":
                name, head = block.get("name", "unknown"), None
                observed["used"].add(name)
                data["_tool_universe"].add(name)
                if friction is not None:
                    friction_block(friction, row, block, True, trusted_source=source is not None and trusted)
                if ("use", block.get("id")) in seen_messages:
                    continue
                seen_messages.add(("use", block.get("id")))
                tool_input = block.get("input") or {}
                if turn is not None:
                    turn["active"] = True
                    turn["calls"] += 1
                original_name = name
                order = turn["calls"] if turn is not None else 0
                match_head = None
                if name == "Bash":
                    command = tool_input.get("command", "")
                    cacheable = isinstance(command, str) and len(command) <= 1024
                    failure_head = (cached_head if cacheable else bash_head)(command)
                    if turn is not None:
                        match_head = (cached_command if cacheable else command_info)(command)
                        turn["bash_calls"][order] = (match_head, None)
                else:
                    target = tool_input.get("file_path") or tool_input.get("path") or tool_input.get("filePath") or ""
                    failure_head = redact(str(target))
                if name == "Agent":
                    agent_type = str(tool_input.get("subagent_type", "unknown"))
                    data["briefs"][agent_type].append(len(tool_input.get("prompt") or ""))
                    name += ":" + agent_type
                if name == "Bash" and not main:
                    head = failure_head
                    data["bash"][agent][head] += 1
                tools[block.get("id")] = (name, head, original_name, failure_head, match_head, order)
            elif block.get("type") == "tool_result":
                if friction is not None:
                    if row_event is None:
                        ids = [item.get("tool_use_id") for item in content if item.get("type") == "tool_result"]
                        result_count = len(ids)
                        uuid = row.get("uuid")
                        identity = (uuid if isinstance(uuid, str) and 0 < len(uuid) <= 256
                                    else (friction_stamp(ts), ids[0] if result_count == 1
                                          and isinstance(ids[0], str) else replay_fingerprint(ids)))
                        row_event = (session_id, identity)
                    friction_block(friction, row, block, False, result_count, row_event, source is not None and trusted)
                if ("result", block.get("tool_use_id")) in seen_messages:
                    continue
                seen_messages.add(("result", block.get("tool_use_id")))
                name, head, original_name, failure_head, match_head, order = tools.get(
                    block.get("tool_use_id"), ("unknown", None, "unknown", "", None, 0))
                result = block.get("content")
                failed = block.get("is_error") is True
                exit_code = None
                if original_name == "Bash":
                    if failed:
                        first_line = result_text(result).partition("\n")[0].strip()
                        exit_match = EXIT_HEADER.match(first_line)
                        if exit_match:
                            exit_code = int(exit_match[1])
                        failed = not benign_exit(failure_head, exit_code)
                    if turn is not None:
                        turn["bash_calls"][order] = (match_head, not failed)
                if turn is not None and failed:
                    signature = (original_name, failure_head, exit_code, error_line(result))
                    turn["failures"].append((signature, match_head, order))
                chars = len(json.dumps(result))
                if main:
                    data["tool_chars"][name] += chars
                    data["tool_counts"][name] += 1
                    data["images"] += image_count(result)
                    if original_name == "Agent" and name.startswith("Agent:"):
                        data["_agent_result_chars"][name[len("Agent:"):]].append(chars)
                else:
                    data["_agent_results"][agent] += 1
                    data["_agent_failed"][agent] += int(failed)
                    if head:
                        data["bash_chars"][agent][head] += chars
    finish_turn(turn, project, session_id, agent or "main", data)
    if observed["active"]:
        data["_observed"][project].append((session_id, observed))
    if not counter["calls"]:
        return
    minutes = 0
    if first and last:
        try:
            minutes = max(0, (date_time(last) - date_time(first)).total_seconds() / 60)
        except ValueError:
            pass
    if main:
        data["sessions"].append(dict(id=session_id, date=first[:10], **counter))
    else:
        data["agents"][agent].append(dict(minutes=minutes, **counter))


def too_old(path, since):
    try:
        return path.stat().st_mtime < since.timestamp()
    except OSError:
        return False


# Bound each JSONL line read; a huge first line is not a session header.
LINE_LIMIT = 1 << 20


def cwd_of_file(path, limit=50):
    """Read only the first cwd recorded near the start of a Claude transcript."""
    try:
        with open_untrusted_transcript(path) as stream:
            for _ in range(limit):
                line = stream.readline(LINE_LIMIT)
                if not line:
                    break
                if b'"cwd"' not in line:
                    continue
                try:
                    row = json.loads(line)
                except (ValueError, RecursionError):
                    continue
                if isinstance(row, dict) and isinstance(row.get("cwd"), str):
                    return row["cwd"]
    except (OSError, ValueError):
        pass
    return None


def canonical_cwd(path, realpaths):
    if path in realpaths:
        return realpaths[path]
    try:
        result = os.path.normpath(os.path.realpath(path))
    except (OSError, ValueError):
        result = None
    if len(path) <= 4096 and (result is None or len(result) <= 4096) and len(realpaths) < 1024:
        realpaths[path] = result
    return result


def cwd_matches(raw, targets, realpaths):
    if not isinstance(raw, str) or not os.path.isabs(raw) or "\0" in raw:
        return False
    location = canonical_cwd(raw, realpaths)
    return location is not None and any(
        target is not None and os.path.commonpath((location, target)) == target
        for target in targets
    )


def scan_codex(root, since, data, cwd=None, realpaths=None):
    if realpaths is None:
        realpaths = {}
    friction = data.get("_friction")

    def context_stamp(row):
        value = row.get("timestamp")
        return friction_stamp(value) if isinstance(value, str) and len(value) <= 40 else None

    def admit(row):
        nonlocal future_header
        payload = row.get("payload") if isinstance(row, dict) else None
        # Future metadata supplies no scope. A later in-window turn can supply it.
        stamp = context_stamp(row) if friction is not None and isinstance(row, dict) else None
        if stamp is not None and stamp > friction["until"]:
            future_header = row.get("type") == "session_meta"
            return future_header
        if not isinstance(payload, dict) or not cwd_matches(payload.get("cwd"), cwd, realpaths):
            return False
        data["codex_files_scanned"] += 1
        return True

    def rollout_rows(path, bounds):
        nonlocal trusted_rollout, unsafe_rollout
        source = None
        if friction is not None:
            try:
                source = open_permission_transcript(path)
                trusted_rollout = True
            except (OSError, ValueError, AttributeError, ImportError):
                unsafe_rollout = True
                try:
                    source = open_untrusted_transcript(path)
                except (OSError, ValueError):
                    return
        with (source if source is not None else nullcontext()):
            yield from rows(path, since, data["warnings"], keep_model=True, bounds=bounds,
                            canary=data["format_canary"], keep_codex=friction is not None,
                            admit=admit if cwd is not None else None, source=source)

    # Session filenames are usually rollout-*.jsonl; scan the standard date tree.
    for path in root.glob("*/*/*/*.jsonl"):
        if too_old(path, since):
            continue
        if cwd is None:
            data["codex_files_scanned"] += 1
        model, seen_usage, brief, effort = "unknown", False, None, None
        first = last = None
        users = []
        prior_usage, window = {}, Counter()

        bounds = [None, None]
        pairs, disqualified, turns, current_cwd = {}, set(), {}, None
        future_header, scoped_turn, rejection_overflow, trusted_rollout, unsafe_rollout = False, False, False, False, False
        scanned_before = data["codex_files_scanned"]
        # Older session files can contain recent resumes. Keep earlier model
        # metadata, but count only sessions with a token_count in the window.
        for row in rollout_rows(path, bounds):
            if "_codex_tool" in row:
                kind, ident, observation = row["_codex_tool"]
                stamp = row["timestamp"]
                if (not isinstance(ident, str) or ident in disqualified
                        or (rejection_overflow and ident not in pairs)):
                    continue
                if stamp is not None and stamp > friction["until"]:
                    if ident not in pairs:
                        if len(disqualified) < FRICTION_REJECTED_LIMIT:
                            disqualified.add(ident)
                        else:
                            rejection_overflow = friction["capped"] = True
                    continue
                valid = observation is not None and stamp is not None and stamp >= since
                if valid:
                    turn = observation["turn_id"]
                    location = observation.pop("cwd")
                    if location is None:
                        location = turns.get(turn, current_cwd) if isinstance(turn, (str, tuple)) else current_cwd
                    if location is not None:
                        in_scope = cwd_matches(location, cwd or (), realpaths)
                        location = canonical_cwd(location, realpaths) if isinstance(location, str) else None
                        valid = location is not None and (cwd is None or in_scope)
                    else:
                        valid = cwd is None
                if not valid:
                    # Keep rejected IDs separate from the budget for in-scope pairs.
                    if ident in pairs:
                        pairs[ident] = None
                    elif len(disqualified) < FRICTION_REJECTED_LIMIT:
                        disqualified.add(ident)
                    else:
                        rejection_overflow = friction["capped"] = True
                    continue
                if ident not in pairs:
                    if len(pairs) >= FRICTION_PAIR_LIMIT:
                        friction["capped"] = True
                        continue
                    pairs[ident] = [None, None]
                pair = pairs[ident]
                if pair is None:
                    continue
                slot = int(kind in CODEX_OUTPUT_TYPES)
                value = (kind, stamp, bounded_turn_id(location), observation)
                if pair[slot] is None and (slot or pair[1] is None):
                    pair[slot] = value
                elif pair[slot] != value:
                    pairs[ident] = None
                continue
            payload = row.get("payload") or {}
            if not isinstance(payload, dict):
                continue
            if friction is not None and row.get("type") in ("session_meta", "turn_context"):
                stamp = context_stamp(row)
                if (stamp is not None and stamp <= friction["until"]
                        and (not future_header or (stamp >= since and row["type"] == "turn_context"))):
                    location = payload.get("cwd")
                    if isinstance(location, str) and location:
                        current_cwd = location if len(location) <= 4096 else bounded_turn_id(location)
                    turn = payload.get("turn_id")
                    if isinstance(turn, str) and len(turns) < FRICTION_PAIR_LIMIT:
                        turn = bounded_turn_id(turn)
                        turns[turn] = current_cwd
                    if future_header and not scoped_turn and cwd_matches(location, cwd, realpaths):
                        scoped_turn = True
                        data["codex_files_scanned"] += 1
            if future_header and not scoped_turn:
                continue
            if row.get("type") == "turn_context" and effort is None:
                effort = payload.get("effort") or payload.get("reasoning_effort") or "n/a"
            if row.get("model"):
                model = row["model"]
            if payload.get("model"):
                model = payload["model"]
            if row.get("type") == "event_msg" and payload.get("type") == "user_message":
                users.append(payload.get("message") or "")
            if row.get("type") == "response_item" and payload.get("role") == "user":
                users.extend(item.get("text") or "" for item in payload.get("content") or [] if isinstance(item, dict))
            if row.get("type") == "event_msg" and payload.get("type") == "user_message" and brief is None:
                brief = len(payload.get("message") or "")
            if row.get("type") == "response_item" and payload.get("role") == "user" and brief is None:
                texts = [item.get("text") or "" for item in payload.get("content") or [] if isinstance(item, dict)]
                length = sum(len(text) for text in texts if text and not text.startswith(INJECTED_PREFIXES))
                if length:
                    brief = length
            if payload.get("type") == "token_count":
                info = payload.get("info")
                usage = info.get("total_token_usage") if isinstance(info, dict) else None
                if isinstance(usage, dict):
                    delta, prior_usage = codex_delta(prior_usage, usage)
                    # Rows before the window only seed the baseline: not priced, not counted.
                    if row.get("_before_window"):
                        continue
                    seen_usage = True
                    window.update(delta)
                    price(data, model, "codex", delta, codex=True)
        if unsafe_rollout and (cwd is None or data["codex_files_scanned"] > scanned_before):
            data["warnings"]["unsafe permission transcript"] += 1
        if friction is not None:
            finish_codex_pairs(pairs, friction, str(path), trusted_rollout)
        first, last = bounds
        if seen_usage:
            if brief is not None:
                data["codex_briefs"][model].append(brief)
            text = " ".join(users)
            kind = ("review-plan" if "VERDICT: APPROVE | REVISE" in text else
                    "review-diff" if "VERDICT: NO ISSUES" in text else
                    "planner" if "as the engineering planner" in text else
                    "engineer" if "You are working in a git repository. Read AGENTS" in text else "other")
            # In-window deltas, not the session's cumulative totals.
            tokens = window["total_tokens"] if "total_tokens" in window else window["input_tokens"] + window["output_tokens"]
            data["codex_sessions"].append(dict(kind=kind, model=model, effort=effort or "n/a", tokens=tokens,
                                               duration_s=(last - first).total_seconds() if first and last and first != last else None))
            total = data["codex"][model]
            total.update(sessions=1, input=window["input_tokens"], cached_input=window["cached_input_tokens"],
                         output=window["output_tokens"], tokens=tokens)


def finish_codex_pairs(pairs, friction, session=None, trusted=False):
    signals = friction["codex_signals"]
    for pair in pairs.values():
        if pair is None or pair[1] is None:
            continue
        start, (kind, end, location, result) = pair
        if start is not None and (start[0] + b"_output" != kind or start[1] > end or start[2] != location
                                  or (start[3]["turn_id"] is not None and result["turn_id"] is not None
                                      and start[3]["turn_id"] != result["turn_id"])):
            continue
        signals["inotify"] += result["inotify"]
        if start is None:
            continue
        signals["timeout_hints"] += result["timeout"]
        signals["lock_phrases"] += result["lock"]
        if result["seconds"] is not None:
            if friction["codex_samples"] >= FRICTION_PAIR_LIMIT:
                friction["capped"] = True
                continue
            friction["codex_samples"] += 1
            friction["codex_calls"][start[3]["signature"]].append((result["seconds"], True))
            if trusted:
                friction["trusted_codex_calls"][start[3]["signature"]].append((result["seconds"], True))
            if len(friction["timeline"]) >= FRICTION_PAIR_LIMIT:
                friction["capped"] = True
            timeline_call(friction["timeline"], start[1], end, result["seconds"],
                          start[3]["signature"], True, start[3].get("poll", False), ("codex", session))


def collect(projects, codex_root, since, pricing, pricing_error, options, cwd=None, *,
            friction=True, friction_thresholds=None, friction_window=None, samples_dir=None, now=None):
    if cwd is not None:
        cwd = [os.path.normpath(os.path.realpath(path)) for path in cwd]
    data = dict(models=defaultdict(Counter), sessions=[], agents=defaultdict(list),
                triggers=defaultdict(Counter), tool_chars=Counter(), tool_counts=Counter(),
                images=0, bash=defaultdict(Counter), bash_chars=defaultdict(Counter),
                codex=defaultdict(Counter), codex_sessions=[], briefs=defaultdict(list), codex_briefs=defaultdict(list), warnings=Counter(), codex_files_scanned=0)
    data["format_canary"] = defaultdict(Counter)
    if friction:
        data["_friction"] = dict(pairs={}, trusted_pairs={}, capped=False, since=since, usage_limits=set(),
                                 until=now or datetime.now(timezone.utc),
                                 cwd=set(cwd or ()), permissions={}, warnings=data["warnings"], codex_calls=defaultdict(list),
                                 trusted_codex_calls=defaultdict(list), codex_signals=Counter(), codex_samples=0, timeline=[],
                                 samples=read_samples(samples_dir if samples_dir is not None else default_samples_dir(), since, data["warnings"]))
    data["cache_writes"] = {kind: {bucket: Counter(writes=0, write_tokens=0, full_rewrites=0) for bucket in CACHE_BUCKETS}
                            for kind in ("main", "subagent")}
    data.update(cost=dict(total=0, by_agent=Counter(), by_model=Counter(), components=Counter(),
                          unpriced={}, pricing_error=pricing_error),
                deferred_tools_unused=0, stuck_turns=dict(turns=0, flagged_turns=0, tool_calls=0, cost=0, signatures=[]),
                repeat_failures=[], unused_tools=[])
    data.update(_pricing=pricing, _options=options, _observed=defaultdict(list), _tool_universe=set(),
                _agent_models=defaultdict(Counter), _agent_effort=defaultdict(Counter),
                _agent_turns=Counter(), _agent_flagged=Counter(), _agent_results=Counter(),
                _agent_failed=Counter(), _agent_result_chars=defaultdict(list),
                _cwd=cwd, _cwd_observed=defaultdict(set),
                _failures=defaultdict(lambda: dict(sessions=set(), occurrences=0, worked_instead=set())))
    seen = set()
    seen_messages = set()
    decisions, realpaths = {}, {}
    encoded = {re.sub(r"[^a-zA-Z0-9]", "-", target) for target in cwd or []}

    def belongs(path, folder_name):
        if cwd is None:
            return True
        if path.parent.name == "subagents":
            parent = path.parent.parent.parent / (path.parent.parent.name + ".jsonl")
            if parent.is_file():
                path = parent
        if path not in decisions:
            raw = cwd_of_file(path)
            decisions[path] = (folder_name in encoded if raw is None else cwd_matches(raw, cwd, realpaths))
            if decisions[path] and raw is not None:
                data["_cwd_observed"][folder_name].add(raw)
        return decisions[path]

    def scan(path, agent, project):
        source = None
        if friction:
            try:
                source = open_permission_transcript(path)
            except (OSError, ValueError, AttributeError, ImportError):
                data["warnings"]["unsafe permission transcript"] += 1
                try:
                    with open_untrusted_transcript(path) as fallback:
                        scan_claude(path, agent, since, data, seen_messages, project, fallback, trusted=False)
                except (OSError, ValueError):
                    pass
                return
        with (source if source is not None else nullcontext()):
            scan_claude(path, agent, since, data, seen_messages, project, source)

    for project in projects:
        for path in project.glob("*.jsonl"):
            if too_old(path, since):
                continue
            real = path.resolve()
            if real not in seen and belongs(path, project.name):
                seen.add(real)
                scan(path, None, project.name)
        for path in project.glob("*/subagents/*.jsonl"):
            if too_old(path, since):
                continue
            real = path.resolve()
            if real in seen or not belongs(path, project.name):
                continue
            seen.add(real)
            meta = path.with_name(path.stem + ".meta.json")
            agent = "unknown"
            if meta.is_file():
                try:
                    agent = str(json.loads(meta.read_text()).get("agentType") or "unknown")
                except (OSError, ValueError, AttributeError):
                    data["warnings"]["malformed metadata"] += 1
            scan(path, agent, project.name)
    scan_codex(codex_root, since, data, cwd, realpaths)
    data["files_scanned"] = len(seen)
    data["headline"] = {
        "claude_calls": sum(c["calls"] for c in data["models"].values()),
        "claude_context": sum(c["context"] for c in data["models"].values()),
        "claude_output": sum(c["output"] for c in data["models"].values()),
        "codex_sessions": sum(c["sessions"] for c in data["codex"].values()),
        "codex_tokens": sum(c["tokens"] for c in data["codex"].values()),
        "image_reads": data["images"],
        "brief_chars_median": int(statistics.median([n for values in data["briefs"].values() for n in values])) if data["briefs"] else 0,
        "codex_brief_chars_median": int(statistics.median([n for values in data["codex_briefs"].values() for n in values])) if data["codex_briefs"] else 0,
    }
    unknown_types = Counter()
    for counts in data["format_canary"].values():
        unknown_types.update({key[1]: count for key, count in counts.items()
                              if isinstance(key, tuple) and key[0] == "unknown_type"})
    data["unknown_types"] = dict(unknown_types)
    data["format_canary"] = {version: dict(records=c["records"], unknown_records=c["unknown_records"],
                                            missing_usage=c["missing_usage"])
                             for version, c in sorted(data["format_canary"].items())}
    h = data["headline"]
    h["format_canary"] = canary_summary(data["format_canary"])
    h.update(claude_context_per_call=h["claude_context"] // h["claude_calls"] if h["claude_calls"] else 0,
             claude_output_per_call=h["claude_output"] // h["claude_calls"] if h["claude_calls"] else 0,
             image_reads_per_100_calls=round(100 * h["image_reads"] / h["claude_calls"], 1) if h["claude_calls"] else 0,
             codex_tokens_per_session=h["codex_tokens"] // h["codex_sessions"] if h["codex_sessions"] else 0)
    data["parser_warnings"] = []
    if data["files_scanned"] and not data["headline"]["claude_calls"]:
        data["parser_warnings"].append(
            "WARNING: transcript format may have changed; token-audit's parser needs updating "
            f"({data['files_scanned']} files scanned, 0 usage rows)")
    if data["codex_files_scanned"] and not data["headline"]["codex_sessions"]:
        data["parser_warnings"].append(
            "WARNING: Codex transcript format may have changed; token-audit's parser needs updating "
            f"({data['codex_files_scanned']} files scanned, 0 token_count rows)")
    data["parser_warning"] = bool(data["parser_warnings"])
    for key in ("briefs", "codex_briefs"):
        data[key] = {name: dict(median=statistics.median(values), max=max(values), count=len(values))
                     for name, values in data[key].items()}
    if friction:
        window = friction_window or dict(kind="fixed", cutoff=since.astimezone(timezone.utc).isoformat())
        thresholds = dict(FRICTION_THRESHOLDS, **(friction_thresholds or {}))
        data["friction"] = finalize_friction(data.pop("_friction"), thresholds, window)
    finalize_measurements(data, seen, since)
    data["since"] = since.isoformat()
    return data


def configured_servers(project, observed, config, cwd=None, observed_cwds=()):
    servers = set(config.get("mcpServers", {}))
    paths = {entry["cwd"] for _, entry in observed if entry["cwd"]}
    if cwd is not None:
        # Only the selected paths this folder's sessions actually ran in, not every --cwd.
        paths.update(observed_cwds)
        paths.update(target for target in cwd if any(cwd_matches(seen, [target], {}) for seen in observed_cwds))
    for config_cwd, settings in config.get("projects", {}).items():
        if config_cwd in paths or (cwd is None and re.sub(r"[^a-zA-Z0-9]", "-", config_cwd) == project):
            paths.add(config_cwd)
            servers.update(settings.get("mcpServers", {}))
    for cwd in paths:
        try:
            value = json.loads((Path(cwd) / ".mcp.json").read_text())
            servers.update(value.get("mcpServers", {}))
        except (OSError, ValueError, AttributeError):
            pass
    return servers


def agent_usage(data):
    pricing = data["_pricing"]
    rates = pricing.get("models", {})
    cheapest = min((rate.get("output", 0) for key, rate in rates.items()
                    if key.startswith("claude-")), default=None)
    result = []
    for agent, spawns in data["agents"].items():
        calls = sorted(spawn["calls"] for spawn in spawns)
        cost = data["cost"]["by_agent"].get(agent, 0)
        share = cost / data["cost"]["total"] if data["cost"]["total"] else 0
        models = dict(data["_agent_models"][agent])
        chars = data["_agent_result_chars"][agent]
        median_chars = round(statistics.median(chars)) if chars else None
        median_calls = statistics.median(calls)
        thresholds = CHEAPER_MODEL_THRESHOLDS
        candidate = (share >= thresholds["cost_share"] and median_calls <= thresholds["calls_median"]
                     and median_chars is not None and median_chars <= thresholds["result_chars_median"]
                     and cheapest is not None and any(
                         rates[key].get("output", 0) > cheapest for model in models
                         for key in [pricing_key(pricing, model)] if key is not None))
        result.append(dict(agent=agent, spawns=len(spawns), calls_median=median_calls,
            calls_p90=calls[math.ceil(0.9 * len(calls)) - 1], cost=round(cost, 6), cost_share=round(share, 6),
            models=models, effort=dict(data["_agent_effort"][agent]), result_chars_median=median_chars,
            stuck_share=round(data["_agent_flagged"][agent] / max(1, data["_agent_turns"][agent]), 6),
            failure_rate=round(data["_agent_failed"][agent] / max(1, data["_agent_results"][agent]), 6),
            cheaper_model_candidate=candidate))
    return sorted(result, key=lambda row: (-row["cost"], row["agent"]))


TOOL_USE_TYPE = re.compile(rb'"type"\s*:\s*"tool_use"')
TOOL_USE_NAME = re.compile(rb'"type"\s*:\s*"tool_use"\s*,\s*"id"\s*:\s*"[^"\\]*"\s*,\s*"name"\s*:\s*"((?:[^"\\]|\\.)*)"')


def needs_tool_universe(data):
    """True when a main session (all its files merged) has no recorded tool definitions."""
    for observed in data["_observed"].values():
        known = {}
        for session_id, entry in observed:
            if entry["main"]:
                known[session_id] = known.get(session_id, False) or entry["known"]
        if not all(known.values()):
            return True
    return False


def tool_use_names(line):
    """Tool names in one transcript line; a pattern reads the usual key order, json.loads the rest."""
    names = TOOL_USE_NAME.findall(line)
    if len(names) == line.count(b'"tool_use"') or len(names) == len(TOOL_USE_TYPE.findall(line)):
        try:
            return [json.loads(b'"' + name + b'"') if b"\\" in name else name.decode("utf-8")
                    for name in names if name]
        except (ValueError, UnicodeError):
            pass
    row = json.loads(line)
    return [b["name"] for b in blocks(row.get("message") or {}) if b.get("type") == "tool_use" and b.get("name")]


def add_unscanned_tools(data, scanned, since):
    root = claude_home() / "projects"
    for directory in root.iterdir() if root.is_dir() else []:
        if not directory.is_dir():
            continue
        paths = list(directory.glob("*.jsonl")) + list(directory.glob("*/subagents/*.jsonl"))
        for path in paths:
            if path in scanned or too_old(path, since) or path.resolve() in scanned:
                continue
            # Only parse potential tool-use records from unscanned files.
            try:
                with open_untrusted_transcript(path) as stream:
                    for line in stream:
                        if b'"tool_use"' not in line:
                            continue
                        match = TIMESTAMP.search(line)
                        if not match or date_time(match[1].decode()) < since:
                            continue
                        try:
                            data["_tool_universe"].update(tool_use_names(line))
                        except (ValueError, TypeError, UnicodeError):
                            pass
            except (OSError, ValueError):
                pass


def finalize_measurements(data, scanned, since):
    cost, stuck = data["cost"], data["stuck_turns"]
    cost["shares"] = {key: value / cost["total"] if cost["total"] else 0
                      for key, value in cost["components"].items()}
    data["agent_usage"] = agent_usage(data)
    stuck["share"] = stuck["flagged_turns"] / max(1, stuck["turns"])
    stuck["cost_share"] = stuck["cost"] / cost["total"] if cost["total"] else 0
    grouped = {}
    for row in stuck["signatures"]:
        key = tuple(row[k] for k in ("project", "agent", "session", "signature"))
        if key not in grouped:
            grouped[key] = dict(row, repeats=0, turns=set())
            del grouped[key]["_turn"]
        grouped[key]["repeats"] += row["repeats"]
        grouped[key]["turns"].add(row["_turn"])
    for row in grouped.values():
        row["turns"] = len(row["turns"])
    stuck["signatures"] = sorted(grouped.values(), key=lambda v: (
        -v["repeats"], -v["turns"], v["project"], v["agent"], v["session"], v["signature"]))[:10]
    for row in stuck["signatures"]:
        row["session"] = row["session"][:12]
    for (project, signature), fact in sorted(data["_failures"].items(), key=lambda item: (
            -len(item[1]["sessions"]), -item[1]["occurrences"], str(item[0]))):
        if len(fact["sessions"]) >= data["_options"]["fact_sessions"]:
            data["repeat_failures"].append(dict(project=project, signature=signature_text(signature),
                sessions=len(fact["sessions"]), occurrences=fact["occurrences"],
                worked_instead=next(iter(fact["worked_instead"]), "")))
    # Filters should not shrink the fallback universe to tools used in that project.
    # It is only read when some observed main session has no recorded tool definitions.
    if needs_tool_universe(data):
        add_unscanned_tools(data, scanned, since)
    try:
        config = json.loads(claude_json().read_text())
    except (OSError, ValueError):
        config = {}
    prune_tools(data, config)
    for key in list(data):
        if key.startswith("_"):
            del data[key]


def server_name(name):
    return re.sub(r"[^a-z0-9]", "_", name.lower())


def tool_server(name):
    return server_name(name.split("__", 2)[1]) if name.startswith("mcp__") and name.count("__") >= 2 else None


def prune_tools(data, config):
    for project, observed in sorted(data["_observed"].items()):
        configured = {server_name(name) for name in configured_servers(
            project, observed, config, data["_cwd"], data["_cwd_observed"][project])}
        sessions = {}
        used = set().union(*(entry["used"] for _, entry in observed))
        used_servers = {tool_server(name) for name in used if tool_server(name)}
        for session_id, entry in observed:
            if not entry["main"]:
                continue
            if session_id not in sessions:
                sessions[session_id] = dict(known=False, available=set(), servers=set(), prompts=0,
                                            loading=defaultdict(set))
            session = sessions[session_id]
            session["known"] |= entry["known"]
            session["available"].update(entry["available"] | entry["used"])
            session["servers"].update(server_name(name) for name in entry["servers"])
            session["prompts"] += entry["prompts"]
            for name, states in entry["loading"].items():
                session["loading"][name].update(states)
        candidates = defaultdict(lambda: dict(sessions=set(), prompts=0, loading=set(), tools=set(), instructions=False))
        deferred = defaultdict(lambda: dict(sessions=set(), prompts=0))
        all_loading = defaultdict(set)
        for session in sessions.values():
            for name, states in session["loading"].items():
                all_loading[name].update(states)
        for session_id, session in sessions.items():
            universe = session["available"] if session["known"] else data["_tool_universe"]
            grouped = defaultdict(set)
            for name in universe:
                server = tool_server(name)
                if server:
                    grouped[server].add(name)
                if name not in used and "deferred" in all_loading[name] and "loaded in full" not in all_loading[name]:
                    deferred[name]["sessions"].add(session_id)
                    deferred[name]["prompts"] += session["prompts"]
            names = {(name, "MCP server") for name in configured | session["servers"] | set(grouped)}
            for name, kind in names:
                if name in used_servers:
                    continue
                candidate = candidates[(name, kind)]
                candidate["sessions"].add(session_id)
                candidate["prompts"] += session["prompts"]
                candidate["tools"].update(grouped[name])
                candidate["instructions"] |= name in session["servers"]
                for tool in grouped[name]:
                    candidate["loading"].update(session["loading"].get(tool, {"unknown"}))
        options = data["_options"]
        def eligible(candidate):
            count = len(candidate["sessions"])
            return ((candidate["prompts"] >= options["prune_prompts"] and count >= options["prune_min_sessions"])
                    or count >= options["prune_sessions"])
        data["deferred_tools_unused"] += sum(eligible(candidate) for candidate in deferred.values())
        for (name, kind), candidate in candidates.items():
            states = candidate["loading"]
            if not eligible(candidate):
                continue
            if not candidate["instructions"] and "deferred" in states and "loaded in full" not in states:
                continue
            if candidate["instructions"]:
                states.add("loaded in full (instructions)")
            data["unused_tools"].append(dict(project=project, candidate=name, kind=kind,
                sessions=len(candidate["sessions"]), prompts=candidate["prompts"], tools=len(candidate["tools"]),
                loading=", ".join(sorted(states or {"unknown"}))))
    def saving(row):
        loaded = "loaded in full" in row["loading"]
        priority = 3 if loaded and row["kind"] == "MCP server" else 2 if loaded else 1 if row["kind"] == "MCP server" else 0
        return (-priority, -row["sessions"], -row["prompts"], row["project"], row["candidate"])
    data["unused_tools"].sort(key=saving)


def money(value):
    return f"${value:,.2f}"


def loading_state(value):
    if "instructions" in value:
        return "full + instructions"
    if "loaded in full" in value:
        return "full"
    return "deferred" if "deferred" in value else "unknown"


def measurement_sections(data):
    cost, stuck = data["cost"], data["stuck_turns"]
    lines = ["", "## Cost (API-equivalent)",
             "API-equivalent $ is a comparison weighting, not a subscription bill."]
    if cost["pricing_error"]:
        lines.append(cost["pricing_error"])
    if cost.get("pricing_warning"):
        lines.append(cost["pricing_warning"])
    lines.append(f"Total API-equivalent cost: {money(cost['total'])}")
    for label, mapping in (("Agent", cost["by_agent"]), ("Model", cost["by_model"])):
        lines += [f"{label} | API-equivalent $ | Share", "--- | --- | ---"]
        lines += [f"{cell(name)} | {money(value)} | {value / cost['total'] if cost['total'] else 0:.1%}"
                  for name, value in sorted(mapping.items(), key=lambda pair: (-pair[1], pair[0]))]
    lines += ["Component | API-equivalent $ | Share", "--- | --- | ---"]
    lines += [f"{name} | {money(cost['components'].get(name, 0))} | {cost['shares'].get(name, 0):.1%}"
              for name in ("cache_read", "cache_write", "uncached_input", "output")]
    if cost["unpriced"]:
        lines += ["Unpriced model | Token totals", "--- | ---"]
        lines += [f"{cell(model)} | " + ", ".join(f"{k}={v}" for k, v in tokens.items())
                  for model, tokens in sorted(cost["unpriced"].items())]
    lines += ["", "## Stuck turns",
              f"{stuck['flagged_turns']} of {stuck['turns']} turns ({stuck['share']:.1%}); "
              f"{stuck['tool_calls']} tool calls; API-equivalent cost {money(stuck['cost'])} ({stuck['cost_share']:.1%} of cost).",
              "Project | Agent | Repeats | Turns | Session | Signature", "--- | --- | --- | --- | --- | ---"]
    lines += [" | ".join(cell(row[k]) for k in ("project", "agent", "repeats", "turns", "session", "signature"))
              for row in stuck["signatures"]] or ["None."]
    lines += ["", "## Repeated failures across sessions", "Project | Signature | Sessions | Occurrences | Worked instead",
              "--- | --- | --- | --- | ---"]
    lines += [" | ".join(cell(row[k]) for k in ("project", "signature", "sessions", "occurrences", "worked_instead"))
              for row in data["repeat_failures"]] or ["None."]
    lines += ["", "## Unused tools and MCP servers",
              "A deny rule takes effect for new sessions. Changing the tool set invalidates the prompt cache of a resumed conversation.",
              "Universe: recorded tool definitions/deferred names and MCP instructions when available; otherwise tools used across all projects in the window plus user/project MCP configuration. Loading state is unknown without evidence.",
              f"{data['deferred_tools_unused']} deferred tools unused (names only, ~negligible per turn)",
              "Project | Candidate | Kind | Sessions without use | Prompts without use | Tools | Loading",
              "--- | --- | --- | --- | --- | --- | ---"]
    lines += [" | ".join(cell(row[k]) for k in ("project", "candidate", "kind", "sessions", "prompts")) +
              " | " + (f"{row['tools']} tools" if row["kind"] == "MCP server" else "—") +
              " | " + loading_state(row["loading"])
              for row in data["unused_tools"][:25]] or ["None."]
    if len(data["unused_tools"]) > 25:
        lines.append(f"+{len(data['unused_tools']) - 25} more; use --json for all details.")
    projects = len({r["project"] for r in data["unused_tools"]})
    headline = [f"API-equivalent cost {money(cost['total'])} (cache reads {cost['shares'].get('cache_read', 0):.1%})",
                f"Stuck turns: {stuck['flagged_turns']} of {stuck['turns']} ({stuck['cost_share']:.1%} of cost)",
                f"Repo-fact candidates: {len(data['repeat_failures'])}",
                f"Pruning candidates: {len(data['unused_tools'])} across {projects} project{'s' if projects != 1 else ''}"]
    return lines, headline


def cell(value):
    return str(value).replace("|", "\\|").replace("\n", " ").replace("\r", " ")


def avg(counter):
    return round(counter["context"] / max(1, counter["calls"]))


def agent_stats(data):
    result = []
    usage = {row["agent"]: row for row in data["agent_usage"]}
    for name, spawns in data["agents"].items():
        calls = [spawn["calls"] for spawn in spawns]
        median = statistics.median(calls)
        ctx = sum(spawn["context"] for spawn in spawns)
        flag = " ⚠" if median > 120 else ""
        brief = data["briefs"].get(name)
        brief_text = f"{brief['median']:g}/{brief['max']}" if brief else "-"
        row = usage[name]
        models = ", ".join(sorted(row["models"], key=lambda model: (-row["models"][model], model))[:3]) or "-"
        effort = ", ".join(f"{label} {count}" for label, count in sorted(
            row["effort"].items(), key=lambda pair: (-pair[1], pair[0]))) or "-"
        values = (name + flag, len(spawns), f"{median:g}/{max(calls)}", ctx, round(ctx / sum(calls)),
                  f"{statistics.median(s['minutes'] for s in spawns):.1f}", brief_text,
                  f"{row['cost_share']:.1%}", models, effort)
        result.append((ctx, name, " | ".join(cell(value) for value in values)))
    return sorted(result, reverse=True)


def previous_audit(out, scope, eligible=None):
    candidates = sorted((p for p in out.parent.glob("token-audit-*.md") if p != out),
                        key=lambda p: (p.stat().st_mtime_ns, p.name), reverse=True)
    match, other = None, None
    for path in candidates:
        try:
            # Report markers are ASCII, including in older locale-encoded reports.
            with path.open(encoding="utf-8", errors="replace") as stream:
                for line in stream:
                    if line.startswith("<!-- token-audit-headline "):
                        value = json.loads(line.removeprefix("<!-- token-audit-headline ").rstrip("\r\n").removesuffix(" -->"))
                        if not isinstance(value, dict):
                            break
                        metadata = None
                        line = next(stream, "")
                        if line.startswith("<!-- token-audit-scope "):
                            try:
                                metadata = json.loads(line.removeprefix("<!-- token-audit-scope ").rstrip("\r\n").removesuffix(" -->"))
                            except ValueError:
                                pass
                        # Partial or other-format scope lines count as no scope, never as a crash.
                        if not isinstance(metadata, dict) or set(metadata) != set(scope):
                            metadata = None
                        entry = (path, value, metadata)
                        if match is None and metadata == scope and (eligible is None or eligible(path)):
                            match = entry
                        elif other is None:
                            other = entry
                        break
        except (OSError, ValueError):
            continue
        if match is not None and other is not None:
            break
    return match, other


def describe(scope):
    if scope["cwd"] is not None:
        projects = "cwd " + ", ".join(scope["cwd"])
    elif scope["project_dirs"]:
        projects = "project dirs " + ", ".join(scope["project_dirs"])
    else:
        projects = "all projects"
    if scope["project"] is not None:
        project = "project " + json.dumps(scope["project"])
        projects = projects + ", " + project if scope["project_dirs"] or scope["cwd"] is not None else project
    return "window " + scope["window"] + ", " + projects


def audit_machine_key(*, create=False):
    helper = Path(__file__).resolve().with_name("kaizen_friction_actions.py")
    if helper.is_file():
        actions = runpy.run_path(str(helper))["HostActions"]
        backups = Path(os.environ.get("KAIZEN_BACKUP_DIR") or claude_home() / "kaizen-backups").expanduser()
        return actions(claude_home().absolute() / "audits", backups, None, None)._secret(create=create)


def regression_binding_mac(secret, report_name, binding):
    payload = json.dumps([report_name, binding], sort_keys=True, separators=(",", ":")).encode("ascii")
    return hmac.digest(secret, b"friction-regression-binding-v1\0" + payload, "sha256").hex()


def regression_cohorts(path, scope, extract_dir, friction, secret):
    try:
        if path.stat().st_size > 1024 * 1024:
            return
        report_text = path.read_text(encoding="utf-8", errors="replace")
        if not report_text.endswith("<!-- token-audit-complete -->\n"):
            return
        metadata = next(line for line in report_text.splitlines() if line.startswith("<!-- token-audit-extract "))
        ref = json.loads(metadata[len("<!-- token-audit-extract "):-4])
        name = path.stem + ".extract.json"
        if ref != dict(v=1, file=name):
            return
        bindings = re.findall(r"^<!-- token-audit-friction (.*?) -->$", report_text, re.M)
        if len(bindings) != 1:
            return
        binding = json.loads(bindings[0])
        size = binding.get("size")
        if type(size) is not int or not 0 < size <= 8 * 1024 * 1024:
            return
        macs = re.findall(r"^<!-- token-audit-friction-mac (.*?) -->$", report_text, re.M)
        if (len(macs) != 1 or not re.fullmatch(r"[0-9a-f]{64}", macs[0])
                or not hmac.compare_digest(macs[0], regression_binding_mac(secret, path.name, binding))):
            return
        extract = extract_dir.expanduser() / name
        if extract.stat().st_size != size:
            return
        with extract.open("rb") as stream:
            raw = stream.read(size + 1)
        if len(raw) != size or binding != dict(size=size, sha256=hashlib.sha256(raw).hexdigest()):
            return
        previous = json.loads(raw)
        old = previous["friction"]
        if (type(previous["v"]) is not int or previous["v"] != 1
                or previous["scope"] != scope or previous["report"] != path.name
                or type(old["v"]) is not int or old["v"] != friction["v"] or old["thresholds"] != friction["thresholds"]
                or old["window"] != friction["window"] or old["basis"] != friction["basis"]
                or old["summary"]["capped"]):
            return
        indexed = {}
        for row in old["comparisons"]:
            key = (row["signature"], row["basis"])
            if (key in indexed or not isinstance(key[0], str) or key[1] not in ("measured", "row_gap")
                    or type(row["count"]) is not int or row["count"] < 3
                    or type(row["p50"]) not in (int, float) or not math.isfinite(row["p50"]) or row["p50"] < 0):
                return
            indexed[key] = row
        return indexed
    except (OSError, ValueError, TypeError, KeyError, AttributeError, StopIteration, OverflowError, RecursionError):
        return None


def apply_regression(data, out, scope, extract_dir):
    friction = data.get("friction")
    if friction is None or friction["summary"]["capped"]:
        return
    current = {(row["signature"], row["basis"]): row for row in friction["comparisons"] if row["count"] >= 3}
    if not current:
        return
    try:
        secret = audit_machine_key()
    except (OSError, ValueError):
        return
    if secret is None:
        return
    indexed = None

    def eligible(path):
        nonlocal indexed
        indexed = regression_cohorts(path, scope, extract_dir, friction, secret)
        return indexed is not None and any(key in current and row["p50"] > 0 for key, row in indexed.items())

    match, _ = previous_audit(out, scope, eligible)
    if match is None:
        return
    regressions = []
    for key, row in current.items():
        before = indexed.get(key)
        if before and before["p50"] > 0 and row["p50"] >= 1.5 * before["p50"]:
            regressions.append(dict(signature=row["signature"], basis=row["basis"], count=row["count"],
                                    previous_count=before["count"], p50=row["p50"], previous_p50=before["p50"],
                                    ratio=round(row["p50"] / before["p50"], 3)))
    friction["regressions"] = regressions
    for row in regressions:
        friction["flags"].append(dict(id="regression", subject=row["signature"], value=row["p50"],
                                      basis=row["basis"], detail="Comparable median timing grew by at least 1.5 times."))


def report(data, out, scope, extract_binding=None, extract_mac=None):
    h = data["headline"]
    headline = [f"Claude: {h['claude_calls']:,} calls; {h['claude_context']:,} context tokens; {h['claude_output']:,} output tokens.",
                f"Codex: {h['codex_sessions']:,} sessions; {h['codex_tokens']:,} tokens."]
    cache = data["cache_writes"]
    writes = sum(entry["writes"] for groups in cache.values() for entry in groups.values())
    tokens = sum(entry["write_tokens"] for groups in cache.values() for entry in groups.values())
    rewrites = sum(entry["full_rewrites"] for groups in cache.values() for entry in groups.values())
    headline.append(f"Claude cache writes: {writes:,} calls; {tokens:,} tokens; {rewrites:,} full rewrites (at least 80% of context). First observed gaps may be unknown; Codex does not report cache writes.")
    gap_counts = ", ".join(f"{bucket} {sum(groups[bucket]['writes'] for groups in cache.values()):,}"
                           for bucket in CACHE_BUCKETS)
    headline.append("Cache write gaps (main and individual subagent transcripts): " + gap_counts + ".")
    if any(c["unknown_records"] or c["missing_usage"] for c in data["format_canary"].values()):
        types = sorted(data.get("unknown_types", {}).items(), key=lambda item: (-item[1], item[0]))[:5]
        suffix = " unknown_types=" + ",".join(f"{name}:{count}" for name, count in types) if types else ""
        headline.append("FORMAT-DRIFT: " + h["format_canary"] + suffix)
    elif not data["format_canary"]:
        headline.append("FORMAT-DRIFT: no transcript data observed.")
    sections = []
    sections.append(("1. Totals by model (Claude)",
                     ["Model | Calls | Context | Cache-read share | Output"],
                     [f"{cell(name)} | {c['calls']} | {c['context']} | {c['cache_read'] / max(1, c['context']):.1%} | {c['output']}"
                      for name, c in sorted(data["models"].items(), key=lambda pair: -pair[1]["context"])]))
    sessions = sorted(data["sessions"], key=lambda s: -s["context"])
    sections.append(("2. Main sessions", ["ID | Date | Calls | Avg context | Peak context"],
                     [f"{cell(s['id'])}{' ⚠' if s['context'] > s['calls'] * 150000 or s['peak'] > 250000 else ''} | "
                      f"{s['date']} | {s['calls']} | {avg(s)} | {s['peak']}" for s in sessions]))
    agents = agent_stats(data)
    sections.append(("3. By agent type", ["Agent | Spawns | Median/max calls | Context | Avg context | Median minutes | Median/max brief chars | Cost share | Models | Effort"],
                     [row for _, _, row in agents]))
    sections.append(("4. Orchestrator turns by trigger", ["Trigger | Turns | Avg context"],
                     [f"{trigger} | {data['triggers'][trigger]['calls']} | {avg(data['triggers'][trigger])}"
                      for trigger in ("human", "tool result", "task notification")]))
    sections.append(("5. Main-session tool results",
                     [f"Image blocks read: {data['images']}{' ⚠ images in main session' if data['images'] else ''}",
                      "Tool | Results | Chars"],
                     [f"{cell(tool)} | {data['tool_counts'][tool]} | {chars}"
                      for tool, chars in data["tool_chars"].most_common()]))
    heavy = [name for _, name, _ in agents if any(s["calls"] > 8 for s in data["agents"][name])]
    sections.append(("6. Top Bash command heads per heavy agent", [],
                     [f"{cell(name)}: " + "; ".join(
                         f"{cell(head)} ({count} calls, {data['bash_chars'][name][head]} chars)"
                         for head, count in data["bash"][name].most_common(6)) for name in heavy]))
    sections.append(("7. Codex by model", ["Model | Sessions | Input (cached subset) | Output | Tokens | Median brief chars"],
                     [f"{cell(name)} | {c['sessions']} | {c['input']} ({c['cached_input']}) | {c['output']} | {c['tokens']} | "
                      f"{data['codex_briefs'][name]['median']:g}" if name in data["codex_briefs"] else
                      f"{cell(name)} | {c['sessions']} | {c['input']} ({c['cached_input']}) | {c['output']} | {c['tokens']} | -"
                      for name, c in sorted(data["codex"].items(), key=lambda pair: -pair[1]["tokens"])]))
    kinds = defaultdict(list)
    for session in data["codex_sessions"]:
        kinds[(session["kind"], session["model"], session["effort"])].append(session)
    kind_rows = []
    for (kind, model, effort), group in sorted(kinds.items(), key=lambda pair: -sum(s["tokens"] for s in pair[1])):
        durations = [s["duration_s"] for s in group if s["duration_s"] is not None]
        median = f"{statistics.median(durations) / 60:.1f}" if durations else "n/a"
        hours = f"{sum(durations) / 3600:.1f}" if durations else "n/a"
        kind_rows.append(f"{kind} | {cell(model)} | {cell(effort)} | {len(group)} | {median} | {hours} | {sum(s['tokens'] for s in group)}")
    if len(kind_rows) > 12:
        kind_rows = kind_rows[:12] + [f"… {len(kind_rows) - 12} more kind/model/effort rows omitted; use --json for all details."]
    sections.append(("7b. Codex by kind, model and effort",
                     ["Kind | Model | Effort | Sessions | Median min | Total hours | Tokens"], kind_rows))
    match, other = previous_audit(out, scope)
    volume = ("claude_calls", "claude_context", "claude_output", "codex_sessions", "codex_tokens", "image_reads")
    intensity = ("claude_context_per_call", "claude_output_per_call", "image_reads_per_100_calls",
                 "brief_chars_median", "codex_tokens_per_session", "codex_brief_chars_median")
    changes = ["No earlier token-audit report."]
    old = match[1] if match is not None else None
    if match is not None:
        deltas = []
        for key in intensity:
            if key not in old:
                deltas.append(f"{key} new")
            else:
                percent = f" ({(h[key] - old[key]) / old[key] * 100:+.1f}%)" if old[key] else ""
                deltas.append(f"{key} {old[key]:,} → {h[key]:,}{percent}")
        changes = [f"Compared with {match[0].name} (same scope: {describe(scope)}).",
                   "Activity (never flagged): " + "; ".join(
                       f"{key} {h[key] - old[key]:+,}" if key in old else f"{key} new" for key in volume) + ".",
                   "Intensity: " + "; ".join(deltas) + "."]
    elif other is not None:
        prior_scope = describe(other[2]) if other[2] is not None else "no scope metadata, before 0.4.0"
        changes = [f"Not comparable: no earlier report with the same scope ({describe(scope)}). "
                   f"Newest other report: {other[0].name} ({prior_scope})."]
    sections.append(("8. Changes since last audit", [], changes))
    data["flagged"] = []
    flags = []
    for key in intensity:
        if old is None or key not in old:
            continue
        before = old[key]
        sample, minimum = ("codex_sessions", 3) if key.startswith("codex_") else ("claude_calls", 20)
        if before <= 0 or old.get(sample, 0) < minimum:
            flags.append(f"{key}: baseline too small to compare")
            continue
        value = h[key]
        if (value - before) * 100 > before * 20:
            data["flagged"].append(dict(metric=key, old=before, new=value,
                                        percent_change=(value - before) / before * 100))
    for flag in data["flagged"]:
        percent = f"{flag['percent_change']:.1f}" if flag['percent_change'] is not None else "∞"
        flags.append(f"{flag['metric']}: {flag['old']:,} → {flag['new']:,} (+{percent}%).")
    sections.append(("9. Flagged", [], flags or [
        "Nothing flagged: no comparable report." if match is None and other is not None else
        "no previous audit to compare" if match is None else "None."]))
    # A pipe header needs a separator row to render as a Markdown table.
    for _, headers, _ in sections:
        if headers and " | " in headers[-1]:
            headers.append(" | ".join("---" for _ in headers[-1].split(" | ")))
    lines = [*data["parser_warnings"], "# Token audit", f"Since: {data['since']} (UTC; Claude calls in window, Codex in-window token deltas).",
             *headline, "<!-- token-audit-headline " + json.dumps(h) + " -->",
             "<!-- token-audit-scope " + json.dumps(scope, sort_keys=True) + " -->",
             "<!-- token-audit-extract " + json.dumps(dict(v=1, file=out.stem + ".extract.json")) + " -->"]
    if data["warnings"]:
        lines.append("Skipped: " + "; ".join(f"{n} {key}" for key, n in data["warnings"].items()))
    # Fairly share the remaining 80-line budget; JSON retains every row.
    budgets = [0] * len(sections)
    remaining = 80 - len(lines) - sum(2 + len(headers) for _, headers, _ in sections)
    # Always show comparison details and every regression.
    budgets[-2] = len(changes)
    budgets[-1] = len(sections[-1][2])
    remaining -= budgets[-2] + budgets[-1]
    needs = [max(1, len(rows)) for _, _, rows in sections]
    while remaining > 0 and any(b < n for b, n in zip(budgets, needs)):
        for i, need in enumerate(needs):
            if remaining and budgets[i] < need:
                budgets[i] += 1
                remaining -= 1
    for (title, headers, body), budget in zip(sections, budgets):
        lines += ["", "## " + title] + headers
        if not body:
            lines.append("None.")
        elif len(body) > budget:
            lines += body[:max(0, budget - 1)] + [f"… {len(body) - max(0, budget - 1)} more rows; use --json for all details."]
        else:
            lines += body
    extra, headlines = measurement_sections(data)
    if "friction" in data:
        extra += friction_sections(data["friction"])
    if extract_binding is not None:
        extra.append("<!-- token-audit-friction " + json.dumps(extract_binding) + " -->")
    if extract_mac is not None:
        extra.append("<!-- token-audit-friction-mac " + extract_mac + " -->")
    return "\n".join(lines + extra + ["<!-- token-audit-complete -->"]) + "\n", headline + headlines


def write_extract(data, out, directory, scope, now=None):
    directory_fd = temporary = None
    try:
        if not all(hasattr(os, name) for name in ("O_NOFOLLOW", "O_DIRECTORY", "geteuid")):
            raise ValueError("secure extract storage unavailable on this platform")
        directory = directory.expanduser().absolute()
        # Walk from the filesystem root without following any symlink component.
        directory_fd = os.open(directory.anchor, os.O_RDONLY | os.O_NOFOLLOW | os.O_DIRECTORY)
        for component in directory.parts[1:]:
            try:
                os.mkdir(component, 0o700, dir_fd=directory_fd)
            except FileExistsError:
                pass
            next_fd = os.open(component, os.O_RDONLY | os.O_NOFOLLOW | os.O_DIRECTORY,
                              dir_fd=directory_fd)
            os.close(directory_fd)
            directory_fd = next_fd
        store = os.fstat(directory_fd)
        if store.st_uid != os.geteuid():
            raise ValueError("extract directory is owned by another user")
        if stat.S_IMODE(store.st_mode) != 0o700:
            if directory != claude_home().absolute() / "audits" / "extracts":
                raise ValueError("custom extract directory must have mode 0700")
            os.fchmod(directory_fd, 0o700)
        name = out.stem + ".extract.json"
        value = dict(v=1, scope=scope, since=data["since"], report=out.name,
                     usage=dict(agents=data["agent_usage"], sessions=[], task_switches=[], instructions=[]))
        friction = data.get("friction")
        if friction and (friction["summary"]["samples"] or friction["summary"]["capped"] or any(friction["signals"].values()) or friction["permission_acceptance"] or friction.get("host_load") or friction.get("permission_waits", {}).get("count")):
            value["friction"] = friction
            if now is not None and friction["permission_acceptance"]:
                value["friction"] = dict(friction, audited_at=now.isoformat())
        audits = claude_home().absolute() / "audits"
        managed_store = directory == audits / "extracts" or directory.parent == audits / "projects"
        if (friction and friction["permission_acceptance"] and managed_store
                and scope.get("cwd") and scope.get("project") is None and not scope.get("project_dirs")):
            # A standalone audit can still emit an extract. Only an install with
            # the machine key helper can attest counters for a settings write.
            try:
                secret = audit_machine_key(create=True)
                if secret is not None:
                    payload = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("ascii")
                    value["allow_rule_mac"] = hmac.digest(secret, b"allow-rule-extract-v2\0" + payload, "sha256").hex()
            except (OSError, ValueError):
                print("token-audit: could not authenticate allow-rule evidence", file=sys.stderr)
        raw = (json.dumps(value) + "\n").encode("ascii")
        candidate = ".extract-" + os.urandom(16).hex()
        fd = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory_fd)
        temporary = candidate
        with os.fdopen(fd, "wb") as stream:
            stream.write(raw)
        os.replace(temporary, name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        temporary = None
        return str(directory / name), dict(size=len(raw), sha256=hashlib.sha256(raw).hexdigest())
    except (OSError, ValueError) as exc:
        print(f"token-audit: extract not written ({exc})", file=sys.stderr)
        return None
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary, dir_fd=directory_fd)
            except OSError:
                pass
        if directory_fd is not None:
            os.close(directory_fd)


MAX_DAYS = 36500


def utc_date(value):
    try:
        return datetime.strptime(value, "%Y-%m-%d").replace(tzinfo=timezone.utc)
    except ValueError:
        raise argparse.ArgumentTypeError(f"{value!r} is not a date in YYYY-MM-DD form")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    period = parser.add_mutually_exclusive_group()
    period.add_argument("--days", type=int, default=3,
                        help=f"audit the last N days, 0 to {MAX_DAYS} (default: 3)")
    period.add_argument("--since", type=utc_date, metavar="YYYY-MM-DD",
                        help="audit from this UTC date instead of --days (default: use --days)")
    selection = parser.add_mutually_exclusive_group()
    selection.add_argument("--project", help="filter Claude project folder names by substring; "
                           "does not filter Codex sessions (--cwd does)")
    selection.add_argument("--cwd", action="append", metavar="PATH",
                           help="select Claude transcripts and Codex sessions by working directory "
                           "and its descendants (repeatable; default: all)")
    parser.add_argument("--project-dir", action="append", default=[], type=Path,
                        help="audit this Claude project directory instead of every one under the "
                        "Claude config dir (repeatable; default: all projects)")
    parser.add_argument("--codex", action="store_true",
                        help="kept for compatibility; Codex sessions are always included")
    parser.add_argument("--out", type=Path,
                        help="report directory (default: Claude config dir/audits)")
    parser.add_argument("--extract-out", type=Path, default=claude_home() / "audits" / "extracts",
                        help="extract directory (default: Claude config dir/audits/extracts)")
    parser.add_argument("--json", action="store_true", help="print full structured data instead of headline stdout")
    parser.add_argument("--no-write", action="store_true", help="do not write a report or extract")
    parser.add_argument("--samples-dir", type=Path, help="private sample source (default: configured audits/samples)")
    parser.add_argument("--no-friction", action="store_true", help="disable friction collection and reporting")
    parser.add_argument("--friction-slow-seconds", type=int, default=FRICTION_THRESHOLDS["slow_call_seconds"],
                        help="flag individual calls at or above this duration (default: %(default)s)")
    parser.add_argument("--friction-heavy-seconds", type=int, default=FRICTION_THRESHOLDS["heavy_seconds"],
                        help="flag median durations at or above this value across 3 or more calls (default: %(default)s)")
    parser.add_argument("--pricing", type=Path, default=Path(__file__).resolve().with_name("pricing.json"),
                        help="pricing file (default: pricing.json next to this script)")
    for flag, default, text in (
            ("stuck-repeats", 3, "same failed tool call this many times in one turn marks it stuck"),
            ("fact-sessions", 3, "sessions that hit the same failure before it is a repo-fact candidate"),
            ("prune-prompts", 10, "prompts without use before an unused tool or server is a pruning candidate"),
            ("prune-min-sessions", 2, "sessions without use that go with --prune-prompts"),
            ("prune-sessions", 5, "sessions without use that make a pruning candidate on their own")):
        parser.add_argument("--" + flag, type=int, default=default, help=f"{text} (default: {default})")
    args = parser.parse_args()
    options = {key: getattr(args, key) for key in ("stuck_repeats", "fact_sessions", "prune_prompts",
                                                  "prune_min_sessions", "prune_sessions")}
    if any(value < 1 for value in options.values()):
        parser.error("measurement thresholds must be positive")
    friction_thresholds = dict(slow_call_seconds=args.friction_slow_seconds, heavy_seconds=args.friction_heavy_seconds)
    if any(value < 1 for value in friction_thresholds.values()):
        parser.error("friction thresholds must be positive")
    if not 0 <= args.days <= MAX_DAYS:
        parser.error(f"--days must be between 0 and {MAX_DAYS}")
    now = datetime.now(timezone.utc)
    since = args.since or (now - timedelta(days=args.days)).replace(microsecond=0)
    root = claude_home() / "projects"
    projects = [p.expanduser().resolve() for p in args.project_dir] if args.project_dir else (
        sorted(p for p in root.iterdir() if p.is_dir()) if root.is_dir() else [])
    codex_root = codex_home() / "sessions"
    cwd = sorted({str(Path(p).expanduser().resolve()) for p in args.cwd}) if args.cwd else None
    scope = dict(codex=("cwd" if cwd is not None else "all") if codex_root.exists() else "none", cwd=cwd,
                 project=args.project.casefold() if args.project else None,
                 project_dirs=sorted({str(p.expanduser().resolve()) for p in args.project_dir}), v=1,
                 window="since:" + args.since.strftime("%Y-%m-%d") if args.since else f"{args.days}d")
    if not args.project_dir and not projects and not next(codex_root.glob("*/*/*/*.jsonl"), None):
        print(f"token-audit: no Claude Code projects under {root} "
              "(set CLAUDE_CONFIG_DIR if they live elsewhere)", file=sys.stderr)
    if os.path.isdir(Path(os.environ.get("COPILOT_HOME") or Path.home() / ".copilot").expanduser() / "session-state"):
        print("token-audit: Copilot sessions found but not measured in this version", file=sys.stderr)
    if args.project:
        projects = [p for p in projects if args.project.casefold() in p.name.casefold()]
    directory = (args.out or claude_home() / "audits").expanduser().resolve()
    out = directory / f"token-audit-{now:%Y%m%dT%H%M%S.%fZ}.md"
    try:
        for path in projects:
            if not path.is_dir():
                raise ValueError(f"project directory missing: {path}")
        pricing, pricing_error = load_pricing(args.pricing.expanduser())
        friction_window = None if args.since else dict(kind="rolling", seconds=args.days * 86400,
                                                        policy="utc-now-floor-second")
        data = collect(projects, codex_root, since, pricing, pricing_error, options, cwd,
                       friction=not args.no_friction, friction_thresholds=friction_thresholds,
                       friction_window=friction_window, samples_dir=args.samples_dir, now=now)
        data["cost"]["pricing_warning"] = pricing_age_warning(pricing, now)
        data["scope"] = scope
        apply_regression(data, out, scope, args.extract_out)
        for warning in data["parser_warnings"]:
            print(warning, file=sys.stderr)
        extract_path = binding = extract_mac = None
        if not args.no_write:
            out.parent.mkdir(parents=True, exist_ok=True)
            extract_path, binding = write_extract(data, out, args.extract_out, scope, now) or (None, None)
            if (binding is not None and data.get("friction", {}).get("comparisons")
                    and not data["warnings"].get("unsafe permission transcript")):
                try:
                    secret = audit_machine_key(create=True)
                    if secret is not None:
                        extract_mac = regression_binding_mac(secret, out.name, binding)
                except (OSError, ValueError):
                    print("token-audit: could not authenticate regression evidence", file=sys.stderr)
        text, headline = report(data, out, scope, binding, extract_mac)
        if not args.no_write:
            out.write_text(text, encoding="utf-8")
        if args.json:
            print(json.dumps(dict(report_path=None if args.no_write else str(out), extract_path=extract_path, **data), indent=2))
        else:
            print(("" if args.no_write else str(out) + "\n") + "\n".join(headline))
        return 0
    except (OSError, ValueError) as exc:
        print(f"token-audit: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
