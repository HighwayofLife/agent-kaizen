#!/usr/bin/env python3
"""Build a project report from packet outcomes and owner-configured commands."""
import argparse
from datetime import date
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile


def claude_home():
    return Path(os.environ.get('CLAUDE_CONFIG_DIR') or Path.home() / '.claude').expanduser()


def section(title, lines):
    return {'title': title, 'lines': lines}


def run_command(argv, project):
    try:
        result = subprocess.run(argv, cwd=project, capture_output=True, text=True,
                                timeout=120, shell=False)
        if result.returncode:
            return [f'unavailable: exit {result.returncode}' +
                    (f': {result.stderr.strip()}' if result.stderr.strip() else '')]
        lines = result.stdout.splitlines()
        return lines[:15] + ([f'… {len(lines) - 15} more lines'] if len(lines) > 15 else [])
    except (subprocess.TimeoutExpired, OSError, ValueError, TypeError) as error:
        return [f'unavailable: {error}']


def packet_sections(project, log, since):
    path = project / log
    if not path.is_file():
        return [section('Packet outcomes', [f'no outcome log at {log}']),
                section('Calibration proposals', ['no outcome log at ' + str(log)])]
    argv = [sys.executable, str(Path(__file__).resolve().parent / 'packet-report'),
            '--packets', str(path), '--markdown']
    if since:
        argv += ['--since', since]
    try:
        result = subprocess.run(argv, cwd=project, capture_output=True, text=True,
                                timeout=120, shell=False)
        if result.returncode:
            raise ValueError(result.stderr.strip() or f'exit {result.returncode}')
        lines = result.stdout.splitlines()
        split = lines.index('Calibration proposals')
        return [section('Packet outcomes', lines[1:split]),
                section('Calibration proposals', lines[split + 1:])]
    except (subprocess.TimeoutExpired, OSError, ValueError) as error:
        return [section('Packet outcomes', [f'unavailable: {error}']),
                section('Calibration proposals', [f'unavailable: {error}'])]


def ledger_lines(project):
    path = project / 'docs/kaizen/LEDGER.md'
    try:
        lines = path.read_text(encoding='utf-8').splitlines()
    except FileNotFoundError:
        return ['ledger not found']
    except OSError as error:
        return [f'ledger unavailable: {error}']
    columns = None
    pending = []
    for line in lines:
        if '|' not in line:
            continue
        cells = [cell.strip() for cell in line.strip().strip('|').split('|')]
        lowered = [cell.lower() for cell in cells]
        if 'date' in lowered and 'measured effect' in lowered:
            columns = {name: lowered.index(name) for name in ('date', 'measured effect')}
            if 'change' in lowered:
                columns['change'] = lowered.index('change')
            continue
        if columns is None or len(cells) <= max(columns.values()):
            continue
        if cells[columns['measured effect']].lower() != 'pending':
            continue
        try:
            day = date.fromisoformat(cells[columns['date']])
        except ValueError:
            continue
        change = cells[columns['change']][:60] if 'change' in columns else ''
        pending.append(f"{day.isoformat()} {change} ({(date.today() - day).days} days pending)".strip())
    if columns is None:
        return ['ledger missing date or measured effect column']
    return pending or ['no pending rows']


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--project', required=True, type=Path)
    parser.add_argument('--since', type=date.fromisoformat)
    parser.add_argument('--out', type=Path)
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--verbose', action='store_true')
    args = parser.parse_args()
    project = args.project.expanduser().resolve()
    if not project.is_dir() or not (project / 'docs/kaizen').is_dir():
        parser.exit(2, 'not an enrolled project\n')
    try:
        with (claude_home() / 'agent-kaizen.json').open(encoding='utf-8') as stream:
            config = json.load(stream)
    except FileNotFoundError:
        config = {}
    except (OSError, ValueError) as error:
        parser.exit(2, f'global config unavailable: {error}\n')
    if not isinstance(config, dict) or not isinstance(config.get('projectCommands', {}), dict):
        parser.exit(2, 'projectCommands must be a dict\n')
    commands = {}
    for key, value in config.get('projectCommands', {}).items():
        if Path(key).expanduser().resolve() == project:
            if not isinstance(value, dict):
                parser.exit(2, 'projectCommands entry must be a dict\n')
            commands = value
            break
    sections = packet_sections(project, commands.get('outcomeLog', 'out/packets.jsonl'),
                               args.since.isoformat() if args.since else None)
    for key, title in [('shadowStatus', 'Shadow reviews'), ('slowTests', 'Slow tests'),
                       ('speedReport', 'Speed')]:
        if key in commands:
            sections.append(section(title, run_command(commands[key], project)))
        elif args.verbose:
            sections.append(section(title, ['not configured']))
    sections.append(section('Project ledger rows pending', ledger_lines(project)))
    output = (json.dumps({'sections': sections}) if args.json else
              '\n\n'.join('## ' + s['title'] + '\n' + '\n'.join(s['lines']) for s in sections)) + '\n'
    if args.out:
        name = None
        try:
            with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', dir=args.out.parent,
                                             delete=False) as stream:
                name = stream.name
                stream.write(output)
                mask = os.umask(0)
                os.umask(mask)
                os.fchmod(stream.fileno(), 0o644 & ~mask)
            os.replace(name, args.out)
        finally:
            if name and os.path.exists(name):
                os.unlink(name)
    else:
        sys.stdout.write(output)
    return 0


if __name__ == '__main__':
    sys.exit(main())
