+def tree_snapshot(cwd):
+    """Return the worktree fingerprint and number of changed paths, if in Git."""
+    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=cwd,
+                          capture_output=True, check=False)
+    if root.returncode:
+        return None
+    root = Path(os.fsdecode(root.stdout.rstrip(b"\n")))
+
+    def git(*args):
+        return subprocess.run(["git", *args], cwd=root, capture_output=True, check=True).stdout
+
+    status = git("status", "--porcelain=v1", "-uall", "-z")
+    try:
+        diff = git("diff", "HEAD", "--binary")
+    except subprocess.CalledProcessError:
+        # A newly initialized repository has no HEAD yet.
+        diff = git("diff", "--binary") + git("diff", "--cached", "--binary")
+    entries = status.split(b"\0")
+    untracked = []
+    count = 0
+    index = 0
+    while index < len(entries) and entries[index]:
+        entry = entries[index]
+        count += 1
+        if entry.startswith(b"?? "):
+            path = root / os.fsdecode(entry[3:])
+            stat = path.lstat()
+            if path.is_symlink():
+                content = os.fsencode(os.readlink(path))
+            elif stat.st_size > 5 * 1024 * 1024:
+                content = f"{stat.st_size}:{stat.st_mtime_ns}".encode()
+            else:
+                content = path.read_bytes()
+            untracked.append((entry[3:], hashlib.sha256(content).digest()))
+        if entry[:2].find(b"R") >= 0 or entry[:2].find(b"C") >= 0:
+            index += 1
+        index += 1
+    return (status, hashlib.sha256(diff).digest(), tuple(untracked)), count
+
